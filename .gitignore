# Lean build artefacts and the mathlib checkout (7.8 GB; restore with `lake exe cache get`)
lean/.lake/
lean/build/
lean/lakefile.olean

# Node
**/node_modules/
**/.vite/

# LaTeX byproducts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk

# Downloaded papers: PDFs are third-party and large. The INVENTORY.md files,
# which carry the citations and verbatim theorem statements, are kept.
papers/**/*.pdf
papers/**/*.txt

# Scratch output from probe scripts
formal/**/*.out
**/.graphify_*
graphify-out/cache/

# Editor / OS
.DS_Store
*.swp

# Model-checker server output and run logs
_apalache-out/
**/_apalache-out/
formal/*.log
formal/**/*.log

# Third-party protocol source, cloned for the Phase 2 re-spec (3.5 GB).
# Rebuild with research/positive-program/tooling/clone_repos.sh
protocol-repos/

# The corpus split is derived and rebuildable.
# Rebuild with research/positive-program/tooling/split_tex.py.
paper/kg-corpus/

# graphify-out is NOT wholly derived, whatever its name suggests. The gate path
# reads expansion/*/graphify-out/graph.json (verify-graphs.py, lane-coverage.py,
# merged-fresh.sh) and GRAPH_REPORT.md (lane-coverage.py), so those are committed
# inputs and ignoring them while depending on them is the contradiction this
# resolves. Regenerating is not a substitute: merged-fresh.sh shows the generator
# is not byte-reproducible across graphify versions. Only the content-addressed
# cache below is genuinely disposable.
**/graphify-out/cache/

# Scratch
tmp/

# A Windows absolute path handed to a WSL-side tool is not a destination, it is
# a filename: backslashes are ordinary characters there, so the tool creates a
# file in the current directory whose NAME is the path. One 16,701-line scratch
# chunk reached a commit that way. Refuse the shape.
*C:\\Users\\*
*\\scratchpad\\*
