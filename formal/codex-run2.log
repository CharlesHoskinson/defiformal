@@ -0,0 +1,173 @@
+module atlas {
+  type Element =
+    | Sh | Ix | Rb
+    | Cp | Wg | St | Cl | Pm
+    | Ob | Rf | Ba | In
+    | Ag | Fl
+    | Pl | Im | Cd | Uc | Ft
+    | Ct | Li | Ad | Sl | Bs
+    | Pf | Op | Tr | Cv | Py | Sv | Dp
+    | Ex | Tp | Oa | At
+    | Sr | Ep | Wq
+    | Em | Fd
+    | Tg | Up | Gp | Au | Gs
+    | Xm | Xf | Rl | Of
+    | Rd | Ps | As
+    | Aw | Sb | Sd | Fz
+    | Rs | Vl
+
+  type Group =
