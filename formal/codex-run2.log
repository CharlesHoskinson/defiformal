@@ -0,0 +1,416 @@
+module atlas {
+  type Element =
+    | Sh | Ix | Rb
+    | Cp | Wg | St | Cl | Pm
+    | Ob | Rf | Ba | In
+    | Ag | Fl
+    | Pl | Im | Cd | Uc | Ft
+    | Ct | Li | Ad | Sl | Bs
+    | Pf | Op | Tr | Cv | Py | Sv | Dp
