+module atlas {
+  type Element =
+    | Sh | Ix | Rb
+    | Cp | Wg | St | Cl | Pm
+    | Ob | Rf | Ba | In
+    | Ag | Fl
+    | Pl | Im | Cd | Uc | Ft
+    | Ct | Li | Ad | Sl | Bs
+    | Pf | Op | Tr | Cv | Py | Sv | Dp
+    | Ex | Tp | Oa | At
+    | Sr | Ep | Wq
+    | Em | Fd
+    | Tg | Up | Gp | Au | Gs
+    | Xm | Xf | Rl | Of
+    | Rd | Ps | As
+    | Aw | Sb | Sd | Fz
+    | Rs | Vl
+
+  type Group =
+    | G01 | G02 | G03 | G04 | G05 | G06 | G07 | G08
+    | G09 | G10 | G11 | G12 | G13 | G14 | G15 | G16
+
+  type Atom = AsyncNative | AsyncRepairable | AsyncImpossible
+  type ElementStatus = Core | Candidate | Provisional
+
+  type ElementAttributes = {
+    id: str,
+    name: str,
+    group: Group,
+    stratum: int,
+    atom: Atom,
+    status: ElementStatus,
+    definition: str,
+  }
+
+  pure val allElements: Set[Element] = Set(
+    Sh, Ix, Rb,
+    Cp, Wg, St, Cl, Pm,
+    Ob, Rf, Ba, In,
+    Ag, Fl,
+    Pl, Im, Cd, Uc, Ft,
+    Ct, Li, Ad, Sl, Bs,
+    Pf, Op, Tr, Cv, Py, Sv, Dp,
+    Ex, Tp, Oa, At,
+    Sr, Ep, Wq,
+    Em, Fd,
+    Tg, Up, Gp, Au, Gs,
+    Xm, Xf, Rl, Of,
+    Rd, Ps, As,
+    Aw, Sb, Sd, Fz,
+    Rs, Vl
+  )
+
+  // The first executable increment only establishes the empty-set law.
+  pure def satisfiesClosure(protocol: Set[Element]): bool = protocol.size() == 0
+}
