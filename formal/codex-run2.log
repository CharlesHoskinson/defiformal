+    name: str,
+    elements: Set[Element],
+    dead: bool,
+  }
+
+  pure val allElements: Set[Element] = Set(
+    Sh, Ix, Rb,
+    Cp, Wg, St, Cl, Pm,
+    Ob, Rf, Ba, In,
+    Ag, Fl,
+    Pl, Im, Cd, Uc, Ft,
+    Ct, Li, Ad, Sl, Bs,
+    Pf, Op, Tr, Cv, Py, Sv, Dp,
