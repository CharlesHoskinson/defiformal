+    { id: "terra", name: "Terra / Anchor", elements: Set(As, Rd, Ex, Pl, Ix, Em), dead: true },
+    { id: "mango", name: "Mango Markets", elements: Set(Ob, Pf, Pl, Ct, Ex, Li), dead: true },
+    { id: "euler", name: "Euler v1", elements: Set(Pl, Ix, Ct, Ex, Li, Fl, Up), dead: true }
+  )
+
+  pure val hazards: Set[Hazard] = Set(
+    { id: "X1", family: "X1", raw: "As + reflexive junior token, with no hard redemption or exogenous capital", elements: Set(As), cls: Forbidden, polarity: ExternalQualified },
+    { id: "X2", family: "X2", raw: "Fl* + manipulable Cp/Cl price + Pl/Cd, where manipulation cost < position value", elements: Set(Fl, Cp, Cl, Pl, Cd), cls: Elevated, polarity: MixedQualified },
+    { id: "X3", family: "X3", raw: "Protocol token as collateral AND oracle market AND backstop", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X4", family: "X4", raw: "Rb into a balance-invariant ledger with no adapter", elements: Set(Rb), cls: Forbidden, polarity: ExternalQualified },
+    { id: "X5", family: "X5", raw: "Illiquid backing + uncapped instant par redemption", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X6", family: "X6", raw: "Borrowable voting power + immediate execution", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X7", family: "X7", raw: "Cross-domain mint whose verifier is present but unproven correct", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X8", family: "X8", raw: "Shared collateral across nominally isolated markets", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X9", family: "X9", raw: "Up with immediate single-key control", elements: Set(Up), cls: Elevated, polarity: ExternalQualified },
+    { id: "X10", family: "X10", raw: "Pm with a stale reference and unrestricted inventory", elements: Set(Pm), cls: Elevated, polarity: ExternalQualified },
+    { id: "X11a", family: "X11", raw: "Uc with no Aw, At, collateral or reputation", elements: Set(Uc, Aw, At), cls: Forbidden, polarity: NegativeNamed },
+    { id: "X11b", family: "X11", raw: "Uc with all of them and weak underwriting", elements: Set(Uc), cls: Elevated, polarity: ExternalQualified },
+    { id: "X12", family: "X12", raw: "Lock-mint wrapped asset as canonical collateral whose value at risk exceeds the bridge's economic security", elements: Set(), cls: Forbidden, polarity: ExternalQualified },
+    { id: "X13", family: "X13", raw: "External-validator Xm securing value exceeding slashable stake", elements: Set(Xm), cls: Elevated, polarity: ExternalQualified },
+    { id: "X14", family: "X14", raw: "Exclusive market structure plus a price-improvement claim with no named benchmark", elements: Set(), cls: Unverifiable, polarity: ExternalQualified },
+    { id: "X15", family: "X15", raw: "Rs securing a bridge mostly with assets issued by that bridge", elements: Set(Rs), cls: Elevated, polarity: ExternalQualified },
+    { id: "X16", family: "X16", raw: "Unbounded delegated authority, or unlimited token approvals", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X17", family: "X17", raw: "Passive protocol-token reserve backing protocol-token collateral", elements: Set(), cls: Elevated, polarity: ExternalQualified },
+    { id: "X18", family: "X18", raw: "Oa as sole truth for high-frequency liquidation", elements: Set(Oa), cls: Elevated, polarity: ExternalQualified },
+    { id: "X19", family: "X19", raw: "Restricted claim bridged via Xf into a representation with no destination-side Aw", elements: Set(Xf, Aw), cls: Forbidden, polarity: NegativeNamed }
+  )
+
+  pure val hazardFamilies: Set[str] = hazards.map(hazard => hazard.family)
+
+  // This projection matches the TypeScript engine. It is not a semantic
+  // interpretation of negative or externally qualified hazard prose.
+  pure val projectedHazards: Set[Hazard] =
+    hazards.filter(hazard => hazard.elements.size() >= 2)
+
+  pure def projectedHazardArmed(hazard: Hazard, protocol: Set[Element]): bool =
+    hazard.elements.subseteq(protocol)
+
+  pure def hazardFree(protocol: Set[Element]): bool =
+    projectedHazards.forall(hazard => not(projectedHazardArmed(hazard, protocol)))
+
+  // X11a's element-only necessary condition, with source polarity restored.
+  // Collateral and reputation remain outside the vocabulary.
+  pure def x11aCoreFree(protocol: Set[Element]): bool =
+    not(protocol.contains(Uc) and not(protocol.contains(Aw)) and not(protocol.contains(At)))
+
+  pure val crossDomainElements: Set[Element] =
+    allElements.filter(element => elementAttributes.get(element).group == G12)
+
+  // HYPOTHESIS: a flat element set cannot scope Fl to one settlement domain.
+  pure def atomicScopeConsistent(protocol: Set[Element]): bool =
+    not(protocol.contains(Fl) and protocol.intersect(crossDomainElements).size() > 0)
+
+  // HYPOTHESIS: a dependency should not have a deeper hand stratum than
+  // the subject that requires it.
+  pure def stratumMonotone(protocol: Set[Element]): bool =
+    laws.forall(law =>
+      law.subjects.intersect(protocol).forall(subject =>
+        law.terms.forall(term =>
+          term.intersect(protocol).exists(required =>
+            elementAttributes.get(required).stratum <= elementAttributes.get(subject).stratum))))
+
+  pure def lawFires(law: Law, protocol: Set[Element]): bool =
+    law.subjects.intersect(protocol).size() > 0
+
+  pure def lawSatisfied(law: Law, protocol: Set[Element]): bool =
+    not(lawFires(law, protocol)) or
+      law.terms.forall(term => term.intersect(protocol).size() > 0)
+
+  pure def firedLaws(protocol: Set[Element]): Set[Law] =
+    laws.filter(law => lawFires(law, protocol))
+
+  pure def violatedLaws(protocol: Set[Element]): Set[Law] =
+    laws.filter(law => lawFires(law, protocol) and not(lawSatisfied(law, protocol)))
+
+  pure def satisfiesClosure(protocol: Set[Element]): bool =
+    laws.forall(law => lawSatisfied(law, protocol))
+}
diff --git a/formal/atlas_test.qnt b/formal/atlas_test.qnt
new file mode 100644
index 0000000000000000000000000000000000000000..5e8df7b70fa5867f26cdd530b68c056c59dcedd6
--- /dev/null
+++ b/formal/atlas_test.qnt
@@ -0,0 +1,76 @@
+module atlasTest {
+  import atlas.* from "./atlas"
+
+  run testVocabularyHasFiftyEightMechanisms = allElements.size() == 58
+
+  run testEveryMechanismHasAttributes =
+    allElements == elementAttributes.keys()
+
+  run testEmptyProtocolIsClosed = satisfiesClosure(Set())
+
+  run testSourceRelationCounts = all {
+    laws.size() == 29,
+    laws.filter(law => not(law.unsupportedSubject)).size() == 25,
+    protocols.size() == 12,
+    protocols.filter(protocol => protocol.dead).size() == 3,
+    hazards.size() == 20,
+    hazardFamilies.size() == 19,
+    projectedHazards.size() == 3,
+  }
+
+  run testProtocolClosureMatchesCorpus = all {
+    satisfiesClosure(Set(Pl, Ix, Ct, Ex, Li, Bs, Im, Up, Tg, Gp)),
+    satisfiesClosure(Set(Sh, Cl, Tp, Fl)),
+    satisfiesClosure(Set(Cd, Ix, Ct, Ex, Li, Ps, Sh, Up, Tg, Gp)),
+    satisfiesClosure(Set(Cd, Ct, Ex, Li, Rd, Bs)),
+    satisfiesClosure(Set(Sh, Pm, Ex, Pf, Ct, Li, Bs, Sl)),
+    not(satisfiesClosure(Set(Rb, Ex, Wq, Up, Gp))),
+    satisfiesClosure(Set(In, Ba, Ag, Rf)),
+    not(satisfiesClosure(Set(Au, Xm, Xf, Of))),
+    not(satisfiesClosure(Set(Uc, Ft, Tr, Sh, At, Aw, Wq, Xm))),
+    not(satisfiesClosure(Set(As, Rd, Ex, Pl, Ix, Em))),
+    not(satisfiesClosure(Set(Ob, Pf, Pl, Ct, Ex, Li))),
+    not(satisfiesClosure(Set(Pl, Ix, Ct, Ex, Li, Fl, Up))),
+  }
+
+  run testProtocolViolationIds = all {
+    violatedLaws(Set(Rb, Ex, Wq, Up, Gp)).map(law => law.id) == Set("L15"),
+    violatedLaws(Set(Au, Xm, Xf, Of)).map(law => law.id) == Set("L19"),
+    violatedLaws(Set(Uc, Ft, Tr, Sh, At, Aw, Wq, Xm)).map(law => law.id) == Set("L6"),
+    violatedLaws(Set(As, Rd, Ex, Pl, Ix, Em)).map(law => law.id) == Set("L1"),
+    violatedLaws(Set(Ob, Pf, Pl, Ct, Ex, Li)).map(law => law.id) == Set("L2", "L4"),
+    violatedLaws(Set(Pl, Ix, Ct, Ex, Li, Fl, Up)).map(law => law.id) == Set("L15"),
+  }
+
+  run testHazardProjectionExposesReversedPolarity = all {
+    hazardFree(Set(Uc)),
+    not(x11aCoreFree(Set(Uc))),
+    not(hazardFree(Set(Uc, Aw, At))),
+    x11aCoreFree(Set(Uc, Aw, At)),
+    not(hazardFree(Set(Xf, Aw))),
+  }
+}
+
+module rawAssemblyTest {
+  import rawFull.* from "./atlas"
+
+  run testRawAssemblyAddsOneElement =
+    init.then(addElement(Sh)).expect(chosen == Set(Sh))
+}
+
+module legalAssemblyTest {
+  import legalFull.* from "./atlas"
+
+  run testLegalAssemblyPreservesClosure =
+    init
+      .then(addLegal(Tg))
+      .then(addLegal(Up))
+      .expect(closure and hazardFree)
+
+  run testSponsoredFeeNeedsAuthorityFirst =
+    init
+      .then(addLegal(Gs).fail())
+      .then(addLegal(Au))
+      .then(addLegal(Gs))
+      .expect(chosen == Set(Au, Gs))
+}

diff --git a/formal/DESIGN.md b/formal/DESIGN.md
new file mode 100644
index 0000000000000000000000000000000000000000..cdb957cc29caca41faa010a4eeafb496b91e8b00
--- /dev/null
+++ b/formal/DESIGN.md
@@ -0,0 +1,72 @@
+# DeFi Atlas Quint Model Design
+
+## Objective
+
+Model the DeFi mechanism taxonomy as executable Quint data and state machines.
+Use the source data as the vocabulary authority.
+Keep source defects visible instead of silently repairing them.
+
+## Scope
+
+The model covers these source files:
+
+- `viz/src/data.ts` supplies elements, attributes, laws, and hazards.
+- `viz/src/protocols.ts` supplies the 12 protocol element sets.
+- `viz/src/laws.ts` supplies the current operational closure semantics.
+- `research/QUESTIONS.md` supplies questions 10 through 14.
+
+The model does not change those files.
+All generated files stay in `formal/`.
+
+## Architecture
+
+`atlas.qnt` contains several modules in one file.
+
+The vocabulary module defines element identifiers and attributes.
+It also defines law records, hazard records, and protocol sets.
+
+The raw assembly module starts with an empty element set.
+Its `addOne` action adds one nondeterministically selected element.
+Its predicates expose closure violations and hazard projections.
+
+The legal assembly module uses the same state shape.
+Its `addLegal` action permits only results that satisfy closure and `hazardFree`.
+This module exposes the legal-configuration order.
+
+The reflexive module adds economic state that element membership cannot express.
+It models peg health, endogenous backing, supply expansion, and recovery capital.
+Its target liveness property is `always(depegged implies eventually(recovered))`.
+
+`atlas_test.qnt` contains executable checks and protocol assertions.
+`analyze.mjs` independently computes protocol closure, graph ranks, and bounded configuration results.
+It does not import `viz/src/laws.ts`.
+
+## Semantic Layers
+
+The faithful layer models the current element-set semantics.
+External law clauses become recorded residue and do not fail closure.
+
+The projection layer implements the requested membership-based `hazardFree` predicate.
+This projection is not a faithful interpretation of many prose hazards.
+
+The hypothesis layer defines candidate properties from existing notes and attributes.
+Each candidate result remains separate from confirmed hazards.
+
+## Verification
+
+Run `quint typecheck` after each model increment.
+Run `quint run` after each executable state-machine increment.
+Run `quint test` for fixed protocol cases.
+Run `quint verify` only because the user explicitly requested model checking.
+
+Attempt full vocabulary checking first.
+If the full state space is intractable, use an explicit reduced universe.
+Record every universe, depth, timeout, and result in `FINDINGS.md`.
+
+## Interpretation Rules
+
+Do not call a candidate property a confirmed financial hazard.
+Do not claim that model checking can infer unspecified economic facts.
+Treat the TypeScript engine result as a comparison target, not as proof.
+Treat Quint output and the independent analyzer as separate evidence.
+
