+    { id: "L4", raw: "Pf → Ex + Ct + Li + (Ad|Sl|Bs)", subjects: Set(Pf), terms: Set(Set(Ex), Set(Ct), Set(Li), Set(Ad, Sl, Bs)), externalTerms: 0, mixedTerms: 0, asyncRepairable: false, unsupportedSubject: false },
