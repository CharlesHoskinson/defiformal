+module atlas {
+  type Element =
+    | Sh | Ix | Rb
+    | Cp | Wg | St | Cl | Pm
+    | Ob | Rf | Ba | In
+    | Ag | Fl
+    | Pl | Im | Cd | Uc | Ft
+    | Ct | Li | Ad | Sl | Bs
