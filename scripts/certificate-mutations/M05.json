{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Composition.Interfaces",
    "DefiKernel.Certificates.Audit"
  ],
  "mutations": [
    {
      "name": "m05-skip-component-id-nodup",
      "module": "DefiKernel.Composition.Interfaces",
      "needle": "decide ((catalog.map Component.id).Nodup) &&",
      "replacement": "true &&",
      "required_false": [
        "cert.catalog.nodup"
      ]
    }
  ],
  "positive_checks": [
    "cert.catalog.export-not-private"
  ]
}
