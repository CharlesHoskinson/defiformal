{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Typed.Authority",
    "DefiKernel.Certificates.Audit"
  ],
  "mutations": [
    {
      "name": "m13-issue-overwrite-head",
      "module": "DefiKernel.Typed.Authority",
      "needle": ".ok (store.nextId, ⟨store.entries ++ [⟨grant, true⟩]⟩)",
      "replacement": ".ok (⟨0⟩, ⟨store.entries.set 0 ⟨grant, true⟩⟩)",
      "required_false": [
        "cert.capability.fresh-id"
      ]
    }
  ],
  "positive_checks": [
    "cert.authority.debit"
  ]
}
