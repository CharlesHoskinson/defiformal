{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Certificates.Decode",
    "DefiKernel.Certificates.Audit"
  ],
  "mutations": [
    {
      "name": "m16-quiet-accept-nary-ctor",
      "module": "DefiKernel.Certificates.Decode",
      "needle": "| \"treeJoin\" | \"naryAdvance\" => .error (.unsupportedForm _)",
      "replacement": "| \"treeJoin\" | \"naryAdvance\" => decodeInvoke rest",
      "required_false": [
        "cert.unsupported.rejected"
      ]
    }
  ],
  "positive_checks": [
    "cert.rational.canonical"
  ]
}
