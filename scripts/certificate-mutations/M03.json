{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Typed.Transition",
    "DefiKernel.Certificates.Audit"
  ],
  "mutations": [
    {
      "name": "m03-drop-accounting-check",
      "module": "DefiKernel.Typed.Transition",
      "needle": "if !e.accountingOK then .error .accounting",
      "replacement": "if false && !e.accountingOK then .error .accounting",
      "required_false": [
        "cert.accounting.recomputed"
      ]
    }
  ],
  "positive_checks": [
    "cert.transfer.alice7"
  ]
}
