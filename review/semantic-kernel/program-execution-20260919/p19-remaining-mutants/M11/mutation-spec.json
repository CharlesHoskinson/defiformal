{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Certificates.Observation",
    "DefiKernel.Certificates.Audit"
  ],
  "mutations": [
    {
      "name": "m11-drop-constructor-identity",
      "module": "DefiKernel.Certificates.Observation",
      "needle": "failure = other.failure",
      "replacement": "(failure.isSome = other.failure.isSome)",
      "required_false": [
        "cert.refusal.constructor"
      ]
    }
  ],
  "positive_checks": [
    "cert.funds.insufficient"
  ]
}
