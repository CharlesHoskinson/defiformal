+/-- Informational outstanding families. Theorem-name tags never become executable pass. -/
+def outstandingFamilies (cert : EnvelopeEnc) : List String :=
+  (if !cert.libraries.isEmpty then ["libraryTheoremsInstantiated"] else []) ++
