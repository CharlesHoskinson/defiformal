+    (h : (overlayPolicy env base raw disc cursor miss).status = .accepted) :
+    raw.kernelFailure = none := by
+  unfold overlayPolicy at h
+  cases hkf : raw.kernelFailure with
+  | none => rfl
+  | some _ => simp [hkf] at h
