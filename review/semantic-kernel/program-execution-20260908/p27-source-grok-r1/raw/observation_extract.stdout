      "text": "590|\n591|    // @dev increment the claimable funding amount\n592|    // @param dataStore DataStore\n593|    // @param eventEmitter EventEmitter\n594|    // @param market the trading market\n595|    // @param token the claimable token\n596|    // @param account the account to increment for\n597|    // @param delta the amount to increment\n598|    function incrementClaimableFundingAmount(\n599|        DataStore dataStore,\n600|        EventEmitter eventEmitter,\n601|        address market,\n602|        address token,\n603|        address account,\n604|        uint256 delta\n605|    ) internal {\n606|        uint256 nextValue = dataStore.incrementUint(\n607|            Keys.claimableFundingAmountKey(market, token, account),\n608|            delta\n609|        );\n610|\n611|        uint256 nextPoolValue = dataStore.incrementUint(\n612|            Keys.claimableFundingAmountKey(market, token),\n613|            delta\n614|        );\n615|\n616|        MarketEventUtils.emitClaimableFundingUpdated(\n617|            eventEmitter,\n618|            market,\n619|            token,\n620|            account,\n621|            delta,\n622|            nextValue,\n623|            nextPoolValue\n624|        );\n625|    }\n626|\n627|    // @dev claim funding fees\n628|    // @param dataStore DataStore\n629|    // @param eventEmitter EventEmitter\n630|    // @param market the market to claim for\n631|    // @param token the token to claim\n632|    // @param account the account to claim for\n633|    // @param receiver the receiver to send the amount to\n634|    function claimFundingFees(\n635|        DataStore dataStore,\n636|        EventEmitter eventEmitter,\n637|        address market,\n638|        address token,\n639|        address account,\n640|        address receiver\n641|    ) internal returns (uint256) {\n642|        bytes32 key = Keys.claimableFundingAmountKey(market, token, account);\n643|\n644|        uint256 claimableAmount = dataStore.getUint(key);\n645|        dataStore.setUint(key, 0);\n646|\n647|        uint256 nextPoolValue = dataStore.decrementUint(\n648|            Keys.claimableFundingAmountKey(market, token),\n649|            claimableAmount\n650|        );\n651|\n652|        MarketToken(payable(market)).transferOut(\n653|            token,\n654|            receiver,\n655|            claimableAmount\n656|        );\n657|\n658|        validateMarketTokenBalance(dataStore, market);\n659|\n660|        MarketEventUtils.emitFundingFeesClaimed(\n661|            eventEmitter,\n662|            market,\n663|            token,\n664|            account,\n665|            receiver,\n666|            claimableAmount,\n667|            nextPoolValue\n668|        );\n669|\n670|        return claimableAmount;"
    },
    {
      "id": "liquidation-utils",
      "path": "source/contracts/liquidation/LiquidationUtils.sol",
      "sha256": "2d4ed9be73be3c6d0c6561be32f122d063b5e8de7b06efa4d3e9b264a4593ff8",
      "start": 1,
      "end": 107,
      "needles": [
        "function createLiquidationOrder"
      ],
      "missing_needles": [],
      "text": "1|// SPDX-License-Identifier: BUSL-1.1\n2|\n3|pragma solidity ^0.8.0;\n4|\n5|import \"../position/PositionStoreUtils.sol\";\n6|import \"../order/OrderStoreUtils.sol\";\n7|import \"../order/OrderEventUtils.sol\";\n8|import \"../nonce/NonceUtils.sol\";\n9|import \"../callback/CallbackUtils.sol\";\n10|\n11|// @title LiquidationUtils\n12|// @dev Library to help with liquidations\n13|library LiquidationUtils {\n14|    using Position for Position.Props;\n15|    using Order for Order.Props;\n16|\n17|    struct CreateLiquidationOrderCache {\n18|        bytes32 positionKey;\n19|        uint256 lastSrcChainId;\n20|    }\n21|\n22|    // @dev creates a liquidation order for a position\n23|    // @param dataStore DataStore\n24|    // @param account the position's account\n25|    // @param market the position's market\n26|    // @param collateralToken the position's collateralToken\n27|    // @param isLong whether the position is long or short\n28|    function createLiquidationOrder(\n29|        DataStore dataStore,\n30|        EventEmitter eventEmitter,\n31|        address account,\n32|        address market,\n33|        address collateralToken,\n34|        bool isLong\n35|    ) external returns (bytes32) {\n36|        CreateLiquidationOrderCache memory cache;\n37|\n38|        cache.positionKey = Position.getPositionKey(account, market, collateralToken, isLong);\n39|        Position.Props memory position = PositionStoreUtils.get(dataStore, cache.positionKey);\n40|\n41|        Order.Addresses memory addresses = Order.Addresses(\n42|            account, // account\n43|            account, // receiver\n44|            account, // cancellationReceiver\n45|            CallbackUtils.getSavedCallbackContract(dataStore, account, market), // callbackContract\n46|            address(0), // uiFeeReceiver\n47|            market, // market\n48|            position.collateralToken(), // initialCollateralToken\n49|            new address[](0) // swapPath\n50|        );\n51|\n52|        cache.lastSrcChainId = dataStore.getUint(Keys.positionLastSrcChainId(cache.positionKey));\n53|\n54|        // no slippage is set for this order, in case of a liquidation the amount\n55|        // of collateral being swapped should not be too large\n56|        // in case of large price impact, the user could be refunded\n57|        // through a protocol fund if required, this amount could later be claimed\n58|        // from the price impact pool, this claiming process should be added if\n59|        // required\n60|        //\n61|        // setting a maximum price impact that will work for majority of cases\n62|        // may also be challenging since the price impact would vary based on the\n63|        // amount of collateral being swapped\n64|        //\n65|        // note that the decreasePositionSwapType should be SwapPnlTokenToCollateralToken\n66|        // because fees are calculated with reference to the collateral token\n67|        // fees are deducted from the output amount if the output token is the same as the\n68|        // collateral token\n69|        // swapping the pnl token to the collateral token helps to ensure fees can be paid\n70|        // using the realized profit\n71|        Order.Numbers memory numbers = Order.Numbers(\n72|            Order.OrderType.Liquidation, // orderType\n73|            Order.DecreasePositionSwapType.SwapPnlTokenToCollateralToken, // decreasePositionSwapType\n74|            position.sizeInUsd(), // sizeDeltaUsd\n75|            0, // initialCollateralDeltaAmount\n76|            0, // triggerPrice\n77|            position.isLong() ? 0 : type(uint256).max, // acceptablePrice\n78|            0, // executionFee\n79|            dataStore.getUint(Keys.MAX_CALLBACK_GAS_LIMIT), // callbackGasLimit\n80|            0, // minOutputAmount\n81|            Chain.currentTimestamp(), // updatedAtTime\n82|            0, // validFromTime\n83|            cache.lastSrcChainId // srcChainId\n84|        );\n85|\n86|        Order.Flags memory flags = Order.Flags(\n87|            position.isLong(), // isLong\n88|            cache.lastSrcChainId == 0, // shouldUnwrapNativeToken\n89|            false, // isFrozen\n90|            false // autoCancel\n91|        );\n92|\n93|        Order.Props memory order = Order.Props(\n94|            addresses,\n95|            numbers,\n96|            flags,\n97|            new bytes32[](0)\n98|        );\n99|\n100|        bytes32 key = NonceUtils.getNextKey(dataStore);\n101|        OrderStoreUtils.set(dataStore, key, order);\n102|\n103|        OrderEventUtils.emitOrderCreated(eventEmitter, key, order);\n104|\n105|        return key;\n106|    }\n107|}"
    },
