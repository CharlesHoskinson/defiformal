      "missing_needles": [],
      "text": "1970|\n1971|        return (impactAmount, cappedDiffUsd);\n1972|    }\n1973|\n1974|    // @dev get the funding amount to be deducted or distributed\n1975|    //\n1976|    // @param latestFundingAmountPerSize the latest funding amount per size\n1977|    // @param positionFundingAmountPerSize the funding amount per size for the position\n1978|    // @param positionSizeInUsd the position size in USD\n1979|    // @param roundUpMagnitude whether the round up the result\n1980|    //\n1981|    // @return fundingAmount\n1982|    function getFundingAmount(\n1983|        uint256 latestFundingAmountPerSize,\n1984|        uint256 positionFundingAmountPerSize,\n1985|        uint256 positionSizeInUsd,\n1986|        bool roundUpMagnitude\n1987|    ) internal pure returns (uint256) {\n1988|        uint256 fundingDiffFactor = (latestFundingAmountPerSize - positionFundingAmountPerSize);\n1989|\n1990|        // a user could avoid paying funding fees by continually updating the position\n1991|        // before the funding fee becomes large enough to be chargeable\n1992|        // to avoid this, funding fee amounts should be rounded up\n1993|        //\n1994|        // this could lead to large additional charges if the token has a low number of decimals\n1995|        // or if the token's value is very high, so care should be taken to inform users of this\n1996|        //\n1997|        // if the calculation is for the claimable amount, the amount should be rounded down instead\n1998|\n1999|        // divide the result by Precision.FLOAT_PRECISION * Precision.FLOAT_PRECISION_SQRT as the fundingAmountPerSize values\n2000|        // are stored based on FLOAT_PRECISION_SQRT values\n2001|        return Precision.mulDiv(\n2002|            positionSizeInUsd,\n2003|            fundingDiffFactor,\n2004|            Precision.FLOAT_PRECISION * Precision.FLOAT_PRECISION_SQRT,\n2005|            roundUpMagnitude\n2006|        );\n2007|    }\n2008|\n2009|    // @dev get the borrowing fees for a position, assumes that cumulativeBorrowingFactor\n2010|    // has already been updated to the latest value\n2011|    // @param dataStore DataStore\n2012|    // @param position Position.Props\n2013|    // @return the borrowing fees for a position\n2014|    function getBorrowingFees(DataStore dataStore, Position.Props memory position) internal view returns (uint256) {\n2015|        uint256 cumulativeBorrowingFactor = getCumulativeBorrowingFactor(dataStore, position.market(), position.isLong());\n2016|        if (position.borrowingFactor() > cumulativeBorrowingFactor) {\n2017|            revert Errors.UnexpectedBorrowingFactor(position.borrowingFactor(), cumulativeBorrowingFactor);\n2018|        }\n2019|        uint256 diffFactor = cumulativeBorrowingFactor - position.borrowingFactor();\n2020|        return Precision.applyFactor(position.sizeInUsd(), diffFactor);"
    },
