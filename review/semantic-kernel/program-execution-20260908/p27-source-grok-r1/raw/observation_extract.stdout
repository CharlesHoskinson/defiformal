    {
      "id": "collateral-no-positive-pnl",
      "path": "source/contracts/position/PositionUtils.sol",
      "sha256": "38d1f1e4900b5c4fdb01476ab592adda8d58fa6188865b78423eb0a311d3cd06",
      "start": 470,
      "end": 520,
      "needles": [
        "if (values.realizedPnlUsd < 0)"
      ],
      "missing_needles": [],
      "text": "470|    //\n471|    // fees and price impact are validated in the validatePosition check\n472|    function willPositionCollateralBeSufficient(\n473|        DataStore dataStore,\n474|        Market.Props memory market,\n475|        MarketUtils.MarketPrices memory prices,\n476|        address collateralToken,\n477|        bool isLong,\n478|        WillPositionCollateralBeSufficientValues memory values\n479|    ) public view returns (bool, int256) {\n480|        Price.Props memory collateralTokenPrice = MarketUtils.getCachedTokenPrice(\n481|            collateralToken,\n482|            market,\n483|            prices\n484|        );\n485|\n486|        int256 remainingCollateralUsd = values.positionCollateralAmount.toInt256() * collateralTokenPrice.min.toInt256();\n487|\n488|        // deduct realized pnl if it is negative since this would be paid from\n489|        // the position's collateral\n490|        if (values.realizedPnlUsd < 0) {\n491|            remainingCollateralUsd = remainingCollateralUsd + values.realizedPnlUsd;\n492|        }\n493|\n494|        if (remainingCollateralUsd < 0) {\n495|            return (false, remainingCollateralUsd);\n496|        }\n497|\n498|        // the min collateral factor will increase as the open interest for a market increases\n499|        // this may lead to previously created limit increase orders not being executable\n500|        //\n501|        // the position's pnl is not factored into the remainingCollateralUsd value, since\n502|        // factoring in a positive pnl may allow the user to manipulate price and bypass this check\n503|        // it may be useful to factor in a negative pnl for this check, this can be added if required\n504|        uint256 minCollateralFactor = MarketUtils.getMinCollateralFactorForOpenInterest(\n505|            dataStore,\n506|            market,\n507|            values.openInterestDelta,\n508|            isLong\n509|        );\n510|\n511|        uint256 minCollateralFactorForMarket = MarketUtils.getMinCollateralFactor(dataStore, market.marketToken);\n512|        // use the minCollateralFactor for the market if it is larger\n513|        if (minCollateralFactorForMarket > minCollateralFactor) {\n514|            minCollateralFactor = minCollateralFactorForMarket;\n515|        }\n516|\n517|        int256 minCollateralUsdForLeverage = Precision.applyFactor(values.positionSizeInUsd, minCollateralFactor).toInt256();\n518|        bool willBeSufficient = remainingCollateralUsd >= minCollateralUsdForLeverage;\n519|\n520|        return (willBeSufficient, remainingCollateralUsd);"
    },
