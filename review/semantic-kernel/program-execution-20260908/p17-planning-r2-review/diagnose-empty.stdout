      "name": "neg_same_premises",
      "ok": true,
      "detail": {
        "id": "P17-TH-NEGATIVE",
        "statement": "For the honest deposit template with assets > 0, execute_ok_iff derives post.USDS.vault = pre.USDS.vault + assets. The candidate observation candidate.USDS.vault = pre.USDS.vault cannot equal that result. Evaluated.Valid has no post-state argument and remains a precondition on store, context, request, pre-state and effects. This is rejection of an incorrect proposed observation, not an executor refusal, and not a generic cross-asset-backing claim. The matching positive is P17-POS-DEPOSIT-CREDIT under the same premises.",
        "predicate": "observation_correspondence",
        "not_predicate": "Evaluated.Valid",
        "shared_theorem": "DefiKernel.Typed.execute_ok_iff",
        "assets_positive": true,
