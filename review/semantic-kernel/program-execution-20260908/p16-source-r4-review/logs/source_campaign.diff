+            m = BINDING_RE.fullmatch(stripped)
+            if not m:
+                unparseable.append(stripped)
+                continue
+            model = m.group(6)
+            rows.append({
+                "id": m.group(1),
+                "sqrtP": m.group(2),
+                "L": m.group(3),
+                "amount": m.group(4),
+                "add": m.group(5) == "true",
+                "model": model,
+                "ok_value": m.group(7),
+                "error_name": m.group(8),
+                "match": m.group(9) == "true",
+                "line": stripped,
+            })
+    printed = None
+    for ln in reversed(text.splitlines()):
+        if ln.strip() in {"0", "1", "3"}:
+            printed = int(ln.strip())
+            break
+    summary = None
+    for ln in text.splitlines():
+        if ln.startswith("P16 source-binding comparisons:"):
+            summary = ln.strip()
+    if unparseable:
+        return {
+            "status": "blocked",
+            "exit": 3,
+            "reason": "Lean binding row is unparseable",
+            "unparseable": unparseable,
+            "printed_uint32": printed,
+        }
+    ids = [r["id"] for r in rows]
+    if not rows:
+        return {
+            "status": "blocked",
+            "exit": 3,
+            "reason": "Lean bindings produced no parseable rows",
+            "printed_uint32": printed,
+            "denominator": 0,
+        }
+    if len(ids) != len(set(ids)):
+        return {
+            "status": "blocked",
+            "exit": 3,
+            "reason": "Lean binding duplicate ids",
+            "ids": ids,
+            "printed_uint32": printed,
+            "denominator": len(ids),
+        }
+    if ids != EXPECTED_FIXTURE_IDS:
+        return {
+            "status": "blocked",
+            "exit": 3,
+            "reason": "Lean binding ids are not the exact required twelve",
+            "got": ids,
+            "expected": EXPECTED_FIXTURE_IDS,
+            "missing": [i for i in EXPECTED_FIXTURE_IDS if i not in ids],
+            "extra": [i for i in ids if i not in EXPECTED_FIXTURE_IDS],
+            "printed_uint32": printed,
+            "denominator": len(ids),
