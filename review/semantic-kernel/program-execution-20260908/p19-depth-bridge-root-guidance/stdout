Std.TreeMap.Raw.foldl_eq_foldl_toList.{u, v, w} {α : Type u} {β : Type v} {cmp : α → α → Ordering}
  {t : Std.TreeMap.Raw α β cmp} {δ : Type w} {f : δ → α → β → δ} {init : δ} :
  Std.TreeMap.Raw.foldl f init t = List.foldl (fun a b => f a b.1 b.2) init t.toList
Std.TreeMap.Raw.toList_insert_perm.{u, v} {α : Type u} {β : Type v} {cmp : α → α → Ordering}
  {t : Std.TreeMap.Raw α β cmp} [BEq α] [Std.TransCmp cmp] [Std.LawfulBEqCmp cmp] (h : t.WF) {k : α} {v : β} :
  (t.insert k v).toList.Perm ((k, v) :: List.filter (fun x => decide ¬(k == x.1) = true) t.toList)
Std.TreeMap.Raw.ofList_equiv_foldl.{u, v} {α : Type u} {β : Type v} {cmp : α → α → Ordering} {l : List (α × β)} :
  (Std.TreeMap.Raw.ofList l cmp).Equiv (List.foldl (fun acc p => acc.insert p.1 p.2) ∅ l)
Std.TreeMap.Raw.Equiv.foldl_eq.{u, v, w} {α : Type u} {β : Type v} {cmp : α → α → Ordering}
  {t₁ t₂ : Std.TreeMap.Raw α β cmp} {δ : Type w} [Std.TransCmp cmp] {f : δ → α → β → δ} {init : δ} (h₁ : t₁.WF)
  (h₂ : t₂.WF) (h : t₁.Equiv t₂) : Std.TreeMap.Raw.foldl f init t₁ = Std.TreeMap.Raw.foldl f init t₂
Std.TreeMap.Raw.getElem?_ofList_of_mem.{u, v} {α : Type u} {β : Type v} {cmp : α → α → Ordering} [Std.TransCmp cmp]
  {l : List (α × β)} {k k' : α} (k_eq : cmp k k' = Ordering.eq) {v : β}
  (distinct : List.Pairwise (fun a b => ¬cmp a.1 b.1 = Ordering.eq) l) (mem : (k, v) ∈ l) :
  (Std.TreeMap.Raw.ofList l cmp)[k']? = some v
