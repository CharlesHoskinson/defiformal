P05_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.CapabilityProvenance.Observation","name":"DefiKernel.CapabilityProvenance.map_selected_balances","statement":"∀ {P A D : Type} {cells : List.{0} (DefiKernel.Typed.Cell P A D)} {pre post : DefiKernel.Composition.World P A D},\n  (∀ (c : DefiKernel.Typed.Cell P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n          (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D)) cells c →\n        @Eq.{1} Rat (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D pre) c)\n          (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D post) c)) →\n    @Eq.{1} (List.{0} (Prod.{0, 0} (DefiKernel.Typed.Cell P A D) Rat))\n      (@List.map.{0, 0} (DefiKernel.Typed.Cell P A D) (Prod.{0, 0} (DefiKernel.Typed.Cell P A D) Rat)\n        (fun c =>\n          @Prod.mk.{0, 0} (DefiKernel.Typed.Cell P A D) Rat c\n            (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D pre) c))\n        cells)\n      (@List.map.{0, 0} (DefiKernel.Typed.Cell P A D) (Prod.{0, 0} (DefiKernel.Typed.Cell P A D) Rat)\n        (fun c =>\n          @Prod.mk.{0, 0} (DefiKernel.Typed.Cell P A D) Rat c\n            (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D post) c))\n        cells)"}
