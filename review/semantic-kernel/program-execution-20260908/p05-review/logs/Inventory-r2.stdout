P05_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.CapabilityProvenance.Trace","name":"DefiKernel.CapabilityProvenance.issued_after_revoke_fresh","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : Nat → DefiKernel.Composition.Boundary P A D} {initial final : DefiKernel.Composition.World P A D}\n  {events : List.{0} (DefiKernel.Composition.Event P A D)}\n  {history : List.{0} (DefiKernel.Composition.OutputObservation A)} {index : Nat},\n  @DefiKernel.Composition.TraceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial events final\n      history index →\n    ∀ (rev iss : DefiKernel.Composition.Event P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Composition.Event P A D) (List.{0} (DefiKernel.Composition.Event P A D))\n          (@List.instMembership.{0} (DefiKernel.Composition.Event P A D)) events rev →\n        @Membership.mem.{0, 0} (DefiKernel.Composition.Event P A D) (List.{0} (DefiKernel.Composition.Event P A D))\n            (@List.instMembership.{0} (DefiKernel.Composition.Event P A D)) events iss →\n          ∀ (rid nid : DefiKernel.Typed.CapabilityId) (grant : DefiKernel.Typed.Grant P A D),\n            @Eq.{1} (DefiKernel.Composition.Step P A D) (@DefiKernel.Composition.Event.step P A D rev)\n                (@DefiKernel.Composition.Step.revoke P A D rid) →\n              @Eq.{1} (DefiKernel.Composition.Receipt P A D)\n                  (@DefiKernel.Composition.StepResult.receipt P A D (@DefiKernel.Composition.Event.result P A D rev))\n                  (@DefiKernel.Composition.Receipt.revoked P A D rid) →\n                @Eq.{1} (DefiKernel.Composition.Step P A D) (@DefiKernel.Composition.Event.step P A D iss)\n                    (@DefiKernel.Composition.Step.issue P A D grant) →\n                  @Eq.{1} (DefiKernel.Composition.Receipt P A D)\n                      (@DefiKernel.Composition.StepResult.receipt P A D\n                        (@DefiKernel.Composition.Event.result P A D iss))\n                      (@DefiKernel.Composition.Receipt.issued P A D nid) →\n                    @LT.lt.{0} Nat instLTNat (@DefiKernel.Composition.Event.index P A D rev)\n                        (@DefiKernel.Composition.Event.index P A D iss) →\n                      And (@Ne.{1} DefiKernel.Typed.CapabilityId nid rid)\n                        (∃ cap cap',\n                          And\n                            (@Eq.{1} (Option.{0} (DefiKernel.Typed.Capability P A D))\n                              (@DefiKernel.Typed.CapabilityStore.lookup P A D\n                                (@DefiKernel.Typed.ExecutionResult.capabilities P A D\n                                  (@DefiKernel.Composition.StepResult.world P A D\n                                    (@DefiKernel.Composition.Event.result P A D rev)))\n                                rid)\n                              (@Option.some.{0} (DefiKernel.Typed.Capability P A D) cap))\n                            (And (@Eq.{1} Bool (@DefiKernel.Typed.Capability.live P A D cap) Bool.false)\n                              (And\n                                (@Eq.{1} (Option.{0} (DefiKernel.Typed.Capability P A D))\n                                  (@DefiKernel.Typed.CapabilityStore.lookup P A D\n                                    (@DefiKernel.Typed.ExecutionResult.capabilities P A D final) rid)\n                                  (@Option.some.{0} (DefiKernel.Typed.Capability P A D) cap'))\n                                (And (@Eq.{1} Bool (@DefiKernel.Typed.Capability.live P A D cap') Bool.false)\n                                  (@Eq.{1} (DefiKernel.Typed.Grant P A D)\n                                    (@DefiKernel.Typed.Capability.toGrant P A D cap')\n                                    (@DefiKernel.Typed.Capability.toGrant P A D cap))))))"}
P05_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.CapabilityProvenance.Trace","name":"DefiKernel.CapabilityProvenance.issued_event_equation","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : Nat → DefiKernel.Composition.Boundary P A D} {initial final : DefiKernel.Composition.World P A D}\n  {events : List.{0} (DefiKernel.Composition.Event P A D)}\n  {history : List.{0} (DefiKernel.Composition.OutputObservation A)} {index : Nat},\n  @DefiKernel.Composition.TraceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial events final\n      history index →\n    ∀ (event : DefiKernel.Composition.Event P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Composition.Event P A D) (List.{0} (DefiKernel.Composition.Event P A D))\n          (@List.instMembership.{0} (DefiKernel.Composition.Event P A D)) events event →\n        ∀ (grant : DefiKernel.Typed.Grant P A D) (id : DefiKernel.Typed.CapabilityId),\n          @Eq.{1} (DefiKernel.Composition.Step P A D) (@DefiKernel.Composition.Event.step P A D event)\n              (@DefiKernel.Composition.Step.issue P A D grant) →\n            @Eq.{1} (DefiKernel.Composition.Receipt P A D)\n                (@DefiKernel.Composition.StepResult.receipt P A D (@DefiKernel.Composition.Event.result P A D event))\n                (@DefiKernel.Composition.Receipt.issued P A D id) →\n              @Eq.{1}\n                (Except.{0, 0} DefiKernel.Typed.AuthorityFailure\n                  (Prod.{0, 0} DefiKernel.Typed.CapabilityId (DefiKernel.Typed.CapabilityStore P A D)))\n                (@DefiKernel.Typed.issueCapability P A D inst inst_2\n                  (@DefiKernel.Composition.Config.authority P A D cfg)\n                  (@DefiKernel.Composition.Boundary.ctx P A D\n                    (boundaries (@DefiKernel.Composition.Event.index P A D event)))\n                  (@DefiKernel.Typed.ExecutionResult.capabilities P A D\n                    (@DefiKernel.Composition.Event.before P A D event))\n                  grant)\n                (@Except.ok.{0, 0} DefiKernel.Typed.AuthorityFailure\n                  (Prod.{0, 0} DefiKernel.Typed.CapabilityId (DefiKernel.Typed.CapabilityStore P A D))\n                  (@Prod.mk.{0, 0} DefiKernel.Typed.CapabilityId (DefiKernel.Typed.CapabilityStore P A D) id\n                    (@DefiKernel.Typed.ExecutionResult.capabilities P A D\n                      (@DefiKernel.Composition.StepResult.world P A D\n                        (@DefiKernel.Composition.Event.result P A D event)))))"}
