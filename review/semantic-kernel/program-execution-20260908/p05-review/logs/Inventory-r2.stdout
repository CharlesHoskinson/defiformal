.Typed.CapabilityId id\n              (@DefiKernel.Typed.CapabilityStore.nextId Party Asset Domain store))\n            (@Eq.{1} (DefiKernel.Typed.CapabilityStore Party Asset Domain) post\n              (@DefiKernel.Typed.CapabilityStore.mk Party Asset Domain\n                (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Typed.Capability Party Asset Domain))\n                  (List.{0} (DefiKernel.Typed.Capability Party Asset Domain))\n                  (List.{0} (DefiKernel.Typed.Capability Party Asset Domain))\n                  (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Typed.Capability Party Asset Domain))\n                    (@List.instAppend.{0} (DefiKernel.Typed.Capability Party Asset Domain)))\n                  (@DefiKernel.Typed.CapabilityStore.entries Party Asset Domain store)\n                  (@List.cons.{0} (DefiKernel.Typed.Capability Party Asset Domain)\n                    (@DefiKernel.Typed.Capability.mk Party Asset Domain grant Bool.true)\n                    (@List.nil.{0} (DefiKernel.Typed.Capability Party Asset Domain))))))))))"}
