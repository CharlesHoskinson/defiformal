    {
      "id": "unordered_duplicate_noop",
      "path": "source/modules/core/04-channel/keeper/packet.go",
      "start_line": 199,
      "end_line": 206,
      "lines": [
        {
          "n": 199,
          "text": "\t\t_, found := k.GetPacketReceipt(ctx, packet.GetDestPort(), packet.GetDestChannel(), packet.GetSequence())"
        },
        {
          "n": 200,
          "text": "\t\tif found {"
        },
        {
          "n": 201,
          "text": "\t\t\temitRecvPacketEvent(ctx, packet, channel)"
        },
        {
          "n": 202,
          "text": "\t\t\t// This error indicates that the packet has already been relayed. Core IBC will"
        },
        {
          "n": 203,
          "text": "\t\t\t// treat this error as a no-op in order to prevent an entire relay transaction"
        },
        {
          "n": 204,
          "text": "\t\t\t// from failing and consuming unnecessary fees."
        },
        {
          "n": 205,
          "text": "\t\t\treturn types.ErrNoOpMsg"
        },
        {
          "n": 206,
          "text": "\t\t}"
        }
