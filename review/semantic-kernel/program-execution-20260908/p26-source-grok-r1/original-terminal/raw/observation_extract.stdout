        },
        {
          "n": 337,
          "text": "func (k *Keeper) VerifyMembership(ctx sdk.Context, clientID string, height exported.Height, delayTimePeriod uint64, delayBlockPeriod uint64, proof []byte, path exported.Path, value []byte) error {"
        },
        {
          "n": 338,
          "text": "\tclientModule, err := k.Route(ctx, clientID)"
        },
        {
          "n": 339,
          "text": "\tif err != nil {"
        },
        {
          "n": 340,
          "text": "\t\treturn err"
        },
        {
          "n": 341,
          "text": "\t}"
        },
        {
          "n": 342,
          "text": ""
        },
        {
          "n": 343,
          "text": "\tif status := clientModule.Status(ctx, clientID); status != exported.Active {"
        },
        {
          "n": 344,
          "text": "\t\treturn errorsmod.Wrapf(types.ErrClientNotActive, \"cannot call verify membership on client (%s) with status %s\", clientID, status)"
        },
        {
          "n": 345,
          "text": "\t}"
        },
        {
          "n": 346,
          "text": ""
        },
        {
          "n": 347,
          "text": "\treturn clientModule.VerifyMembership(ctx, clientID, height, delayTimePeriod, delayBlockPeriod, proof, path, value)"
        }
      ]
    },
