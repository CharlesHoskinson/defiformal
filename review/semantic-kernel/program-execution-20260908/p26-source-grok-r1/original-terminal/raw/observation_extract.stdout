    {
      "id": "recover_client",
      "path": "source/modules/core/02-client/keeper/client.go",
      "start_line": 118,
      "end_line": 145,
      "lines": [
        {
          "n": 118,
          "text": "// RecoverClient will invoke the light client module associated with the subject clientID requesting it to"
        },
        {
          "n": 119,
          "text": "// recover the subject client given a substitute client identifier. The light client implementation"
        },
        {
          "n": 120,
          "text": "// is responsible for validating the parameters of the substitute (ensuring they match the subject's parameters)"
        },
        {
          "n": 121,
          "text": "// as well as copying the necessary consensus states from the substitute to the subject client store."
        },
        {
          "n": 122,
          "text": "// The substitute must be Active and the subject must not be Active."
        },
        {
          "n": 123,
          "text": "func (k *Keeper) RecoverClient(ctx sdk.Context, subjectClientID, substituteClientID string) error {"
        },
        {
          "n": 124,
          "text": "\tclientModule, err := k.Route(ctx, subjectClientID)"
        },
        {
          "n": 125,
          "text": "\tif err != nil {"
        },
        {
          "n": 126,
          "text": "\t\treturn errorsmod.Wrap(types.ErrRouteNotFound, subjectClientID)"
        },
        {
          "n": 127,
          "text": "\t}"
        },
        {
          "n": 128,
          "text": ""
        },
        {
          "n": 129,
          "text": "\tif status := clientModule.Status(ctx, subjectClientID); status == exported.Active {"
        },
        {
          "n": 130,
          "text": "\t\treturn errorsmod.Wrapf(types.ErrInvalidRecoveryClient, \"cannot recover subject client (%s) with status %s\", subjectClientID, status)"
        },
        {
          "n": 131,
          "text": "\t}"
        },
        {
          "n": 132,
          "text": ""
        },
        {
          "n": 133,
          "text": "\tif status := clientModule.Status(ctx, substituteClientID); status != exported.Active {"
        },
        {
          "n": 134,
          "text": "\t\treturn errorsmod.Wrapf(types.ErrClientNotActive, \"cannot recover client using substitute client (%s) with status %s\", substituteClientID, status)"
        },
        {
          "n": 135,
          "text": "\t}"
        },
        {
          "n": 136,
          "text": ""
        },
        {
          "n": 137,
          "text": "\tsubjectLatestHeight := clientModule.LatestHeight(ctx, subjectClientID)"
        },
        {
          "n": 138,
          "text": "\tsubstituteLatestHeight := clientModule.LatestHeight(ctx, substituteClientID)"
        },
        {
          "n": 139,
          "text": "\tif subjectLatestHeight.GTE(substituteLatestHeight) {"
        },
        {
          "n": 140,
          "text": "\t\treturn errorsmod.Wrapf(types.ErrInvalidHeight, \"subject client state latest height is greater or equal to substitute client state latest height (%s >= %s)\", subjectLatestHeight, substituteLatestHeight)"
        },
        {
          "n": 141,
          "text": "\t}"
        },
        {
          "n": 142,
          "text": ""
        },
        {
          "n": 143,
          "text": "\tif err := clientModule.RecoverClient(ctx, subjectClientID, substituteClientID); err != nil {"
        },
        {
          "n": 144,
          "text": "\t\treturn err"
        },
        {
          "n": 145,
          "text": "\t}"
        }
      ]
    },
    {
      "id": "verify_membership_requires_active",
      "path": "source/modules/core/02-client/keeper/keeper.go",
      "start_line": 336,
