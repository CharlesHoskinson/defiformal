    {
      "id": "ics20_unescrow_can_fail",
      "path": "source/modules/apps/transfer/keeper/relay.go",
      "start_line": 315,
      "end_line": 322,
      "lines": [
        {
          "n": 315,
          "text": "func (k *Keeper) UnescrowCoin(ctx sdk.Context, escrowAddress, receiver sdk.AccAddress, coin sdk.Coin) error {"
        },
        {
          "n": 316,
          "text": "\tif err := k.BankKeeper.SendCoins(ctx, escrowAddress, receiver, sdk.NewCoins(coin)); err != nil {"
        },
        {
          "n": 317,
          "text": "\t\t// NOTE: this error is only expected to occur given an unexpected bug or a malicious"
        },
        {
          "n": 318,
          "text": "\t\t// counterparty module. The bug may occur in bank or any part of the code that allows"
        },
        {
          "n": 319,
          "text": "\t\t// the escrow address to be drained. A malicious counterparty module could drain the"
        },
        {
          "n": 320,
          "text": "\t\t// escrow address by allowing more tokens to be sent back then were escrowed."
        },
        {
          "n": 321,
          "text": "\t\treturn errorsmod.Wrap(err, \"unable to unescrow tokens, this may be caused by a malicious counterparty module or a bug: please open an issue on counterparty module\")"
        },
        {
          "n": 322,
          "text": "\t}"
        }
      ]
    },
