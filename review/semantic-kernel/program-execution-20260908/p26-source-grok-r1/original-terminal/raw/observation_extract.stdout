    {
      "id": "ics20_refund_origin_branches",
      "path": "source/modules/apps/transfer/keeper/relay.go",
      "start_line": 275,
      "end_line": 292,
      "lines": [
        {
          "n": 275,
          "text": "\t// if the token we must refund is prefixed by the source port and channel"
        },
        {
          "n": 276,
          "text": "\t// then the tokens were burnt when the packet was sent and we must mint new tokens"
        },
        {
          "n": 277,
          "text": "\tif token.Denom.HasPrefix(sourcePort, sourceChannel) {"
        },
        {
          "n": 278,
          "text": "\t\t// mint vouchers back to sender"
        },
        {
          "n": 279,
          "text": "\t\tif err := k.BankKeeper.MintCoins("
        },
        {
          "n": 280,
          "text": "\t\t\tctx, types.ModuleName, sdk.NewCoins(coin),"
        },
        {
          "n": 281,
          "text": "\t\t); err != nil {"
        },
        {
          "n": 282,
          "text": "\t\t\treturn err"
        },
        {
          "n": 283,
          "text": "\t\t}"
        },
        {
          "n": 284,
          "text": ""
        },
        {
          "n": 285,
          "text": "\t\tif err := k.BankKeeper.SendCoins(ctx, moduleAccountAddr, sender, sdk.NewCoins(coin)); err != nil {"
        },
        {
          "n": 286,
          "text": "\t\t\tpanic(fmt.Errorf(\"unable to send coins from module to account despite previously minting coins to module account: %w\", err))"
        },
        {
          "n": 287,
          "text": "\t\t}"
        },
        {
          "n": 288,
          "text": "\t} else {"
        },
        {
          "n": 289,
          "text": "\t\tif err := k.UnescrowCoin(ctx, escrowAddress, sender, coin); err != nil {"
        },
        {
          "n": 290,
          "text": "\t\t\treturn err"
        },
        {
          "n": 291,
          "text": "\t\t}"
        },
