DefiKernel.Certificates.string_roundtrip (s : String) (rest : List Char) :
  String.fromUTF8? s.toUTF8 = some s ∧ lexString [] (escapeChars s.toList ++ '\"' :: rest) = Except.ok (s, rest)
DefiKernel.Certificates.decode_encode_roundtrip_of_decode (raw : ByteArray) (ir : DecodedIR)
  (h : decodeBytes raw = Except.ok ir) : decodeBytes (encodeModule ir) = Except.ok ir
