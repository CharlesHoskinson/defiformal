            have hle : W ≤ n1 + prod := Nat.le_of_not_gt hnot
            have hlt : n1 + prod < W + W := Nat.add_lt_add hn1 hprod
            have hmod : (n1 + prod) % W = n1 + prod - W := add_mod_eq_sub hle hlt
