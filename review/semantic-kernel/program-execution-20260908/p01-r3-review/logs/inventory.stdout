okupCollected B P A D inst (@DefiKernel.Nary.Tree.collectLocals B P A D locals')\n                  x)\n              (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Nary.Attempt B P A D))\n                (List.{0} (DefiKernel.Nary.Attempt B P A D)) (List.{0} (DefiKernel.Nary.Attempt B P A D))\n                (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Nary.Attempt B P A D))\n                  (@List.instAppend.{0} (DefiKernel.Nary.Attempt B P A D)))\n                (@DefiKernel.Nary.Tree.TreeMachine.attempts B P A D tm)\n                (@List.cons.{0} (DefiKernel.Nary.Attempt B P A D)\n                  (@DefiKernel.Nary.Attempt.mk B P A D b (@DefiKernel.Interleaving.LocalState.nextIndex P A D own) inv\n                    (@DefiKernel.Nary.Tree.TreeMachine.world B P A D tm)\n                    (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) result))\n                  (@List.nil.{0} (DefiKernel.Nary.Attempt B P A D)))))\n            (@DefiKernel.Nary.Machine.accept B P A D inst (@DefiKernel.Nary.Tree.flattenMachine B P A D inst roster tm)\n              b inv result)"}
