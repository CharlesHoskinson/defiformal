xcept.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n              (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n          (@DefiKernel.Nary.analyzeAll B P A D inst inst_1 inst_2 cfg boundaries branches rest)\n          (fun reason =>\n            @Except.error.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n              (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) reason)\n          fun footprints =>\n          @Except.ok.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n            (@List.cons.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))\n              (@Prod.mk.{0, 0} B (DefiKernel.Parallel.Footprint P A D) b footprint) footprints))"}
