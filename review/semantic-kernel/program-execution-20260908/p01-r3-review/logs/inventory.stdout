P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Parallel.Dependency.Adapter","name":"DefiKernel.Parallel.StepAgrees.eq_2","statement":"∀ {P A D : Type} (region : Set.{0} (DefiKernel.Typed.Cell P A D)) (a b : DefiKernel.Composition.StepResult P A D),\n  @Eq.{1} Prop\n    (@DefiKernel.Parallel.StepAgrees P A D region\n      (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) a)\n      (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) b))\n    (And\n      (@DefiKernel.Composition.AgreeOn P A D region\n        (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.StepResult.world P A D a))\n        (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.StepResult.world P A D b)))\n      (And\n        (@Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Composition.StepResult.world P A D a))\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Composition.StepResult.world P A D b)))\n        (And\n          (@Eq.{1} (DefiKernel.Composition.Receipt P A D) (@DefiKernel.Composition.StepResult.receipt P A D a)\n            (@DefiKernel.Composition.StepResult.receipt P A D b))\n          (@Eq.{1} (List.{0} (DefiKernel.Composition.OutputObservation A))\n            (@DefiKernel.Composition.StepResult.outputs P A D a)\n            (@DefiKernel.Composition.StepResult.outputs P A D b)))))"}
