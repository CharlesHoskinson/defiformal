tprint P A D) part))\n            (And\n              (∀ (c : DefiKernel.Typed.Cell P A D),\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.reads P A D part) c →\n                  @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.reads P A D\n                      (@DefiKernel.Nary.Tree.footprintOf B P A D inst assoc b))\n                    c)\n              (∀ (c : DefiKernel.Typed.Cell P A D),\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.writes P A D part) c →\n                  @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.writes P A D\n                      (@DefiKernel.Nary.Tree.footprintOf B P A D inst assoc b))\n                    c))"}
