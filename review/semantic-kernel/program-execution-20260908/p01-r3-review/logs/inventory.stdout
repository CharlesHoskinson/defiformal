P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"definition","module":"DefiKernel.Parallel.Execution","name":"DefiKernel.Parallel.ObservationallyEquivalent._sparseCasesOn_1","statement":"{P A D : Type} →\n  {motive : DefiKernel.Parallel.Result P A D → Sort u} →\n    (t : DefiKernel.Parallel.Result P A D) →\n      ((reason : DefiKernel.Parallel.AdmissionFailure P A D) →\n          (world : DefiKernel.Composition.World P A D) →\n            motive (@DefiKernel.Parallel.Result.refused P A D reason world)) →\n        (Nat.hasNotBit (nat_lit 1) (@DefiKernel.Parallel.Result.ctorIdx P A D t) → motive t) → motive t"}
P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"definition","module":"DefiKernel.Parallel.Execution","name":"DefiKernel.Parallel.ObservationallyEquivalent._sparseCasesOn_2","statement":"{P A D : Type} →\n  {motive : DefiKernel.Parallel.Result P A D → Sort u} →\n    (t : DefiKernel.Parallel.Result P A D) →\n      ((joined : DefiKernel.Parallel.Joined P A D) → motive (@DefiKernel.Parallel.Result.executed P A D joined)) →\n        (Nat.hasNotBit (nat_lit 2) (@DefiKernel.Parallel.Result.ctorIdx P A D t) → motive t) → motive t"}
P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Parallel.Execution","name":"DefiKernel.Parallel.ObservationallyEquivalent.eq_1","statement":"∀ {P A D : Type} (le : DefiKernel.Parallel.AdmissionFailure P A D) (lw : DefiKernel.Composition.World P A D)\n  (re : DefiKernel.Parallel.AdmissionFailure P A D) (rw : DefiKernel.Composition.World P A D),\n  @Eq.{1} Prop\n    (@DefiKernel.Parallel.ObservationallyEquivalent P A D (@DefiKernel.Parallel.Result.refused P A D le lw)\n      (@DefiKernel.Parallel.Result.refused P A D re rw))\n    (And (@Eq.{1} (DefiKernel.Parallel.AdmissionFailure P A D) le re)\n      (@DefiKernel.Parallel.WorldEquivalent P A D lw rw))"}
P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Parallel.Execution","name":"DefiKernel.Parallel.ObservationallyEquivalent.eq_2","statement":"∀ {P A D : Type} (l r : DefiKernel.Parallel.Joined P A D),\n  @Eq.{1} Prop\n    (@DefiKernel.Parallel.ObservationallyEquivalent P A D (@DefiKernel.Parallel.Result.executed P A D l)\n      (@DefiKernel.Parallel.Result.executed P A D r))\n    (And\n      (@DefiKernel.Parallel.WorldEquivalent P A D (@DefiKernel.Parallel.Joined.world P A D l)\n        (@DefiKernel.Parallel.Joined.world P A D r))\n      (And\n        (@Eq.{1} (DefiKernel.Parallel.BranchObservation P A D)\n          (@DefiKernel.Parallel.observeBranch P A D (@DefiKernel.Parallel.Joined.left P A D l))\n          (@DefiKernel.Parallel.observeBranch P A D (@DefiKernel.Parallel.Joined.left P A D r)))\n        (@Eq.{1} (DefiKernel.Parallel.BranchObservation P A D)\n          (@DefiKernel.Parallel.observeBranch P A D (@DefiKernel.Parallel.Joined.right P A D l))\n          (@DefiKernel.Parallel.observeBranch P A D (@DefiKernel.Parallel.Joined.right P A D r)))))"}
P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Parallel.Execution","name":"DefiKernel.Parallel.ObservationallyEquivalent.eq_3","statement":"∀ {P A D : Type} (left right : DefiKernel.Parallel.Result P A D),\n  (∀ (le : DefiKernel.Parallel.AdmissionFailure P A D) (lw : DefiKernel.Composition.World P A D)\n      (re : DefiKernel.Parallel.AdmissionFailure P A D) (rw : DefiKernel.Composition.World P A D),\n      @Eq.{1} (DefiKernel.Parallel.Result P A D) left (@DefiKernel.Parallel.Result.refused P A D le lw) →\n        @Eq.{1} (DefiKernel.Parallel.Result P A D) right (@DefiKernel.Parallel.Result.refused P A D re rw) → False) →\n    (∀ (l r : DefiKernel.Parallel.Joined P A D),\n        @Eq.{1} (DefiKernel.Parallel.Result P A D) left (@DefiKernel.Parallel.Result.executed P A D l) →\n          @Eq.{1} (DefiKernel.Parallel.Result P A D) right (@DefiKernel.Parallel.Result.executed P A D r) → False) →\n      @Eq.{1} Prop (@DefiKernel.Parallel.ObservationallyEquivalent P A D left right) False"}
P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"definition","module":"DefiKernel.Parallel.Execution","name":"DefiKernel.Parallel.ObservationallyEquivalent.match_1","statement":"{P A D : Type} →\n  (motive : DefiKernel.Parallel.Result P A D → DefiKernel.Parallel.Result P A D → Sort u_1) →\n    (left right : DefiKernel.Parallel.Result P A D) →\n      ((le : DefiKernel.Parallel.AdmissionFailure P A D) →\n          (lw : DefiKernel.Composition.World P A D) →\n            (re : DefiKernel.Parallel.AdmissionFailure P A D) →\n              (rw : DefiKernel.Composition.World P A D) →\n                motive (@DefiKernel.Parallel.Result.refused P A D le lw)\n                  (@DefiKernel.Parallel.Result.refused P A D re rw)) →\n        ((l r : DefiKernel.Parallel.Joined P A D) →\n            motive (@DefiKernel.Parallel.Result.executed P A D l) (@DefiKernel.Parallel.Result.executed P A D r)) →\n          ((x x_1 : DefiKernel.Parallel.Result P A D) → motive x x_1) → motive left right"}
