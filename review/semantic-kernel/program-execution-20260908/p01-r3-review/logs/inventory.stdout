P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.Recovery","name":"DefiKernel.Nary.Tree.complete_schedule_independence","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (roster : @DefiKernel.Nary.Roster B inst) (assoc : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n  (tree : DefiKernel.Nary.Tree.Tree B) (s1 s2 : DefiKernel.Nary.Schedule B),\n  @DefiKernel.Nary.Tree.WellFormed B inst roster tree →\n    @Eq.{1} Bool\n        (@DefiKernel.Composition.validateCatalog P A D inst_1 inst_2 inst_3\n          (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n        Bool.true →\n      @Eq.{1}\n          (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n          (@DefiKernel.Nary.analyzeAll B P A D inst_1 inst_2 inst_3 cfg boundaries branches\n            (@DefiKernel.Nary.Roster.order B inst roster))\n          (@Except.ok.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) assoc) →\n        @DefiKernel.Nary.Tree.PairwiseCompatible B P A D assoc →\n          @DefiKernel.Nary.Complete B P A D inst branches s1 →\n            @DefiKernel.Nary.Complete B P A D inst branches s2 →\n              @Eq.{1} Bool\n                (@DefiKernel.Nary.Tree.canonicalEq B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6\n                  (@DefiKernel.Nary.Tree.canonicalOf B P A D inst roster\n                    (@DefiKernel.Nary.Tree.runTreePrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n                      boundaries initial tree branches s1))\n                  (@DefiKernel.Nary.Tree.canonicalOf B P A D inst roster\n                    (@DefiKernel.Nary.Tree.runTreePrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n                      boundaries initial tree branches s2)))\n                Bool.true"}
