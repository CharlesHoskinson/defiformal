P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.Recovery","name":"DefiKernel.Nary.Tree.advance_branch_frame","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (roster : @DefiKernel.Nary.Roster B inst) (assoc : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n      (@DefiKernel.Nary.analyzeAll B P A D inst_1 inst_2 inst_3 cfg boundaries branches\n        (@DefiKernel.Nary.Roster.order B inst roster))\n      (@Except.ok.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) assoc) →\n    ∀ (m : DefiKernel.Nary.Machine B P A D),\n      @DefiKernel.Nary.Reachable B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches initial\n          m →\n        ∀ (b : B),\n          ∀ c ∉ @DefiKernel.Parallel.Footprint.writes P A D (@DefiKernel.Nary.Tree.footprintOf B P A D inst assoc b),\n            @Eq.{1} Rat\n              (@DefiKernel.Typed.State.balance P A D\n                (@DefiKernel.Typed.ExecutionResult.state P A D\n                  (@DefiKernel.Nary.Machine.world B P A D\n                    (@DefiKernel.Nary.advance B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries\n                      branches m b)))\n                c)\n              (@DefiKernel.Typed.State.balance P A D\n                (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Nary.Machine.world B P A D m)) c)"}
P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.Recovery","name":"DefiKernel.Nary.Tree.advance_own_agrees","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (roster : @DefiKernel.Nary.Roster B inst) (assoc : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n      (@DefiKernel.Nary.analyzeAll B P A D inst_1 inst_2 inst_3 cfg boundaries branches\n        (@DefiKernel.Nary.Roster.order B inst roster))\n      (@Except.ok.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) assoc) →\n    ∀ (m : DefiKernel.Nary.Machine B P A D),\n      @DefiKernel.Nary.Reachable B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches initial\n          m →\n        ∀ (b : B),\n          @DefiKernel.Parallel.CursorAgrees P A D\n              (@Set.ofPred.{0} (DefiKernel.Typed.Cell P A D) fun c =>\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                  (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                  (@DefiKernel.Parallel.Footprint.reads P A D\n                    (@DefiKernel.Nary.Tree.isolatedFootprint B P A D inst assoc b))\n                  c)\n              (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Nary.Machine.locals B P A D m b)\n                (@DefiKernel.Nary.Machine.world B P A D m))\n              (@DefiKernel.Nary.Tree.isolated P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg (boundaries b) initial\n                (branches b)\n                (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Nary.Machine.locals B P A D m b))) →\n            have post :=\n              @DefiKernel.Nary.advance B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m\n                b;\n            @DefiKernel.Parallel.CursorAgrees P A D\n              (@Set.ofPred.{0} (DefiKernel.Typed.Cell P A D) fun c =>\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                  (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                  (@DefiKernel.Parallel.Footprint.reads P A D\n                    (@DefiKernel.Nary.Tree.isolatedFootprint B P A D inst assoc b))\n                  c)\n              (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Nary.Machine.locals B P A D post b)\n                (@DefiKernel.Nary.Machine.world B P A D post))\n              (@DefiKernel.Nary.Tree.isolated P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg (boundaries b) initial\n                (branches b)\n                (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Nary.Machine.locals B P A D post b)))"}
