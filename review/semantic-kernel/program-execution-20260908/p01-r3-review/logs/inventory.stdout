ing.Attempt P A D)) (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n            (@List.instAppend.{0} (DefiKernel.Interleaving.Attempt P A D)))\n          (@DefiKernel.Interleaving.Machine.attempts P A D m)\n          (@List.cons.{0} (DefiKernel.Interleaving.Attempt P A D)\n            (@DefiKernel.Interleaving.Attempt.mk P A D branch\n              (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                (@DefiKernel.Interleaving.Machine.local P A D m branch))\n              inv (@DefiKernel.Interleaving.Machine.world P A D m)\n              (@DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n                (boundaries branch\n                  (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                    (@DefiKernel.Interleaving.Machine.local P A D m branch)))\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D m branch))\n                (@DefiKernel.Interleaving.LocalState.outputs P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D m branch))\n                (@DefiKernel.Composition.Step.invoke P A D inv) (@DefiKernel.Interleaving.Machine.world P A D m)))\n            (@List.nil.{0} (DefiKernel.Interleaving.Attempt P A D))))"}
