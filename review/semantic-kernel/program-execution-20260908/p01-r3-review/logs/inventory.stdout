P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Composition.Execution","name":"DefiKernel.Composition.StepSound.accounting","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundary : DefiKernel.Composition.Boundary P A D} {index : Nat}\n  {history : List.{0} (DefiKernel.Composition.OutputObservation A)} {step : DefiKernel.Composition.Step P A D}\n  {pre : DefiKernel.Composition.World P A D} {result : DefiKernel.Composition.StepResult P A D},\n  @DefiKernel.Composition.StepSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index history step pre\n      result →\n    ∀ (d : D) (a : A),\n      @Eq.{1} Rat\n        (@DefiKernel.Typed.total P A D inst_3\n          (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.StepResult.world P A D result)) d a)\n        (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n          (@DefiKernel.Typed.total P A D inst_3 (@DefiKernel.Typed.ExecutionResult.state P A D pre) d a)\n          (@DefiKernel.Composition.Receipt.supply P A D inst_1 inst_2\n            (@DefiKernel.Composition.StepResult.receipt P A D result) d a))"}
