        (fun x =>\n          Prod.{0, 0} (DefiKernel.Interleaving.LocalState P A D)\n            (Prod.{0, 0} (DefiKernel.Composition.World P A D) (List.{0} (DefiKernel.Nary.Attempt B P A D))))\n        (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat (DefiKernel.Composition.Invocation P A D)\n          (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n          (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D)) (branches b)\n          (@DefiKernel.Interleaving.LocalState.consumed P A D own))\n        (fun _ =>\n          @Prod.mk.{0, 0} (DefiKernel.Interleaving.LocalState P A D)\n            (Prod.{0, 0} (DefiKernel.Composition.World P A D) (List.{0} (DefiKernel.Nary.Attempt B P A D)))\n            (@DefiKernel.Nary.Tree.skipSelected P A D own)\n            (@Prod.mk.{0, 0} (DefiKernel.Composition.World P A D) (List.{0} (DefiKernel.Nary.Attempt B P A D))\n              (@DefiKernel.Nary.Tree.TreeMachine.world B P A D m)\n              (@DefiKernel.Nary.Tree.TreeMachine.attempts B P A D m)))\n        fun inv =>\n        have outcome :=\n          @DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n            (boundaries b (@DefiKernel.Interleaving.LocalState.nextIndex P A D own))\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D own) (@DefiKernel.Nary.Tree.leafHistory P A D own)\n            (@DefiKernel.Composition.Step.invoke P A D inv) (@DefiKernel.Nary.Tree.TreeMachine.world B P A D m);\n        @DefiKernel.Nary.Tree.stepLeaf.match_1.{1} P A D\n          (fun outcome =>\n            Prod.{0, 0} (DefiKernel.Interleaving.LocalState P A D)\n              (Prod.{0, 0} (DefiKernel.Composition.World P A D) (List.{0} (DefiKernel.Nary.Attempt B P A D))))\n          outcome\n          (fun reason =>\n            @Prod.mk.{0, 0} (DefiKernel.Interleaving.LocalState P A D)\n              (Prod.{0, 0} (DefiKernel.Compositi