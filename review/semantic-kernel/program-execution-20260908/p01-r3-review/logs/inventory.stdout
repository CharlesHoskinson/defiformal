P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Observation","name":"DefiKernel.Nary.ResultEquivalent.eq_3","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] (roster : @DefiKernel.Nary.Roster B inst)\n  (left right : DefiKernel.Nary.Result B P A D),\n  (∀ (lr : DefiKernel.Nary.AdmissionFailure B P A D) (lw : DefiKernel.Composition.World P A D)\n      (ls : DefiKernel.Nary.Schedule B) (rr : DefiKernel.Nary.AdmissionFailure B P A D)\n      (rw : DefiKernel.Composition.World P A D) (rs : DefiKernel.Nary.Schedule B),\n      @Eq.{1} (DefiKernel.Nary.Result B P A D) left (@DefiKernel.Nary.Result.refused B P A D lr lw ls) →\n        @Eq.{1} (DefiKernel.Nary.Result B P A D) right (@DefiKernel.Nary.Result.refused B P A D rr rw rs) → False) →\n    (∀ (ls : DefiKernel.Nary.Schedule B) (lm : DefiKernel.Nary.Machine B P A D) (rs : DefiKernel.Nary.Schedule B)\n        (rm : DefiKernel.Nary.Machine B P A D),\n        @Eq.{1} (DefiKernel.Nary.Result B P A D) left (@DefiKernel.Nary.Result.executed B P A D ls lm) →\n          @Eq.{1} (DefiKernel.Nary.Result B P A D) right (@DefiKernel.Nary.Result.executed B P A D rs rm) → False) →\n      @Eq.{1} Prop (@DefiKernel.Nary.ResultEquivalent B P A D inst roster left right) False"}
