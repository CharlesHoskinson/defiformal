P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"constructor","module":"DefiKernel.Nary.Causal","name":"DefiKernel.Nary.Replay.accept","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] {Q : Type}\n  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}\n  {branches : DefiKernel.Nary.Branches B P A D} {update : Q → DefiKernel.Nary.MonitorInput B P A D → Q} {q : Q}\n  {m : DefiKernel.Nary.Machine B P A D} {q' : Q} {rest : DefiKernel.Nary.Schedule B}\n  {final : Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D)} (b : B) (inv : DefiKernel.Composition.Invocation P A D)\n  (result : DefiKernel.Composition.StepResult P A D),\n  @DefiKernel.Nary.AdvanceSound B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m b\n      (@DefiKernel.Nary.Machine.accept B P A D inst m b inv result) →\n    @Eq.{1} (Option.{0} (DefiKernel.Nary.Attempt B P A D))\n        (@GetElem?.getElem?.{0, 0, 0} (List.{0} (DefiKernel.Nary.Attempt B P A D)) Nat (DefiKernel.Nary.Attempt B P A D)\n          (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Nary.Attempt B P A D) as))\n          (@List.instGetElem?NatLtLength.{0} (DefiKernel.Nary.Attempt B P A D))\n          (@DefiKernel.Nary.Machine.attempts B P A D (@DefiKernel.Nary.Machine.accept B P A D inst m b inv result))\n          (@List.length.{0} (DefiKernel.Nary.Attempt B P A D) (@DefiKernel.Nary.Machine.attempts B P A D m)))\n        (@Option.some.{0} (DefiKernel.Nary.Attempt B P A D)\n          (@DefiKernel.Nary.Attempt.mk B P A D b\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m b)) inv\n            (@DefiKernel.Nary.Machine.world B P A D m)\n            (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) result))) →\n      @Eq.{1} Q q'\n          (update q\n            (@DefiKernel.Nary.MonitorInput.mk B P A D b\n              (boundaries b\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m b)))\n              m (@DefiKernel.Nary.Machine.accept B P A D inst m b inv result)\n              (@Option.some.{0} (DefiKernel.Nary.Attempt B P A D)\n                (@DefiKernel.Nary.Attempt.mk B P A D b\n                  (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m b))\n                  inv (@DefiKernel.Nary.Machine.world B P A D m)\n                  (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D)\n                    result))))) →\n        @DefiKernel.Nary.Replay B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries branches update\n            (@Prod.mk.{0, 0} Q (DefiKernel.Nary.Machine B P A D) q'\n              (@DefiKernel.Nary.Machine.accept B P A D inst m b inv result))\n            rest final →\n          @DefiKernel.Nary.Replay B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries branches\n            update (@Prod.mk.{0, 0} Q (DefiKernel.Nary.Machine B P A D) q m) (@List.cons.{0} B b rest) final"}
