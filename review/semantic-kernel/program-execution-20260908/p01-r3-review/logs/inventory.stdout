))\n            (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat\n              (DefiKernel.Composition.Invocation P A D)\n              (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n              (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D))\n              (@DefiKernel.Interleaving.selectBranch P A D left right b)\n              (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m b)))\n            (@Option.none.{0} (DefiKernel.Composition.Invocation P A D))),\n        motive (@DefiKernel.Interleaving.Machine.skip P A D m b)\n          (@DefiKernel.Interleaving.AdvanceSound.exhausted P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n            left right m b active absent)) →\n      (∀ (inv : DefiKernel.Composition.Invocation P A D) (reason : DefiKernel.Composition.Failure)\n          (active :\n            @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n              (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n              (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)))\n          (selected :\n            @Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n              (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat\n                (DefiKernel.Composition.Invocation P A D)\n                (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n                (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D))\n                (@DefiKernel.Interleaving.selectBranch P A D left right b)\n                (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m b)))\n              (@Option.some.{0} (DefiKernel.Composition.Invocation P A D) inv))\n          (rejected :\n            @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D))\n              (@DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n                (boundaries b\n                  (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                    (@DefiKernel.Interleaving.Machine.local P A D m b)))\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n                (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n                (@DefiKernel.Composition.Step.invoke P A D inv) (@DefiKernel.Interleaving.Machine.world P A D m))\n              (@Except.error.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) reason)),\n          motive (@DefiKernel.Interleaving.Machine.refuse P A D m b inv reason)\n            (@DefiKernel.Interleaving.AdvanceSound.refused P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n              left right m b inv reason active selected rejected)) →\n        (∀ (inv : DefiKernel.Composition.Invocation P A D) (result : DefiKernel.Composition.StepResult P A D)\n            (active :\n              @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n                (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n                (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)))\n            (selected :\n              @Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n                (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat\n                  (DefiKernel.Composition.Invocation P A D)\n                  (fun as i =>\n                    @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n                  (@List.ins