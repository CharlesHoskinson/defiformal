P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Atomic.Settlement","name":"DefiKernel.Atomic.attemptOutstanding.congr_simp","statement":"∀ {P A D : Type} {inst : DecidableEq.{1} P} [inst_1 : DecidableEq.{1} P] {inst_2 : DecidableEq.{1} A}\n  [inst_3 : DecidableEq.{1} A] {inst_4 : DecidableEq.{1} D} [inst_5 : DecidableEq.{1} D]\n  (policy policy_1 : DefiKernel.Atomic.Policy P A D),\n  @Eq.{1} (DefiKernel.Atomic.Policy P A D) policy policy_1 →\n    ∀ (boundaries boundaries_1 : DefiKernel.Parallel.ParallelBoundary P A D),\n      @Eq.{1} (DefiKernel.Parallel.ParallelBoundary P A D) boundaries boundaries_1 →\n        ∀ (owed owed_1 : DefiKernel.Atomic.Outstanding P A D),\n          @Eq.{1} (DefiKernel.Atomic.Outstanding P A D) owed owed_1 →\n            ∀ (attempt attempt_1 : DefiKernel.Interleaving.Attempt P A D),\n              @Eq.{1} (DefiKernel.Interleaving.Attempt P A D) attempt attempt_1 →\n                ∀ (a a_1 : DefiKernel.Atomic.Lane P A D),\n                  @Eq.{1} (DefiKernel.Atomic.Lane P A D) a a_1 →\n                    ∀ (a_2 a_3 : P),\n                      @Eq.{1} P a_2 a_3 →\n                        @Eq.{1} Rat\n                          (@DefiKernel.Atomic.attemptOutstanding P A D inst inst_2 inst_4 policy boundaries owed attempt\n                            a a_2)\n                          (@DefiKernel.Atomic.attemptOutstanding P A D inst_1 inst_3 inst_5 policy_1 boundaries_1 owed_1\n                            attempt_1 a_1 a_3)"}
P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Atomic.Settlement","name":"DefiKernel.Atomic.attemptOutstanding.eq_1","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (owed : DefiKernel.Atomic.Outstanding P A D) (attempt : DefiKernel.Interleaving.Attempt P A D),\n  @Eq.{1} (DefiKernel.Atomic.Outstanding P A D)\n    (@DefiKernel.Atomic.attemptOutstanding P A D inst inst_1 inst_2 policy boundaries owed attempt)\n    (@DefiKernel.Atomic.attemptOutstanding.match_1.{1} P A D (fun x => DefiKernel.Atomic.Outstanding P A D)\n      (@DefiKernel.Interleaving.Attempt.outcome P A D attempt) (fun a => owed) fun result =>\n      @DefiKernel.Atomic.updateOutstanding P A D inst inst_1 inst_2 policy owed\n        (@DefiKernel.Typed.InvocationContext.principal P D\n          (@DefiKernel.Composition.Boundary.ctx P A D\n            (boundaries (@DefiKernel.Interleaving.Attempt.branch P A D attempt)\n              (@DefiKernel.Interleaving.Attempt.index P A D attempt))))\n        (@DefiKernel.Composition.StepResult.receipt P A D result))"}
