                      (@DefiKernel.Typed.State.balance P A D\n                            (@DefiKernel.Typed.ExecutionResult.state P A D\n                              (@DefiKernel.Nary.Tree.foldIsolatedWorld B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n                                inst_6 cfg boundaries initial branches assoc x))\n                            x_4)\n                          (@DefiKernel.Typed.State.balance P A D\n                            (@DefiKernel.Typed.ExecutionResult.state P A D\n                              (@DefiKernel.Nary.Tree.IsolatedRef.world P A D\n                                (@DefiKernel.Nary.Tree.runIsolatedLeaf P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6\n                                  cfg (boundaries x_2) initial (branches x_2))))\n                            x_4))\n            x),\n        @List.Nodup.{0} B x →\n          ∀ (x_2 : B),\n            @Membership.mem.{0, 0} B (List.{0} B) (@List.instMembership.{0} B) x x_2 →\n              ∀ (x_4 : DefiKernel.Typed.Cell P A D),\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.writes P A D\n                      (@DefiKernel.Nary.Tree.footprintOf B P A D inst assoc x_2))\n                    x_4 →\n                  @Eq.{1} Rat\n                    (@DefiKernel.Typed.State.balance P A D\n                      (@DefiKernel.Typed.ExecutionResult.state P A D\n                        (@DefiKernel.Nary.Tree.foldIsolatedWorld B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6\n                          cfg boundaries initial branches assoc x))\n                      x_4)\n                    (@DefiKernel.Typed.State.balance P A D\n                      (@DefiKernel.Typed.ExecutionResult.state P A D\n                        (@DefiKernel.Nary.Tree.IsolatedRef.world P A D\n         