P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.Recovery","name":"DefiKernel.Nary.Tree.compatible_peer_reads","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [Fintype.{0} P] [Fintype.{0} A] [Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (roster : @DefiKernel.Nary.Roster B inst)\n  (assoc : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n      (@DefiKernel.Nary.analyzeAll B P A D inst_1 inst_2 inst_3 cfg boundaries branches\n        (@DefiKernel.Nary.Roster.order B inst roster))\n      (@Except.ok.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) assoc) →\n    @DefiKernel.Nary.Tree.PairwiseCompatible B P A D assoc →\n      ∀ (b peer : B),\n        @Ne.{1} B b peer →\n          ∀ (c : DefiKernel.Typed.Cell P A D),\n            @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                (@DefiKernel.Parallel.Footprint.reads P A D (@DefiKernel.Nary.Tree.footprintOf B P A D inst assoc peer))\n                c →\n              c ∉ @DefiKernel.Parallel.Footprint.writes P A D (@DefiKernel.Nary.Tree.footprintOf B P A D inst assoc b)"}
