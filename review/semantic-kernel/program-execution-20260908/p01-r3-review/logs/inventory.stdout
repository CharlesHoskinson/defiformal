P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Schedule","name":"DefiKernel.Nary.Complete.length","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] {branches : DefiKernel.Nary.Branches B P A D}\n  {schedule : DefiKernel.Nary.Schedule B} (roster : @DefiKernel.Nary.Roster B inst),\n  @DefiKernel.Nary.Complete B P A D inst branches schedule →\n    @Eq.{1} Nat (@List.length.{0} B schedule)\n      (@List.sum.{0} Nat instAddNat (@MulZeroClass.toZero.{0} Nat Nat.instMulZeroClass)\n        (@List.map.{0, 0} B Nat (fun b => @List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches b))\n          (@DefiKernel.Nary.Roster.order B inst roster)))"}
