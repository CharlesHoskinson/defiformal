hId)\n        (previous :\n          @DefiKernel.Atomic.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right\n            initial m)\n        (ih :\n          @DefiKernel.Atomic.Reachable.below P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left\n            right initial motive m previous)\n        (previous_ih : motive m previous),\n        @motive_1\n          (@DefiKernel.Atomic.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right m\n            branch)\n          (@DefiKernel.Atomic.Reachable.next P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left\n            right initial m branch previous)\n          (@DefiKernel.Atomic.Reachable.below.next P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy\n            left right initial motive m branch previous ih previous_ih)) →\n      @motive_1 a t t_1"}
