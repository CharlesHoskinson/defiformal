P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"definition","module":"DefiKernel.Composition.Execution","name":"DefiKernel.Composition.StepSound.casesOn","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundary : DefiKernel.Composition.Boundary P A D} {index : Nat}\n  {history : List.{0} (DefiKernel.Composition.OutputObservation A)}\n  {motive :\n    (a : DefiKernel.Composition.Step P A D) →\n      (a_1 : DefiKernel.Composition.World P A D) →\n        (a_2 : DefiKernel.Composition.StepResult P A D) →\n          @DefiKernel.Composition.StepSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index history a\n              a_1 a_2 →\n            Prop}\n  {a : DefiKernel.Composition.Step P A D} {a_1 : DefiKernel.Composition.World P A D}\n  {a_2 : DefiKernel.Composition.StepResult P A D}\n  (t :\n    @DefiKernel.Composition.StepSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index history a a_1\n      a_2),\n  (∀ (inv : DefiKernel.Composition.Invocation P A D) (pre post : DefiKernel.Composition.World P A D)\n      (iface : DefiKernel.Composition.OperationInterface P A D) (request : DefiKernel.Typed.Request P A D)\n      (e : DefiKernel.Typed.Evaluated P A D)\n      (prepared :\n        @Eq.{1}\n          (Except.{0, 0} DefiKernel.Composition.Failure\n            (Prod.{0, 0} (DefiKernel.Composition.OperationInterface P A D) (DefiKernel.Typed.Request P A D)))\n          (@DefiKernel.Composition.prepareInvocation P A D inst inst_1 inst_2 cfg boundary index history inv)\n          (@Except.ok.{0, 0} DefiKernel.Composition.Failure\n            (Prod.{0, 0} (DefiKernel.Composition.OperationInterface P A D) (DefiKernel.Typed.Request P A D))\n            (@Prod.mk.{0, 0} (DefiKernel.Composition.OperationInterface P A D) (DefiKernel.Typed.Request P A D) iface\n              request)))\n      (executed :\n        @Eq.{1} (Except.{0, 0} DefiKernel.Typed.Refusal (DefiKernel.Typed.ExecutionResult P A D))\n          (@DefiKernel.Typed.execute P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n            (@DefiKernel.Composition.Config.registry P A D cfg)\n            (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n            (@DefiKernel.Composition.Boundary.ctx P A D boundary) (@DefiKernel.Composition.Boundary.env P A D boundary)\n            (@DefiKernel.Composition.Boundary.now P A D boundary) request\n            (@DefiKernel.Typed.ExecutionResult.state P A D pre))\n          (@Except.ok.{0, 0} DefiKernel.Typed.Refusal (DefiKernel.Typed.ExecutionResult P A D) post))\n      (extracted :\n        @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Typed.Evaluated P A D))\n          (@DefiKernel.Composition.extractReceipt P A D inst_1 cfg boundary request pre)\n          (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Typed.Evaluated P A D) e))\n      (applied :\n        @Eq.{1} (Except.{0, 0} DefiKernel.Typed.Refusal (DefiKernel.Typed.ExecutionResult P A D))\n          (@DefiKernel.Typed.applyEvaluated P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n            (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n            (@DefiKernel.Composition.Boundary.ctx P A D boundary) request\n            (@DefiKernel.Typed.ExecutionResult.state P A D pre) e)\n          (@Except.ok.{0, 0} DefiKernel.Typed.Refusal (DefiKernel.Typed.ExecutionResult P A D) post)),\n      motive (@DefiKernel.Composition.Step.invoke P A D inv) pre\n        (@DefiKernel.Composition.StepResult.mk P A D post (@DefiKernel.Composition.Receipt.invoked P A D request e)\n          (@DefiKernel.Composition.snapshots P A D index (@DefiKernel.Composition.Invocation.component P A D inv) iface\n            (@DefiKernel.Typed.ExecutionResult.state P A D post)))\n        (@DefiKernel.Composition.StepSound.invoke P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index\n          history inv pre post iface request e prepared executed extracted applied)) →\n    (∀ (grant : DefiKernel.Typed.Grant P A D) (pre : DefiKernel.Composition.World P A D)\n        (id : DefiKernel.Typed.CapabilityId) (store : DefiKernel.Typed.CapabilityStore P A D)\n        (issued :\n          @Eq.{1}\n            (Except.{0, 0} DefiKernel.Typed.AuthorityFailure\n              (Prod.{0, 0} DefiKernel.Typed.CapabilityId (DefiKernel.Typed.CapabilityStore P A D)))\n            (@DefiKernel.Typed.issueCapability P A D inst inst_2 (@DefiKernel.Composition.Config.authority P A D cfg)\n              (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n              (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre) grant)\n            (@Except.ok.{0, 0} DefiKernel.Typed.AuthorityFailure\n              (Prod.{0, 0} DefiKernel.Typed.CapabilityId (DefiKernel.Typed.CapabilityStore P A D))\n              (@Prod.mk.{0, 0} DefiKernel.Typed.CapabilityId (DefiKernel.Typed.CapabilityStore P A D) id store))),\n        motive (@DefiKernel.Composition.Step.issue P A D grant) pre\n          (@DefiKernel.Composition.StepResult.mk P A D\n            (@DefiKernel.Typed.ExecutionResult.mk P A D (@DefiKernel.Typed.ExecutionResult.state P A D pre) store)\n            (@DefiKernel.Composition.Receipt.issued P A D id)\n            (@List.nil.{0} (DefiKernel.Composition.OutputObservation A)))\n          (@DefiKernel.Composition.StepSound.issue P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index\n            history grant pre id store issued)) →\n      (∀ (id : DefiKernel.Typed.CapabilityId) (pre : DefiKernel.Composition.World P A D)\n          (store : DefiKernel.Typed.CapabilityStore P A D)\n          (revoked :\n            @Eq.{1} (Except.{0, 0} DefiKernel.Typed.AuthorityFailure (DefiKernel.Typed.CapabilityStore P A D))\n              (@DefiKernel.Typed.revokeCapability P A D inst inst_2 (@DefiKernel.Composition.Config.authority P A D cfg)\n                (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n                (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre) id)\n              (@Except.ok.{0, 0} DefiKernel.Typed.AuthorityFailure (DefiKernel.Typed.CapabilityStore P A D) store)),\n          motive (@DefiKernel.Composition.Step.revoke P A D id) pre\n            (@DefiKernel.Composition.StepResult.mk P A D\n              (@DefiKernel.Typed.ExecutionResult.mk P A D (@DefiKernel.Typed.ExecutionResult.state P A D pre) store)\n              (@DefiKernel.Composition.Receipt.revoked P A D id)\n              (@List.nil.{0} (DefiKernel.Composition.OutputObservation A)))\n            (@DefiKernel.Composition.StepSound.revoke P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index\n              history id pre store revoked)) →\n        motive a a_1 a_2 t"}
