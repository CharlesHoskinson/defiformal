Composition.World P A D)\n                      (List.{0} (Prod.{0, 0} B (DefiKernel.Nary.Tree.CanonicalLocal P A D)))\n                      (@DefiKernel.Nary.Tree.runIsolatedTree B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n                        boundaries initial branches assoc tree)))\n                  c)\n                (@DefiKernel.Typed.State.balance P A D\n                  (@DefiKernel.Typed.ExecutionResult.state P A D\n                    (@DefiKernel.Nary.Tree.IsolatedRef.world P A D\n                      (@DefiKernel.Nary.Tree.runIsolatedLeaf P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n                        (boundaries b) initial (branches b))))\n                  c)"}
