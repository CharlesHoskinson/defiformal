P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Observation","name":"DefiKernel.Nary.ResultEquivalent.eq_1","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] (roster : @DefiKernel.Nary.Roster B inst)\n  (lr : DefiKernel.Nary.AdmissionFailure B P A D) (lw : DefiKernel.Composition.World P A D)\n  (ls : DefiKernel.Nary.Schedule B) (rr : DefiKernel.Nary.AdmissionFailure B P A D)\n  (rw : DefiKernel.Composition.World P A D) (rs : DefiKernel.Nary.Schedule B),\n  @Eq.{1} Prop\n    (@DefiKernel.Nary.ResultEquivalent B P A D inst roster (@DefiKernel.Nary.Result.refused B P A D lr lw ls)\n      (@DefiKernel.Nary.Result.refused B P A D rr rw rs))\n    (And (@Eq.{1} (DefiKernel.Nary.AdmissionFailure B P A D) lr rr)\n      (And (@DefiKernel.Parallel.WorldEquivalent P A D lw rw) (@Eq.{1} (DefiKernel.Nary.Schedule B) ls rs)))"}
