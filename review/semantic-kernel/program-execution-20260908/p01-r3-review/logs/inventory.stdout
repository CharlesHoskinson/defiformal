P01_INVENTORY {"axioms":["propext","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.Simulation","name":"DefiKernel.Nary.Tree.acceptSelected.eq_1","statement":"∀ {P A D : Type} (own : DefiKernel.Interleaving.LocalState P A D) (inv : DefiKernel.Composition.Invocation P A D)\n  (before : DefiKernel.Composition.World P A D) (result : DefiKernel.Composition.StepResult P A D),\n  @Eq.{1} (DefiKernel.Interleaving.LocalState P A D) (@DefiKernel.Nary.Tree.acceptSelected P A D own inv before result)\n    (@DefiKernel.Interleaving.LocalState.mk P A D\n      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n        (@DefiKernel.Interleaving.LocalState.consumed P A D own)\n        (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Composition.Event P A D))\n        (List.{0} (DefiKernel.Composition.Event P A D)) (List.{0} (DefiKernel.Composition.Event P A D))\n        (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Composition.Event P A D))\n          (@List.instAppend.{0} (DefiKernel.Composition.Event P A D)))\n        (@DefiKernel.Interleaving.LocalState.events P A D own)\n        (@List.cons.{0} (DefiKernel.Composition.Event P A D)\n          (@DefiKernel.Composition.Event.mk P A D (@DefiKernel.Interleaving.LocalState.nextIndex P A D own)\n            (@DefiKernel.Composition.Step.invoke P A D inv) before result)\n          (@List.nil.{0} (DefiKernel.Composition.Event P A D))))\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Composition.OutputObservation A))\n        (List.{0} (DefiKernel.Composition.OutputObservation A)) (List.{0} (DefiKernel.Composition.OutputObservation A))\n        (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Composition.OutputObservation A))\n          (@List.instAppend.{0} (DefiKernel.Composition.OutputObservation A)))\n        (@DefiKernel.Interleaving.LocalState.outputs P A D own)\n        (@DefiKernel.Composition.StepResult.outputs P A D result))\n      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n        (@DefiKernel.Interleaving.LocalState.nextIndex P A D own)\n        (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))\n      (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)))"}
P01_INVENTORY {"axioms":["propext"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.DisjointRuntime","name":"DefiKernel.Nary.Tree.admitIsolated.eq_1","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] (cfg : DefiKernel.Composition.Config P A D) (roster : @DefiKernel.Nary.Roster B inst)\n  (boundaries : DefiKernel.Nary.Boundaries B P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (tree : DefiKernel.Nary.Tree.Tree B),\n  @Eq.{1}\n    (Except.{0, 0}\n      (Sum.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D) (DefiKernel.Nary.Tree.PairConflict B P A D))\n      (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n    (@DefiKernel.Nary.Tree.admitIsolated B P A D inst inst_1 inst_2 inst_3 cfg roster boundaries branches schedule tree)\n    (@DefiKernel.Nary.Tree.admitIsolated.match_1.{1} B P A D\n      (fun x =>\n        Except.{0, 0}\n          (Sum.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D) (DefiKernel.Nary.Tree.PairConflict B P A D))\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n      (@DefiKernel.Nary.Tree.admitTree B P A D inst inst_1 inst_2 inst_3 cfg roster boundaries branches schedule tree)\n      (fun reason =>\n        @Except.error.{0, 0}\n          (Sum.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D) (DefiKernel.Nary.Tree.PairConflict B P A D))\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n          (@Sum.inl.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D)\n            (DefiKernel.Nary.Tree.PairConflict B P A D) reason))\n      fun assoc =>\n      @DefiKernel.Nary.Tree.checkAgainst.match_1.{1} B P A D\n        (fun x =>\n          Except.{0, 0}\n            (Sum.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D) (DefiKernel.Nary.Tree.PairConflict B P A D))\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n        (@DefiKernel.Nary.Tree.checkPairwise B P A D inst_1 inst_2 inst_3 assoc)\n        (fun conflict =>\n          @Except.error.{0, 0}\n            (Sum.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D) (DefiKernel.Nary.Tree.PairConflict B P A D))\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n            (@Sum.inr.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D)\n              (DefiKernel.Nary.Tree.PairConflict B P A D) conflict))\n        fun a =>\n        @Except.ok.{0, 0}\n          (Sum.{0, 0} (DefiKernel.Nary.Tree.TreeAdmissionFailure B P A D) (DefiKernel.Nary.Tree.PairConflict B P A D))\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) assoc)"}
