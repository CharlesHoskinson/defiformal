P01_INVENTORY {"axioms":["propext","Classical.choice","Quot.sound"],"forbidden":[],"kind":"theorem","module":"DefiKernel.Nary.Tree.Recovery","name":"DefiKernel.Nary.Tree.Simulates.start","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (assoc : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))),\n  @Eq.{1} Bool\n      (@DefiKernel.Composition.validateCatalog P A D inst_1 inst_2 inst_3\n        (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n      Bool.true →\n    @DefiKernel.Nary.Tree.Simulates B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries initial\n      branches assoc (@DefiKernel.Nary.start B P A D initial)"}
