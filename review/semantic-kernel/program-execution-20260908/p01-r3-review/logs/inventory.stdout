igation B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q\n                        cfg boundaries branches update K invariant guarantee assumption →\n                      ∀ (schedule : DefiKernel.Nary.Schedule B) (length : Nat),\n                        And\n                          (K\n                            (@Prod.fst.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                              (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6\n                                Q cfg boundaries branches update entry (@List.take.{0} B length schedule)))\n                            (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                              (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6\n                                Q cfg boundaries branches update entry (@List.take.{0} B length schedule))))\n                          (∀ (b : B),\n                            invariant b\n                              (@DefiKernel.Typed.ExecutionResult.state P A D\n                                (@DefiKernel.Nary.Machine.world B P A D\n                                  (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                                    (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n                                      inst_6 Q cfg boundaries branches update entry\n                                      (@List.take.{0} B length schedule))))))"}
