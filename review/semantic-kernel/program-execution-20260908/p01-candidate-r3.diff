+    (runIsolatedTree cfg boundaries initial branches assoc ((a.fork b).fork c)).2 =
+      (runIsolatedTree cfg boundaries initial branches assoc (a.fork (b.fork c))).2 := by
+  simp [runIsolatedTree, List.append_assoc]
