DefiKernel.Certificates.decodeEnvelope_sortedFields (env : EnvelopeEnc) (payloadJ : Lean.Json)
  (h_ver : env.schema_version = 1) (h_sm : env.source_map = []) (h_cns : env.claimed_next_state = none) :
  decodeEnvelope (envelopeSortedFields env payloadJ) = Except.ok env
DefiKernel.Certificates.decodeDecodedIR_fields_typed (env : EnvelopeEnc) (payload : TypedExecutePayloadEnc)
  (h_ver : env.schema_version = 1) (h_mode : env.mode = "typed-execute") (h_sm : env.source_map = [])
  (h_cns : env.claimed_next_state = none) (h_reg_can : RegistryCanonical payload.registry)
  (h_env_can : EnvironmentCanonical payload.env) (h_req_can : RequestCanonical payload.request)
  (h_state_valid :
    ∀ c ∈ payload.state.cells, c.amount.den ≠ 0 ∧ (↑c.amount.num.natAbs).gcd ↑c.amount.den = 1 ∧ c.amount.num ≥ 0)
  (h_state_unique :
    (List.map (fun c => (c.domain, c.party, c.asset)) payload.state.cells).eraseDups.length =
      payload.state.cells.length)
  (raw : String) :
  (do
      let env_dec ← decodeEnvelope (envelopeSortedFields env (typedExecutePayloadToJson payload))
      let payloadJ ← getField (envelopeSortedFields env (typedExecutePayloadToJson payload)) "payload"
      match env_dec.mode with
        | "typed-execute" => do
          let payload_dec ← decodeTypedExecutePayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.typed env_dec payload_dec))
        | "composition-step" => do
          let payload_dec ← decodeCompositionStepPayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.step env_dec payload_dec))
        | "composition-run" => do
          let payload_dec ← decodeCompositionRunPayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.run env_dec payload_dec))
        | "codec" => Except.ok (DecodedIR.codec { envelope := some env_dec, rawText := raw })
        | "audit" => do
          let payload_dec ← decodeAuditPayload env_dec payloadJ
          Except.ok (DecodedIR.audit payload_dec)
        | s => Except.error (DecodeFailure.unknownIdentifier s)) =
    Except.ok (DecodedIR.execution (DecodedExecution.typed env payload))
DefiKernel.Certificates.decodeDecodedIR_fields_step (env : EnvelopeEnc) (payload : CompositionStepPayloadEnc)
  (h_ver : env.schema_version = 1) (h_mode : env.mode = "composition-step") (h_sm : env.source_map = [])
  (h_cns : env.claimed_next_state = none) (h_cfg_can : RegistryCanonical payload.config.registry)
  (h_bnd_can : BoundaryCanonical payload.boundary) (h_hist_can : HistoryCanonical payload.history)
  (h_step_can : StepCanonical payload.step)
  (h_pre_valid :
    ∀ c ∈ payload.pre.state.cells, c.amount.den ≠ 0 ∧ (↑c.amount.num.natAbs).gcd ↑c.amount.den = 1 ∧ c.amount.num ≥ 0)
  (h_pre_unique :
    (List.map (fun c => (c.domain, c.party, c.asset)) payload.pre.state.cells).eraseDups.length =
      payload.pre.state.cells.length)
  (raw : String) :
  (do
      let env_dec ← decodeEnvelope (envelopeSortedFields env (compositionStepPayloadToJson payload))
      let payloadJ ← getField (envelopeSortedFields env (compositionStepPayloadToJson payload)) "payload"
      match env_dec.mode with
        | "typed-execute" => do
          let payload_dec ← decodeTypedExecutePayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.typed env_dec payload_dec))
        | "composition-step" => do
          let payload_dec ← decodeCompositionStepPayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.step env_dec payload_dec))
        | "composition-run" => do
          let payload_dec ← decodeCompositionRunPayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.run env_dec payload_dec))
        | "codec" => Except.ok (DecodedIR.codec { envelope := some env_dec, rawText := raw })
        | "audit" => do
          let payload_dec ← decodeAuditPayload env_dec payloadJ
          Except.ok (DecodedIR.audit payload_dec)
        | s => Except.error (DecodeFailure.unknownIdentifier s)) =
    Except.ok (DecodedIR.execution (DecodedExecution.step env payload))
DefiKernel.Certificates.decodeDecodedIR_fields_run (env : EnvelopeEnc) (payload : CompositionRunPayloadEnc)
  (h_ver : env.schema_version = 1) (h_mode : env.mode = "composition-run") (h_sm : env.source_map = [])
  (h_cns : env.claimed_next_state = none) (h_cfg_can : RegistryCanonical payload.config.registry)
  (h_bnds_can : ∀ b ∈ payload.boundaries, BoundaryCanonical b) (h_steps_can : ∀ s ∈ payload.steps, StepCanonical s)
  (h_w_valid :
    ∀ c ∈ payload.world.state.cells, c.amount.den ≠ 0 ∧ (↑c.amount.num.natAbs).gcd ↑c.amount.den = 1 ∧ c.amount.num ≥ 0)
  (h_w_unique :
    (List.map (fun c => (c.domain, c.party, c.asset)) payload.world.state.cells).eraseDups.length =
      payload.world.state.cells.length)
  (raw : String) :
  (do
      let env_dec ← decodeEnvelope (envelopeSortedFields env (compositionRunPayloadToJson payload))
      let payloadJ ← getField (envelopeSortedFields env (compositionRunPayloadToJson payload)) "payload"
      match env_dec.mode with
        | "typed-execute" => do
          let payload_dec ← decodeTypedExecutePayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.typed env_dec payload_dec))
        | "composition-step" => do
          let payload_dec ← decodeCompositionStepPayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.step env_dec payload_dec))
        | "composition-run" => do
          let payload_dec ← decodeCompositionRunPayload payloadJ
          Except.ok (DecodedIR.execution (DecodedExecution.run env_dec payload_dec))
        | "codec" => Except.ok (DecodedIR.codec { envelope := some env_dec, rawText := raw })
        | "audit" => do
          let payload_dec ← decodeAuditPayload env_dec payloadJ
          Except.ok (DecodedIR.audit payload_dec)
        | s => Except.error (DecodeFailure.unknownIdentifier s)) =
    Except.ok (DecodedIR.execution (DecodedExecution.run env payload))
