+def expected_classification(timeout: bool, cancelled: bool, exit_code: int | None) -> str:
+    if timeout:
+        return "timeout_blocked"
+    if cancelled:
+        return "cancelled"
+    if exit_code is None or (isinstance(exit_code, int) and exit_code < 0):
+        return "crash"
+    if exit_code == 0:
+        return "ok"
+    if exit_code == 1:
+        return "failure"
+    if exit_code == 3:
+        return "blocked"
+    return "nonzero"
+
