+/-- String encoding correspondence for TreeJson rationals. -/
+theorem ratToTreeJson_encode (r : RatEnc) :
+    (ratToTreeJson r).encode = encodeRat r := by
+  dsimp [ratToTreeJson, encodeRat]
+  rw [encode_obj_eq_jsonObj]
+  rfl
