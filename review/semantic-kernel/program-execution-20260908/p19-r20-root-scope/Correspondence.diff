+/-- Semantic JSON correspondence for TreeJson rationals. -/
+theorem ratToTreeJson_toJson (r : RatEnc) :
+    (ratToTreeJson r).toJson = ratToJson r := by
+  dsimp [ratToTreeJson, TreeJson.toJson, TreeJson.toJsonObj, ratToJson]
+  rfl
