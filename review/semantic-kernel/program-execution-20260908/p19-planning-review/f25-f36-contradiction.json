  "correspondence_contract": {
    "status": "proposed_unelaborated_statements",
    "compiler_check_recorded": false,
    "supported_ir_domain": "DecodedIR values for which decodeBytes succeeds, types enumerations are nonempty finite, state table is complete 32-or-declared-size nonnegative cells, registry ids unique, and step tags are invoke|issue|revoke",
    "canonicality_hypothesis": "RatEnc lowest terms den>0; objects use grammar canonical_nested_key_order; compact UTF-8; no duplicate keys",
    "extensional_finite_world_equality": "worldEq cells amounts and store.entries pointwise; not function extensionality over an infinite Domain",
    "finite_fixture_tests_do_not_discharge_RC01": true,
    "statements": [
      {
        "id": "T-roundtrip",
        "name": "encode_decode_roundtrip",
        "module": "DefiKernel.Certificates.Correspondence",
        "statement": "∀ (ir : DecodedIR), supported ir → canonical ir → decodeBytes (encodeModule ir) = .ok ir",
        "discharges": "universal RC01 for supported IR",
        "finite_tests": [
          "F25",
          "F27",
          "F28",
          "F48"
        ]
      },
      {
        "id": "T-canonical-bytes",
        "name": "decode_encode_canonical_bytes",
        "module": "DefiKernel.Certificates.Correspondence",
        "statement": "∀ raw ir, decodeBytes raw = .ok ir → canonical ir → encodeModule ir is the unique compact canonical encoding of ir (not necessarily equal to raw if raw had key-order differences that decode accepted only after canonicalization — this increment refuses non-canonical key order at decode)",
        "finite_tests": [
          "F13",
          "F25"
        ]
      },
      {
        "id": "T-accepted-execute",
        "name": "checkIR_execute_ok",
        "module": "DefiKernel.Certificates.Soundness",
        "statement": "∀ cert ir post, decodeBytes cert.raw = .ok ir → ir.mode = typed-execute → Typed.execute ir.registry ir.store ir.ctx ir.env ir.now ir.request ir.state = .ok post → (checkIR ir).status = .accepted ∧ worldEq (checkIR ir).world post",
        "finite_tests": [
          "F25"
        ]
      },
      {
        "id": "T-refused-execute",
        "name": "checkIR_execute_error",
        "module": "DefiKernel.Certificates.Soundness",
        "statement": "∀ cert ir r, decodeBytes cert.raw = .ok ir → ir.mode = typed-execute → Typed.execute ... = .error r → (checkIR ir).status = .refused ∧ (checkIR ir).failure = kernel r ∧ worldEq (checkIR ir).world ir.preState",
        "finite_tests": [
          "F15",
          "F20",
          "F21",
          "F23",
          "F24",
          "F29",
          "F30"
        ]
      },
      {
        "id": "T-accepted-step",
        "name": "checkIR_executeStep_ok",
        "module": "DefiKernel.Certificates.Soundness",
        "statement": "ir.mode = composition-step → Composition.executeStep ... = .ok result → Report accepted and world/receipt/outputs equal result, receipt extracted from pre-state",
        "finite_tests": [
          "F27",
          "F50",
          "F51"
        ]
      },
      {
        "id": "T-refused-step",
        "name": "checkIR_executeStep_error",
        "module": "DefiKernel.Certificates.Soundness",
        "statement": "executeStep = .error f → Report refused with FailurePath f and world equal pre",
        "finite_tests": [
          "F08",
          "F26",
          "F32",
          "F47"
        ]
      },
      {
        "id": "T-run-cursor",
        "name": "checkIR_run_cursor",
        "module": "DefiKernel.Certificates.Soundness",
        "statement": "ir.mode = composition-run → Report fields equal Composition.run cursor including events, outputs, nextIndex, cursorFailure and inert suffix",
        "finite_tests": [
          "F48",
          "F49"
        ]
      },
      {
        "id": "T-malformed-no-kernel",
        "name": "decode_error_no_execute",
