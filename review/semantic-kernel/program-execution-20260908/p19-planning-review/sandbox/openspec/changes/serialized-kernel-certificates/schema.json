  "rat_enc": {
    "type": "object",
    "required": ["num", "den"],
    "additionalProperties": false,
    "properties": {
      "num": {"type": "integer"},
      "den": {"type": "integer", "minimum": 1}
    },
    "constraints": [
      "den > 0",
      "gcd(abs(num), den) = 1",
      "sign on num only",
      "reject JSON number, string, array, null, float, scientific notation, den=0, negative den, unreduced pairs"
    ]
  },
  "nat_id": {
    "type": "integer",
    "minimum": 0,
    "reject": ["negative", "float", "string"]
  },
  "module_required_keys": [
