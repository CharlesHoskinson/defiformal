INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Accounting","name":"DefiKernel.Interface.advance_accounting_suffix","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  (region : DefiKernel.Interface.Region P A D) (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (entry : DefiKernel.Composition.Cursor P A D)\n  (step : DefiKernel.Composition.Step P A D),\n  ∃ suffix,\n    And\n      (@Eq.{1} (List.{0} (DefiKernel.Composition.Event P A D))\n        (@DefiKernel.Composition.Cursor.events P A D\n          (@DefiKernel.Composition.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry step))\n        (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Composition.Event P A D))\n          (List.{0} (DefiKernel.Composition.Event P A D)) (List.{0} (DefiKernel.Composition.Event P A D))\n          (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Composition.Event P A D))\n            (@List.instAppend.{0} (DefiKernel.Composition.Event P A D)))\n          (@DefiKernel.Composition.Cursor.events P A D entry) suffix))\n      (@Eq.{1} Rat\n        (@DefiKernel.Interface.balanceSum P A D region\n          (@DefiKernel.Typed.ExecutionResult.state P A D\n            (@DefiKernel.Composition.Cursor.world P A D\n              (@DefiKernel.Composition.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n                step))))\n        (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n          (@DefiKernel.Interface.balanceSum P A D region\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D entry)))\n          (@DefiKernel.Interface.eventDeltaSum P A D inst inst_1 inst_2 region suffix)))","user_name":"DefiKernel.Interface.advance_accounting_suffix"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Preservation","name":"DefiKernel.Interface.advance_preserves","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (allowed : DefiKernel.Composition.Step P A D → Prop) (invariant : DefiKernel.Typed.State P A D → Prop),\n  @DefiKernel.Interface.LocalPreserves P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg allowed invariant →\n    ∀ (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (entry : DefiKernel.Composition.Cursor P A D)\n      (step : DefiKernel.Composition.Step P A D),\n      allowed step →\n        invariant (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D entry)) →\n          invariant\n            (@DefiKernel.Typed.ExecutionResult.state P A D\n              (@DefiKernel.Composition.Cursor.world P A D\n                (@DefiKernel.Composition.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n                  step)))","user_name":"DefiKernel.Interface.advance_preserves"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.agrees_append","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (left right : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  Iff\n    (@DefiKernel.Interface.Agrees P A D catalog\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n        (List.{0} DefiKernel.Interface.Binding)\n        (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n          (@List.instAppend.{0} DefiKernel.Interface.Binding))\n        left right)\n      state)\n    (And (@DefiKernel.Interface.Agrees P A D catalog left state)\n      (@DefiKernel.Interface.Agrees P A D catalog right state))","user_name":"DefiKernel.Interface.agrees_append"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.agrees_assoc","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D)\n  (first second third : List.{0} DefiKernel.Interface.Binding) (state : DefiKernel.Typed.State P A D),\n  Iff\n    (@DefiKernel.Interface.Agrees P A D catalog\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n        (List.{0} DefiKernel.Interface.Binding)\n        (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n          (@List.instAppend.{0} DefiKernel.Interface.Binding))\n        (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n          (List.{0} DefiKernel.Interface.Binding)\n          (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n            (@List.instAppend.{0} DefiKernel.Interface.Binding))\n          first second)\n        third)\n      state)\n    (@DefiKernel.Interface.Agrees P A D catalog\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n        (List.{0} DefiKernel.Interface.Binding)\n        (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n          (@List.instAppend.{0} DefiKernel.Interface.Binding))\n        first\n        (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n          (List.{0} DefiKernel.Interface.Binding)\n          (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n            (@List.instAppend.{0} DefiKernel.Interface.Binding))\n          second third))\n      state)","user_name":"DefiKernel.Interface.agrees_assoc"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.agrees_cons","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (edge : DefiKernel.Interface.Binding)\n  (edges : List.{0} DefiKernel.Interface.Binding) (state : DefiKernel.Typed.State P A D),\n  Iff (@DefiKernel.Interface.Agrees P A D catalog (@List.cons.{0} DefiKernel.Interface.Binding edge edges) state)\n    (And (@DefiKernel.Interface.EdgeAgrees P A D catalog edge state)\n      (@DefiKernel.Interface.Agrees P A D catalog edges state))","user_name":"DefiKernel.Interface.agrees_cons"}
