INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingPreservation","name":"DefiKernel.Interface.agrees_transitive_extension","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (a b c : DefiKernel.Composition.QualifiedPort)\n  (state : DefiKernel.Typed.State P A D),\n  Iff\n    (@DefiKernel.Interface.Agrees P A D catalog\n      (@List.cons.{0} DefiKernel.Interface.Binding\n        (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort a b)\n        (@List.cons.{0} DefiKernel.Interface.Binding\n          (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort b c)\n          (@List.nil.{0} DefiKernel.Interface.Binding)))\n      state)\n    (@DefiKernel.Interface.Agrees P A D catalog\n      (@List.cons.{0} DefiKernel.Interface.Binding\n        (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort a b)\n        (@List.cons.{0} DefiKernel.Interface.Binding\n          (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort b c)\n          (@List.cons.{0} DefiKernel.Interface.Binding\n            (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort a c)\n            (@List.nil.{0} DefiKernel.Interface.Binding))))\n      state)","user_name":"DefiKernel.Interface.agrees_transitive_extension"}
