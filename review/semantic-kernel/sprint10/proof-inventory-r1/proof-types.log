INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingPreservation","name":"DefiKernel.Interface.edgeAgrees_self","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (name : DefiKernel.Composition.QualifiedPort)\n  (state : DefiKernel.Typed.State P A D),\n  Iff\n    (@DefiKernel.Interface.EdgeAgrees P A D catalog\n      (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort name name) state)\n    (∃ cell,\n      @Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n        (@DefiKernel.Interface.resolveExport P A D catalog name)\n        (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) cell))","user_name":"DefiKernel.Interface.edgeAgrees_self"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingPreservation","name":"DefiKernel.Interface.edgeAgrees_trans","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (a b c : DefiKernel.Composition.QualifiedPort)\n  (state : DefiKernel.Typed.State P A D),\n  @DefiKernel.Interface.EdgeAgrees P A D catalog\n      (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort a b) state →\n    @DefiKernel.Interface.EdgeAgrees P A D catalog\n        (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort b c) state →\n      @DefiKernel.Interface.EdgeAgrees P A D catalog\n        (@Prod.mk.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort a c) state","user_name":"DefiKernel.Interface.edgeAgrees_trans"}
