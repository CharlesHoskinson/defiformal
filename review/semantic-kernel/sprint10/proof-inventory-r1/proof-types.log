INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Regions","name":"DefiKernel.Interface.balanceSum_empty","statement":"∀ {P A D : Type} (domain : D) (asset : A) (state : DefiKernel.Typed.State P A D),\n  @Eq.{1} Rat\n    (@DefiKernel.Interface.balanceSum P A D\n      (@DefiKernel.Interface.Region.mk P A D domain asset\n        (@EmptyCollection.emptyCollection.{0} (Finset.{0} (DefiKernel.Typed.Cell P A D))\n          (@Finset.instEmptyCollection.{0} (DefiKernel.Typed.Cell P A D))))\n      state)\n    (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0)))","user_name":"DefiKernel.Interface.balanceSum_empty"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Preservation","name":"DefiKernel.Interface.binding_localPreserves","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (allowed : DefiKernel.Composition.Step P A D → Prop) (edges : List.{0} DefiKernel.Interface.Binding),\n  @DefiKernel.Interface.BindingObligations P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg allowed edges →\n    @DefiKernel.Interface.LocalPreserves P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg allowed\n      (@DefiKernel.Interface.Agrees P A D (@DefiKernel.Composition.Config.catalog P A D cfg) edges)","user_name":"DefiKernel.Interface.binding_localPreserves"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.bindingsHold_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (edges : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  Iff (@Eq.{1} Bool (@DefiKernel.Interface.bindingsHold P A D inst inst_1 inst_2 cfg edges state) Bool.true)\n    (And\n      (@Eq.{1} Bool\n        (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n          (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n        Bool.true)\n      (@DefiKernel.Interface.Agrees P A D (@DefiKernel.Composition.Config.catalog P A D cfg) edges state))","user_name":"DefiKernel.Interface.bindingsHold_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingPreservation","name":"DefiKernel.Interface.bindingsHold_perm","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (left right : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  @List.Perm.{0} DefiKernel.Interface.Binding left right →\n    Iff (@Eq.{1} Bool (@DefiKernel.Interface.bindingsHold P A D inst inst_1 inst_2 cfg left state) Bool.true)\n      (@Eq.{1} Bool (@DefiKernel.Interface.bindingsHold P A D inst inst_1 inst_2 cfg right state) Bool.true)","user_name":"DefiKernel.Interface.bindingsHold_perm"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingPreservation","name":"DefiKernel.Interface.bindingsHold_reverse","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (edges : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  Iff\n    (@Eq.{1} Bool\n      (@DefiKernel.Interface.bindingsHold P A D inst inst_1 inst_2 cfg\n        (@List.map.{0, 0} DefiKernel.Interface.Binding DefiKernel.Interface.Binding DefiKernel.Interface.reverseBinding\n          edges)\n        state)\n      Bool.true)\n    (@Eq.{1} Bool (@DefiKernel.Interface.bindingsHold P A D inst inst_1 inst_2 cfg edges state) Bool.true)","user_name":"DefiKernel.Interface.bindingsHold_reverse"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingResolution","name":"DefiKernel.Interface.checkBindings_error_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (edges : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D) (failure : DefiKernel.Interface.BindingFailure P A D),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkBindings P A D inst inst_1 inst_2 cfg edges state)\n      (@Except.error.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} failure))\n    (Or\n      (And\n        (@Eq.{1} Bool\n          (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n            (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n          Bool.false)\n        (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n          (@DefiKernel.Interface.BindingFailure.configuration P A D)))\n      (And\n        (@Eq.{1} Bool\n          (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n            (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n          Bool.true)\n        (∃ before edge after,\n          And\n            (@Eq.{1} (List.{0} DefiKernel.Interface.Binding) edges\n              (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding)\n                (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n                (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n                  (@List.instAppend.{0} DefiKernel.Interface.Binding))\n                before (@List.cons.{0} DefiKernel.Interface.Binding edge after)))\n            (And (@DefiKernel.Interface.Agrees P A D (@DefiKernel.Composition.Config.catalog P A D cfg) before state)\n              (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n                (@DefiKernel.Interface.checkEdge P A D inst_1 inst_2 (@DefiKernel.Composition.Config.catalog P A D cfg)\n                  edge state (@List.length.{0} DefiKernel.Interface.Binding before))\n                (@Except.error.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} failure))))))","user_name":"DefiKernel.Interface.checkBindings_error_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingResolution","name":"DefiKernel.Interface.checkBindings_first_failure","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (edges : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D) (failure : DefiKernel.Interface.BindingFailure P A D),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkBindings P A D inst inst_1 inst_2 cfg edges state)\n      (@Except.error.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} failure))\n    (Or\n      (And\n        (@Eq.{1} Bool\n          (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n            (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n          Bool.false)\n        (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n          (@DefiKernel.Interface.BindingFailure.configuration P A D)))\n      (And\n        (@Eq.{1} Bool\n          (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n            (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n          Bool.true)\n        (∃ before edge after,\n          And\n            (@Eq.{1} (List.{0} DefiKernel.Interface.Binding) edges\n              (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding)\n                (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n                (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n                  (@List.instAppend.{0} DefiKernel.Interface.Binding))\n                before (@List.cons.{0} DefiKernel.Interface.Binding edge after)))\n            (And (@DefiKernel.Interface.Agrees P A D (@DefiKernel.Composition.Config.catalog P A D cfg) before state)\n              (@DefiKernel.Interface.EdgeFailureAt P A D (@DefiKernel.Composition.Config.catalog P A D cfg) edge state\n                (@List.length.{0} DefiKernel.Interface.Binding before) failure)))))","user_name":"DefiKernel.Interface.checkBindings_first_failure"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.checkBindings_ok_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (edges : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkBindings P A D inst inst_1 inst_2 cfg edges state)\n      (@Except.ok.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} PUnit.unit.{1}))\n    (And\n      (@Eq.{1} Bool\n        (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n          (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n        Bool.true)\n      (@DefiKernel.Interface.Agrees P A D (@DefiKernel.Composition.Config.catalog P A D cfg) edges state))","user_name":"DefiKernel.Interface.checkBindings_ok_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingResolution","name":"DefiKernel.Interface.checkEdge_error_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} A] [inst_1 : DecidableEq.{1} D]\n  (catalog : DefiKernel.Composition.Catalog P A D) (edge : DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D) (index : Nat) (failure : DefiKernel.Interface.BindingFailure P A D),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkEdge P A D inst inst_1 catalog edge state index)\n      (@Except.error.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} failure))\n    (@DefiKernel.Interface.EdgeFailureAt P A D catalog edge state index failure)","user_name":"DefiKernel.Interface.checkEdge_error_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.checkEdge_ok_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} A] [inst_1 : DecidableEq.{1} D]\n  (catalog : DefiKernel.Composition.Catalog P A D) (edge : DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D) (index : Nat),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkEdge P A D inst inst_1 catalog edge state index)\n      (@Except.ok.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} PUnit.unit.{1}))\n    (@DefiKernel.Interface.EdgeAgrees P A D catalog edge state)","user_name":"DefiKernel.Interface.checkEdge_ok_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingResolution","name":"DefiKernel.Interface.checkEdgesFrom_error_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} A] [inst_1 : DecidableEq.{1} D]\n  (catalog : DefiKernel.Composition.Catalog P A D) (state : DefiKernel.Typed.State P A D) (index : Nat)\n  (edges : List.{0} DefiKernel.Interface.Binding) (failure : DefiKernel.Interface.BindingFailure P A D),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkEdgesFrom P A D inst inst_1 catalog state index edges)\n      (@Except.error.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} failure))\n    (∃ before edge after,\n      And\n        (@Eq.{1} (List.{0} DefiKernel.Interface.Binding) edges\n          (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Interface.Binding) (List.{0} DefiKernel.Interface.Binding)\n            (List.{0} DefiKernel.Interface.Binding)\n            (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Interface.Binding)\n              (@List.instAppend.{0} DefiKernel.Interface.Binding))\n            before (@List.cons.{0} DefiKernel.Interface.Binding edge after)))\n        (And (@DefiKernel.Interface.Agrees P A D catalog before state)\n          (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n            (@DefiKernel.Interface.checkEdge P A D inst inst_1 catalog edge state\n              (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) index\n                (@List.length.{0} DefiKernel.Interface.Binding before)))\n            (@Except.error.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} failure))))","user_name":"DefiKernel.Interface.checkEdgesFrom_error_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.checkEdgesFrom_ok_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} A] [inst_1 : DecidableEq.{1} D]\n  (catalog : DefiKernel.Composition.Catalog P A D) (state : DefiKernel.Typed.State P A D) (index : Nat)\n  (edges : List.{0} DefiKernel.Interface.Binding),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1})\n      (@DefiKernel.Interface.checkEdgesFrom P A D inst inst_1 catalog state index edges)\n      (@Except.ok.{0, 0} (DefiKernel.Interface.BindingFailure P A D) PUnit.{1} PUnit.unit.{1}))\n    (@DefiKernel.Interface.Agrees P A D catalog edges state)","user_name":"DefiKernel.Interface.checkEdgesFrom_ok_iff"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Accounting","name":"DefiKernel.Interface.continueRun_accounting","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  (region : DefiKernel.Interface.Region P A D) (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (entry : DefiKernel.Composition.Cursor P A D)\n  (steps : List.{0} (DefiKernel.Composition.Step P A D)),\n  @Eq.{1} Rat\n    (@DefiKernel.Interface.balanceSum P A D region\n      (@DefiKernel.Typed.ExecutionResult.state P A D\n        (@DefiKernel.Composition.Cursor.world P A D\n          (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n            steps))))\n    (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n      (@DefiKernel.Interface.balanceSum P A D region\n        (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D entry)))\n      (@DefiKernel.Interface.eventDeltaSum P A D inst inst_1 inst_2 region\n        (@List.drop.{0} (DefiKernel.Composition.Event P A D)\n          (@List.length.{0} (DefiKernel.Composition.Event P A D) (@DefiKernel.Composition.Cursor.events P A D entry))\n          (@DefiKernel.Composition.Cursor.events P A D\n            (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n              steps)))))","user_name":"DefiKernel.Interface.continueRun_accounting"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Accounting","name":"DefiKernel.Interface.continueRun_accounting_suffix","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  (region : DefiKernel.Interface.Region P A D) (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (entry : DefiKernel.Composition.Cursor P A D)\n  (steps : List.{0} (DefiKernel.Composition.Step P A D)),\n  ∃ suffix,\n    And\n      (@Eq.{1} (List.{0} (DefiKernel.Composition.Event P A D))\n        (@DefiKernel.Composition.Cursor.events P A D\n          (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n            steps))\n        (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Composition.Event P A D))\n          (List.{0} (DefiKernel.Composition.Event P A D)) (List.{0} (DefiKernel.Composition.Event P A D))\n          (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Composition.Event P A D))\n            (@List.instAppend.{0} (DefiKernel.Composition.Event P A D)))\n          (@DefiKernel.Composition.Cursor.events P A D entry) suffix))\n      (@Eq.{1} Rat\n        (@DefiKernel.Interface.balanceSum P A D region\n          (@DefiKernel.Typed.ExecutionResult.state P A D\n            (@DefiKernel.Composition.Cursor.world P A D\n              (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n                steps))))\n        (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n          (@DefiKernel.Interface.balanceSum P A D region\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D entry)))\n          (@DefiKernel.Interface.eventDeltaSum P A D inst inst_1 inst_2 region suffix)))","user_name":"DefiKernel.Interface.continueRun_accounting_suffix"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Accounting","name":"DefiKernel.Interface.continueRun_outputs_suffix","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (entry : DefiKernel.Composition.Cursor P A D)\n  (steps : List.{0} (DefiKernel.Composition.Step P A D)),\n  ∃ suffix,\n    @Eq.{1} (List.{0} (DefiKernel.Composition.OutputObservation A))\n      (@DefiKernel.Composition.Cursor.outputs P A D\n        (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry steps))\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Composition.OutputObservation A))\n        (List.{0} (DefiKernel.Composition.OutputObservation A)) (List.{0} (DefiKernel.Composition.OutputObservation A))\n        (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Composition.OutputObservation A))\n          (@List.instAppend.{0} (DefiKernel.Composition.OutputObservation A)))\n        (@DefiKernel.Composition.Cursor.outputs P A D entry) suffix)","user_name":"DefiKernel.Interface.continueRun_outputs_suffix"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Preservation","name":"DefiKernel.Interface.continueRun_preserves","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (allowed : DefiKernel.Composition.Step P A D → Prop) (invariant : DefiKernel.Typed.State P A D → Prop),\n  @DefiKernel.Interface.LocalPreserves P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg allowed invariant →\n    ∀ (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (entry : DefiKernel.Composition.Cursor P A D)\n      (steps : List.{0} (DefiKernel.Composition.Step P A D)),\n      (∀ (step : DefiKernel.Composition.Step P A D),\n          @Membership.mem.{0, 0} (DefiKernel.Composition.Step P A D) (List.{0} (DefiKernel.Composition.Step P A D))\n              (@List.instMembership.{0} (DefiKernel.Composition.Step P A D)) steps step →\n            allowed step) →\n        invariant (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D entry)) →\n          invariant\n            (@DefiKernel.Typed.ExecutionResult.state P A D\n              (@DefiKernel.Composition.Cursor.world P A D\n                (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries entry\n                  steps)))","user_name":"DefiKernel.Interface.continueRun_preserves"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingResolution","name":"DefiKernel.Interface.distinct_exports_nonalias","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (registry : DefiKernel.Typed.Registry P A D) (catalog : DefiKernel.Composition.Catalog P A D),\n  @Eq.{1} Bool (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2 registry catalog) Bool.true →\n    ∀ (left right : DefiKernel.Composition.QualifiedPort) (leftCell rightCell : DefiKernel.Typed.Cell P A D),\n      @Ne.{1} DefiKernel.Composition.QualifiedPort left right →\n        @Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n            (@DefiKernel.Interface.resolveExport P A D catalog left)\n            (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) leftCell) →\n          @Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n              (@DefiKernel.Interface.resolveExport P A D catalog right)\n              (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) rightCell) →\n            @Ne.{1} (DefiKernel.Typed.Cell P A D) leftCell rightCell","user_name":"DefiKernel.Interface.distinct_exports_nonalias"}
