erleaving.Machine.world P A D entry)))\n          (@DefiKernel.Interface.attemptDeltaSum P A D inst inst_1 inst_2 region suffix)))","user_name":"DefiKernel.Interface.interleaving_advance_accounting_suffix"}
INTERFACE_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Preservation","name":"DefiKernel.Interface.interleaving_advance_preserves","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (allowed : DefiKernel.Composition.Step P A D → Prop) (invariant : DefiKernel.Typed.State P A D → Prop),\n  @DefiKernel.Interface.LocalPreserves P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg allowed invariant →\n    ∀ (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (left right : DefiKernel.Parallel.Branch P A D),\n      (∀ (inv : DefiKernel.Composition.Invocation P A D),\n          @Membership.mem.{0, 0} (DefiKernel.Composition.Invocation P A D) (DefiKernel.Parallel.Branch P A D)\n              (@List.instMembership.{0} (DefiKernel.Composition.Invocation P A D)) left inv →\n            allowed (@DefiKernel.Composition.Step.invoke P A D inv)) →\n        (∀ (inv : DefiKernel.Composition.Invocation P A D),\n            @Membership.mem.{0, 0} (DefiKernel.Composition.Invocation P A D) (DefiKernel.Parallel.Branch P A D)\n                (@List.instMembership.{0} (DefiKernel.Composition.Invocation P A D)) right inv →\n              allowed (@DefiKernel.Composition.Step.invoke P A D inv)) →\n          ∀ (entry : DefiKernel.Interleaving.Machine P A D) (branch : DefiKernel.Parallel.BranchId),\n            invariant\n                (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D entry)) →\n              invariant\n                (@DefiKernel.Typed.ExecutionResult.state P A D\n                  (@DefiKernel.Interleaving.Machine.world P A D\n                    (@DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left\n                      r