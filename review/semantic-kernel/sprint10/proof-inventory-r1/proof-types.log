INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.Agrees.eq_1","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (edges : List.{0} DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  @Eq.{1} Prop (@DefiKernel.Interface.Agrees P A D catalog edges state)\n    (∀ (edge : DefiKernel.Interface.Binding),\n      @Membership.mem.{0, 0} DefiKernel.Interface.Binding (List.{0} DefiKernel.Interface.Binding)\n          (@List.instMembership.{0} DefiKernel.Interface.Binding) edges edge →\n        @DefiKernel.Interface.EdgeAgrees P A D catalog edge state)","user_name":"DefiKernel.Interface.Agrees.eq_1"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.Bindings","name":"DefiKernel.Interface.EdgeAgrees.eq_1","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (edge : DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D),\n  @Eq.{1} Prop (@DefiKernel.Interface.EdgeAgrees P A D catalog edge state)\n    (∃ left right,\n      And\n        (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n          (@DefiKernel.Interface.resolveExport P A D catalog\n            (@Prod.fst.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n          (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) left))\n        (And\n          (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n            (@DefiKernel.Interface.resolveExport P A D catalog\n              (@Prod.snd.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n            (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) right))\n          (And (@Eq.{1} D (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) left) (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) right))\n            (And\n              (@Eq.{1} A (@Prod.snd.{0, 0} P A (@Prod.snd.{0, 0} D (Prod.{0, 0} P A) left))\n                (@Prod.snd.{0, 0} P A (@Prod.snd.{0, 0} D (Prod.{0, 0} P A) right)))\n              (@Eq.{1} Rat (@DefiKernel.Typed.State.balance P A D state left)\n                (@DefiKernel.Typed.State.balance P A D state right))))))","user_name":"DefiKernel.Interface.EdgeAgrees.eq_1"}
INTERFACE_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Interface.BindingResolution","name":"DefiKernel.Interface.EdgeFailureAt.eq_1","statement":"∀ {P A D : Type} (catalog : DefiKernel.Composition.Catalog P A D) (edge : DefiKernel.Interface.Binding)\n  (state : DefiKernel.Typed.State P A D) (index : Nat) (failure : DefiKernel.Interface.BindingFailure P A D),\n  @Eq.{1} Prop (@DefiKernel.Interface.EdgeFailureAt P A D catalog edge state index failure)\n    (Or\n      (∃ reason,\n        And\n          (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n            (@DefiKernel.Interface.resolveExport P A D catalog\n              (@Prod.fst.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n            (@Except.error.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) reason))\n          (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n            (@DefiKernel.Interface.BindingFailure.endpoint P A D index DefiKernel.Interface.EndpointSide.left reason)))\n      (Or\n        (∃ left reason,\n          And\n            (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n              (@DefiKernel.Interface.resolveExport P A D catalog\n                (@Prod.fst.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n              (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) left))\n            (And\n              (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n                (@DefiKernel.Interface.resolveExport P A D catalog\n                  (@Prod.snd.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n                (@Except.error.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) reason))\n              (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n                (@DefiKernel.Interface.BindingFailure.endpoint P A D index DefiKernel.Interface.EndpointSide.right\n                  reason))))\n        (∃ left right,\n          And\n            (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n              (@DefiKernel.Interface.resolveExport P A D catalog\n                (@Prod.fst.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n              (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) left))\n            (And\n              (@Eq.{1} (Except.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D))\n                (@DefiKernel.Interface.resolveExport P A D catalog\n                  (@Prod.snd.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort edge))\n                (@Except.ok.{0, 0} DefiKernel.Interface.EndpointFailure (DefiKernel.Typed.Cell P A D) right))\n              (Or\n                (And\n                  (@Ne.{1} D (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) left) (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) right))\n                  (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n                    (@DefiKernel.Interface.BindingFailure.domainMismatch P A D index left right)))\n                (Or\n                  (And\n                    (@Eq.{1} D (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) left) (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) right))\n                    (And\n                      (@Ne.{1} A (@Prod.snd.{0, 0} P A (@Prod.snd.{0, 0} D (Prod.{0, 0} P A) left))\n                        (@Prod.snd.{0, 0} P A (@Prod.snd.{0, 0} D (Prod.{0, 0} P A) right)))\n                      (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n                        (@DefiKernel.Interface.BindingFailure.assetMismatch P A D index left right))))\n                  (And\n                    (@Eq.{1} D (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) left) (@Prod.fst.{0, 0} D (Prod.{0, 0} P A) right))\n                    (And\n                      (@Eq.{1} A (@Prod.snd.{0, 0} P A (@Prod.snd.{0, 0} D (Prod.{0, 0} P A) left))\n                        (@Prod.snd.{0, 0} P A (@Prod.snd.{0, 0} D (Prod.{0, 0} P A) right)))\n                      (And\n                        (@Ne.{1} Rat (@DefiKernel.Typed.State.balance P A D state left)\n                          (@DefiKernel.Typed.State.balance P A D state right))\n                        (@Eq.{1} (DefiKernel.Interface.BindingFailure P A D) failure\n                          (@DefiKernel.Interface.BindingFailure.unequal P A D index\n                            (@Prod.fst.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort\n                              edge)\n                            (@Prod.snd.{0, 0} DefiKernel.Composition.QualifiedPort DefiKernel.Composition.QualifiedPort\n                              edge)\n                            (@DefiKernel.Typed.State.balance P A D state left)\n                            (@DefiKernel.Typed.State.balance P A D state right))))))))))))","user_name":"DefiKernel.Interface.EdgeFailureAt.eq_1"}
