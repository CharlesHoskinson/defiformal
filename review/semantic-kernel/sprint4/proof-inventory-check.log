DefiKernel.Typed.Acceptance.reference_invocation_authority (store : DefiKernel.Typed.Examples.Store)
  (ctx : DefiKernel.Typed.InvocationContext DefiKernel.Typed.Examples.Party DefiKernel.Typed.Examples.Domain)
  (env : DefiKernel.Typed.Environment DefiKernel.Typed.Examples.Asset DefiKernel.Typed.Examples.Domain) (now : ℕ)
  (request : DefiKernel.Typed.Examples.Call) (state : DefiKernel.Typed.Examples.Ledger)
  (post : DefiKernel.Typed.Examples.Result)
  (h : DefiKernel.Typed.execute DefiKernel.Typed.Examples.registry store ctx env now request state = Except.ok post) :
  ∃ id ∈ request.capabilityIds,
    ∃ cap,
      DefiKernel.Typed.CapabilityStore.lookup store id = some cap ∧
        cap.live = true ∧
          cap.holder = ctx.principal ∧
            cap.domain = ctx.domain ∧ cap.operation = request.operation ∧ cap.right = DefiKernel.Typed.Right.invoke
DefiKernel.Typed.Acceptance.reference_capabilities_preserved (store : DefiKernel.Typed.Examples.Store)
  (ctx : DefiKernel.Typed.InvocationContext DefiKernel.Typed.Examples.Party DefiKernel.Typed.Examples.Domain)
  (env : DefiKernel.Typed.Environment DefiKernel.Typed.Examples.Asset DefiKernel.Typed.Examples.Domain) (now : ℕ)
  (request : DefiKernel.Typed.Examples.Call) (state : DefiKernel.Typed.Examples.Ledger)
  (post : DefiKernel.Typed.Examples.Result)
  (h : DefiKernel.Typed.execute DefiKernel.Typed.Examples.registry store ctx env now request state = Except.ok post) :
  post.capabilities = store
