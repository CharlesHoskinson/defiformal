{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Nary.Schedule",
    "DefiKernel.Nary.Execution",
    "DefiKernel.Nary.Observation",
    "DefiKernel.Nary.CausalRuntime",
    "DefiKernel.Nary.Examples",
    "DefiKernel.Nary.Tests",
    "DefiKernel.Nary.Audit"
  ],
  "mutations": [
    {
      "name": "m15-replay-last-on-skip",
      "module": "DefiKernel.Nary.CausalRuntime",
      "needle": "let appended := post.attempts[pre.attempts.length]?",
      "replacement": "let appended := post.attempts.getLast?",
      "required_false": [
        "nary.monitor.skip_no_replay"
      ]
    }
  ],
  "positive_checks": [
    "nary.monitor.actual_producer"
  ]
}
