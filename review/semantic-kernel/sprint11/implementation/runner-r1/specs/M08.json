{
  "schema_version": 1,
  "modules": [
    "DefiKernel.Nary.Schedule",
    "DefiKernel.Nary.Execution",
    "DefiKernel.Nary.Observation",
    "DefiKernel.Nary.CausalRuntime",
    "DefiKernel.Nary.Examples",
    "DefiKernel.Nary.Tests",
    "DefiKernel.Nary.Audit"
  ],
  "mutations": [
    {
      "name": "m08-halt-peers-on-error",
      "module": "DefiKernel.Nary.Execution",
      "needle": "if own.failure.isSome then m.skip b",
      "replacement": "if own.failure.isSome || m.attempts.any failedAttempt then m.skip b",
      "required_false": [
        "nary.refusal.peer_continues"
      ]
    }
  ],
  "positive_checks": [
    "nary.no_failure.exact"
  ]
}
