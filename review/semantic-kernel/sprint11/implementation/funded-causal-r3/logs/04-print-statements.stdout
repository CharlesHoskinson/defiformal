theorem DefiKernel.Nary.FundedCausal.f10_reachable_empty_outputs : ∀ {m : DefiKernel.Nary.Examples.M3},
  DefiKernel.Nary.Reachable DefiKernel.Nary.Examples.f10Cfg DefiKernel.Nary.Examples.f10Bounds
      DefiKernel.Nary.Examples.f10Branches DefiKernel.Nary.Examples.f10Initial m →
    ∀ (b : Fin 3), (m.locals b).nextIndex = 0 → (m.locals b).outputs = [] :=
fun {m} h =>
  DefiKernel.Nary.Reachable.rec (motive := fun {m} h =>
    ∀ (b : Fin 3), (m.locals b).nextIndex = 0 → (m.locals b).outputs = []) (fun b hidx => of_eq_true (eq_self []))
    (fun {pre post} sel previous step ih own hidx =>
      DefiKernel.Nary.AdvanceSound.casesOn (motive := fun a t => post = a → step ≍ t → (post.locals own).outputs = [])
        step
        (fun failure failed h =>
          Eq.ndrec (motive := fun {post} =>
            ∀
              (step :
                DefiKernel.Nary.AdvanceSound DefiKernel.Nary.Examples.f10Cfg DefiKernel.Nary.Examples.f10Bounds
                  DefiKernel.Nary.Examples.f10Branches pre sel post),
              (post.locals own).nextIndex = 0 →
                step ≍ DefiKernel.Nary.AdvanceSound.halted failure failed → (post.locals own).outputs = [])
            (fun step hidx h =>
              Eq.mpr (id (congrArg (fun _a => _a = []) (DefiKernel.Nary.FundedCausal.skip_outputs pre sel own)))
                (ih own
                  (Eq.mp (congrArg (fun _a => _a = 0) (DefiKernel.Nary.FundedCausal.skip_nextIndex pre sel own)) hidx)))
            (Eq.symm h) step hidx)
        (fun active absent h =>
          Eq.ndrec (motive := fun {post} =>
            ∀
              (step :
                DefiKernel.Nary.AdvanceSound DefiKernel.Nary.Examples.f10Cfg DefiKernel.Nary.Examples.f10Bounds
                  DefiKernel.Nary.Examples.f10Branches pre sel post),
              (post.locals own).nextIndex = 0 →
                step ≍ DefiKernel.Nary.AdvanceSound.exhausted active absent → (post.locals own).outputs = [])
            (fun step hidx h =>
              Eq.mpr (id (congrArg (fun _a => _a = []) (DefiKernel.Nary.FundedCausal.skip_outputs pre sel own)))
                (ih own
                  (Eq.mp (congrArg (fun _a => _a = 0) (DefiKernel.Nary.FundedCausal.skip_nextIndex pre sel own)) hidx)))
            (Eq.symm h) step hidx)
        (fun inv reason active selected rejected h =>
          Eq.ndrec (motive := fun {post} =>
            ∀
              (step :
                DefiKernel.Nary.AdvanceSound DefiKernel.Nary.Examples.f10Cfg DefiKernel.Nary.Examples.f10Bounds
                  DefiKernel.Nary.Examples.f10Branches pre sel post),
              (post.locals own).nextIndex = 0 →
                step ≍ DefiKernel.Nary.AdvanceSound.refused inv reason active selected rejected →
                  (post.locals own).outputs = [])
            (fun step hidx h =>
              Eq.mpr
                (id (congrArg (fun _a => _a = []) (DefiKernel.Nary.FundedCausal.refuse_outputs pre sel own inv reason)))
                (ih own
                  (Eq.mp
                    (congrArg (fun _a => _a = 0) (DefiKernel.Nary.FundedCausal.refuse_nextIndex pre sel own inv reason))
                    hidx)))
            (Eq.symm h) step hidx)
        (fun inv result active selected executed h =>
          Eq.ndrec (motive := fun {post} =>
            ∀
              (step :
                DefiKernel.Nary.AdvanceSound DefiKernel.Nary.Examples.f10Cfg DefiKernel.Nary.Examples.f10Bounds
                  DefiKernel.Nary.Examples.f10Branches pre sel post),
              (post.locals own).nextIndex = 0 →
                step ≍ DefiKernel.Nary.AdvanceSound.accepted inv result active selected executed →
                  (post.locals own).outputs = [])
            (fun step hidx h =>
              if ho : own = sel then
                Eq.ndrec (motive := fun own =>
                  ((pre.accept sel inv result).locals own).nextIndex = 0 →
                    ((pre.accept sel inv result).locals own).outputs = [])
                  (fun hidx =>
                    Decidable.byContradiction fun a =>
                      DefiKernel.Nary.FundedCausal.f10_reachable_empty_outputs._proof_1_1 sel
                        (Eq.mp
                          (congrArg (fun _a => _a = 0)
                            (DefiKernel.Nary.FundedCausal.accept_nextIndex_sel pre sel inv result))
                          hidx))
                  (Eq.symm ho) hidx
              else
                Eq.mpr
                  (id
                    (congrArg (fun _a => _a = [])
                      (DefiKernel.Nary.FundedCausal.accept_outputs_away pre sel own inv result ho)))
                  (ih own
                    (Eq.mp
                      (congrArg (fun _a => _a = 0)
                        (DefiKernel.Nary.FundedCausal.accept_nextIndex_away pre sel own inv result ho))
                      hidx)))
            (Eq.symm h) step hidx)
        (Eq.refl post) (HEq.refl step))
    h
theorem DefiKernel.Nary.FundedCausal.f10_live_selected_enabled_details : ∀ {q : DefiKernel.Nary.Examples.ReservePhase}
  {m : DefiKernel.Nary.Examples.M3} {b : Fin 3}
  {inv :
    DefiKernel.Composition.Invocation DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A DefiKernel.Nary.Examples.D},
  DefiKernel.Nary.FundedCausal.FundedK q m →
    (m.locals b).failure = none →
      (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
        ∃ result,
          DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
                (DefiKernel.Nary.Examples.f10Bounds b (m.locals b).nextIndex) (m.locals b).nextIndex
                (m.locals b).outputs (DefiKernel.Composition.Step.invoke inv) m.world =
              Except.ok result ∧
            result.world.capabilities = DefiKernel.Nary.Examples.f10Store ∧
              ((b = 0 ∧
                  inv = DefiKernel.Nary.Examples.inv200 ∧
                    result.receipt = DefiKernel.Nary.Examples.rec200 ∧
                      result.outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                        ∀
                          (c :
                            DefiKernel.Typed.Cell DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A
                              DefiKernel.Nary.Examples.D),
                          result.world.state.balance c = m.world.state.balance c) ∨
                (b = 0 ∧
                    inv = DefiKernel.Nary.Examples.inv201 ∧
                      result.receipt = DefiKernel.Nary.Examples.rec201 ∧
                        result.outputs = [] ∧
                          result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                              m.world.state.balance DefiKernel.Nary.Examples.vaultC + -6 ∧
                            result.world.state.balance DefiKernel.Nary.Examples.recipientC =
                                m.world.state.balance DefiKernel.Nary.Examples.recipientC + 6 ∧
                              ∀ (c : DefiKernel.Nary.Examples.C),
                                c ≠ DefiKernel.Nary.Examples.vaultC →
                                  c ≠ DefiKernel.Nary.Examples.recipientC →
                                    result.world.state.balance c = m.world.state.balance c) ∨
                  (b = 1 ∧
                      inv = DefiKernel.Nary.Examples.inv202 ∧
                        result.receipt = DefiKernel.Nary.Examples.rec202 ∧
                          result.outputs = [] ∧
                            result.world.state.balance DefiKernel.Nary.Examples.donor1C =
                                m.world.state.balance DefiKernel.Nary.Examples.donor1C + -1 ∧
                              result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                  m.world.state.balance DefiKernel.Nary.Examples.vaultC + 1 ∧
                                ∀ (c : DefiKernel.Nary.Examples.C),
                                  c ≠ DefiKernel.Nary.Examples.donor1C →
                                    c ≠ DefiKernel.Nary.Examples.vaultC →
                                      result.world.state.balance c = m.world.state.balance c) ∨
                    b = 2 ∧
                      inv = DefiKernel.Nary.Examples.inv203 ∧
                        result.receipt = DefiKernel.Nary.Examples.rec203 ∧
                          result.outputs = [] ∧
                            result.world.state.balance DefiKernel.Nary.Examples.donor2C =
                                m.world.state.balance DefiKernel.Nary.Examples.donor2C + -2 ∧
                              result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                  m.world.state.balance DefiKernel.Nary.Examples.vaultC + 2 ∧
                                ∀ (c : DefiKernel.Nary.Examples.C),
                                  c ≠ DefiKernel.Nary.Examples.donor2C →
                                    c ≠ DefiKernel.Nary.Examples.vaultC →
                                      result.world.state.balance c = m.world.state.balance c) :=
fun {q} {m} {b} {inv} hk hf hs =>
  have hstore := DefiKernel.Nary.FundedCausal.f10_store_preserved hk;
  have hbudget := DefiKernel.Nary.FundedCausal.f10_budget_initialized hk;
  Or.casesOn (DefiKernel.Nary.FundedCausal.f10_selected_guards hk hf hs)
    (fun hprod =>
      And.casesOn hprod fun hb right =>
        And.casesOn right fun hinv right =>
          And.casesOn right fun hn0 hout =>
            Eq.ndrec (motive := fun {b} =>
              (m.locals b).failure = none →
                (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
                  ∃ result,
                    DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
                          (DefiKernel.Nary.Examples.f10Bounds b (m.locals b).nextIndex) (m.locals b).nextIndex
                          (m.locals b).outputs (DefiKernel.Composition.Step.invoke inv) m.world =
                        Except.ok result ∧
                      result.world.capabilities = DefiKernel.Nary.Examples.f10Store ∧
                        ((b = 0 ∧
                            inv = DefiKernel.Nary.Examples.inv200 ∧
                              result.receipt = DefiKernel.Nary.Examples.rec200 ∧
                                result.outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                                  ∀
                                    (c :
                                      DefiKernel.Typed.Cell DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A
                                        DefiKernel.Nary.Examples.D),
                                    result.world.state.balance c = m.world.state.balance c) ∨
                          (b = 0 ∧
                              inv = DefiKernel.Nary.Examples.inv201 ∧
                                result.receipt = DefiKernel.Nary.Examples.rec201 ∧
                                  result.outputs = [] ∧
                                    result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                        m.world.state.balance DefiKernel.Nary.Examples.vaultC + -6 ∧
                                      result.world.state.balance DefiKernel.Nary.Examples.recipientC =
                                          m.world.state.balance DefiKernel.Nary.Examples.recipientC + 6 ∧
                                        ∀ (c : DefiKernel.Nary.Examples.C),
                                          c ≠ DefiKernel.Nary.Examples.vaultC →
                                            c ≠ DefiKernel.Nary.Examples.recipientC →
                                              result.world.state.balance c = m.world.state.balance c) ∨
                            (b = 1 ∧
                                inv = DefiKernel.Nary.Examples.inv202 ∧
                                  result.receipt = DefiKernel.Nary.Examples.rec202 ∧
                                    result.outputs = [] ∧
                                      result.world.state.balance DefiKernel.Nary.Examples.donor1C =
                                          m.world.state.balance DefiKernel.Nary.Examples.donor1C + -1 ∧
                                        result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                            m.world.state.balance DefiKernel.Nary.Examples.vaultC + 1 ∧
                                          ∀ (c : DefiKernel.Nary.Examples.C),
                                            c ≠ DefiKernel.Nary.Examples.donor1C →
                                              c ≠ DefiKernel.Nary.Examples.vaultC →
                                                result.world.state.balance c = m.world.state.balance c) ∨
                              b = 2 ∧
                                inv = DefiKernel.Nary.Examples.inv203 ∧
                                  result.receipt = DefiKernel.Nary.Examples.rec203 ∧
                                    result.outputs = [] ∧
                                      result.world.state.balance DefiKernel.Nary.Examples.donor2C =
                                          m.world.state.balance DefiKernel.Nary.Examples.donor2C + -2 ∧
                                        result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                            m.world.state.balance DefiKernel.Nary.Examples.vaultC + 2 ∧
                                          ∀ (c : DefiKernel.Nary.Examples.C),
                                            c ≠ DefiKernel.Nary.Examples.donor2C →
                                              c ≠ DefiKernel.Nary.Examples.vaultC →
                                                result.world.state.balance c = m.world.state.balance c))
              (fun hf hs =>
                Eq.ndrec (motive := fun {inv} =>
                  (DefiKernel.Nary.Examples.f10Branches 0)[(m.locals 0).consumed]? = some inv →
                    ∃ result,
                      DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
                            (DefiKernel.Nary.Examples.f10Bounds 0 (m.locals 0).nextIndex) (m.locals 0).nextIndex
                            (m.locals 0).outputs (DefiKernel.Composition.Step.invoke inv) m.world =
                          Except.ok result ∧
                        result.world.capabilities = DefiKernel.Nary.Examples.f10Store ∧
                          ((0 = 0 ∧
                              inv = DefiKernel.Nary.Examples.inv200 ∧
                                result.receipt = DefiKernel.Nary.Examples.rec200 ∧
                                  result.outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                                    ∀
                                      (c :
                                        DefiKernel.Typed.Cell DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A
                                          DefiKernel.Nary.Examples.D),
                                      result.world.state.balance c = m.world.state.balance c) ∨
                            (0 = 0 ∧
                                inv = DefiKernel.Nary.Examples.inv201 ∧
                                  result.receipt = DefiKernel.Nary.Examples.rec201 ∧
                                    result.outputs = [] ∧
                                      result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                          m.world.state.balance DefiKernel.Nary.Examples.vaultC + -6 ∧
                                        result.world.state.balance DefiKernel.Nary.Examples.recipientC =
                                            m.world.state.balance DefiKernel.Nary.Examples.recipientC + 6 ∧
                                          ∀ (c : DefiKernel.Nary.Examples.C),
                                            c ≠ DefiKernel.Nary.Examples.vaultC →
                                              c ≠ DefiKernel.Nary.Examples.recipientC →
                                                result.world.state.balance c = m.world.state.balance c) ∨
                              (0 = 1 ∧
                                  inv = DefiKernel.Nary.Examples.inv202 ∧
                                    result.receipt = DefiKernel.Nary.Examples.rec202 ∧
                                      result.outputs = [] ∧
                                        result.world.state.balance DefiKernel.Nary.Examples.donor1C =
                                            m.world.state.balance DefiKernel.Nary.Examples.donor1C + -1 ∧
                                          result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                              m.world.state.balance DefiKernel.Nary.Examples.vaultC + 1 ∧
                                            ∀ (c : DefiKernel.Nary.Examples.C),
                                              c ≠ DefiKernel.Nary.Examples.donor1C →
                                                c ≠ DefiKernel.Nary.Examples.vaultC →
                                                  result.world.state.balance c = m.world.state.balance c) ∨
                                0 = 2 ∧
                                  inv = DefiKernel.Nary.Examples.inv203 ∧
                                    result.receipt = DefiKernel.Nary.Examples.rec203 ∧
                                      result.outputs = [] ∧
                                        result.world.state.balance DefiKernel.Nary.Examples.donor2C =
                                            m.world.state.balance DefiKernel.Nary.Examples.donor2C + -2 ∧
                                          result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                              m.world.state.balance DefiKernel.Nary.Examples.vaultC + 2 ∧
                                            ∀ (c : DefiKernel.Nary.Examples.C),
                                              c ≠ DefiKernel.Nary.Examples.donor2C →
                                                c ≠ DefiKernel.Nary.Examples.vaultC →
                                                  result.world.state.balance c = m.world.state.balance c))
                  (fun hs =>
                    Exists.casesOn (DefiKernel.Nary.FundedEnabledness.f10_producer_enabled m.world hstore hbudget)
                      fun result h =>
                      And.casesOn h fun hstep right =>
                        And.casesOn right fun hrec right =>
                          And.casesOn right fun houts right =>
                            And.casesOn right fun hcap hbal =>
                              Exists.intro result
                                ⟨Eq.mpr
                                    (id
                                      (congrFun'
                                        (congrArg Eq
                                          (congrFun'
                                            (congrFun'
                                              (congr
                                                (congr
                                                  (congrArg
                                                    (DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg)
                                                    (congrArg (DefiKernel.Nary.Examples.f10Bounds 0) hn0))
                                                  hn0)
                                                hout)
                                              (DefiKernel.Composition.Step.invoke DefiKernel.Nary.Examples.inv200))
                                            m.world))
                                        (Except.ok result)))
                                    hstep,
                                  ⟨hcap, Or.inl ⟨rfl, ⟨rfl, ⟨hrec, ⟨houts, hbal⟩⟩⟩⟩⟩⟩)
                  (Eq.symm hinv) hs)
              (Eq.symm hb) hf hs)
    fun h =>
    Or.casesOn h
      (fun hcons =>
        And.casesOn hcons fun hb right =>
          And.casesOn right fun hinv right =>
            And.casesOn right fun hn0 right =>
              And.casesOn right fun hout hvault =>
                Eq.ndrec (motive := fun {b} =>
                  (m.locals b).failure = none →
                    (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
                      ∃ result,
                        DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
                              (DefiKernel.Nary.Examples.f10Bounds b (m.locals b).nextIndex) (m.locals b).nextIndex
                              (m.locals b).outputs (DefiKernel.Composition.Step.invoke inv) m.world =
                            Except.ok result ∧
                          result.world.capabilities = DefiKernel.Nary.Examples.f10Store ∧
                            ((b = 0 ∧
                                inv = DefiKernel.Nary.Examples.inv200 ∧
                                  result.receipt = DefiKernel.Nary.Examples.rec200 ∧
                                    result.outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                                      ∀
                                        (c :
                                          DefiKernel.Typed.Cell DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A
                                            DefiKernel.Nary.Examples.D),
                                        result.world.state.balance c = m.world.state.balance c) ∨
                              (b = 0 ∧
                                  inv = DefiKernel.Nary.Examples.inv201 ∧
                                    result.receipt = DefiKernel.Nary.Examples.rec201 ∧
                                      result.outputs = [] ∧
                                        result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                            m.world.state.balance DefiKernel.Nary.Examples.vaultC + -6 ∧
                                          result.world.state.balance DefiKernel.Nary.Examples.recipientC =
                                              m.world.state.balance DefiKernel.Nary.Examples.recipientC + 6 ∧
                                            ∀ (c : DefiKernel.Nary.Examples.C),
                                              c ≠ DefiKernel.Nary.Examples.vaultC →
                                                c ≠ DefiKernel.Nary.Examples.recipientC →
                                                  result.world.state.balance c = m.world.state.balance c) ∨
                                (b = 1 ∧
                                    inv = DefiKernel.Nary.Examples.inv202 ∧
                                      result.receipt = DefiKernel.Nary.Examples.rec202 ∧
                                        result.outputs = [] ∧
                                          result.world.state.balance DefiKernel.Nary.Examples.donor1C =
                                              m.world.state.balance DefiKernel.Nary.Examples.donor1C + -1 ∧
                                            result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                                m.world.state.balance DefiKernel.Nary.Examples.vaultC + 1 ∧
                                              ∀ (c : DefiKernel.Nary.Examples.C),
                                                c ≠ DefiKernel.Nary.Examples.donor1C →
                                                  c ≠ DefiKernel.Nary.Examples.vaultC →
                                                    result.world.state.balance c = m.world.state.balance c) ∨
                                  b = 2 ∧
                                    inv = DefiKernel.Nary.Examples.inv203 ∧
                                      result.receipt = DefiKernel.Nary.Examples.rec203 ∧
                                        result.outputs = [] ∧
                                          result.world.state.balance DefiKernel.Nary.Examples.donor2C =
                                              m.world.state.balance DefiKernel.Nary.Examples.donor2C + -2 ∧
                                            result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                                m.world.state.balance DefiKernel.Nary.Examples.vaultC + 2 ∧
                                              ∀ (c : DefiKernel.Nary.Examples.C),
                                                c ≠ DefiKernel.Nary.Examples.donor2C →
                                                  c ≠ DefiKernel.Nary.Examples.vaultC →
                                                    result.world.state.balance c = m.world.state.balance c))
                  (fun hf hs =>
                    Eq.ndrec (motive := fun {inv} =>
                      (DefiKernel.Nary.Examples.f10Branches 0)[(m.locals 0).consumed]? = some inv →
                        ∃ result,
                          DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
                                (DefiKernel.Nary.Examples.f10Bounds 0 (m.locals 0).nextIndex) (m.locals 0).nextIndex
                                (m.locals 0).outputs (DefiKernel.Composition.Step.invoke inv) m.world =
                              Except.ok result ∧
                            result.world.capabilities = DefiKernel.Nary.Examples.f10Store ∧
                              ((0 = 0 ∧
                                  inv = DefiKernel.Nary.Examples.inv200 ∧
                                    result.receipt = DefiKernel.Nary.Examples.rec200 ∧
                                      result.outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                                        ∀
                                          (c :
                                            DefiKernel.Typed.Cell DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A
                                              DefiKernel.Nary.Examples.D),
                                          result.world.state.balance c = m.world.state.balance c) ∨
                                (0 = 0 ∧
                                    inv = DefiKernel.Nary.Examples.inv201 ∧
                                      result.receipt = DefiKernel.Nary.Examples.rec201 ∧
                                        result.outputs = [] ∧
                                          result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                              m.world.state.balance DefiKernel.Nary.Examples.vaultC + -6 ∧
                                            result.world.state.balance DefiKernel.Nary.Examples.recipientC =
                                                m.world.state.balance DefiKernel.Nary.Examples.recipientC + 6 ∧
                                              ∀ (c : DefiKernel.Nary.Examples.C),
                                                c ≠ DefiKernel.Nary.Examples.vaultC →
                                                  c ≠ DefiKernel.Nary.Examples.recipientC →
                                                    result.world.state.balance c = m.world.state.balance c) ∨
                                  (0 = 1 ∧
                                      inv = DefiKernel.Nary.Examples.inv202 ∧
                                        result.receipt = DefiKernel.Nary.Examples.rec202 ∧
                                          result.outputs = [] ∧
                                            result.world.state.balance DefiKernel.Nary.Examples.donor1C =
                                                m.world.state.balance DefiKernel.Nary.Examples.donor1C + -1 ∧
                                              result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                                  m.world.state.balance DefiKernel.Nary.Examples.vaultC + 1 ∧
                                                ∀ (c : DefiKernel.Nary.Examples.C),
                                                  c ≠ DefiKernel.Nary.Examples.donor1C →
                                                    c ≠ DefiKernel.Nary.Examples.vaultC →
                                                      result.world.state.balance c = m.world.state.balance c) ∨
                                    0 = 2 ∧
                                      inv = DefiKernel.Nary.Examples.inv203 ∧
                                        result.receipt = DefiKernel.Nary.Examples.rec203 ∧
                                          result.outputs = [] ∧
                                            result.world.state.balance DefiKernel.Nary.Examples.donor2C =
                                                m.world.state.balance DefiKernel.Nary.Examples.donor2C + -2 ∧
                                              result.world.state.balance DefiKernel.Nary.Examples.vaultC =
                                                  m.world.state.balance DefiKernel.Nary.Examples.vaultC + 2 ∧
                                                ∀ (c : DefiKernel.Nary.Examples.C),
                                                  c ≠ DefiKernel.Nary.Examples.donor2C →
                                                    c ≠ DefiKernel.Nary.Examples.vaultC →
                                                      result.world.state.balance c = m.world.state.balance c))
                      (fun hs =>
                        Exists.casesOn (DefiKernel.Nary.FundedEnabledness.f10_consumer_enabled m.world hstore hvault)
                          fun result h =>
                          And.casesOn h fun hstep right =>
                            And.casesOn right fun hrec right =>
                              And.casesOn right fun houts right =>
                                And.casesOn right fun hcap right =>
                                  And.casesOn right fun hv right =>
                                    And.casesOn right fun hr hfr =>
                                      Exists.intro result
                                        ⟨Eq.mpr
                                            (id
                                              (congrFun'
                                                (congrArg Eq
                                                  (congrFun'
                                                    (congrFun'
                                                      (congr
                                                        (congr
                                                          (congrArg
                                                            (DefiKernel.Composition.executeStep
                                                              DefiKernel.Nary.Examples.f10Cfg)
                                                            (congrArg (DefiKernel.Nary.Examples.f10Bounds 0) hn0))
                                                          hn0)
                                                        hout)
                                                      (DefiKernel.Composition.Step.invoke
