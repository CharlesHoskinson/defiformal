theorem DefiKernel.Nary.FundedCausal.f10_live_selected_enabled : ∀ {q : DefiKernel.Nary.Examples.ReservePhase}
  {m : DefiKernel.Nary.Examples.M3} {b : Fin 3}
  {inv :
    DefiKernel.Composition.Invocation DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A DefiKernel.Nary.Examples.D},
  DefiKernel.Nary.FundedCausal.FundedK q m →
    (m.locals b).failure = none →
      (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
        ∃ result,
          DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
              (DefiKernel.Nary.Examples.f10Bounds b (m.locals b).nextIndex) (m.locals b).nextIndex (m.locals b).outputs
              (DefiKernel.Composition.Step.invoke inv) m.world =
            Except.ok result :=
fun {q} {m} {b} {inv} hk hf hs =>
  Exists.casesOn (DefiKernel.Nary.FundedCausal.f10_live_selected_enabled_details hk hf hs) fun result h =>
    And.casesOn h fun hstep right => Exists.intro result hstep
theorem DefiKernel.Nary.FundedCausal.f10_initialized_prefix_enabled : ∀ (schedule : DefiKernel.Nary.Schedule (Fin 3))
  (n : ℕ) {b : Fin 3}
  {inv :
    DefiKernel.Composition.Invocation DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A DefiKernel.Nary.Examples.D},
  have m :=
    (DefiKernel.Nary.continueMonitored DefiKernel.Nary.Examples.f10Cfg DefiKernel.Nary.Examples.f10Bounds
        DefiKernel.Nary.Examples.f10Branches DefiKernel.Nary.Examples.reserveUpdate
        (DefiKernel.Nary.Examples.ReservePhase.awaiting, DefiKernel.Nary.start DefiKernel.Nary.Examples.f10Initial)
        (List.take n schedule)).2;
  (m.locals b).failure = none →
    (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
      ∃ result,
        DefiKernel.Composition.executeStep DefiKernel.Nary.Examples.f10Cfg
            (DefiKernel.Nary.Examples.f10Bounds b (m.locals b).nextIndex) (m.locals b).nextIndex (m.locals b).outputs
            (DefiKernel.Composition.Step.invoke inv) m.world =
          Except.ok result :=
fun schedule n {b} {inv} hf hs =>
  DefiKernel.Nary.FundedCausal.f10_live_selected_enabled
    (DefiKernel.Nary.FundedCausal.f10_monitored_initialized (List.take n schedule)).left hf hs
theorem DefiKernel.Nary.FundedCausal.f10_selected_guards : ∀ {q : DefiKernel.Nary.Examples.ReservePhase}
  {m : DefiKernel.Nary.Examples.M3} {b : Fin 3}
  {inv :
    DefiKernel.Composition.Invocation DefiKernel.Nary.Examples.P DefiKernel.Nary.Examples.A DefiKernel.Nary.Examples.D},
  DefiKernel.Nary.FundedCausal.FundedK q m →
    (m.locals b).failure = none →
      (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
        b = 0 ∧ inv = DefiKernel.Nary.Examples.inv200 ∧ (m.locals 0).nextIndex = 0 ∧ (m.locals 0).outputs = [] ∨
          b = 0 ∧
              inv = DefiKernel.Nary.Examples.inv201 ∧
                (m.locals 0).nextIndex = 1 ∧
                  (m.locals 0).outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                    6 ≤ m.world.state.balance DefiKernel.Nary.Examples.vaultC ∨
            b = 1 ∧
                inv = DefiKernel.Nary.Examples.inv202 ∧
                  (m.locals 1).nextIndex = 0 ∧ 1 ≤ m.world.state.balance DefiKernel.Nary.Examples.donor1C ∨
              b = 2 ∧
                inv = DefiKernel.Nary.Examples.inv203 ∧
                  (m.locals 2).nextIndex = 0 ∧ 2 ≤ m.world.state.balance DefiKernel.Nary.Examples.donor2C :=
fun {q} {m} {b} {inv} hk hf hs =>
  have hA :=
    DefiKernel.Nary.FundedCausal.f10_assumption_derivation q m b hk
      (DefiKernel.Nary.FundedCausal.f10_present_external q m b hk);
  have hsel := DefiKernel.Nary.FundedCausal.f10_selected_cases (hA.left hf) hs;
  Or.casesOn hsel.right
    (fun h =>
      And.casesOn h fun hb0 hop =>
        Eq.ndrec (motive := fun {b} =>
          (m.locals b).failure = none →
            (DefiKernel.Nary.Examples.f10Branches b)[(m.locals b).consumed]? = some inv →
              DefiKernel.Nary.FundedCausal.fundedAssumption b q m →
                (m.locals b).nextIndex = (m.locals b).consumed ∧
                    (b = 0 ∧
                        ((m.locals 0).nextIndex = 0 ∧ inv = DefiKernel.Nary.Examples.inv200 ∨
                          (m.locals 0).nextIndex = 1 ∧ inv = DefiKernel.Nary.Examples.inv201) ∨
                      b = 1 ∧ (m.locals 1).nextIndex = 0 ∧ inv = DefiKernel.Nary.Examples.inv202 ∨
                        b = 2 ∧ (m.locals 2).nextIndex = 0 ∧ inv = DefiKernel.Nary.Examples.inv203) →
                  b = 0 ∧
                      inv = DefiKernel.Nary.Examples.inv200 ∧ (m.locals 0).nextIndex = 0 ∧ (m.locals 0).outputs = [] ∨
                    b = 0 ∧
                        inv = DefiKernel.Nary.Examples.inv201 ∧
                          (m.locals 0).nextIndex = 1 ∧
                            (m.locals 0).outputs = [DefiKernel.Nary.Examples.budgetOut 0] ∧
                              6 ≤ m.world.state.balance DefiKernel.Nary.Examples.vaultC ∨
                      b = 1 ∧
                          inv = DefiKernel.Nary.Examples.inv202 ∧
                            (m.locals 1).nextIndex = 0 ∧ 1 ≤ m.world.state.balance DefiKernel.Nary.Examples.donor1C ∨
                        b = 2 ∧
                          inv = DefiKernel.Nary.Examples.inv203 ∧
                            (m.locals 2).nextIndex = 0 ∧ 2 ≤ m.world.state.balance DefiKernel.Nary.Examples.donor2C)
          (fun hf hs hA hsel =>
            Or.casesOn hop
              (fun h =>
                And.casesOn h fun hn0 hinv0 =>
                  Or.inl ⟨rfl, ⟨hinv0, ⟨hn0, hk.right.right.right.right.right.right.right.left hn0⟩⟩⟩)
              fun h =>
              And.casesOn h fun hn0 hinv0 =>
                have ha := hA.right;
                Or.casesOn ha (fun hne => False.elim (hne hn0)) fun h =>
                  And.casesOn h fun left right =>
                    And.casesOn right fun hout hvault =>
                      Or.inr
                        (Or.inl
                          ⟨rfl,
                            ⟨hinv0,
                              ⟨hn0,
                                ⟨hout,
                                  le_of_not_gt fun a =>
                                    Mathlib.Tactic.Linarith.lt_irrefl
                                      (Eq.mp
                                        (congrArg (fun _a => _a < 0)
                                          (Mathlib.Tactic.Ring.of_eq
                                            (Mathlib.Tactic.Ring.Common.add_congr
                                              (Mathlib.Tactic.Ring.Common.add_congr
                                                (Mathlib.Tactic.Ring.Common.mul_congr
                                                  (Mathlib.Tactic.Ring.cast_pos
                                                    (Mathlib.Meta.NormNum.isNat_ofNat ℚ (Eq.refl 4)))
