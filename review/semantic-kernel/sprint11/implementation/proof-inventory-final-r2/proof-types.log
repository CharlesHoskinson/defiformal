NARY_PROOF_JSON {"axioms":["propext"],"is_private_name":false,"module":"DefiKernel.Nary.Schedule","name":"DefiKernel.Nary.count_append","statement":"∀ {B : Type} [inst : DecidableEq.{1} B] (b : B) (first second : DefiKernel.Nary.Schedule B),\n  @Eq.{1} Nat\n    (@List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b\n      (@HAppend.hAppend.{0, 0, 0} (DefiKernel.Nary.Schedule B) (DefiKernel.Nary.Schedule B) (DefiKernel.Nary.Schedule B)\n        (@instHAppendOfAppend.{0} (DefiKernel.Nary.Schedule B) (@List.instAppend.{0} B)) first second))\n    (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n      (@List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b first)\n      (@List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b second))","user_name":"DefiKernel.Nary.count_append"}
NARY_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Schedule","name":"DefiKernel.Nary.count_sum_length","statement":"∀ {B : Type} [inst : DecidableEq.{1} B] (roster : @DefiKernel.Nary.Roster B inst)\n  (schedule : DefiKernel.Nary.Schedule B),\n  @Eq.{1} Nat\n    (@List.sum.{0} Nat instAddNat (@MulZeroClass.toZero.{0} Nat Nat.instMulZeroClass)\n      (@List.map.{0, 0} B Nat (fun (b : B) => @List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b schedule)\n        (@DefiKernel.Nary.Roster.order B inst roster)))\n    (@List.length.{0} B schedule)","user_name":"DefiKernel.Nary.count_sum_length"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Causal","name":"DefiKernel.Nary.derived_monitor_step_preserves","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] {Q : Type}\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (update : Q → DefiKernel.Nary.MonitorInput B P A D → Q)\n  (entry : Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D)) (K : DefiKernel.Nary.JointInvariant Q B P A D)\n  (invariant : B → DefiKernel.Typed.State P A D → Prop)\n  (guarantee rely : B → DefiKernel.Typed.State P A D → DefiKernel.Typed.State P A D → Prop)\n  (assumption : DefiKernel.Nary.AssumptionFamily B Q P A D) (external : DefiKernel.Nary.ExternalFamily B Q P A D),\n  K (@Prod.fst.{0, 0} Q (DefiKernel.Nary.Machine B P A D) entry)\n      (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D) entry) →\n    @DefiKernel.Nary.InvariantDerivation B P A D Q K invariant →\n      @DefiKernel.Nary.AssumptionDerivation B P A D Q K assumption external →\n        @DefiKernel.Nary.PresentExternal B P A D Q K external →\n          @DefiKernel.Nary.SelectedSuccessGuarantee B P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries\n              branches invariant guarantee assumption →\n            @DefiKernel.Nary.GuaranteeInclusion B P A D guarantee rely →\n              @DefiKernel.Nary.RelyStable B P A D invariant rely →\n                @DefiKernel.Nary.SkipUpdateObligation B P A D inst Q cfg boundaries branches update K →\n                  @DefiKernel.Nary.RefusalUpdateObligation B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg\n                      boundaries branches update K →\n                    @DefiKernel.Nary.SuccessUpdateObligation B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q\n                        cfg boundaries branches update K invariant guarantee assumption →\n                      ∀ (b : B),\n                        K\n                          (@Prod.fst.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                            (@DefiKernel.Nary.advanceMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q\n                              cfg boundaries branches update entry b))\n                          (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                            (@DefiKernel.Nary.advanceMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q\n                              cfg boundaries branches update entry b))","user_name":"DefiKernel.Nary.derived_monitor_step_preserves"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Observation","name":"DefiKernel.Nary.eventEq_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  (left right : DefiKernel.Composition.Event P A D),\n  Iff (@Eq.{1} Bool (@DefiKernel.Nary.eventEq P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 left right) Bool.true)\n    (@Eq.{1} (DefiKernel.Composition.Event P A D) left right)","user_name":"DefiKernel.Nary.eventEq_iff"}
