NARY_PROOF_JSON {"axioms":["propext"],"is_private_name":false,"module":"DefiKernel.Nary.Schedule","name":"DefiKernel.Nary.sum_count_cons","statement":"∀ {B : Type} [inst : DecidableEq.{1} B] (order : List.{0} B),\n  @List.Nodup.{0} B order →\n    ∀ (head : B) (tail : DefiKernel.Nary.Schedule B),\n      @Eq.{1} Nat\n        (@List.sum.{0} Nat instAddNat (@MulZeroClass.toZero.{0} Nat Nat.instMulZeroClass)\n          (@List.map.{0, 0} B Nat\n            (fun (b : B) => @List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b (@List.cons.{0} B head tail)) order))\n        (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n          (@List.sum.{0} Nat instAddNat (@MulZeroClass.toZero.{0} Nat Nat.instMulZeroClass)\n            (@List.map.{0, 0} B Nat (fun (b : B) => @List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b tail) order))\n          (@ite.{1} Nat (@Membership.mem.{0, 0} B (List.{0} B) (@List.instMembership.{0} B) order head)\n            (@List.instDecidableMemOfLawfulBEq.{0} B (@instBEqOfDecidableEq.{0} B inst) (@instLawfulBEq.{0} B inst) head\n              order)\n            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))\n            (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))","user_name":"DefiKernel.Nary.sum_count_cons"}
