NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Trace","name":"DefiKernel.Nary.continueRun_refusal_stable","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (m : DefiKernel.Nary.Machine B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (own : B) (failure : DefiKernel.Composition.LocatedFailure P A D),\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n      (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Nary.Machine.locals B P A D m own))\n      (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure) →\n    have post :=\n      @DefiKernel.Nary.continueRun B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m\n        schedule;\n    And\n      (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n        (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Nary.Machine.locals B P A D post own))\n        (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure))\n      (And\n        (@Eq.{1} (List.{0} (DefiKernel.Composition.Event P A D))\n          (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Nary.Machine.locals B P A D post own))\n          (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Nary.Machine.locals B P A D m own)))\n        (And\n          (@Eq.{1} (List.{0} (DefiKernel.Composition.OutputObservation A))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Nary.Machine.locals B P A D post own))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Nary.Machine.locals B P A D m own)))\n          (@Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D post own))\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m own)))))","user_name":"DefiKernel.Nary.continueRun_refusal_stable"}
