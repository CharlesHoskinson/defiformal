NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Execution","name":"DefiKernel.Nary.AdvanceSound.congr_simp","statement":"∀ {B P A D : Type} {inst : DecidableEq.{1} B} [inst_1 : DecidableEq.{1} B] {inst_2 : DecidableEq.{1} P}\n  [inst_3 : DecidableEq.{1} P] {inst_4 : DecidableEq.{1} A} [inst_5 : DecidableEq.{1} A] {inst_6 : DecidableEq.{1} D}\n  [inst_7 : DecidableEq.{1} D] [inst_8 : Fintype.{0} P] [inst_9 : Fintype.{0} A] [inst_10 : Fintype.{0} D]\n  (cfg cfg_1 : DefiKernel.Composition.Config P A D),\n  @Eq.{1} (DefiKernel.Composition.Config P A D) cfg cfg_1 →\n    ∀ (boundaries boundaries_1 : DefiKernel.Nary.Boundaries B P A D),\n      @Eq.{1} (DefiKernel.Nary.Boundaries B P A D) boundaries boundaries_1 →\n        ∀ (branches branches_1 : DefiKernel.Nary.Branches B P A D),\n          @Eq.{1} (DefiKernel.Nary.Branches B P A D) branches branches_1 →\n            ∀ (m m_1 : DefiKernel.Nary.Machine B P A D),\n              @Eq.{1} (DefiKernel.Nary.Machine B P A D) m m_1 →\n                ∀ (b b_1 : B),\n                  @Eq.{1} B b b_1 →\n                    ∀ (a a_1 : DefiKernel.Nary.Machine B P A D),\n                      @Eq.{1} (DefiKernel.Nary.Machine B P A D) a a_1 →\n                        @Eq.{1} Prop\n                          (@DefiKernel.Nary.AdvanceSound B P A D inst inst_2 inst_4 inst_6 inst_8 inst_9 inst_10 cfg\n                            boundaries branches m b a)\n                          (@DefiKernel.Nary.AdvanceSound B P A D inst_1 inst_3 inst_5 inst_7 inst_8 inst_9 inst_10 cfg_1\n                            boundaries_1 branches_1 m_1 b_1 a_1)","user_name":"DefiKernel.Nary.AdvanceSound.congr_simp"}
