@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries\n          branches update entry preTokens))\n      (@Eq.{1} (Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D))\n        (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries\n          branches update entry\n          (@List.take.{0} B (@List.length.{0} B preTokens)\n            (@HAppend.hAppend.{0, 0, 0} (DefiKernel.Nary.Schedule B) (DefiKernel.Nary.Schedule B)\n              (DefiKernel.Nary.Schedule B)\n              (@instHAppendOfAppend.{0} (DefiKernel.Nary.Schedule B) (@List.instAppend.{0} B)) preTokens suffix₁)))\n        (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries\n          branches update entry\n          (@List.take.{0} B (@List.length.{0} B preTokens)\n            (@HAppend.hAppend.{0, 0, 0} (DefiKernel.Nary.Schedule B) (DefiKernel.Nary.Schedule B)\n              (DefiKernel.Nary.Schedule B)\n              (@instHAppendOfAppend.{0} (DefiKernel.Nary.Schedule B) (@List.instAppend.{0} B)) preTokens suffix₂)))))","user_name":"DefiKernel.Nary.continueMonitored_fixed_parameter_shared_prefix"}
