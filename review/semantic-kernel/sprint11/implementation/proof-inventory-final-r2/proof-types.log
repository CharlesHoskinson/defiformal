NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Soundness","name":"DefiKernel.Nary.AdvanceSound.error_attempt","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}\n  {branches : DefiKernel.Nary.Branches B P A D} {m : DefiKernel.Nary.Machine B P A D} {b : B}\n  {inv : DefiKernel.Composition.Invocation P A D} {reason : DefiKernel.Composition.Failure},\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n      (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Nary.Machine.locals B P A D m b))\n      (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)) →\n    @Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n        (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat (DefiKernel.Composition.Invocation P A D)\n          (fun (as : List.{0} (DefiKernel.Composition.Invocation P A D)) (i : Nat) =>\n            @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n          (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D)) (branches b)\n          (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Nary.Machine.locals B P A D m b)))\n        (@Option.some.{0} (DefiKernel.Composition.Invocation P A D) inv) →\n      @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D))\n          (@DefiKernel.Composition.executeStep P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n            (boundaries b\n              (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m b)))\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m b))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Nary.Machine.locals B P A D m b))\n            (@DefiKernel.Composition.Step.invoke P A D inv) (@DefiKernel.Nary.Machine.world B P A D m))\n          (@Except.error.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) reason) →\n        @Eq.{1} (List.{0} (DefiKernel.Nary.Attempt B P A D))\n          (@DefiKernel.Nary.Machine.attempts B P A D (@DefiKernel.Nary.Machine.refuse B P A D inst m b inv reason))\n          (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Nary.Attempt B P A D))\n            (List.{0} (DefiKernel.Nary.Attempt B P A D)) (List.{0} (DefiKernel.Nary.Attempt B P A D))\n            (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Nary.Attempt B P A D))\n              (@List.instAppend.{0} (DefiKernel.Nary.Attempt B P A D)))\n            (@DefiKernel.Nary.Machine.attempts B P A D m)\n            (@List.cons.{0} (DefiKernel.Nary.Attempt B P A D)\n              (@DefiKernel.Nary.Attempt.mk B P A D b\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m b)) inv\n                (@DefiKernel.Nary.Machine.world B P A D m)\n                (@Except.error.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) reason))\n              (@List.nil.{0} (DefiKernel.Nary.Attempt B P A D))))","user_name":"DefiKernel.Nary.AdvanceSound.error_attempt"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Preservation","name":"DefiKernel.Nary.AdvanceSound.locality","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}\n  {branches : DefiKernel.Nary.Branches B P A D} {m post : DefiKernel.Nary.Machine B P A D} {b : B},\n  @DefiKernel.Nary.AdvanceSound B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m b\n      post →\n    ∀ c ∉ @DefiKernel.Nary.Machine.writes B P A D post,\n      And\n        (@Eq.{1} Rat\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Nary.Machine.world B P A D post)) c)\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Nary.Machine.world B P A D m)) c))\n        (c ∉ @DefiKernel.Nary.Machine.writes B P A D m)","user_name":"DefiKernel.Nary.AdvanceSound.locality"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Soundness","name":"DefiKernel.Nary.AdvanceSound.none_attempt","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}\n  {branches : DefiKernel.Nary.Branches B P A D} {m post : DefiKernel.Nary.Machine B P A D} {b : B},\n  @DefiKernel.Nary.AdvanceSound B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m b\n      post →\n    Or\n        (@Eq.{1} Bool\n          (@Option.isSome.{0} (DefiKernel.Composition.LocatedFailure P A D)\n            (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Nary.Machine.locals B P A D m b)))\n          Bool.true)\n        (And\n          (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Nary.Machine.locals B P A D m b))\n            (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)))\n          (@Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n            (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat\n              (DefiKernel.Composition.Invocation P A D)\n              (fun (as : List.{0} (DefiKernel.Composition.Invocation P A D)) (i : Nat) =>\n                @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n              (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D)) (branches b)\n              (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Nary.Machine.locals B P A D m b)))\n            (@Option.none.{0} (DefiKernel.Composition.Invocation P A D)))) →\n      @Eq.{1} (List.{0} (DefiKernel.Nary.Attempt B P A D)) (@DefiKernel.Nary.Machine.attempts B P A D post)\n        (@DefiKernel.Nary.Machine.attempts B P A D m)","user_name":"DefiKernel.Nary.AdvanceSound.none_attempt"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Interference","name":"DefiKernel.Nary.AdvanceSound.preserves_invariants","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}\n  {branches : DefiKernel.Nary.Branches B P A D} {m post : DefiKernel.Nary.Machine B P A D} {b : B},\n  @DefiKernel.Nary.AdvanceSound B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m b\n      post →\n    (∀ (own : B),\n        @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Nary.Machine.locals B P A D m own))\n            (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)) →\n          @Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Nary.Machine.locals B P A D m own))\n            (@Min.min.{0} Nat instMinNat\n              (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Nary.Machine.locals B P A D m own))\n              (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches own)))) →\n      ∀ (invariant : B → DefiKernel.Nary.LedgerPredicate P A D)\n        (guarantee rely : B → DefiKernel.Nary.LedgerRelation P A D),\n        (∀ (own : B),\n            invariant own (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Nary.Machine.world B P A D m))) →\n          @DefiKernel.Nary.LocalObligation B P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches\n              invariant guarantee →\n            @DefiKernel.Nary.CrossInclusion B P A D guarantee rely →\n              @DefiKernel.Nary.Stable B P A D invariant rely →\n       