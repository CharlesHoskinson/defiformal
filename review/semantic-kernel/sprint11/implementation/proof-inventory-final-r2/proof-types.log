NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.BinaryCorrespondence","name":"DefiKernel.Nary.analyzeAll_binary","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D] [Fintype.{0} P]\n  [Fintype.{0} A] [Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Nary.Boundaries DefiKernel.Parallel.BranchId P A D)\n  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D),\n  @Eq.{1}\n    (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n      (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))))\n    (@DefiKernel.Nary.analyzeAll DefiKernel.Parallel.BranchId P A D inst inst_1 inst_2 cfg boundaries branches\n      (@DefiKernel.Nary.Roster.order DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId\n        DefiKernel.Nary.binaryParticipants))\n    (@DefiKernel.Nary.analyzeAll_binary.match_1.{1} P A D\n      (fun (x : Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D)) =>\n        Except.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n          (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))))\n      (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries DefiKernel.Parallel.BranchId.left)\n        (branches DefiKernel.Parallel.BranchId.left))\n      (fun (failure : DefiKernel.Parallel.LocalFailure) =>\n        @Except.error.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n          (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D)))\n          (@DefiKernel.Nary.AdmissionFailure.structural DefiKernel.Parallel.BranchId P A D\n            DefiKernel.Parallel.BranchId.left failure))\n      fun (lf : DefiKernel.Parallel.Footprint P A D) =>\n      @DefiKernel.Nary.analyzeAll_binary.match_1.{1} P A D\n        (fun (x : Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D)) =>\n          Except.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n            (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))))\n        (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries DefiKernel.Parallel.BranchId.right)\n          (branches DefiKernel.Parallel.BranchId.right))\n        (fun (failure : DefiKernel.Parallel.LocalFailure) =>\n          @Except.error.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n            (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D)))\n            (@DefiKernel.Nary.AdmissionFailure.structural DefiKernel.Parallel.BranchId P A D\n              DefiKernel.Parallel.BranchId.right failure))\n        fun (rf : DefiKernel.Parallel.Footprint P A D) =>\n        @Except.ok.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n          (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D)))\n          (@List.cons.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))\n            (@Prod.mk.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D)\n              DefiKernel.Parallel.BranchId.left lf)\n            (@List.cons.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))\n              (@Prod.mk.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D)\n                DefiKernel.Parallel.BranchId.right rf)\n              (@List.nil.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))))))","user_name":"DefiKernel.Nary.analyzeAll_binary"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.BinaryCorrespondence","name":"DefiKernel.Nary.analyzeAll_cons_ok","statement":"∀ {B P A D : Type} [DecidableEq.{1} B] [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A]\n  [inst_2 : DecidableEq.{1} D] [Fintype.{0} P] [Fintype.{0} A] [Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (b : B) (rest : List.{0} B) (fp : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n      (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries b) (branches b))\n      (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) fp) →\n    @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n        (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n      (@DefiKernel.Nary.analyzeAll B P A D inst inst_1 inst_2 cfg boundaries branches (@List.cons.{0} B b rest))\n      (@DefiKernel.Nary.analyzeAll_cons_ok.match_1.{1} B P A D\n        (fun\n            (x :\n              Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n                (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))) =>\n          Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n        (@DefiKernel.Nary.analyzeAll B P A D inst inst_1 inst_2 cfg boundaries branches rest)\n        (fun (reason : DefiKernel.Nary.AdmissionFailure B P A D) =>\n          @Except.error.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) reason)\n        fun (footprints : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) =>\n        @Except.ok