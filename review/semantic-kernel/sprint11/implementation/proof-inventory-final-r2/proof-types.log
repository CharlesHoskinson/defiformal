NARY_PROOF_JSON {"axioms":["propext"],"is_private_name":false,"module":"DefiKernel.Nary.Schedule","name":"DefiKernel.Nary.admit_analyze_error","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] (cfg : DefiKernel.Composition.Config P A D) (roster : @DefiKernel.Nary.Roster B inst)\n  (boundaries : DefiKernel.Nary.Boundaries B P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (reason : DefiKernel.Nary.AdmissionFailure B P A D),\n  @Eq.{1} Bool\n      (@DefiKernel.Composition.validateCatalog P A D inst_1 inst_2 inst_3\n        (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n      Bool.true →\n    @Eq.{1}\n        (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n        (@DefiKernel.Nary.analyzeAll B P A D inst_1 inst_2 inst_3 cfg boundaries branches\n          (@DefiKernel.Nary.Roster.order B inst roster))\n        (@Except.error.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) reason) →\n      @Eq.{1}\n        (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))))\n        (@DefiKernel.Nary.admit B P A D inst inst_1 inst_2 inst_3 cfg roster boundaries branches schedule)\n        (@Except.error.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)\n          (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) reason)","user_name":"DefiKernel.Nary.admit_analyze_error"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.BinaryCorrespondence","name":"DefiKernel.Nary.admit_correspondence","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D] [Fintype.{0} P]\n  [Fintype.{0} A] [Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Nary.Boundaries DefiKernel.Parallel.BranchId P A D)\n  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)\n  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId),\n  @Eq.{1}\n    (Except.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n      (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n    (@DefiKernel.Nary.existingBinaryAdmit P A D inst inst_1 inst_2 cfg boundaries branches schedule)\n    (@DefiKernel.Nary.admit_correspondence.match_3.{1} P A D\n      (fun\n          (x :\n            Except.{0, 0} (DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D)\n              (List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D)))) =>\n        Except.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n          (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Nary.admit DefiKernel.Parallel.BranchId P A D DefiKernel.Parallel.instDecidableEqBranchId inst inst_1\n        inst_2 cfg DefiKernel.Nary.binaryParticipants boundaries branches schedule)\n      (fun (reason : DefiKernel.Nary.AdmissionFailure DefiKernel.Parallel.BranchId P A D) =>\n        @Except.error.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n          (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n          (@DefiKernel.Nary.projectAdmissionFailure P A D branches schedule reason))\n      fun (fps : List.{0} (Prod.{0, 0} DefiKernel.Parallel.BranchId (DefiKernel.Parallel.Footprint P A D))) =>\n      @DefiKernel.Nary.admit_correspondence.match_1.{1} P A D\n        (fun\n            (x :\n              Option.{0} (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))) =>\n          Except.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n            (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n        (@DefiKernel.Nary.projectAdmitSuccess P A D fps)\n        (fun (pair : Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)) =>\n          @Except.ok.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n            (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)) pair)\n        fun (_ : Unit) =>\n        @Except.error.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n          (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n          (@DefiKernel.Interleaving.AdmissionFailure.configuration P A D))","user_name":"DefiKernel.Nary.admit_correspondence"}
