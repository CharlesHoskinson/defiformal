NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Observation","name":"DefiKernel.Nary.eventEq.eq_1","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  (left right : DefiKernel.Composition.Event P A D),\n  @Eq.{1} Bool (@DefiKernel.Nary.eventEq P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 left right)\n    ((((@Decidable.decide\n                  (@Eq.{1} Nat (@DefiKernel.Composition.Event.index P A D left)\n                    (@DefiKernel.Composition.Event.index P A D right))\n                  (instDecidableEqNat (@DefiKernel.Composition.Event.index P A D left)\n                    (@DefiKernel.Composition.Event.index P A D right))).and\n              (@Decidable.decide\n                (@Eq.{1} (DefiKernel.Composition.Step P A D) (@DefiKernel.Composition.Event.step P A D left)\n                  (@DefiKernel.Composition.Event.step P A D right))\n                (@DefiKernel.Parallel.instDecidableEqStep P A D inst inst_1 inst_2\n                  (@DefiKernel.Composition.Event.step P A D left)\n                  (@DefiKernel.Composition.Event.step P A D right)))).and\n          (@DefiKernel.Parallel.worldEq P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n            (@DefiKernel.Composition.Event.before P A D left) (@DefiKernel.Composition.Event.before P A D right))).and\n      (@DefiKernel.Nary.stepResultEq P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n        (@DefiKernel.Composition.Event.result P A D left) (@DefiKernel.Composition.Event.result P A D right)))","user_name":"DefiKernel.Nary.eventEq.eq_1"}
