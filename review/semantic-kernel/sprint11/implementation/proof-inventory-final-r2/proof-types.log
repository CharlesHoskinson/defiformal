NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Preservation","name":"DefiKernel.Composition.ReceiptAuthorized.eq_1","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (pre : DefiKernel.Composition.World P A D) (boundary : DefiKernel.Composition.Boundary P A D)\n  (request : DefiKernel.Typed.Request P A D) (e : DefiKernel.Typed.Evaluated P A D),\n  @Eq.{1} Prop\n    (@DefiKernel.Composition.ReceiptAuthorized P A D inst inst_1 inst_2 pre boundary\n      (@DefiKernel.Composition.Receipt.invoked P A D request e))\n    (And\n      (@Eq.{1} Bool\n        (@DefiKernel.Typed.hasAuthority P A D inst inst_1 inst_2\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n          (@DefiKernel.Typed.Request.capabilityIds P A D request) (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n          (@DefiKernel.Typed.Request.operation P A D request) (@DefiKernel.Typed.Right.invoke P A D))\n        Bool.true)\n      (And\n        (∀ (c : DefiKernel.Typed.Cell P A D),\n          @LT.lt.{0} Rat Rat.instLT (@DefiKernel.Typed.Evaluated.effect P A D inst inst_1 inst_2 e c)\n              (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))) →\n            @Eq.{1} Bool\n              (@DefiKernel.Typed.hasAuthority P A D inst inst_1 inst_2\n                (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n                (@DefiKernel.Typed.Request.capabilityIds P A D request)\n                (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n                (@DefiKernel.Typed.Request.operation P A D request) (@DefiKernel.Typed.Right.debit P A D c))\n              Bool.true)\n        (∀ (d : D) (a : A),\n          @Ne.{1} Rat (@DefiKernel.Typed.Evaluated.supply P A D inst_1 inst_2 e d a)\n              (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))) →\n            @Eq.{1} Bool\n              (@DefiKernel.Typed.hasAuthority P A D inst inst_1 inst_2\n                (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n                (@DefiKernel.Typed.Request.capabilityIds P A D request)\n                (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n                (@DefiKernel.Typed.Request.operation P A D request) (@DefiKernel.Typed.Right.changeSupply P A D d a))\n              Bool.true)))","user_name":"DefiKernel.Composition.ReceiptAuthorized.eq_1"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Preservation","name":"DefiKernel.Composition.ReceiptAuthorized.eq_2","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (pre : DefiKernel.Composition.World P A D) (boundary : DefiKernel.Composition.Boundary P A D)\n  (receipt : DefiKernel.Composition.Receipt P A D),\n  (∀ (request : DefiKernel.Typed.Request P A D) (e : DefiKernel.Typed.Evaluated P A D),\n      @Eq.{1} (DefiKernel.Composition.Receipt P A D) receipt (@DefiKernel.Composition.Receipt.invoked P A D request e) →\n        False) →\n    @Eq.{1} Prop (@DefiKernel.Composition.ReceiptAuthorized P A D inst inst_1 inst_2 pre boundary receipt) True","user_name":"DefiKernel.Composition.ReceiptAuthorized.eq_2"}
