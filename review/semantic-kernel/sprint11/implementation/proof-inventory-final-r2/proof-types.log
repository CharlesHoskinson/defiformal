NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Execution","name":"DefiKernel.Nary.continueRun_consumed","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (m : DefiKernel.Nary.Machine B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (b : B),\n  @Eq.{1} Nat\n    (@DefiKernel.Interleaving.LocalState.consumed P A D\n      (@DefiKernel.Nary.Machine.locals B P A D\n        (@DefiKernel.Nary.continueRun B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m\n          schedule)\n        b))\n    (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n      (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Nary.Machine.locals B P A D m b))\n      (@List.count.{0} B (@instBEqOfDecidableEq.{0} B inst) b schedule))","user_name":"DefiKernel.Nary.continueRun_consumed"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Interference","name":"DefiKernel.Nary.continueRun_invariants","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}\n  {branches : DefiKernel.Nary.Branches B P A D} {initial : DefiKernel.Composition.World P A D}\n  {m : DefiKernel.Nary.Machine B P A D},\n  @DefiKernel.Nary.Reachable B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches initial m →\n    ∀ (invariant : B → DefiKernel.Nary.LedgerPredicate P A D)\n      (guarantee rely : B → DefiKernel.Nary.LedgerRelation P A D),\n      (∀ (b : B), invariant b (@DefiKernel.Typed.ExecutionResult.state P A D initial)) →\n        @DefiKernel.Nary.LocalObligation B P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches\n            invariant guarantee →\n          @DefiKernel.Nary.CrossInclusion B P A D guarantee rely →\n            @DefiKernel.Nary.Stable B P A D invariant rely →\n              ∀ (schedule : DefiKernel.Nary.Schedule B) (b : B),\n                invariant b\n                  (@DefiKernel.Typed.ExecutionResult.state P A D\n                    (@DefiKernel.Nary.Machine.world B P A D\n                      (@DefiKernel.Nary.continueRun B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n                        boundaries branches m schedule)))","user_name":"DefiKernel.Nary.continueRun_invariants"}
