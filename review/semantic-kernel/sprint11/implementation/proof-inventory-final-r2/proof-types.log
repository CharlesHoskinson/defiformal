NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Causal","name":"DefiKernel.Nary.joint_advanceMonitored","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] {Q : Type}\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (update : Q → DefiKernel.Nary.MonitorInput B P A D → Q)\n  (K : DefiKernel.Nary.JointInvariant Q B P A D) (invariant : B → DefiKernel.Typed.State P A D → Prop)\n  (guarantee rely : B → DefiKernel.Typed.State P A D → DefiKernel.Typed.State P A D → Prop)\n  (assumption : DefiKernel.Nary.AssumptionFamily B Q P A D) (external : DefiKernel.Nary.ExternalFamily B Q P A D),\n  @DefiKernel.Nary.InvariantDerivation B P A D Q K invariant →\n    @DefiKernel.Nary.AssumptionDerivation B P A D Q K assumption external →\n      @DefiKernel.Nary.PresentExternal B P A D Q K external →\n        @DefiKernel.Nary.SelectedSuccessGuarantee B P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries\n            branches invariant guarantee assumption →\n          @DefiKernel.Nary.GuaranteeInclusion B P A D guarantee rely →\n            @DefiKernel.Nary.RelyStable B P A D invariant rely →\n              @DefiKernel.Nary.SkipUpdateObligation B P A D inst Q cfg boundaries branches update K →\n                @DefiKernel.Nary.RefusalUpdateObligation B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg\n                    boundaries branches update K →\n                  @DefiKernel.Nary.SuccessUpdateObligation B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg\n                      boundaries branches update K invariant guarantee assumption →\n                    ∀ (entry : Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D)),\n                      K (@Prod.fst.{0, 0} Q (DefiKernel.Nary.Machine B P A D) entry)\n                          (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D) entry) →\n                        ∀ (b : B),\n                          And\n                            (K\n                              (@Prod.fst.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                                (@DefiKernel.Nary.advanceMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n                                  inst_6 Q cfg boundaries branches update entry b))\n                              (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                                (@DefiKernel.Nary.advanceMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n                                  inst_6 Q cfg boundaries branches update entry b)))\n                            (∀ (own : B),\n                              invariant own\n                                (@DefiKernel.Typed.ExecutionResult.state P A D\n                                  (@DefiKernel.Nary.Machine.world B P A D\n                                    (@Prod.snd.{0, 0} Q (DefiKernel.Nary.Machine B P A D)\n                                      (@DefiKernel.Nary.advanceMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n                                        inst_6 Q cfg boundaries branches update entry b)))))","user_name":"DefiKernel.Nary.joint_advanceMonitored"}
