NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.BinaryCorrespondence","name":"DefiKernel.Nary.checkSchedule_error_project","statement":"∀ {P A D : Type} [DecidableEq.{1} P] [DecidableEq.{1} A] [DecidableEq.{1} D]\n  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)\n  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId)\n  (mismatch : DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId),\n  @Eq.{u_1 + 1} (Except.{0, u_1} (DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId) PUnit.{u_1 + 1})\n      (@DefiKernel.Nary.checkSchedule.{u_1} DefiKernel.Parallel.BranchId P A D\n        DefiKernel.Parallel.instDecidableEqBranchId DefiKernel.Nary.binaryParticipants branches schedule)\n      (@Except.error.{0, u_1} (DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId) PUnit.{u_1 + 1}\n        mismatch) →\n    @Eq.{1} (Except.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1})\n      (DefiKernel.Interleaving.checkSchedule\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches DefiKernel.Parallel.BranchId.left))\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches DefiKernel.Parallel.BranchId.right))\n        schedule)\n      (@Except.error.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1}\n        (@DefiKernel.Nary.projectScheduleMismatch P A D branches schedule mismatch))","user_name":"DefiKernel.Nary.checkSchedule_error_project"}
