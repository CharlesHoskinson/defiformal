ssionFailure B P A D))\n                      (@Except.instMonad.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))))\n                  (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) footprints)\n          __r)\n      ((fun (__r : Unit) =>\n          @Bind.bind.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n            (@Monad.toBind.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n              (@Except.instMonad.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)))\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n            (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n            (@DefiKernel.Nary.analyzeAll B P A D inst_1 inst_2 inst_3 cfg boundaries branches\n              (@DefiKernel.Nary.Roster.order B inst roster))\n            fun (footprints : List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D))) =>\n            @Bind.bind.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n              (@Monad.toBind.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n                (@Except.instMonad.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D)))\n              PUnit.{1} (List.{0} (Prod.{0, 0} B (DefiKernel.Parallel.Footprint P A D)))\n              (@Except.mapError.{0, 0, 0} (DefiKernel.Nary.ScheduleMismatch B)\n                (DefiKernel.Nary.AdmissionFailure B P A D) PUnit.{1}\n                (@DefiKernel.Nary.AdmissionFailure.schedule B P A D)\n                (@DefiKernel.Nary.checkSchedule.{0} B P A D inst roster branches schedule))\n              fun (__x : PUnit.{1}) =>\n              @Pure.pure.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n                (@Applicative.toPure.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n                  (@Monad.toApplicative.{0, 0} (Except.{0, 0} (DefiKernel.Nary.AdmissionFailure B P A D))\n                    (@Except.instMonad.{0