NARY_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Schedule","name":"DefiKernel.Nary.checkSchedule_ok_iff","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] (roster : @DefiKernel.Nary.Roster B inst)\n  (branches : DefiKernel.Nary.Branches B P A D) (schedule : DefiKernel.Nary.Schedule B),\n  Iff\n    (@Eq.{u_1 + 1} (Except.{0, u_1} (DefiKernel.Nary.ScheduleMismatch B) PUnit.{u_1 + 1})\n      (@DefiKernel.Nary.checkSchedule.{u_1} B P A D inst roster branches schedule)\n      (@Except.ok.{0, u_1} (DefiKernel.Nary.ScheduleMismatch B) PUnit.{u_1 + 1} PUnit.unit.{u_1 + 1}))\n    (@DefiKernel.Nary.Complete B P A D inst branches schedule)","user_name":"DefiKernel.Nary.checkSchedule_ok_iff"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.BinaryCorrespondence","name":"DefiKernel.Nary.checkSchedule_project","statement":"∀ {P A D : Type} [DecidableEq.{1} P] [DecidableEq.{1} A] [DecidableEq.{1} D]\n  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)\n  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId),\n  DefiKernel.Nary.checkSchedule_project.match_1.{u_1, 1}\n    (fun (x : Except.{0, u_1} (DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId) PUnit.{u_1 + 1}) => Prop)\n    (@DefiKernel.Nary.checkSchedule.{u_1} DefiKernel.Parallel.BranchId P A D DefiKernel.Parallel.instDecidableEqBranchId\n      DefiKernel.Nary.binaryParticipants branches schedule)\n    (fun (a : PUnit.{u_1 + 1}) =>\n      @Eq.{1} (Except.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1})\n        (DefiKernel.Interleaving.checkSchedule\n          (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches DefiKernel.Parallel.BranchId.left))\n          (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches DefiKernel.Parallel.BranchId.right))\n          schedule)\n        (@Except.ok.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1} PUnit.unit.{1}))\n    fun (mismatch : DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId) =>\n    @Eq.{1} (Except.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1})\n      (DefiKernel.Interleaving.checkSchedule\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches DefiKernel.Parallel.BranchId.left))\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) (branches DefiKernel.Parallel.BranchId.right))\n        schedule)\n      (@Except.error.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1}\n        (@DefiKernel.Nary.projectScheduleMismatch P A D branches schedule mismatch))","user_name":"DefiKernel.Nary.checkSchedule_project"}
NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.CausalRuntime","name":"DefiKernel.Nary.continueMonitored_append","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] {Q : Type}\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (update : Q → DefiKernel.Nary.MonitorInput B P A D → Q)\n  (entry : Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D)) (s t : DefiKernel.Nary.Schedule B),\n  @Eq.{1} (Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D))\n    (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries branches\n      update entry\n      (@HAppend.hAppend.{0, 0, 0} (DefiKernel.Nary.Schedule B) (DefiKernel.Nary.Schedule B) (DefiKernel.Nary.Schedule B)\n        (@instHAppendOfAppend.{0} (DefiKernel.Nary.Schedule B) (@List.instAppend.{0} B)) s t))\n    (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries branches\n      update\n      (@DefiKernel.Nary.continueMonitored B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 Q cfg boundaries\n        branches update entry s)\n      t)","user_name":"DefiKernel.Nary.continueMonitored_append"}
