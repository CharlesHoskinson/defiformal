NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Preservation","name":"DefiKernel.Nary.continueRun_cell_accounting","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (branches : DefiKernel.Nary.Branches B P A D) (m : DefiKernel.Nary.Machine B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (cell : DefiKernel.Typed.Cell P A D),\n  @Eq.{1} Rat\n    (@DefiKernel.Typed.State.balance P A D\n      (@DefiKernel.Typed.ExecutionResult.state P A D\n        (@DefiKernel.Nary.Machine.world B P A D\n          (@DefiKernel.Nary.continueRun B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m\n            schedule)))\n      cell)\n    (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n      (@DefiKernel.Typed.State.balance P A D\n        (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Nary.Machine.world B P A D m)) cell)\n      (@HSub.hSub.{0, 0, 0} Rat Rat Rat (@instHSub.{0} Rat Rat.instSub)\n        (@DefiKernel.Nary.Machine.cellEffect B P A D inst_1 inst_2 inst_3\n          (@DefiKernel.Nary.continueRun B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches m\n            schedule)\n          cell)\n        (@DefiKernel.Nary.Machine.cellEffect B P A D inst_1 inst_2 inst_3 m cell)))","user_name":"DefiKernel.Nary.continueRun_cell_accounting"}
