NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Interference","name":"DefiKernel.Nary.every_prefix_invariants","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (invariant : B → DefiKernel.Nary.LedgerPredicate P A D)\n  (guarantee rely : B → DefiKernel.Nary.LedgerRelation P A D),\n  (∀ (b : B), invariant b (@DefiKernel.Typed.ExecutionResult.state P A D initial)) →\n    @DefiKernel.Nary.LocalObligation B P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries branches invariant\n        guarantee →\n      @DefiKernel.Nary.CrossInclusion B P A D guarantee rely →\n        @DefiKernel.Nary.Stable B P A D invariant rely →\n          ∀ (length : Nat) (b : B),\n            invariant b\n              (@DefiKernel.Typed.ExecutionResult.state P A D\n                (@DefiKernel.Nary.Machine.world B P A D\n                  (@DefiKernel.Nary.runPrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries\n                    initial branches (@List.take.{0} B length schedule))))","user_name":"DefiKernel.Nary.every_prefix_invariants"}
