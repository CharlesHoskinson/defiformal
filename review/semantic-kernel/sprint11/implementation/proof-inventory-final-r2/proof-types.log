NARY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Nary.Trace","name":"DefiKernel.Nary.runPrefix_attempt_exact","statement":"∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A]\n  [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)\n  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)\n  (schedule : DefiKernel.Nary.Schedule B) (i : Nat) (attempt : DefiKernel.Nary.Attempt B P A D),\n  @Eq.{1} (Option.{0} (DefiKernel.Nary.Attempt B P A D))\n      (@GetElem?.getElem?.{0, 0, 0} (List.{0} (DefiKernel.Nary.Attempt B P A D)) Nat (DefiKernel.Nary.Attempt B P A D)\n        (fun (as : List.{0} (DefiKernel.Nary.Attempt B P A D)) (i : Nat) =>\n          @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Nary.Attempt B P A D) as))\n        (@List.instGetElem?NatLtLength.{0} (DefiKernel.Nary.Attempt B P A D))\n        (@DefiKernel.Nary.Machine.attempts B P A D\n          (@DefiKernel.Nary.runPrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries initial\n            branches schedule))\n        i)\n      (@Option.some.{0} (DefiKernel.Nary.Attempt B P A D) attempt) →\n    And\n      (@Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D))\n        (@DefiKernel.Composition.executeStep P A D inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg\n          (boundaries (@DefiKernel.Nary.Attempt.participant B P A D attempt)\n            (@DefiKernel.Nary.Attempt.index B P A D attempt))\n          (@DefiKernel.Nary.Attempt.index B P A D attempt)\n          (@DefiKernel.Nary.ownHistory B P A D inst\n            (@List.take.{0} (DefiKernel.Nary.Attempt B P A D) i\n              (@DefiKernel.Nary.Machine.attempts B P A D\n                (@DefiKernel.Nary.runPrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries\n                  initial branches schedule)))\n            (@DefiKernel.Nary.Attempt.participant B P A D attempt))\n          (@DefiKernel.Composition.Step.invoke P A D (@DefiKernel.Nary.Attempt.invocation B P A D attempt))\n          (@DefiKernel.Nary.Attempt.before B P A D attempt))\n        (@DefiKernel.Nary.Attempt.outcome B P A D attempt))\n      (And\n        (@Eq.{1} Nat (@DefiKernel.Nary.Attempt.index B P A D attempt)\n          (@List.length.{0} (DefiKernel.Composition.Event P A D)\n            (@List.filterMap.{0, 0} (DefiKernel.Nary.Attempt B P A D) (DefiKernel.Composition.Event P A D)\n              (@DefiKernel.Nary.successfulEvent B P A D inst (@DefiKernel.Nary.Attempt.participant B P A D attempt))\n              (@List.take.{0} (DefiKernel.Nary.Attempt B P A D) i\n                (@DefiKernel.Nary.Machine.attempts B P A D\n                  (@DefiKernel.Nary.runPrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries\n                    initial branches schedule))))))\n        (@DefiKernel.Nary.AttemptChain B P A D initial\n          (@List.take.{0} (DefiKernel.Nary.Attempt B P A D) i\n            (@DefiKernel.Nary.Machine.attempts B P A D\n              (@DefiKernel.Nary.runPrefix B P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 inst_6 cfg boundaries initial\n                branches schedule)))\n          (@DefiKernel.Nary.Attempt.before B P A D attempt)))","user_name":"DefiKernel.Nary.runPrefix_attempt_exact"}
