  {branches : DefiKernel.Nary.Branches B P A D} {initial : DefiKernel.Composition.World P A D}
  {m : DefiKernel.Nary.Machine B P A D},
  DefiKernel.Nary.Reachable cfg boundaries branches initial m →
    ∀ (invariant : B → DefiKernel.Nary.LedgerPredicate P A D)
      (guarantee rely : B → DefiKernel.Nary.LedgerRelation P A D),
      (∀ (b : B), invariant b initial.state) →
        DefiKernel.Nary.LocalObligation cfg boundaries branches invariant guarantee →
          DefiKernel.Nary.CrossInclusion guarantee rely →
            DefiKernel.Nary.Stable invariant rely →
              ∀ (schedule : DefiKernel.Nary.Schedule B) (b : B),
                invariant b (DefiKernel.Nary.continueRun cfg boundaries branches m schedule).world.state
'DefiKernel.Nary.continueRun_invariants' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
