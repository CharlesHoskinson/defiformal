@DefiKernel.Nary.continueRun_refusal_stable : ∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P]
  [inst_2 : DecidableEq.{1} A] [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A]
  [inst_6 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)
  (branches : DefiKernel.Nary.Branches B P A D) (m : DefiKernel.Nary.Machine B P A D)
  (schedule : DefiKernel.Nary.Schedule B) (own : B) (failure : DefiKernel.Composition.LocatedFailure P A D),
  Eq.{1} (m.locals own).failure (some.{0} failure) →
    have post := DefiKernel.Nary.continueRun cfg boundaries branches m schedule;
    Eq.{1} (post.locals own).failure (some.{0} failure) ∧
      Eq.{1} (post.locals own).events (m.locals own).events ∧
        Eq.{1} (post.locals own).outputs (m.locals own).outputs ∧
          Eq.{1} (post.locals own).nextIndex (m.locals own).nextIndex
