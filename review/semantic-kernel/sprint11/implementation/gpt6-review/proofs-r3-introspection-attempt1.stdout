@DefiKernel.Nary.runPrefix_complete_exhausted_or_refused : ∀ {B P A D : Type} [inst : DecidableEq.{1} B]
  [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A] [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P]
  [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)
  (boundaries : DefiKernel.Nary.Boundaries B P A D) (initial : DefiKernel.Composition.World P A D)
  (branches : DefiKernel.Nary.Branches B P A D) (schedule : DefiKernel.Nary.Schedule B),
  DefiKernel.Nary.Complete branches schedule →
    ∀ (b : B),
      Eq.{1} ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).failure none.{0} ∧
          Eq.{1} ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).nextIndex
            (List.length.{0} (branches b)) ∨
        ∃ failure,
          Eq.{1} ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).failure
              (some.{0} failure) ∧
            Eq.{1} failure.index
              ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).nextIndex
