@DefiKernel.Nary.projectScheduleMismatch_eq : ∀ {P A D : Type} [DecidableEq P] [DecidableEq A] [DecidableEq D]
  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)
  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId)
  (mismatch : DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId),
  DefiKernel.Nary.projectScheduleMismatch branches schedule mismatch =
    { expectedLeft := List.length (branches DefiKernel.Parallel.BranchId.left),
      observedLeft := List.count DefiKernel.Parallel.BranchId.left schedule,
      expectedRight := List.length (branches DefiKernel.Parallel.BranchId.right),
      observedRight := List.count DefiKernel.Parallel.BranchId.right schedule }
