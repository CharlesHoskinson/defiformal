@DefiKernel.Nary.analyzeAll_binary : ∀ {P A D : Type} [inst : DecidableEq P] [inst_1 : DecidableEq A]
  [inst_2 : DecidableEq D] [Fintype P] [Fintype A] [Fintype D] (cfg : DefiKernel.Composition.Config P A D)
  (boundaries : DefiKernel.Nary.Boundaries DefiKernel.Parallel.BranchId P A D)
  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D),
  DefiKernel.Nary.analyzeAll cfg boundaries branches DefiKernel.Nary.binaryParticipants.order =
    match
      DefiKernel.Parallel.analyzeBranch cfg (boundaries DefiKernel.Parallel.BranchId.left)
        (branches DefiKernel.Parallel.BranchId.left) with
    | Except.error failure =>
      Except.error (DefiKernel.Nary.AdmissionFailure.structural DefiKernel.Parallel.BranchId.left failure)
    | Except.ok lf =>
      match
        DefiKernel.Parallel.analyzeBranch cfg (boundaries DefiKernel.Parallel.BranchId.right)
          (branches DefiKernel.Parallel.BranchId.right) with
      | Except.error failure =>
        Except.error (DefiKernel.Nary.AdmissionFailure.structural DefiKernel.Parallel.BranchId.right failure)
      | Except.ok rf => Except.ok [(DefiKernel.Parallel.BranchId.left, lf), (DefiKernel.Parallel.BranchId.right, rf)]
'DefiKernel.Nary.analyzeAll_binary' depends on axioms: [propext, Classical.choice, Quot.sound]
@DefiKernel.Nary.admit_invalid_catalog_binary : ∀ {P A D : Type} [inst : DecidableEq P] [inst_1 : DecidableEq A]
  [inst_2 : DecidableEq D] [Fintype P] [Fintype A] [Fintype D] (cfg : DefiKernel.Composition.Config P A D)
  (boundaries : DefiKernel.Nary.Boundaries DefiKernel.Parallel.BranchId P A D)
  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)
  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId),
  DefiKernel.Composition.validateCatalog cfg.registry cfg.catalog = false →
    DefiKernel.Nary.admit cfg DefiKernel.Nary.binaryParticipants boundaries branches schedule =
        Except.error DefiKernel.Nary.AdmissionFailure.configuration ∧
      DefiKernel.Nary.existingBinaryAdmit cfg boundaries branches schedule =
        Except.error DefiKernel.Interleaving.AdmissionFailure.configuration
