@DefiKernel.Nary.checkSchedule_error_project : ∀ {P A D : Type} [DecidableEq P] [DecidableEq A] [DecidableEq D]
  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)
  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId)
  (mismatch : DefiKernel.Nary.ScheduleMismatch DefiKernel.Parallel.BranchId),
  DefiKernel.Nary.checkSchedule DefiKernel.Nary.binaryParticipants branches schedule = Except.error mismatch →
    DefiKernel.Interleaving.checkSchedule (List.length (branches DefiKernel.Parallel.BranchId.left))
        (List.length (branches DefiKernel.Parallel.BranchId.right)) schedule =
      Except.error (DefiKernel.Nary.projectScheduleMismatch branches schedule mismatch)
