@DefiKernel.Nary.admit_correspondence : ∀ {P A D : Type} [inst : DecidableEq P] [inst_1 : DecidableEq A]
  [inst_2 : DecidableEq D] [Fintype P] [Fintype A] [Fintype D] (cfg : DefiKernel.Composition.Config P A D)
  (boundaries : DefiKernel.Nary.Boundaries DefiKernel.Parallel.BranchId P A D)
  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)
  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId),
  DefiKernel.Nary.existingBinaryAdmit cfg boundaries branches schedule =
    match DefiKernel.Nary.admit cfg DefiKernel.Nary.binaryParticipants boundaries branches schedule with
    | Except.error reason => Except.error (DefiKernel.Nary.projectAdmissionFailure branches schedule reason)
    | Except.ok fps =>
      match DefiKernel.Nary.projectAdmitSuccess fps with
      | some pair => Except.ok pair
      | none => Except.error DefiKernel.Interleaving.AdmissionFailure.configuration
'DefiKernel.Nary.admit_correspondence' depends on axioms: [propext, Classical.choice, Quot.sound]
@DefiKernel.Nary.admit_ok_projected : ∀ {P A D : Type} [inst : DecidableEq P] [inst_1 : DecidableEq A]
