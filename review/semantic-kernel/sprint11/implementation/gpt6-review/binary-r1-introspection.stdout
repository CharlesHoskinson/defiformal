  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)
  (schedule : DefiKernel.Nary.Schedule DefiKernel.Parallel.BranchId)
  (fps : List (DefiKernel.Parallel.BranchId × DefiKernel.Parallel.Footprint P A D)),
  DefiKernel.Nary.admit cfg DefiKernel.Nary.binaryParticipants boundaries branches schedule = Except.ok fps →
