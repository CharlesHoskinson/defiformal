@DefiKernel.Nary.toBinary_advance_refused : ∀ {P A D : Type} [inst : DecidableEq P] [inst_1 : DecidableEq A]
  [inst_2 : DecidableEq D] [inst_3 : Fintype P] [inst_4 : Fintype A] [inst_5 : Fintype D]
  (cfg : DefiKernel.Composition.Config P A D)
  (boundaries : DefiKernel.Nary.Boundaries DefiKernel.Parallel.BranchId P A D)
  (branches : DefiKernel.Nary.Branches DefiKernel.Parallel.BranchId P A D)
  (m : DefiKernel.Nary.Machine DefiKernel.Parallel.BranchId P A D) (b : DefiKernel.Parallel.BranchId)
  (inv : DefiKernel.Composition.Invocation P A D) (reason : DefiKernel.Composition.Failure),
  (m.locals b).failure = none →
    (branches b)[(m.locals b).consumed]? = some inv →
      DefiKernel.Composition.executeStep cfg (boundaries b (m.locals b).nextIndex) (m.locals b).nextIndex
            (m.locals b).outputs (DefiKernel.Composition.Step.invoke inv) m.world =
          Except.error reason →
        DefiKernel.Nary.toBinaryMachine (DefiKernel.Nary.advance cfg boundaries branches m b) =
          (DefiKernel.Nary.toBinaryMachine m).refuse b inv reason
