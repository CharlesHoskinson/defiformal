  Eq.{1} sched DefiKernel.Nary.Examples.f12Schedule ∧
    Eq.{1} (m.world.state.balance DefiKernel.Nary.Examples.vaultC) 1 ∧
      Eq.{1} (m.world.state.balance DefiKernel.Nary.Examples.budgetC) 6 ∧
        Eq.{1} (m.world.state.balance DefiKernel.Nary.Examples.recipientC) 6 ∧
          Eq.{1} (m.world.state.balance DefiKernel.Nary.Examples.donor1C) 3 ∧
            Eq.{1} m.world.capabilities DefiKernel.Nary.Examples.f12Store ∧
              Eq.{1} (m.locals 0).outputs (List.cons.{0} (DefiKernel.Nary.Examples.budgetOut 0) List.nil.{0}) ∧
                Eq.{1} (m.locals 0).nextIndex 2 ∧
                  Eq.{1} (m.locals 1).nextIndex 1 ∧ ¬DefiKernel.Nary.FundedCompanions.readyBudgetBound m.world.state
| DefiKernel.Nary.Result.refused reason world schedule => False
