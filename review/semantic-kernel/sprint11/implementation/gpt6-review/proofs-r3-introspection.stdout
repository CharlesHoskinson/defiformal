@DefiKernel.Nary.runPrefix_complete_exhausted_or_refused : ∀ {B P A D : Type} [inst : DecidableEq B]
  [inst_1 : DecidableEq P] [inst_2 : DecidableEq A] [inst_3 : DecidableEq D] [inst_4 : Fintype P] [inst_5 : Fintype A]
  [inst_6 : Fintype D] (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)
  (initial : DefiKernel.Composition.World P A D) (branches : DefiKernel.Nary.Branches B P A D)
  (schedule : DefiKernel.Nary.Schedule B),
  DefiKernel.Nary.Complete branches schedule →
    ∀ (b : B),
      ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).failure = none ∧
          ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).nextIndex =
            List.length (branches b) ∨
        ∃ failure,
          ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).failure = some failure ∧
            failure.index = ((DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).locals b).nextIndex
