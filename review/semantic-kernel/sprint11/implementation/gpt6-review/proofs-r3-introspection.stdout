@DefiKernel.Nary.continueRun_refusal_stable : ∀ {B P A D : Type} [inst : DecidableEq B] [inst_1 : DecidableEq P]
  [inst_2 : DecidableEq A] [inst_3 : DecidableEq D] [inst_4 : Fintype P] [inst_5 : Fintype A] [inst_6 : Fintype D]
  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Nary.Boundaries B P A D)
  (branches : DefiKernel.Nary.Branches B P A D) (m : DefiKernel.Nary.Machine B P A D)
  (schedule : DefiKernel.Nary.Schedule B) (own : B) (failure : DefiKernel.Composition.LocatedFailure P A D),
  (m.locals own).failure = some failure →
    have post := DefiKernel.Nary.continueRun cfg boundaries branches m schedule;
    (post.locals own).failure = some failure ∧
      (post.locals own).events = (m.locals own).events ∧
        (post.locals own).outputs = (m.locals own).outputs ∧ (post.locals own).nextIndex = (m.locals own).nextIndex
