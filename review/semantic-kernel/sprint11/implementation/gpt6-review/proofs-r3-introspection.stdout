@DefiKernel.Nary.Reachable.attempt_exact : ∀ {B P A D : Type} [inst : DecidableEq B] [inst_1 : DecidableEq P]
  [inst_2 : DecidableEq A] [inst_3 : DecidableEq D] [inst_4 : Fintype P] [inst_5 : Fintype A] [inst_6 : Fintype D]
  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}
  {branches : DefiKernel.Nary.Branches B P A D} {initial : DefiKernel.Composition.World P A D}
  {m : DefiKernel.Nary.Machine B P A D},
  DefiKernel.Nary.Reachable cfg boundaries branches initial m →
    ∀ (i : ℕ) (attempt : DefiKernel.Nary.Attempt B P A D),
      m.attempts[i]? = some attempt →
        DefiKernel.Composition.executeStep cfg (boundaries attempt.participant attempt.index) attempt.index
              (DefiKernel.Nary.ownHistory (List.take i m.attempts) attempt.participant)
              (DefiKernel.Composition.Step.invoke attempt.invocation) attempt.before =
            attempt.outcome ∧
          attempt.index =
              (List.filterMap (DefiKernel.Nary.successfulEvent attempt.participant) (List.take i m.attempts)).length ∧
            DefiKernel.Nary.AttemptChain initial (List.take i m.attempts) attempt.before
