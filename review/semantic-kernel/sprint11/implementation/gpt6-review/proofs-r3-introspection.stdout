@DefiKernel.Nary.Reachable.analyzed_predicate_frame : ∀ {B P A D : Type} [inst : DecidableEq B] [inst_1 : DecidableEq P]
  [inst_2 : DecidableEq A] [inst_3 : DecidableEq D] [inst_4 : Fintype P] [inst_5 : Fintype A] [inst_6 : Fintype D]
  {cfg : DefiKernel.Composition.Config P A D} {boundaries : DefiKernel.Nary.Boundaries B P A D}
  {branches : DefiKernel.Nary.Branches B P A D} {initial : DefiKernel.Composition.World P A D}
  {m : DefiKernel.Nary.Machine B P A D},
  DefiKernel.Nary.Reachable cfg boundaries branches initial m →
    ∀ (order : List B) (fps : List (B × DefiKernel.Parallel.Footprint P A D)),
      (∀ (b : B), b ∈ order) →
        DefiKernel.Nary.analyzeAll cfg boundaries branches order = Except.ok fps →
          ∀ (region : Set (DefiKernel.Typed.Cell P A D)) (predicate : DefiKernel.Typed.State P A D → Prop),
            DefiKernel.Composition.Supports region predicate →
              (∀ c ∈ region, c ∉ DefiKernel.Nary.analyzedWrites fps) →
                (predicate initial.state ↔ predicate m.world.state)
