  (cfg : DefiKernel.Composition.Config P A D) (roster : DefiKernel.Nary.Roster B)
  (boundaries : DefiKernel.Nary.Boundaries B P A D) (initial : DefiKernel.Composition.World P A D)
  (branches : DefiKernel.Nary.Branches B P A D) (schedule : DefiKernel.Nary.Schedule B)
  (fps : List (B × DefiKernel.Parallel.Footprint P A D)),
  DefiKernel.Nary.analyzeAll cfg boundaries branches roster.order = Except.ok fps →
    ∀ c ∉ DefiKernel.Nary.analyzedWrites fps,
      (DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).world.state.balance c =
        initial.state.balance c
