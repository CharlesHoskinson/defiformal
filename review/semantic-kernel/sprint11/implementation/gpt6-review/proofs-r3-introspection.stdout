  (DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).attempts[i]? = some attempt →
    DefiKernel.Composition.executeStep cfg (boundaries attempt.participant attempt.index) attempt.index
          (DefiKernel.Nary.ownHistory
            (List.take i (DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).attempts)
            attempt.participant)
          (DefiKernel.Composition.Step.invoke attempt.invocation) attempt.before =
        attempt.outcome ∧
      attempt.index =
          (List.filterMap (DefiKernel.Nary.successfulEvent attempt.participant)
              (List.take i (DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).attempts)).length ∧
        DefiKernel.Nary.AttemptChain initial
          (List.take i (DefiKernel.Nary.runPrefix cfg boundaries initial branches schedule).attempts) attempt.before
