@DefiKernel.Nary.AdvanceSound.appended_option : ∀ {B P A D : Type} [inst : DecidableEq.{1} B]
  [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A] [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P]
  [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}
  {boundaries : DefiKernel.Nary.Boundaries B P A D} {branches : DefiKernel.Nary.Branches B P A D}
  {m post : DefiKernel.Nary.Machine B P A D} {b : B},
  DefiKernel.Nary.AdvanceSound cfg boundaries branches m b post →
    Eq.{1} post (m.skip b) ∧
        Eq.{1} (getElem?.{0, 0, 0} post.attempts (List.length.{0} m.attempts)) none.{0} ∧
          Eq.{1} post.attempts m.attempts ∨
      (∃ inv reason,
          Eq.{1} (m.locals b).failure none.{0} ∧
            Eq.{1} (getElem?.{0, 0, 0} (branches b) (m.locals b).consumed) (some.{0} inv) ∧
              Eq.{1}
                  (DefiKernel.Composition.executeStep cfg (boundaries b (m.locals b).nextIndex) (m.locals b).nextIndex
                    (m.locals b).outputs (DefiKernel.Composition.Step.invoke inv) m.world)
                  (Except.error.{0, 0} reason) ∧
                Eq.{1} post (m.refuse b inv reason) ∧
                  Eq.{1} (getElem?.{0, 0, 0} post.attempts (List.length.{0} m.attempts))
                    (some.{0}
                      { participant := b, index := (m.locals b).nextIndex, invocation := inv, before := m.world,
                        outcome := Except.error.{0, 0} reason })) ∨
        ∃ inv result,
          Eq.{1} (m.locals b).failure none.{0} ∧
            Eq.{1} (getElem?.{0, 0, 0} (branches b) (m.locals b).consumed) (some.{0} inv) ∧
              Eq.{1}
                  (DefiKernel.Composition.executeStep cfg (boundaries b (m.locals b).nextIndex) (m.locals b).nextIndex
                    (m.locals b).outputs (DefiKernel.Composition.Step.invoke inv) m.world)
                  (Except.ok.{0, 0} result) ∧
                Eq.{1} post (m.accept b inv result) ∧
                  Eq.{1} (getElem?.{0, 0, 0} post.attempts (List.length.{0} m.attempts))
                    (some.{0}
                      { participant := b, index := (m.locals b).nextIndex, invocation := inv, before := m.world,
                        outcome := Except.ok.{0, 0} result })
@DefiKernel.Nary.AdvanceSound.eq_advance : ∀ {B P A D : Type} [inst : DecidableEq.{1} B] [inst_1 : DecidableEq.{1} P]
  [inst_2 : DecidableEq.{1} A] [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P] [inst_5 : Fintype.{0} A]
