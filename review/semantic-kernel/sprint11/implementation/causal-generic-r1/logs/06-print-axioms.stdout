@DefiKernel.Nary.continueMonitored_initialized : ∀ {B P A D : Type} [inst : DecidableEq.{1} B]
  [inst_1 : DecidableEq.{1} P] [inst_2 : DecidableEq.{1} A] [inst_3 : DecidableEq.{1} D] [inst_4 : Fintype.{0} P]
  [inst_5 : Fintype.{0} A] [inst_6 : Fintype.{0} D] {Q : Type} (cfg : DefiKernel.Composition.Config P A D)
  (boundaries : DefiKernel.Nary.Boundaries B P A D) (branches : DefiKernel.Nary.Branches B P A D)
  (update : Q → DefiKernel.Nary.MonitorInput B P A D → Q) (entry : Prod.{0, 0} Q (DefiKernel.Nary.Machine B P A D))
  (K : DefiKernel.Nary.JointInvariant Q B P A D) (invariant : B → DefiKernel.Typed.State P A D → Prop)
  (guarantee rely : B → DefiKernel.Typed.State P A D → DefiKernel.Typed.State P A D → Prop)
  (assumption : DefiKernel.Nary.AssumptionFamily B Q P A D) (external : DefiKernel.Nary.ExternalFamily B Q P A D),
  K entry.1 entry.2 →
    DefiKernel.Nary.InvariantDerivation K invariant →
      DefiKernel.Nary.AssumptionDerivation K assumption external →
        DefiKernel.Nary.PresentExternal K external →
          DefiKernel.Nary.SelectedSuccessGuarantee cfg boundaries branches invariant guarantee assumption →
            DefiKernel.Nary.GuaranteeInclusion guarantee rely →
              DefiKernel.Nary.RelyStable invariant rely →
                DefiKernel.Nary.SkipUpdateObligation cfg boundaries branches update K →
                  DefiKernel.Nary.RefusalUpdateObligation cfg boundaries branches update K →
                    DefiKernel.Nary.SuccessUpdateObligation cfg boundaries branches update K invariant guarantee
                        assumption →
                      ∀ (schedule : DefiKernel.Nary.Schedule B),
                        K (DefiKernel.Nary.continueMonitored cfg boundaries branches update entry schedule).1
                            (DefiKernel.Nary.continueMonitored cfg boundaries branches update entry schedule).2 ∧
                          ∀ (b : B),
                            invariant b
                              (DefiKernel.Nary.continueMonitored cfg boundaries branches update entry
                                      schedule).2.world.state
