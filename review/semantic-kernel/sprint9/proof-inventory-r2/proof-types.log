METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Configuration","name":"DefiKernel.Metatheory.advance_config_eq","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  {old new : DefiKernel.Composition.Config P A D} {refs : DefiKernel.Metatheory.ReferenceSet},\n  @DefiKernel.Metatheory.ConfigAgreement P A D inst inst_1 inst_2 old new refs →\n    ∀ (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (cursor : DefiKernel.Composition.Cursor P A D)\n      (step : DefiKernel.Composition.Step P A D),\n      @DefiKernel.Metatheory.SupportedStep P A D refs step →\n        @Eq.{1} (DefiKernel.Composition.Cursor P A D)\n          (@DefiKernel.Composition.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 old boundaries cursor step)\n          (@DefiKernel.Composition.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 new boundaries cursor step)","user_name":"DefiKernel.Metatheory.advance_config_eq"}
