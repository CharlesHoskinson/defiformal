METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.OperatorLifting","name":"DefiKernel.Metatheory.atomic_runPrefix_config_eq","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  {old new : DefiKernel.Composition.Config P A D} {refs : DefiKernel.Metatheory.ReferenceSet},\n  @DefiKernel.Metatheory.ConfigAgreement P A D inst inst_1 inst_2 old new refs →\n    ∀ (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n      (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n      (schedule : DefiKernel.Interleaving.Schedule),\n      @DefiKernel.Metatheory.SupportedBranch P A D refs left →\n        @DefiKernel.Metatheory.SupportedBranch P A D refs right →\n          @Eq.{1} (DefiKernel.Atomic.Machine P A D)\n            (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 old boundaries policy initial\n              left right schedule)\n            (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 new boundaries policy initial\n              left right schedule)","user_name":"DefiKernel.Metatheory.atomic_runPrefix_config_eq"}
METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Configuration","name":"DefiKernel.Metatheory.continueRun_config_eq","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  {old new : DefiKernel.Composition.Config P A D} {refs : DefiKernel.Metatheory.ReferenceSet},\n  @DefiKernel.Metatheory.ConfigAgreement P A D inst inst_1 inst_2 old new refs →\n    ∀ (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (cursor : DefiKernel.Composition.Cursor P A D)\n      (steps : List.{0} (DefiKernel.Composition.Step P A D)),\n      @DefiKernel.Metatheory.SupportedList P A D refs steps →\n        @Eq.{1} (DefiKernel.Composition.Cursor P A D)\n          (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 old boundaries cursor\n            steps)\n          (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 new boundaries cursor\n            steps)","user_name":"DefiKernel.Metatheory.continueRun_config_eq"}
METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Observation","name":"DefiKernel.Metatheory.cursorEq_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  (left right : DefiKernel.Composition.Cursor P A D),\n  Iff\n    (@Eq.{1} Bool (@DefiKernel.Metatheory.cursorEq P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 left right) Bool.true)\n    (@DefiKernel.Metatheory.CursorEquivalent P A D left right)","user_name":"DefiKernel.Metatheory.cursorEq_iff"}
METATHEORY_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Observation","name":"DefiKernel.Metatheory.cursorEquivalent_iff_fields","statement":"∀ {P A D : Type} (left right : DefiKernel.Composition.Cursor P A D),\n  Iff (@DefiKernel.Metatheory.CursorEquivalent P A D left right)\n    (And\n      (@Eq.{1} (DefiKernel.Composition.World P A D) (@DefiKernel.Composition.Cursor.world P A D left)\n        (@DefiKernel.Composition.Cursor.world P A D right))\n      (And\n        (@Eq.{1} (List.{0} (DefiKernel.Parallel.EventObservation P A D))\n          (@List.map.{0, 0} (DefiKernel.Composition.Event P A D) (DefiKernel.Parallel.EventObservation P A D)\n            (@DefiKernel.Parallel.observeEvent P A D) (@DefiKernel.Composition.Cursor.events P A D left))\n          (@List.map.{0, 0} (DefiKernel.Composition.Event P A D) (DefiKernel.Parallel.EventObservation P A D)\n            (@DefiKernel.Parallel.observeEvent P A D) (@DefiKernel.Composition.Cursor.events P A D right)))\n        (And\n          (@Eq.{1} (List.{0} (DefiKernel.Composition.OutputObservation A))\n            (@DefiKernel.Composition.Cursor.outputs P A D left) (@DefiKernel.Composition.Cursor.outputs P A D right))\n          (And\n            (@Eq.{1} Nat (@DefiKernel.Composition.Cursor.nextIndex P A D left)\n              (@DefiKernel.Composition.Cursor.nextIndex P A D right))\n            (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n              (@DefiKernel.Composition.Cursor.failure P A D left)\n              (@DefiKernel.Composition.Cursor.failure P A D right))))))","user_name":"DefiKernel.Metatheory.cursorEquivalent_iff_fields"}
METATHEORY_PROOF_JSON {"axioms":["propext"],"is_private_name":false,"module":"DefiKernel.Metatheory.Observation","name":"DefiKernel.Metatheory.eventEq_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (left right : DefiKernel.Parallel.EventObservation P A D),\n  Iff (@Eq.{1} Bool (@DefiKernel.Metatheory.eventEq P A D inst inst_1 inst_2 left right) Bool.true)\n    (@Eq.{1} (DefiKernel.Parallel.EventObservation P A D) left right)","user_name":"DefiKernel.Metatheory.eventEq_iff"}
METATHEORY_PROOF_JSON {"axioms":["propext"],"is_private_name":false,"module":"DefiKernel.Metatheory.Observation","name":"DefiKernel.Metatheory.eventsEq_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (left right : List.{0} (DefiKernel.Parallel.EventObservation P A D)),\n  Iff (@Eq.{1} Bool (@DefiKernel.Metatheory.eventsEq P A D inst inst_1 inst_2 left right) Bool.true)\n    (@Eq.{1} (List.{0} (DefiKernel.Parallel.EventObservation P A D)) left right)","user_name":"DefiKernel.Metatheory.eventsEq_iff"}
METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Configuration","name":"DefiKernel.Metatheory.executeStep_config_eq","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D]\n  {old new : DefiKernel.Composition.Config P A D} {refs : DefiKernel.Metatheory.ReferenceSet},\n  @DefiKernel.Metatheory.ConfigAgreement P A D inst inst_1 inst_2 old new refs →\n    ∀ (boundary : DefiKernel.Composition.Boundary P A D) (index : Nat)\n      (history : List.{0} (DefiKernel.Composition.OutputObservation A)) (step : DefiKernel.Composition.Step P A D)\n      (pre : DefiKernel.Composition.World P A D),\n      @DefiKernel.Metatheory.SupportedStep P A D refs step →\n        @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D))\n          (@DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 old boundary index history\n            step pre)\n          (@DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 new boundary index history\n            step pre)","user_name":"DefiKernel.Metatheory.executeStep_config_eq"}
METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Configuration","name":"DefiKernel.Metatheory.extractReceipt_config_eq","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  {old new : DefiKernel.Composition.Config P A D} {refs : DefiKernel.Metatheory.ReferenceSet},\n  @DefiKernel.Metatheory.ConfigAgreement P A D inst inst_1 inst_2 old new refs →\n    ∀ (boundary : DefiKernel.Composition.Boundary P A D) (request : DefiKernel.Typed.Request P A D)\n      (pre : DefiKernel.Composition.World P A D),\n      @Membership.mem.{0, 0} DefiKernel.Typed.OperationId (Set.{0} DefiKernel.Typed.OperationId)\n          (@Set.instMembership.{0} DefiKernel.Typed.OperationId) refs.operations\n          (@DefiKernel.Typed.Request.operation P A D request) →\n        @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Typed.Evaluated P A D))\n          (@DefiKernel.Composition.extractReceipt P A D inst_1 old boundary request pre)\n          (@DefiKernel.Composition.extractReceipt P A D inst_1 new boundary request pre)","user_name":"DefiKernel.Metatheory.extractReceipt_config_eq"}
METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Contexts","name":"DefiKernel.Metatheory.groupEquivalent_assoc","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : Nat → DefiKernel.Composition.Boundary P A D)\n  (first second third : DefiKernel.Metatheory.SeqGroup P A D),\n  @DefiKernel.Metatheory.GroupEquivalent P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n    (@DefiKernel.Metatheory.SeqGroup.seq P A D (@DefiKernel.Metatheory.SeqGroup.seq P A D first second) third)\n    (@DefiKernel.Metatheory.SeqGroup.seq P A D first (@DefiKernel.Metatheory.SeqGroup.seq P A D second third))","user_name":"DefiKernel.Metatheory.groupEquivalent_assoc"}
METATHEORY_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Contexts","name":"DefiKernel.Metatheory.groupEquivalent_empty_left","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : Nat → DefiKernel.Composition.Boundary P A D) (group : DefiKernel.Metatheory.SeqGroup P A D),\n  @DefiKernel.Metatheory.GroupEquivalent P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n    (@DefiKernel.Metatheory.SeqGroup.seq P A D (@DefiKernel.Metatheory.SeqGroup.empty P A D) group) group","user_name":"DefiKernel.Metatheory.groupEquivalent_empty_left"}
