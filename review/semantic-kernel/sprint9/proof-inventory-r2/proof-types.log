METATHEORY_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Metatheory.Observation","name":"DefiKernel.Metatheory.CursorEquivalent.eq_1","statement":"∀ {P A D : Type} (left right : DefiKernel.Composition.Cursor P A D),\n  @Eq.{1} Prop (@DefiKernel.Metatheory.CursorEquivalent P A D left right)\n    (And\n      (∀ (cell : DefiKernel.Typed.Cell P A D),\n        @Eq.{1} Rat\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D left)) cell)\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Composition.Cursor.world P A D right)) cell))\n      (And\n        (@Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Composition.Cursor.world P A D left))\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Composition.Cursor.world P A D right)))\n        (@Eq.{1} (DefiKernel.Parallel.BranchObservation P A D) (@DefiKernel.Parallel.observeBranch P A D left)\n          (@DefiKernel.Parallel.observeBranch P A D right))))","user_name":"DefiKernel.Metatheory.CursorEquivalent.eq_1"}
