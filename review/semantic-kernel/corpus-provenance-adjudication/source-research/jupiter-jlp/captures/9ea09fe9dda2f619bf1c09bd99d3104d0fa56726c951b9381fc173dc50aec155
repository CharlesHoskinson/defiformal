title\":\"Craft Clawback (Beta)\",\"description\":\"Reclaim tokens from an unclaimed Send invite before it expires.\",\"llmsDescription\":\"Use the POST /send/v1/craft-clawback endpoint to reclaim tokens from an unclaimed Send invite before it expires.\",\"href\":\"/send/craft-clawback\"},{\"title\":\"Manage Invites (Beta)\",\"description\":\"Query pending and historical Send invites for a wallet address.\",\"llmsDescription\":\"Query pending and historical Send invites using the /send/v1/pending-invites and /send/v1/invite-history endpoints.\",\"href\":\"/send/manage-invites\"}]},{\"group\":\"Studio\",\"tag\":\"BETA\",\"pages\":[{\"title\":\"Jupiter Studio Overview\",\"sidebarTitle\":\"About Studio\",\"description\":\"Jupiter Studio provides APIs for token creation with flexible bonding curves, LP fee management, vesting schedules, and dedicated token pages on jup.ag.\",\"href\":\"/studio/index\"},{\"title\":\"Create Token (Beta)\",\"description\":\"Launch a token with configurable bonding curves, metadata, and images through the Studio API.\",\"llmsDescription\":\"Use the Studio API create-tx and submit endpoints to launch a token with configurable bonding curves, upload metadata and images, and submit the signed transaction.\",\"href\":\"/studio/create-token\"},{\"title\":\"Claim Fee (Beta)\",\"description\":\"Check and claim unclaimed LP fees from Dynamic Bonding Curve pools.\",\"llmsDescription\":\"Retrieve pool addresses, check unclaimed LP fees, and claim fees from Dynamic Bonding Curve pools using the Studio API fee endpoints.\",\"href\":\"/studio/claim-fee\"}]},{\"group\":\"Lock\",\"pages\":[{\"title\":\"Jupiter Lock Overview\",\"sidebarTitle\":\"About Lock\",\"description\":\"Jupiter Lock is an open-sourced, audited, and free ecosystem tool to lock and distribute tokens over-time.\",\"llmsDescription\":\"Jupiter Lock (Program ID: LocpQgucEQHbqNABEYvBvwoxCPsSbG91A1QaQhQQqjn) is an open-source, audited, and free tool for locking and vesting tokens over time on Solana.\",\"href\":\"/lock/index\"}]},{\"group\":\"Perps\",\"pages\":[{\"title\":\"Jupiter Perpetuals Overview\",\"sidebarTitle\":\"About Perps API\",\"description\":\"Overview of Jupiter Perps API for leverage trading on Solana\",\"llmsDescription\":\"Jupiter Perpetuals program for leveraged trading on Solana. Work-in-progress documentation covering account structures and the Anchor IDL.\",\"href\":\"/perps/index\"},{\"title\":\"Position Account\",\"description\":\"Overview of the Position account used in the Jupiter Perpetuals Program, representing trade position data for a given token\",\"llmsDescription\":\"The Position account stores trade position data including owner, side (long/short), entry price, size, collateral, PNL, and borrow fee snapshot. Derived from the trader's wallet, custody, and collateral custody.\",\"href\":\"/perps/position-account\"},{\"title\":\"PositionRequest Account\",\"description\":\"Overview of the PositionRequest account used in the Jupiter Perpetuals Program, representing a request to open or close a position\",\"llmsDescription\":\"The PositionRequest account represents a pending request to open, close, or modify a position, including TP/SL triggers. It is a PDA derived from the Position account with a unique random seed.\",\"href\":\"/perps/position-request-account\"},{\"title\":\"Pool Account\",\"description\":\"Overview of the Pool account used in the Jupiter Perpetuals Program, representing data for the JLP pool including AUM and Custody data\",\"llmsDescription\":\"The Pool account stores JLP pool configuration including AUM (aumUsd), custody public keys, position limits, fee schedules (open/close/swap), and APR calculation data. Only one Pool account exists.\",\"href\":\"/perps/pool-account\"},{\"title\":\"Custody Account\",\"description\":\"Overview of the Custody account used in the Jupiter Perpetuals Program, representing tokens managed by the JLP pool\",\"llmsDescription\":\"The Custody account stores parameters and state for each token (SOL, ETH, BTC, USDC, USDT, JupUSD) managed by the JLP pool, including oracle data, pricing params, asset balances, and funding rate state.\",\"href\":\"/perps/custody-account\"}]},{\"group\":\"API Reference\",\"pages\":[{\"group\":\"Portfolio\",\"pages\":[{\"openapi\":\"openapi-spec/portfolio/portfolio.yaml get /positions/{address}\",\"title\":\"Get Positions\",\"description\":\"Request for Jupiter positions of an address\",\"href\":\"/api-reference/portfolio/get-positions\"},{\"openapi\":\"openapi-spec/portfolio/portfolio.yaml get /staked-jup/{address}\",\"title\":\"Get Staked JUP\",\"description\":\"Request for staked JUP information of an address\",\"href\":\"/api-reference/portfolio/get-staked-jup\"},{\"openapi\":\"openapi-spec/portfolio/portfolio.yaml get /platforms\",\"title\":\"Get Platforms\",\"description\":\"Request for platform information\",\"href\":\"/api-reference/portfolio/get-platforms\"}]},{\"group\":\"Send\",\"pages\":[{\"openapi\":\"openapi-spec/send/send.yaml post /craft-send\",\"title\":\"Craft Send\",\"description\":\"Request for a base64-encoded unsigned Send transaction\",\"href\":\"/api-reference/send/craft-send\"},{\"openapi\":\"openapi-spec/send/send.yaml post /craft-clawback\",\"title\":\"Craft Clawback\",\"description\":\"Request for a base64-encoded unsigned Send transaction\",\"href\":\"/api-reference/send/craft-clawback\"},{\"openapi\":\"openapi-spec/send/send.yaml get /pending-invites\",\"title\":\"Pending Invites\",\"description\":\"Request for the pending invites of an address\",\"href\":\"/api-reference/send/pending-invites\"},{\"openapi\":\"openapi-spec/send/send.yaml get /invite-history\",\"title\":\"Invite History\",\"description\":\"Request for the invite history of an address\",\"href\":\"/api-reference/send/invite-history\"}]},{\"group\":\"Studio\",\"pages\":[{\"openapi\":\"openapi-spec/studio/studio.yaml post /dbc-pool/create-tx\",\"title\":\"DBC Pool Create TX\",\"description\":\"Request for a base64-en