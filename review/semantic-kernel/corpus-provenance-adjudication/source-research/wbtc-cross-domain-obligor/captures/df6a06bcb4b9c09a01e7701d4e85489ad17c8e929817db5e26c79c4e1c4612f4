css-module__JIqztW__page\",\"children\":[[\"$\",\"$L6\",null,{}],[\"$\",\"$L7\",null,{}],[\"$\",\"div\",null,{\"className\":\"page-module-scss-module__JIqztW__body\",\"children\":[[\"$\",\"$L8\",null,{}],[\"$\",\"article\",null,{\"className\":\"page-module-scss-module__JIqztW__article\",\"children\":[[\"$\",\"$L9\",null,{}],[\"$\",\"h1\",null,{\"children\":\"WBTC Whitepaper\"}],[\"$\",\"p\",null,{\"className\":\"page-module-scss-module__JIqztW__lede\",\"children\":\"A multi-institutional framework for tokenizing any asset, introducing an ERC20 token backed 1:1 by Bitcoin and governed by a federation of participating institutions.\"}],[\"$\",\"h2\",null,{\"id\":\"abstract\",\"children\":\"Abstract\"}],[\"$\",\"p\",null,{\"children\":\"With the rise in popularity of ERC20, digital tokens in the Ethereum ecosystem have emerged as an important asset class. These tokens have all the advantages that blockchains and Ethereum have to offer in terms of transparency in total number of coins, owners, minting, fast confirmation times, transactions details and smart contract execution. Tokens on the Ethereum blockchain can serve several different functions; this paper will specifically focus on asset backed or wrapped tokens. The prices of these tokens reflect the price of the asset backing them and hence they can also be called \\\"stable coins\\\". Asset backed tokens are usually done in two different ways:\"}],[\"$\",\"h3\",null,{\"id\":\"algorithmic\",\"children\":\"Algorithmic\"}],[\"$\",\"p\",null,{\"children\":\"This is a mechanism followed by some tokens on Ethereum where demand and supply are controlled by smart contracts in order to keep the price of the token in line with a fiat currency. Some examples of this are Dai, Basis, Carbon, and NuBits\"}],[\"$\",\"h3\",null,{\"id\":\"centralized\",\"children\":\"Centralized\"}],[\"$\",\"p\",null,{\"children\":\"Assets are stored with an organization which publishes proof of reserves. This is the case with Tether, True USD, USDC (USD), Digix (gold), Globcoin (a mix of fiat currencies), and AAA reserve (governmental bonds)\"}],[\"$\",\"p\",null,{\"children\":\"Wrapped tokens follow the centralized model, but instead of relying entirely on one institution, they rely on a consortium of institutions performing different roles in the network. This whitepaper proposes a framework for issuing asset backed tokens by addressing challenges with scalability, trust, regulation, and governance. The first wrapped token we launch will be an ERC20 token backed by Bitcoin (BTC) and will be appropriately named, \\\"Wrapped BTC\\\" (WBTC). Unlike centralized solutions (USD), WBTC will be fully accounted for and proof of reserves posted on the BTC chain.\"}],\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\",\"$L41\",\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\",\"$L57\",\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\",\"$L5e\",\"$L5f\",\"$L60\",\"$L61\",\"$L62\",\"$L63\",\"$L64\"]}],\"$L65\"]}]]}],[\"$L66\",\"$L67\"],\"$L68\"]}],{},null,false,null]},null,false,\"$69\"]},null,false,null]},null,false,null],\"$L6a\",false]],\"m\":\"$undefined\",\"G\":[\"$6b\",[\"$L6c\"]],\"S\":true,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"ubGQLWjeCPsH6XnG8ykmv\"}\n6d:I[3079,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/static/chunks/0ijqztxlruv0a.js\",\"/_next/static/chunks/0t_o1iwg-smnl.js\",\"/_next/static/chunks/1wr2r7g-dhhdx.js\",\"/_next/static/chunks/0zyl3aern4whw.js\",\"/_next/static/chunks/2ay7bovkvz4jr.js\",\"/_next/static/chunks/3hs7wat7athru.js\",\"/_next/static/chunks/21o5nv935rolz.js\"],\"WhitepaperPager\"]\n6e:I[3079,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/static/chunks/0ijqztxlruv0a.js\",\"/_next/static/chunks/0t_o1iwg-smnl.js\",\"/_next/static/chunks/1wr2r7g-dhhdx.js\",\"/_next/static/chunks/0zyl3aern4whw.js\",\"/_next/static/chunks/2ay7bovkvz4jr.js\",\"/_next/static/chunks/3hs7wat7athru.js\",\"/_next/static/chunks/21o5nv935rolz.js\"],\"WhitepaperOnThisPage\"]\n6f:I[97367,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/static/chunks/0ijqztxlruv0a.js\",\"/_next/static/chunks/0t_o1iwg-smnl.js\",\"/_next/static/chunks/1wr2r7g-dhhdx.js\",\"/_next/static/chunks/0zyl3aern4whw.js\"],\"OutletBoundary\"]\n70:\"$Sreact.suspense\"\n72:I[97367,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/static/chunks/0ijqztxlruv0a.js\",\"/_next/static/chunks/0t_o1iwg-smnl.js\",\"/_next/static/chunks/1wr2r7g-dhhdx.js\",\"/_next/static/chunks/0zyl3aern4whw.js\"],\"ViewportBoundary\"]\n74:I[97367,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/static/chunks/0ijqztxlruv0a.js\",\"/_next/static/chunks/0t_o1iwg-smnl.js\",\"/_next/static/chunks/1wr2r7g-dhhdx.js\",\"/_next/static/chunks/0zyl3aern4whw.js\"],\"MetadataBoundary\"]\na:[\"$\",\"p\",null,{\"children\":\"There is no additional secondary utility/payment token required to use WBTC, and no transfer fees other than blockchain fees. WBTC uses a simple federated governance model and strives to promote usability.\"}]\nb:[\"$\",\"h2\",null,{\"id\":\"use-cases\",\"children\":\"Use Cases\"}]\nc:[\"$\",\"h3\",null,{\"id\":\"tokenization\",\"children\":\"Tokenization\"}]\nd:[\"$\",\"p\",null,{\"children\":\"The act of tokenizing assets can:\"}]\ne:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Increase speed of transactions\"}],[\"$\",\"p\",null,{\"children\":\"Ethereum blocks are created every ~15 seconds and it is possible to have a fair deal of confidence in the irrevocability of a transaction in less than 5 minutes. This speed is faster than transacting natively compared to many other assets including Bitcoin, gold, and fiat currencies\"}]]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Reduce the number of intermediaries\"}],[\"$\",\"p\",null,{\"children\":\"One of the key benefits of assets on a blockchain is their ability to be transacted without intermediaries. This can be done through atomic swaps, decentralized exchange protocols, and lightning/raiden style channels.\"}]]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Enhance security\"}],[\"$\",\"p\",null,{\"children\":\"Tokenization enables users to have full control of private keys of the asset. Users who do not want to hold keys can reduce counterparty risk by moving it from exchanges to a security-focused custodian.\"}]]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Usability\"}],[\"$\",\"p\",null,{\"children\":\"The ERC20 standard has been adopted by a large number of institutions and products. This provides users with a variety of exchanges, wallets, and Dapps to use while handling their tokenized asset. They also have the ability to move tokens quickly, 24/7.\"}]]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Improve Transparency\"}],[\"$\",\"p\",null,{\"children\":\"The total number of tokens, token creation transactions, token removal transactions, number of token holders, and rules for transfers can be seen on a public block explorer by anyone. This level of transparency is not usually available for assets like fiat currencies, commodities, and stock.\"}]]}]]}]\nf:[\"$\",\"h3\",null,{\"id\":\"liquidity\",\"children\":\"Liquidity on decentralized exchanges and dapps\"}]\n10:[\"$\",\"p\",null,{\"children\":\"The majority of ERC20 trading in centralized exchanges today is done with BTC and not ETH. Most decentralized exchanges offer only ETH/Token and not BTC/Token trades. Wrapped tokens can bridge this gap and provide more liquidity on decentralized exchanges. In addition, other decentralized applications/protocols (like funds, lending payments) will also benefit from having access to greater liquidity that a BTC token can bring. WBTC brings the ease of creation of smart contracts to Bitcoin.\"}]\n11:[\"$\",\"h3\",null,{\"id\":\"benefits-of-fiat-tokens\",\"children\":\"Benefits of fiat tokens\"}]\n12:[\"$\",\"p\",null,{\"children\":\"Tokens backed by fiat currencies offer a safe way for traders to keep their money in a cryptocurrency without having to worry about price fluctuations. This is particularly useful for traders on both centralized and decentralized exchanges where there is no direct way of transferring fiat currencies. Fiat currency backed tokens also promise a world in which a cryptocurrency can replace traditional finance. Notably, it can be used in e-commerce by both buyer and seller without having to worry about conversion rates or taxes (buyers are required to pay capital gains tax calculated at the time of purchase in the US).\"}]\n13:[\"$\",\"h3\",null,{\"id\":\"interoperability\",\"children\":\"Interoperability between cryptocurrencies\"}]\n14:[\"$\",\"p\",null,{\"children\":\"As we see an expansion in the number of cryptocurrencies today, each one focuses on some aspect of monetary exchange. Some such aspects are transactional throughput, privacy, cheap transaction fees, smart contract ability, and decentralization of nodes/miners. The wrapped framework would make it easy to represent any other cryptocurrency, such as Bitcoin, on Ethereum and thereby enhance it with all the capabilities of the Ethereum blockchain. One such use case is the ability for initial coin offerings (ICOs) to be directly funded and mint tokens on deposits of wrapped Bitcoin tokens. In the future, centralized exchanges and other institutions which accept cryptocurrencies would not need to maintain multiple cryptocurrency nodes and instead could just develop on Ethereum.\"}]\n15:[\"$\",\"h3\",null,{\"id\":\"on-chain-policies\",\"children\":\"On chain ways to enforce policies\"}]\n16:[\"$\",\"p\",null,{\"children\":\"Tokenization also provides a way to enforce policies on chain. On chain policy enforcement makes rules more transparent and doesn’t rely on one single party to enforce them. Based on the type of asset, there could be a need to enforce rules on asset transfer or trade. Securities for example require whitelisting, holding periods, and identity management.\"}]\n17:[\"$\",\"h2\",null,{\"id\":\"common-issues\",\"children\":\"Common Issues\"}]\n18:[\"$\",\"h3\",null,{\"id\":\"scalability\",\"children\":\"Scalability\"}]\n19:[\"$\",\"p\",null,{\"children\":[\"As of January 2018, the maximum practical gas limit on Ethereum’s mainnet topped out at 8,000,000 gas per block\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-1\",\"children\":\"[1]\"}]}],\". This limit is both hardware and software-bound. While there are several scalability solutions proposed, many require significant developer lift (state channels), or are too early in development for practical use (plasma, sharding). This is a problem for Dapps and users of the network because gas prices skyrocket during periods of contention (hot ICOs, CryptoKitties). Earlier this year in July, transactions caused by Chinese exchange Fcoin caused all time high transaction fees\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-2\",\"children\":\"[2]\"}]}],\".\"]}]\n1a:[\"$\",\"h3\",null,{\"id\":\"trust\",\"children\":\"Trust\"}]\n1b:[\"$\",\"p\",null,{\"children\":\"Asset backed tokens usually involve trust in the institution(s) holding the asset. This goes against the ethos of cryptocurrencies which seeks to minimize need for trust in operations. Some key questions to answer here are:\"}]\n1c:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Is the asset holder authorized in the existing legal framework to hold the asset?\"}],[\"$\",\"li\",null,{\"children\":\"Can the custodian create an arbitrary amount of tokens?\"}],[\"$\",\"li\",null,{\"children\":\"How does the custodian prove possession of the asset under custody?\"}]]}]\n1d:[\"$\",\"h3\",null,{\"id\":\"regulation\",\"children\":\"Regulation\"}]\n1e:[\"$\",\"p\",null,{\"children\":\"Custodians of asset backed tokens need to be licensed to hold the asset. This license may vary based on the asset and geographical jurisdiction of the custodian. Custodians must also prove reserves regularly given that a lack of 1:1 backing would undermine the whole system. KYC and AML restrictions also apply to users engaging in asset backed tokens. These restrictions need to be enforced at the time of purchase, redemption, or transfer of tokens.\"}]\n1f:[\"$\",\"h3\",null,{\"id\":\"governance-challenge\",\"children\":\"Governance\"}]\n20:[\"$\",\"p\",null,{\"children\":[\"When there are multiple stakeholders in the system, there is a governance challenge with how to handle changes made to the token. Most asset backed tokens are entirely reliant on the asset custodian to make changes to the rules/smart contract governing the token. Usually in the case of ICOs, the issuer of the token has full control of protocol changes. There have been some cases like decentralized autonomous initial coin offerings (DAICOs) where users have voting rights, but they face the challenge of a low voter turnout\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-3\",\"children\":\"[3]\"}]}],\".\"]}]\n21:[\"$\",\"h2\",null,{\"id\":\"implementation\",\"children\":\"Implementation and Technology\"}]\n22:[\"$\",\"figure\",null,{\"className\":\"page-module-scss-module__JIqztW__figure\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/whitepaper/framework.webp\",\"alt\":\"Diagram of the wrapped tokens framework: custodians at the top, merchants in the middle, and customers at the bottom, connected by dotted lines\",\"width\":1448,\"height\":1086,\"loading\":\"lazy\"}]}]\n23:[\"$\",\"h3\",null,{\"id\":\"key-roles\",\"children\":\"Key Roles\"}]\n24:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Custodian\"}],\" - The institution or party who holds the asset. In the case of WBTC, this will be played by BitGo\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-4\",\"children\":\"[4]\"}]}],\". Custodians hold the keys to mint tokens.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Merchant\"}],\" - The institution or party to which wrapped tokens will be minted to and burnt from. Merchants play a key role in distribution of the wrapped token. In the case of WBTC, this will be played initially by Kyber\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-5\",\"children\":\"[5]\"}]}],\" \",\"and Republic Protocol\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-6\",\"children\":\"[6]\"}]}],\". Each merchant holds a key to initiate minting of new wrapped tokens and burning of wrapped tokens.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"User\"}],\" - The holders of the wrapped token. Users can use wrapped tokens to transfer and transact like any other ERC20 token in the Ethereum ecosystem.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"WBTC DAO member\"}],\" - Contract changes and addition/removal of custodians and merchants will be controlled by a multi-signature contract. Holders of the keys to the multi-sig contract will be held by institutions as part of the WBTC DAO.\"]}]]}]\n25:[\"$\",\"p\",null,{\"children\":\"Custodians exchange assets for wrapped tokens with merchants. This is done through two different types of transactions; minting (creation of wrapped tokens) and burning (reducing supply of wrapped tokens). These transactions will be available publicly and can be viewed by anyone through a block explorer. After the initial exchange, merchants aim to maintain a buffer of wrapped tokens so that they can exchange it with users. The two-step minting process helps reduce the time it takes for users to get wrapped tokens, as minting and burning are more time consuming processes.\"}]\n26:[\"$\",\"h3\",null,{\"id\":\"custodian-wallet-setup\",\"children\":\"Custodian wallet setup\"}]\n27:[\"$\",\"p\",null,{\"children\":\"Custodians are expected to have a pooled wallet for all merchants. The wallet will use multi-signature with all keys controlled by the custodian. The wallet will only be able to send to the whitelisted merchant address on chain. All minting and burning transactions are expected to be done within 48 hours of submission to the custodian. Note that in case of multiple custodians, a single wallet might not have enough funds to redeem all pending wrapped tokens.\"}]\n28:[\"$\",\"h3\",null,{\"id\":\"minting\",\"children\":\"Minting\"}]\n29:[\"$\",\"p\",null,{\"children\":\"Minting refers to the process of creating new wrapped tokens. Minting in the wrapped framework has to be done by a custodian, but needs to be “initiated” by a merchant. It is important to note that minting does not involve the user. It is a set of transactions done between the merchant and the custodian.\"}]\n2a:[\"$\",\"figure\",null,{\"className\":\"page-module-scss-module__JIqztW__figure\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/whitepaper/minting.webp\",\"alt\":\"Minting sequence diagram: the merchant initiates a mint, sends Bitcoin to the custodian, the custodian mints WBTC through the wrapped token contract, and WBTC tokens are returned to the merchant\",\"width\":1448,\"height\":1086,\"loading\":\"lazy\"}]}]\n2b:[\"$\",\"h3\",null,{\"children\":\"Sequence of minting events for WBTC\"}]\n2c:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Merchant initiates a transaction to authorize the custodian to mint X WBTC to the merchant’s address on the Ethereum chain.\"}],[\"$\",\"li\",null,{\"children\":\"The merchant sends the custodian X BTC.\"}],[\"$\",\"li\",null,{\"children\":\"Custodian waits for 6 confirmations of the BTC transaction\"}],[\"$\",\"li\",null,{\"children\":\"Custodian creates a transaction to mint X new WBTC tokens on the Ethereum chain\"}]]}]\n2d:[\"$\",\"figure\",null,{\"className\":\"page-module-scss-module__JIqztW__figure\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/whitepaper/swap-user-wbtc.webp\",\"alt\":\"User swap diagram: the customer sends KYC/AML information and Bitcoin to the merchant and receives WBTC tokens in return\",\"width\":2095,\"height\":750,\"loading\":\"lazy\"}]}]\n2e:[\"$\",\"h3\",null,{\"children\":\"Sequence of events for users to receive WBTC tokens\"}]\n2f:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"User requests wrapped tokens from a merchant\"}],[\"$\",\"li\",null,{\"children\":\"The merchant does the required AML, KYC procedures and gets identification information from the user\"}],[\"$\",\"li\",null,{\"children\":[\"The user and merchant perform an \",[\"$\",\"strong\",null,{\"children\":\"atomic swap\"}],\", or use a trusted exchange with the merchant receiving Bitcoin and the user receiving WBTC\"]}]]}]\n30:[\"$\",\"h3\",null,{\"id\":\"burning\",\"children\":\"Burning\"}]\n31:[\"$\",\"p\",null,{\"children\":\"Burning refers to the action of redeeming BTC for WBTC tokens. Only merchant addresses can burn wrapped tokens. In order to do so, the ‘burn’ function is called in the contract with the amount of tokens to be burnt on the Ethereum chain. By doing so, the amount is deducted from the merchant’s WBTC balance (on chain) and the supply of WBTC is reduced.\"}]\n32:[\"$\",\"figure\",null,{\"className\":\"page-module-scss-module__JIqztW__figure\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/whitepaper/burning.webp\",\"alt\":\"Burning sequence diagram: the custodian sends a BTC transaction to the merchant, the merchant burns WBTC through the wrapped token contract, and the custodian confirms the burn\",\"width\":1438,\"height\":1093,\"loading\":\"lazy\"}]}]\n33:[\"$\",\"h3\",null,{\"children\":\"Sequence of events for burning WBTC tokens\"}]\n34:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"The merchant creates a burn transaction, burning X WBTC tokens\"}],[\"$\",\"li\",null,{\"children\":\"Custodian waits for 25 block confirmations of the ETH transaction\"}],[\"$\",\"li\",null,{\"children\":\"Custodian releases X BTC to the merchants Bitcoin address\"}],[\"$\",\"li\",null,{\"children\":\"Custodian makes an ethereum transaction marking the burn request as completed\"}]]}]\n35:[\"$\",\"figure\",null,{\"className\":\"page-module-scss-module__JIqztW__figure\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/whitepaper/swap-user-btc.webp\",\"alt\":\"Redemption diagram: the customer sends WBTC tokens to the merchant and receives Bitcoin in return\",\"width\":2172,\"height\":724,\"loading\":\"lazy\"}]}]\n36:[\"$\",\"h3\",null,{\"children\":\"Sequence of events for users to receive Bitcoins\"}]\n37:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"User requests the redemption of tokens from a merchant\"}],[\"$\",\"li\",null,{\"children\":\"The merchant does the required AML, KYC procedures and gets identification information from user\"}],[\"$\",\"li\",null,{\"children\":[\"The user and merchant perform an \",[\"$\",\"strong\",null,{\"children\":\"atomic swap\"}],\", or use a trusted exchange where the user receives Bitcoin and the merchant receives WBTC tokens\"]}]]}]\n38:[\"$\",\"h3\",null,{\"id\":\"on-chain-transfer-restrictions\",\"children\":\"On Chain transfer restrictions\"}]\n39:[\"$\",\"p\",null,{\"children\":\"Based on the token, there could be restrictions in place for the transfer of tokens. For WBTC, there will be no restrictions on transfers.\"}]\n3a:[\"$\",\"h2\",null,{\"id\":\"governance\",\"children\":\"Governance\"}]\n3b:[\"$\",\"p\",null,{\"children\":\"The wrapped token contract is governed by a multisig contract in which signatures are required from DAO members in order to add/remove members. All custodians and merchants will be DAO members, but other institutions can also be included as a member without having a custodian or merchant role. An “M of N” signature signature will be used in the contract where M is the required number of signatures in the multisig contract and N is the total number of members. The values of M and N will be decided mutually between members keeping in mind security as well as the ease of adding/removing members.\"}]\n3c:[\"$\",\"h2\",null,{\"id\":\"sidechain\",\"children\":\"Side chain for wrapped tokens\"}]\n3d:[\"$\",\"p\",null,{\"children\":\"Initially, WBTC will be launched on the Ethereum mainnet chain. The mainnet chain is easily accessible and usable as there are a network of exchanges, block explorers, wallets, and other Dapps on it. One of the key benefits of tokenization, is cheap transactional cost. But with gaining popularity of Ethereum and increased Dapp creation, transaction costs of wrapped tokens could rise to the point where it is not cheap to do so on the main chain. The collaboration of multiple institutions in the wrapped framework enables the ability to deploy a practical scalable solution to increase transactional throughput.\"}]\n3e:[\"$\",\"p\",null,{\"children\":[\"This can be done through the use of a pegged sidechain, using existing software (\",[\"$\",\"a\",null,{\"href\":\"https://github.com/paritytech/parity-bridge\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"parity-bridge\"}],\") run among DAO members. The chain will run on it’s own proof of authority network\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-7\",\"children\":\"[7]\"}]}],\" \",\"using the Aura consensus algorithm\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-8\",\"children\":\"[8]\"}]}],\". Blocks will be created every 4 seconds predictably and in a performant manner. Currently, there is already such a chain (Kovan testnet) and it has been in operation since March 2017. Wrapped tokens will be pegged between the main and side chain by creating a 2-way multi-sig wallet on mainnet and on the sidechain. Side chains provide much needed scalability on ethereum. Some benefits of a side chain for trading and transferring wrapped tokens are:\"]}]\n3f:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Scaling with minimal development costs (same EVM)\"}],[\"$\",\"li\",null,{\"children\":\"Dedicated, increased throughput - seperate blockchain on separate hardware and potential proof of authority (PoA) advantages (faster blocks)\"}],[\"$\",\"li\",null,{\"children\":\"Easy to support in existing clients and wallets\"}],[\"$\",\"li\",null,{\"children\":\"Chain is free from other “noisy neighbors”\"}],[\"$\",\"li\",null,{\"children\":\"Minimal transactional cost (to prevent spam)\"}]]}]\n40:[\"$\",\"p\",null,{\"children\":\"Validators (block generators) will be chosen from wrapped partners and other trusted parties who will be geographically distributed and represent several different domiciles / governments. Validators will also maintain the 2-way peg between the main and side chain. To peg the value of wrapped tokens on both chains, we propose a multi-signature contract to be used on the mainnet and the sidechain.\"}]\n41:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"To send from Ethereum mainnet to Ethereum sidechain:\",[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"Send from mainnet address to the federated mainnet multi-sig address\",[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"It is recommended to send the amount while calling the “sendToSidechain” method on the multi-sig address, specifying as the argument the destination address on the sidechain\"}],[\"$\",\"li\",null,{\"children\":\"If sent without a method, the destination address on the sidechain will be assumed to be the same as the source address\"}]]}]]}],[\"$\",\"li\",null,{\"children\":\"An event is generated on the mainnet to record the send\"}],[\"$\",\"li\",null,{\"children\":\"Federated signers “lock” tokens on mainnet\"}],[\"$\",\"li\",null,{\"children\":\"After a “confirmation period”, multisig authorities on the sidechain can validate the send event on the mainnet and disburse the amount to the destination address on the sidechain, less transaction fees\"}]]}]]}],[\"$\",\"li\",null,{\"children\":[\"To send from ETH sidechain to ETH mainnet:\",[\"$\",\"ul\",null,{\"children\":[\"$\",\"li\",null,{\"children\":\"Identical (symmetric)\"}]}]]}]]}]\n42:[\"$\",\"p\",null,{\"children\":\"WBTC will be the first asset on the sidechain and will use a combination of these components working together to create an ecosystem:\"}]\n43:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Node Software and Configuration\"}],[\"$\",\"li\",null,{\"children\":\"Block Explorer\"}],[\"$\",\"li\",null,{\"children\":\"Wallet Providers\"}],[\"$\",\"li\",null,{\"children\":\"Block Validators\"}],[\"$\",\"li\",null,{\"children\":\"Multi-sig Authorities\"}]]}]\n44:[\"$\",\"h3\",null,{\"id\":\"incentivization\",\"children\":\"Incentivization\"}]\n45:[\"$\",\"p\",null,{\"children\":\"Transactions will be charged at the minimal starting gas price of 1 Gwei to cover running block validators and to prevent spam on the sidechain. Validators can also be incentivized off chain for each Dapp or have block rewards. Details of distribution/management of Ether on the sidechain are still to be determined.\"}]\n46:[\"$\",\"h2\",null,{\"id\":\"atomic-swap\",\"children\":\"Atomic Swap\"}]\n47:[\"$\",\"p\",null,{\"children\":\"Atomic swaps can be used between merchants and users in order to exchange WBTC and BTC. If the user would like to receive WBTC or BTC more quickly, a trusted method of exchange could also be done through the merchants.\"}]\n48:[\"$\",\"p\",null,{\"children\":\"Once KYC is completed, the steps for users to atomically swap BTC for WBTC with the merchant are:\"}]\n49:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"User generates a secret and a hash of it is provided to the merchant off chain. The user and the merchant also agree on other swapping details such as receive addresses (ETH and BTC)\"}],[\"$\",\"li\",null,{\"children\":\"The user creates a Bitcoin HTLC (Hashed Time Lock Contract) using the merchant’s Bitcoin address, user’s refund address, secret hash, and expiration time. This is used to create a P2SH address which the user funds with X BTC\"}],[\"$\",\"li\",null,{\"children\":\"After 6 confirmations, the merchant will create an HTLC contract on Ethereum, by using the user’s Ethereum address, merchant’s refund address, secret hash, and expiration time. The merchant then transfers X WBTC to the atomic swap contract.\"}],[\"$\",\"li\",null,{\"children\":\"The user reveals the secret in order to move X WBTC from the atomic swap contract to the user’s Ethereum address\"}],[\"$\",\"li\",null,{\"children\":\"The merchant uses the secret in order to move Bitcoin funds from the P2SH address\"}],[\"$\",\"li\",null,{\"children\":\"If the user does not claim the WBTC within the expiration time, the transaction does not go through and the user can claim the BTC back\"}]]}]\n4a:[\"$\",\"p\",null,{\"children\":\"Some important things to note here:\"}]\n4b:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"In order to deploy the atomic swap contract and send WBTC to it, there are transaction fees involved. Hence, the user will have to pay an atomic swap fee before initiating a swap.\"}],[\"$\",\"li\",null,{\"children\":\"Atomic swaps take time and multiple transactions on both the BTC and ETH chain. The user may have the option of doing a trusted swap in which BTC is transferred to the merchant address and after 6 confirmations on the bitcoin network, the merchant sends WBTC to the user. This involves trust in the merchant, but it is quicker and cheaper.\"}]]}]\n4c:[\"$\",\"h2\",null,{\"id\":\"wbtc-vs-atomic-swaps\",\"children\":\"WBTC vs Atomic Swaps\"}]\n4d:[\"$\",\"p\",null,{\"children\":[\"Atomic swaps can be performed without WBTC for users which only want to perform a BTC-ETH trade. They can be done on a decentralized exchange outlined through a mechanism by the Komodo platform\",\" \",[\"$\",\"sup\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#ref-9\",\"children\":\"[9]\"}]}],\". However, it is important to note that WBTC provides a representation of BTC on the ETH chain, which is required for DAPPs and the ecosystem to interact with. A few other tradeoffs to consider while comparing atomic swaps with WBTC:\"]}]\n4e:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"They require price discovery to be done by whoever does the atomic swap. In wrapped tokens price discovery only needs to be done while trading on a decentralized exchange after having already obtained WBTC.\"}],[\"$\",\"li\",null,{\"children\":\"Requires atomic swap technology to be supported by existing wallets and decentralized exchanges. Wrapped BTC will be available for use in any ERC20 supported wallet.\"}],[\"$\",\"li\",null,{\"children\":\"They are really slow because every transactions is as slow as multiple confirmations on the ETH chain and then the Bitcoin chain (as opposed to WBTC, where the initial minting/tokenization is slow but after creation it’s easily tradable on the ETH chain)\"}],[\"$\",\"li\",null,{\"children\":\"Doing an atomic swap on a decentralized exchange requires a separate deposit and a atomic swap fee as well. This is inconvenient each time users want to swap currencies.\"}]]}]\n4f:[\"$\",\"h2\",null,{\"id\":\"fees\",\"children\":\"Fees\"}]\n50:[\"$\",\"p\",null,{\"children\":\"Transfers of WBTC between users will have no cost apart from network fees. There are three ways in which different parties in the network can earn fees:\"}]\n51:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Custodian fees:\"}],\" This is taken by the custodian at the time when a merchant mints or burns wrapped tokens.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Merchant fees:\"}],\" This is taken by the merchant who the user exchanges wrapped tokens with for the asset.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Sidechain transaction fees:\"}],\" This fee is predominantly aimed at preventing spam on the sidechain. This is shared equally among all institutions running nodes on the sidechain.\"]}]]}]\n52:[\"$\",\"h2\",null,{\"id\":\"legal-binding\",\"children\":\"Legal Binding\"}]\n53:[\"$\",\"h3\",null,{\"id\":\"custodian-merchant-contract\",\"children\":\"Contract between custodians and merchants\"}]\n54:[\"$\",\"p\",null,{\"children\":\"The process of minting and burning tokens does not involve the user and is between trusted institutions. Merchants are required to hold the identity information of the user securely. Custodians are required to publish details of assets under custody quarterly and perform minting/burning duties in a timely manner. Failure to meet these criteria can lead to removal from the network.\"}]\n55:[\"$\",\"p\",null,{\"children\":\"It is to be noted that there can be multiple custodians in the network, but this comes at the cost of increasing the risk involved in the network. A model where custodianship is shared by different institutions holding keys to a multi-sig wallet is also possible in the future. Though operationally, minting/burning/auditing would require more coordination and time. A security breach among any of the custodians would cause the loss of trust and could lead to mass withdrawals. A security breach with a merchant is much less severe as all outstanding tokens will still be backed up by custodians, but instead could lead to a loss of KYC/AML user data.\"}]\n56:[\"$\",\"h2\",null,{\"id\":\"trust-model\",\"children\":\"Trust model\"}]\n57:[\"$\",\"p\",null,{\"children\":\"In some sense custodians are trusted in the wrapped framework, as assets could be stolen or they might not honour the one-to-one backing. However, the wrapped framework aims to minimize this trust in a few ways:\"}]\n58:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Quarterly audits will be conducted by external third parties to verify that all wrapped tokens minted have an equal amount of asset stored among all custodians. In the case of WBTC, proof of reserves can be shown by publishing signatures from the addresses which bitcoin is stored in.\"}],[\"$\",\"li\",null,{\"children\":\"Custodians will not be able to mint tokens on their own, but would instead require the initiation of a merchant in order to do so. Hence creation of new tokens involves both the custodian and the merchant.\"}],[\"$\",\"li\",null,{\"children\":\"The user is insulated from interacting with the custodian through a set of merchant institutions. An individual merchant does not need to be trusted, but instead all merchants together would need to be.\"}],[\"$\",\"li\",null,{\"children\":\"Existing credibility of the institutions involved is at stake for all the institutions involved with the framework.\"}]]}]\n59:[\"$\",\"h2\",null,{\"id\":\"transparency\",\"children\":\"Transparency\"}]\n5a:[\"$\",\"p\",null,{\"children\":\"There will be full transparency in the functioning of the wrapped token. All key details of the network will be reflected in a dashboard, some of which are:\"}]\n5b:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Names and details of institutions performing different roles in the network\"}],[\"$\",\"li\",null,{\"children\":\"Status of mint and burn orders (pending, processing, cancelled, complete)\"}],[\"$\",\"li\",null,{\"children\":\"Total amount of BTC stored by custodians\"}],[\"$\",\"li\",null,{\"children\":\"Total amount of WBTC in the network (Will be the same or slightly lower than BTC stored)\"}],[\"$\",\"li\",null,{\"children\":\"Quarterly audits in the form of transactions which prove that the custodian has the keys to the Bitcoin\"}],[\"$\",\"li\",null,{\"children\":\"Merchant and Custodians ethereum addresses\"}],[\"$\",\"li\",null,{\"children\":\"The Bitcoin address associated with each merchant, controlled by the custodian\"}],[\"$\",\"li\",null,{\"children\":\"Links to the open source token contract code / deployed contract on a block explorer\"}]]}]\n5c:[\"$\",\"p\",null,{\"children\":\"An example of what the dashboard might look like:\"}]\n5d:[\"$\",\"figure\",null,{\"className\":\"page-module-scss-module__JIqztW__figure\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/whitepaper/dashboard.webp\",\"alt\":\"Example transparency dashboard showing an order book with total network WBTC supply and custodied BTC holdings\",\"width\":1105,\"height\":1600,\"loading\":\"lazy\",\"className\":\"page-module-scss-module__JIqztW__dashboardImage\"}]}]\n5e:[\"$\",\"h2\",null,{\"id\":\"conclusion\",\"children\":\"Conclusion\"}]\n5f:[\"$\",\"p\",null,{\"children\":\"Through wrapped tokens, we propose a solution to make assets interchangeable and representable on the Ethereum chain. Global liquidity, increased fractional ownership, smart contract programmability and reduction in transaction fees are some of the key benefits of tokenization. WBTC will be the first such token, enabling Dapps easy access to Bitcoin. All transactions, contracts and audits will be publicly viewable to maintain transparency and enable trust in the network. The framework also provides a way in which multiple institutions in the cryptocurrency space can perform different roles to get past common issues faced by asset backed tokens.\"}]\n60:[\"$\",\"h2\",null,{\"id\":\"glossary\",\"children\":\"Glossary\"}]\n61:[\"$\",\"dl\",null,{\"className\":\"page-module-scss-module__JIqztW__glossary\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"Custodian\"}],[\"$\",\"dd\",null,{\"children\":\"The institution or party who holds the asset. In the case of WBTC, this will be played by BitGo. Custodians hold the keys to mint tokens.\"}],[\"$\",\"dt\",null,{\"children\":\"Merchant\"}],[\"$\",\"dd\",null,{\"children\":\"The institution or party to which wrapped tokens will be minted to and burnt from. Merchants play a key role in distribution of the wrapped token. In the case of WBTC, this will be played initially by Kyber and Republic Protocol. Each merchant holds a key to approve minting of new wrapped tokens and burn wrapped tokens.\"}],[\"$\",\"dt\",null,{\"children\":\"User\"}],[\"$\",\"dd\",null,{\"children\":\"The holders of the wrapped token. Users can use wrapped tokens to transfer and transact like any other ERC20 token in the ethereum ecosystem.\"}],[\"$\",\"dt\",null,{\"children\":\"KYC (Know your customer)\"}],[\"$\",\"dd\",null,{\"children\":\"FINCEN and OFAC Required Guidelines pursuant to which institutions must seek information in order to confirm that customers are not subject to OFAC sanctions, violate any Bank Secrecy Act rules or are otherwise potentially engaged in money laundering activities.\"}],[\"$\",\"dt\",null,{\"children\":\"AML (Anti money laundering)\"}],[\"$\",\"dd\",null,{\"children\":\"Rules and regulations enforced by regulatory authorities (including the Department of Treasury in the US) to target and combat illicit source of funds which may be laundered.\"}],[\"$\",\"dt\",null,{\"children\":\"WBTC (Wrapped Bitcoin)\"}],[\"$\",\"dd\",null,{\"children\":\"An ERC20 token on ethereum backed 1:1 by Bitcoin.\"}]]}]\n62:[\"$\",\"h2\",null,{\"id\":\"references\",\"children\":\"References\"}]\n63:[\"$\",\"ol\",null,{\"className\":\"page-module-scss-module__JIqztW__references\",\"children\":[[\"$\",\"li\",null,{\"id\":\"ref-1\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://etherscan.io/chart/gaslimit\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://etherscan.io/chart/gaslimit\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-2\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.coindesk.com/ethereums-growing-gas-crisis-and-whats-being-done-to-stop-it/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://www.coindesk.com/ethereums-growing-gas-crisis-and-whats-being-done-to-stop-it/\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-3\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://cointelegraph.com/explained/what-is-a-daico-explained\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://cointelegraph.com/explained/what-is-a-daico-explained\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-4\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.bitgo.com\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://www.bitgo.com\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-5\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://kyber.network\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://kyber.network\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-6\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://republicprotocol.com\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://republicprotocol.com\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-7\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://paritytech.github.io/wiki/Proof-of-Authority-Chains\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://paritytech.github.io/wiki/Proof-of-Authority-Chains\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-8\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://wiki.parity.io/Aura\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://wiki.parity.io/Aura\"}]}],[\"$\",\"li\",null,{\"id\":\"ref-9\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://komodoplatform.com/atomic-swaps/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"https://komodoplatform.com/atomic-swaps/\"}]}]]}]\n64:[\"$\",\"$L6d\",null,{}]\n65:[\"$\",\"$L6e\",null,{}]\n66:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2h3_v_8vtvmtk.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n67:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/21o5nv935rolz.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n68:[\"$\",\"$L6f\",null,{\"children\":[\"$\",\"$70\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@71\"}]}]\n6a:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L72\",null,{\"children\":\"$L73\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L74\",null,{\"children\":[\"$\",\"$70\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L75\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n6c:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1-pse8dhg-7r3.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n76:I[51034,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/static/chunks/0ijqztxlruv0a.js\",\"/_next/static/chunks/0t_o1iwg-smnl.js\",\"/_next/static/chunks/1wr2r7g-dhhdx.js\",\"/_next/static/chunks/0zyl3aern4whw.js\"],\"default\"]\n77:I[93704,[\"/_next/static/chunks/3e59oa7sryyyq.js\",\"/_next/static/chunks/4536c0c8y2x2h.js\",\"/_next/st