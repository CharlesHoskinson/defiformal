":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Responses to claims or customer support inquiries filed in connection with your Account.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"}],\"nodeType\":\"unordered-list\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"You consent to the use of electronic signatures in connection with your use of the Services.You specifically agree, opt in and consent to Paperless Delivery of Tax Forms Agreement available at \",\"nodeType\":\"text\"},{\"data\":{\"uri\":\"https:\u002F\u002Faccounts.coinbase.com\u002Ftaxes\u002Fsettings\"},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"https:\u002F\u002Faccounts.coinbase.com\u002Ftaxes\u002Fsettings\",\"nodeType\":\"text\"}],\"nodeType\":\"hyperlink\"},{\"data\":{},\"marks\":[],\"value\":\". You may opt out at any time via the same link.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"We will provide these Communications to you by posting them on the Coinbase Site, emailing them to you at the primary email address listed in your Business Account profile, communicating to you via instant chat, and\u002For through other electronic communication such as text message or mobile push notification.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Hardware and Software Requirements\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"In order to access and retain electronic Communications, you will need the following computer hardware and software:\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\"