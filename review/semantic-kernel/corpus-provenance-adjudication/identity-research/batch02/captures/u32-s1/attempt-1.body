dren\":\".\"}]]}]]\n78:[\"$\",\"p\",\"10c8bf09c2e844f7be65c59cf977f3c0\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"dc5ef18d6d4944679a3db5784f182a33\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"In addition to the liquidity sources above, KyberSwap Aggregator has also been integrated with Professional Market Makers (PMMs) enabling Aggregator swaps on Ethereum Mainnet to access real time quotes from our network of PMMS. PMM quotes are gathered off-chain and only settled on-chain if the PMM quotes offer more favourable rates. KyberSwap's PMM network adds greater market depth to what is already an \"}]]}],\"$L82\",[\"$\",\"$1\",\"810f4e2447964539aa52a6fab5a85df2\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\" ensuring superior rates for KyberSwap traders and integrators.\"}]]}]]}]\n79:[\"$\",\"p\",\"47cb409b474f47198f8499ad42b40b58\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"7654a34b36644fc98ee5b24c029486f3\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"PMMs actively quote two sides of the markets and generate a profit based on the difference in the bid-ask spread. As a result of this market making role, PMMs are able to more efficiently deploy liquidity and consequently aid in the price discovery of an asset without the added volatility. By connecting multiple on-chain (\"}]]}],\"$L83\",[\"$\",\"$1\",\"35e9b2c30e124939b13169b0d2670199\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\", \"}]]}],\"$L84\",[\"$\",\"$1\",\"cd5669a42a51421196e36542fd26d4d9\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\") and off-chain (\"}]]}],\"$L85\",[\"$\",\"$1\",\"14510b1c7d324f6d864fc801ec5bde42\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\", PMMs) liquidity sources, KyberSwap not only guarantees more equitable access to capital but also actively contributes towards a more efficient market.\"}]]}]]}]\n7f:[\"$\",\"div\",null,{\"className\":\"max-w-3xl layout-wide:max-w-6xl mx-auto w-full mt-6 flex flex-row flex-wrap items-center gap-4 text-tint contrast-more:text-tint-strong\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mr-auto text-sm\",\"children\":[[[\"$\",\"$1\",\"string-0\",{\"children\":\"Last updated \"}],[\"$\",\"$1\",\"arg-0\",{\"children\":[\"$\",\"$L86\",null,{\"value\":\"2026-02-28T10:37:51.969Z\"}]}]],\"\"]}],[\"$\",\"$L69\",null,{\"className\":\"layout-wide:chat-open:max-[2416px]:flex layout-wide:max-3xl:flex xl:hidden xl:max-3xl:chat-open:flex\",\"pageId\":\"P4AAjSd0nrbC42bSddka\"}]]}]\n80:[\"$\",\"$L87\",null,{\"displayContext\":\"site\"}]\n6c:[\"$\",\"header\",null,{\"className\":\"max-w-3xl layout-wide:max-w-6xl mx-auto w-full mb-6 space-y-3 after:clear-both after:block\",\"children\":[[\"$\",\"div\",null,{\"className\":\"float-right ml-4 flex gap-2 -mb-1 -mt-1.5\",\"children\":[[\"$\",\"$L88\",null,{\"siteTitle\":\"KyberSwap Docs\",\"urls\":{\"html\":\"https://docs.kyberswap.com/kyberswap-solutions/kyberswap-aggregator\",\"markdown\":\"https://docs.kyberswap.com/kyberswap-solutions/kyberswap-aggregator.md\",\"rss\":\"$undefined\",\"editOnGit\":\"$undefined\",\"pdf\":\"$undefined\",\"mcp\":\"https://docs.kyberswap.com/~gitbook/mcp\"},\"actions\":{\"items\":[\"markdown\",\"external-ai\",\"mcp\"]},\"page\":{\"id\":\"P4AAjSd0nrbC42bSddka\",\"title\":\"KyberSwap Aggregator\",\"path\":\"kyberswap-solutions/kyberswap-aggregator\",\"href\":\"/kyberswap-solutions/kyberswap-aggregator\"}}],[\"$\",\"$L89\",null,{}]]}],[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"data-cover-aware-text\":true,\"data-over-cover\":true,\"className\":\"page-cover-background:text-contrast-cover flow-root text-xs leading-relaxed text-tint layout-wide:page-no-toc:hidden page-cover-background:opacity-9\",\"children\":[\"$\",\"ol\