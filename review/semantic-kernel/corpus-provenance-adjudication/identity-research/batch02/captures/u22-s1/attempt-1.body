"static/chunks/3305-d6785762ffbce13a.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"8617\",\"static/chunks/app/sites/static/%5Bmode%5D/%5BsiteURL%5D/%5BsiteData%5D/(content)/%5BpagePath%5D/page-2b817ac5b411d64f.js?dpl=p-40150f0a6cd80dd82e78562380092f\"],\"InlineLinkTooltip\"]\n6f:[\"$\",\"p\",\"a6f4368afda34950ba3958983dfb9bfd\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"24bbf482103d4daf8efac05a5c7d6541\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Each vault can either refer to a pair of tokens invested in liquidity pools, such as CAKE-BNB LP tokens within the Binance Smart Chain ecosystem, or a single token invested in lending platforms or single stake reward pools. After depositing tokens to a vault, the user is supplied with vault specific mooTokens which represent their share in the vault. We will elaborate on mooTokens in the next section.\"}]]}]]}]\n70:[\"$\",\"p\",\"8c9ef02d387d47168b32ac2eb7ee9b41\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"ae559d5fa162486597f6b61dfd3df04f\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Anyone in the Cowmoonity can work together to build new strategies and submit them to the Beefy team for review. However, a new vault will not be accepted if the underlying platform does not adhere to the \"}]]}],\"$Lb9\",[\"$\",\"$1\",\"4bf3cbd3f7ec4a7eba978e6973db7d53\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\".\"}]]}]]}]\n71:[\"$\",\"p\",\"a6dec45317d046e79060fdb3881ce073\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"092e8a9c903049cfa226bf60ca9a2571\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Summarizing, vaults can:\"}]]}]]}]\n72:[\"$\",\"ul\",\"aeef0ded930c44fa8c1851a959654788\",{\"className\":\"min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full\",\"children\":[[\"$\",\"li\",\"f3bc613aa41146c69a3001100aa3243f\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"dde4df92f31f4861a918975f905933c8\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"ce7c94d0843e4c89a425f221031556e0\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Efficiently execute yield farming strategies.\"}]]}]]}]]}]]}],[\"$\",\"li\",\"9ab0ce140e404f8fa36c319cfa564551\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"e33e45a2efc24a6bbf0b9aeb951875cd\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"f8fb6a87536e4aa8a818218a17d1e2e0\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Compound rewards into the initially deposited token amount.\"}]]}]]}]]}]]}],[\"$\",\"li\",\"aae93bcfe3914988ab98a8452f801e3b\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"b06799cbc586479a83327bda25565ce9\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"26ba61fe81c944048f8a60f71bd68dc3\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Use any asset as liquidity.\"}]]}]]}]]}]]}],[\"$\",\"li\",\"4f80312abb8d4b1cbc8006cbaa8d6b48\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"22302553350f46c5b0463ad87ae83608\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"2f90774c11f447e185e5ee1d2f141997\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Provide one asset as collateral for another.\"}]]}]]}]]}]]}],[\"$\",\"li\",\"e2b7d3884466417f95a628f32ba8c7b8\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":\"$Lba\"}],\"$Lbb\"]}],\"$Lbc\",\"$Lbd\"]}]\n73:[\"$\",\"p\",\"fb1b9d5a11cc42468b7c97936667098e\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"29b7449439324d90afef7a386087a64e\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Users can sit back and relax, and watch their investment grow!\"}]]}]]}]\n75:[\"$\",\"p\",\"8221d827679644e0861637428b0c10c9\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"c59b668ef65046b1aad35c3d2c63869c\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"A mooToken is an interest-bearing, tokenized proof of deposit that you will receive at the moment you deposit in a Beefy vault. A mooToken is unique per vault, e.g. you get $mooBIFI tokens when depositing $BIFI into the BIFI Vault. One can view mooTokens as the receipt of your vault deposit.\"}]]}]]}]\n78:[\"$\",\"p\",\"5cdfae1ef1b3402db49f5d54861f5b4c\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"528c854c5ab449239dda5745035e8156\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Beefy's vaults automatically create more of your deposited asset in the form of compound interest. By holding mooTokens in your wallet, they are increasing in value against its corresponding vault asset. The number of mooTokens in your wallet will remain constant, but the quantity of the vault tokens they can be redeemed for increases. This is also the reason why mooTokens do not 1:1 match with the token amount initially deposited.\"}]]}]]}]\n7a:[\"$\",\"p\",\"386bb1964d304e26a16980cc039418e4\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"70169f57b64d4695af2859382ef3828c\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Whenever you want to withdraw the tokens that are staked for you in Beefy's vault, you simply initiate a withdrawal transaction to exchange them. The mooTokens are then taken from your wallet and burned, and your deposited assets plus yield will be given back to you.\"}]]}]]}]\n7c:[\"$\",\"p\",\"c90ab887759b4d1e8e86954fa2a63207\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"4e8503f9f0fd43f3afeec47bab023466\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Beefy's mooToken system has a few major advantages: \"}]]}]]}]\n7d:[\"$\",\"ol\",\"065552b037134e6aae57ffb766755b5d\",{\"className\":\"min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full\",\"children\":[[\"$\",\"li\",\"59be6e2e89e649afa3687f58c2dc9d9b\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'1.'\",\"--font-family\":\"inherit\",\"fontSize\":\"min(1em, 24px)\"}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"10135f6c0d14488bb29315b3660c0557\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"ae3f69241fb249eb9b6a8c943b208384\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"mooTokens allow any user to withdraw their fair share of deposited funds;\"}]]}]]}]]}]]}],[\"$\",\"li\",\"27888de5808148ba8737d013ab5851d6\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'2.'\",\"--font-family\":\"inherit\",\"fontSize\":\"min(1em, 24px)\"}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"bccd0240cf4e4187a09a3c80a8f3dcf0\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"12fe7aceb6ea48d394686f2cf3225187\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"the system allows you to deposit the mooToken receipt to a cold or hardware wallet for ultimate safety;\"}]]}]]}]]}]]}],[\"$\",\"li\",\"45d5c623a5924d03a944a8d6af919e80\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'3.'\",\"--font-family\":\"inherit\",\"fontSize\":\"min(1em, 24px)\"}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"a5ddffb51ba240ee8893060f6cf4b81b\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"44afd6c9a93c466ea4d7f013a223dc0f\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"your privacy is maintained, as you remain anonymous to Beefy. Your funds in the vault are not tied to the wallet address from which you made the deposit, since the mooTokens are the only evidence of your share in the vault. Therefore, you could withdraw your share of funds from a different address if you moved your mooTokens to it;\"}]]}]]}]]}]]}],[\"$\",\"li\",\"8d6d41ef0b0a4cb9aedc28cdefc23e04\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'4.'\",\"--font-family\":\"inherit\",\"fontSize\":\"min(1em, 24px)\"}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"379822987190493fa15cfabcb16d30f8\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":\"$Lbe\"}]]}]]}],\"$Lbf\"]}]\n7f:[\"$\",\"p\",\"541c7666931a4a98a8883bc9112e4fa8\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"63cd7192cb3343e2b138d8c7b52119b0\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vaults are normally harvested multiple times daily and profits are automatically reinvested (compounded). You can check the harvesting and compounding rate of a vault using \"}]]}],\"$Lc0\",[\"$\",\"$1\",\"e21184cbcc7c4250b585357ebe01e212\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\".\"}]]}]]}]\n81:[\"$\",\"p\",\"749eeda2974346f4ada01325ee9568fc\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"2b0a471c39a8426499c56a2910411803\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"They could, but vaults help you save on personal time and transaction fees, maintain healthy collateral to debt ratios, self-optimize for the best possible yields, and automatically reinvest earnings. Attempting to do this manually would result in large inefficiencies. At Beefy we like to say: \\\"Sit back and relax, the vault does all the work for you.\\\"\"}]]}]]}]\n83:[\"$\",\"p\",\"e87846c5347348cbbf196d70946f8903\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"9cb14ff64ae745b894b47e65ab06caa5\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Most vaults have a performance fee structure, taking a percentage cut of all harvest rewards. This fee on profits is split up and distributed back to $BIFI tokenholders, allocated to Beefy's treasury, sent to the strategist that developed the vault and sent to the one calling the vault's harvest function. These fees are already built into the APY of each vault and daily rate. You do not need to calculate it yourself. The performance fee and the fee structure breakdown are presented inside the Deposit and Withdraw module in a vault.\"}]]}]]}]\n84:[\"$\",\"p\",\"3b8aa0ab5fcc4fe090fccea27abfe855\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"41960dd3720e41e5b6a5271f37f1cc45\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The performance fee on additional yield, i.e. vault profits, is in part distributed back to $BIFI tokenholders and is the main source of Beefy's platform revenue. A part of it also funds Beefy's treasury which is used to further fund platform development, security and other initiatives. The performance fee was also implemented to promote community engagement and governance participation. A successful and engaged community is critical for our future growth, which in turn rewards platform users even more.\"}]]}]]}]\n85:[\"$\",\"p\",\"fd9a55afe58a4f63a9bdd7d7b3bbebdf\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"330cf750ad9443aebf4a9ee9776a3c33\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Furthermore, some vaults have a withdrawal fee. The main purpose of this fee is to prevent possible exploits from bad-faith actors. Without the fee, somebody could deposit just before the harvest() function execution and withdraw straight after that event, taking a % of the gains generated by legitimate stakers. Withdrawal fees stay in the vault and are shared amongst vault funds.\"}]]}]]}]\n86:[\"$\",\"p\",\"5dd81502f5e94e57a75e08ad0f50aefa\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"d194be6ca34740cda170e9cc88d3f847\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Finally, entering or exiting vaults using our Beefy ZAP V2 tool will incur a 0.05% zap fee on your deposited amounts. These fees are returned to the Beefy treasury by way of a intermediate batching treasury, which allows fees to be aggregated and swapped into stables before being deposited. See \"}]]}],\"$Lc1\",[\"$\",\"$1\",\"e896a96f5a374fec9934e3b7222e87db\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\" for more details on the ZAP V2 tool.\"}]]}]]}]\n88:[\"$\",\"p\",\"2ff52740d2e64dde919bb65c24aa7b17\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"b68ade4b7d4545bbb614ff242627a575\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Many of Beefy's vaults \\\"Harvest on Deposit\\\". This means that when you deposit into the vault, you are also calling the harvest function of the vault's strategy. By calling the harvest function, you trigger the collection of pending farm rewards and compounding of those rewards back into the vault tokens for everyone. \"}]]}]]}]\n89:[\"$\",\"p\",\"82c7b0eedecb4bc39c063d9d1cf93ea2\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"3a8bafb4741f427d9c7e6f35246b5b9e\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Beefy does this so that it is impossible for malicious actors to steal yield, so a withdrawal fee is not required. This greatly benefits long-term investors.\"}]]}]]}]\n8a:[\"$\",\"p\",\"329a86144c1a4d5b8c9da16e8dfbbb01\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"3b70ca15176e4af095f2d582c19dd109\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Almost all of the vaults on more inexpensive chains like Fantom and Polygon harvest on deposit. You can tell if a vault harvests on deposit if there is no withdrawal fee.\"}]]}]]}]\n8b:[\"$\",\"p\",\"0eb9d407cef9421ead64f44230c701ab\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"6678cae975704698a8785a4b9bbe4d7d\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"For depositing, and thus calling the harvest function, you will receive a reward in the form of the native chain token (e.g. WFTM or WMATIC) due to the harvest call fee.\"}]]}]]}]\n8d:[\"$\",\"p\",\"20cbc3e66a83420fb31585e39a427985\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"03f4b40b64a4406595309737ba5f1342\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"As transaction fees on Ethereum are expensive, Beefy has introduced a few rules that determine the vault's harvesting frequency.\"}]]}]]}]\n8e:[\"$\",\"ul\",\"7937cd2097e24428b392cbbfbf2e6e63\",{\"className\":\"min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full\",\"children\":[[\"$\",\"li\",\"ea1a9e1b699e4c4fa2e707eac0177b10\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"c629b710d00747b48874c03617b55064\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"3f3c2081a8d843b08ed9a9fcca9013c5\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vault TVL is above $100k: vault will be harvested every 3 days.\"}]]}]]}]]}]]}],[\"$\",\"li\",\"f5e89422a53748a79d4e79c1ac7b4514\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"215da254ea934604ac0ecdb489795563\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"065ab150303e43e884849ee336095cba\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vault TVL is below $100k but above $10k: vault will be harvested every 15 days.\"}]]}]]}]]}]]}],[\"$\",\"li\",\"3f29634053b14afabd1ba708abb9eb77\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"fa336b6b46bf4d97acd181adfcf54b93\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"80736d26fd2e4c46b99dd1da139462ed\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vault TVL is below $10k: community harvest.\"}]]}]]}]]}]]}]]}]\n8f:[\"$\",\"p\",\"50baa5601b124d94ab84b60b2a388c00\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"b286262c967543b087d5134b67c043af\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Community harvest implies that the harvest function on the strategy contract has to be manually called, and the transaction fees for doing so will not be subsidized by Beefy.\"}]]}]]}]\n90:[\"$\",\"p\",\"1bfce078b9924ca48e82fa31a49a5bef\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"de10acb87db94725a52e185abf55f35d\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Another rule watches the gas prices on Ethereum. If \"}],[\"$\",\"$1\",\"1\",{\"children\":[\"$\",\"code\",\"mark\",{\"className\":\"py-px px-1.5 min-w-6.5 justify-center items-center ring-1 ring-inset ring-tint bg-tint rounded-sm text-[.875em] leading-[calc(max(1.20em,1.25rem))] break-words hyphens-none\",\"children\":\"maxGasPrice\"}]}],[\"$\",\"$1\",\"2\",{\"children\":\" is 20 GWei or more, harvests will not be executed as they will become too expensive. This is regardless of a vault's TVL.\"}]]}]]}]\n91:[\"$\",\"p\",\"10d88a4fa34b4a78ac95928197590d3f\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"dd5539061de1411ca9295a508a01a5ce\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The Gelato Off-Chain Resolver that handles the harvests on Ethereum based on the aforementioned rules can be found following this link: \"}]]}],\"$Lc2\",[\"$\",\"$1\",\"14ff99e5f53a42ca8c8c55a9e536bb34\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\". The smart contract and its parameters, as well as past Executions and Task Logs, are also easily accessible there.\"}]]}]]}]\n93:[\"$\",\"p\",\"144570b7c0d94a6ab0f7e21bbed3b782\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"bd71b6f865074cc89cec36f9a36f39df\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"BNB Chain also has a harvesting constraint in place:\"}]]}]]}]\n94:[\"$\",\"ul\",\"b41d1e9b13804c14ad08cb23d0dd5e39\",{\"className\":\"min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full\",\"children\":[[\"$\",\"li\",\"5777cdccfc954e8ea7b55c9a18aad7d4\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"e591911a2122465fa9a7c0879ecb9720\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"4ef0b09a4152496ab98c4dfb22d9eab2\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vault TVL is below $10k and older than 2 weeks: community harvest.\"}]]}]]}]]}]]}]]}]\n96:[\"$\",\"p\",\"324ddb28075e46b1a54186b0bb9cedf2\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"dd7eb740b44e4d949c42ec18ab34e559\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"No, the performance fees are on profits and are taken every time someone calls the harvest() function.\"}]]}]]}]\n98:[\"$\",\"p\",\"1ab48e3f9dbb4662b8095ca9c7ecce17\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"bb88c44b6dfc40cfbeb37e5decde4632\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Yes. Our displayed APY values reflect the predicted rate earned on a vault in a year. This rate is determined by the underlying platform it uses, the strategy that it is interacting with at the time, the total amount of funds in the vault and also takes into account the effect of compounding. As a unique feature, we have also included all vault fees in the APY calculation. What you see is what you get!\"}]]}]]}]\n9a:[\"$\",\"p\",\"0016a5f5353a4a4a85f47128f741c47f\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"d9ac0da5bcb54d6eba46fc98a33a1c5c\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Beefy vaults are audited, but this does not mean that a vault is entirely risk free. As with any smart contract, the ultimate risk is that an investor's funds can end up stolen or unable to be withdrawn. Failing that, there are risks that underlying protocols and tokens may fail and not behave as intended (e.g. failing to deliver rewards).\"}]]}]]}]\n9b:[\"$\",\"p\",\"W51kBsd0DIVu\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"4dK1svZKAFC2\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The team does take steps to quantify the security risks of smart contracts and will only interact with ones that meet a specific set of requirements after excessive testing to make sure the underlying platform does not contain so called 'rug-pull' functions. For a detailed breakdown of the steps Beefy takes before adding new vaults, please consult \"}]]}],\"$Lc3\",[\"$\",\"$1\",\"ba41d7023a574074b81e83c76ef93ea7\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\". Or for a brief overview of key risk checks performed, review \"}]]}],\"$Lc4\",[\"$\",\"$1\",\"1n9iyZL95GCT\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\".\"}]]}]]}]\n9d:[\"$\",\"p\",\"2034bd75f7914d848d4b684482fd878a\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"e4c058609e994995875fe85edc9dc72b\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Each vault and \"}]]}],\"$Lc5\",[\"$\",\"$1\",\"04cc307db2c04bc4a33f6ba387d58719\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\" is hardcoded, and the code has been built to be immutable, so once they are released, they become unalterable. No one can modify the vaults and strategies.\"}]]}]]}]\n9e:[\"$\",\"p\",\"44a55889bcf245389db6b8fa0b1105d2\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"f2ff41569bb64a1fa684a358e6b81dd7\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Modern Beefy vaults do however rely on the standard set out in EIP-1167, known as \"}]]}],\"$Lc6\",[\"$\",\"$1\",\"318aee2386b74909b6ac12ed941aad72\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\". Minimal proxies reduce deployment costs for repetitive contracts (e.g. vaults) by maintaining the vast majority of core functionality in a single implementation contract. They then configure the individual characteristics of the specific strategy (e.g. the relevant tokens and pools) through the minimal proxy contract - which is a much smaller contract to deploy - which directs instructions through to the implementation contract.\"}]]}]]}]\n9f:[\"$\",\"p\",\"d27123e492ef4574b2915fdaf4dc5568\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"76aa0c4838f34b09a7191eb7b0c52f84\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Users should be aware of the distinction between minimal proxy contracts and the proxy pattern used to upgrade contracts. \"}],[\"$\",\"$1\",\"1\",{\"children\":[\"$\",\"strong\",\"mark\",{\"className\":\"font-bold\",\"children\":\"Beefy's minimal proxy contracts are not upgradeable\"}]}],[\"$\",\"$1\",\"2\",{\"children\":\", so Beefy cannot take your funds by a sly upgrade. The proxy is only used to reduce deployment costs.\"}]]}]]}]\na1:[\"$\",\"ul\",\"66fd434795474f32a24024ab75c54ae0\",{\"className\":\"min-w-0 space-y-2 decoration-primary/6 max-w-3xl w-full\",\"children\":[[\"$\",\"li\",\"4aef229a48914f6899aca3ed1d5b2cb3\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"1e7727439edc406c9c98d4f8ce74e5b8\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"9b69d8fa2a854660920a12830beee45a\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[\"$\",\"strong\",\"mark\",{\"className\":\"font-bold\",\"children\":\"Money Market :\"}]}],[\"$\",\"$1\",\"1\",{\"children\":\" Utilizes lending platforms, such as Venus on BNB Chain or Scream on Fantom, to generate the highest possible yield for these coins (e.g. BUSD, BNB, LINK, DOT, DAI, USDT, ETH, or BTCB). \"}]]}]]}]]}]]}],[\"$\",\"li\",\"4bc314d3823a478389ebf915491080ad\",{\"className\":\"leading-normal flex items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-base leading-normal mr-1 flex min-h-lh min-w-6 items-center justify-center text-tint\",\"children\":[\"$\",\"div\",null,{\"className\":\"before:content-(--pseudoBefore--content) before:font-var\",\"style\":{\"--pseudoBefore--content\":\"'•'\",\"--font-family\":\"Arial\",\"fontSize\":\"min(1.5em, 24px)\",\"lineHeight\":1}}]}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col space-y-2\",\"children\":[[\"$\",\"p\",\"01126a23c31a4bb68bf620202f7d261e\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid min-h-lh [h2]:pt-0 [h3]:pt-0 [h4]:pt-0 mx-0 text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"d27baf82b4f849198b405f1a3e2db789\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[\"$\",\"strong\",\"mark\",{\"className\":\"font-bold\",\"children\":\"Native Token Farming :\"}]}],[\"$\",\"$1\",\"1\",{\"children\":\" Takes advantage of the high yield on popular farms by depositing another asset to earn, sell and compound profits of the native reward token.\"}]]}]]}]]}]]}]]}]\na3:[\"$\",\"p\",\"bf483959941d428e9d80604bf4288dfb\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"ffad7c677a024515b2520cbb5af8c673\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The default is that you withdraw the token type that you deposited, because at Beefy you earn what you stake. You will get the amount you deposited plus the yield generated (minus a potential vault withdrawal fee). For vaults supporting Beefy ZAP, users can withdraw directly into other assets, including any assets forming part of the in the relevant liquidity pool for ZAP V1, and any of the bluechip, native or stable assets supported for ZAP V2.\"}]]}]]}]\na5:[\"$\",\"p\",\"44abe4c6ee1e43b5bea5fa724ec8250c\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"0a1d733dd5764379bff02bf06253d6a7\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Liquidity pool (LP) vaults work by reinvesting the fees awarded to LP participants. In return for providing liquidity to the pool, many platforms reward investors with tokens. Our vaults regularly harvest these rewards, sell it, buy more of the LP’s underlying assets, and then reinvest to complete the cycle.\"}]]}]]}]\na6:[\"$\",\"p\",\"4cee090e8af847679a5bc308589662be\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"57f59ecd0b84409f99148108c8e08b0e\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"This compounds the rewards gained from a liquidity pool. Beefy creates strategies that automate this process, saving you time and gas fees in comparison to farming manually. This is all done for a tiny fee that is distributed back to those who deposit $BIFI into the BIFI Pool or BIFI Vault. A small percentage also goes to the Beefy treasury.\"}]]}]]}]\na8:[\"$\",\"p\",\"c3fdbaeb381e4844b8fd8d6cd89b7c02\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"e3764a2cd5a54655a77977739a2f4c78\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Pending rewards are not reflected in the balance until they are swapped for the initial deposited token. This can vary depending on the strategy running. \"}]]}]]}]\naa:[\"$\",\"p\",\"95786e006a834140a0a663c0d90613ed\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"56f58f043f59456aad7fd440ccc4a857\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"New potential vaults can be discussed in our Discord. Our strategists then add the potential investment strategy to our strategy list. A priority is assigned to each new, potential strategy based on its APY, TVL and sustainability. Our developers/strategists then attack the list from top priority to bottom.\"}]]}]]}]\nab:[\"$\",\"p\",\"45c6a35a15a646df89de2ec0c49b3aa9\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"26ef4fd252874440bbbc665ad9fd10b7\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Then the platform which the vault is potentially going to deposit into, is thoroughly screened to ensure its contracts and systems are safe and secure. For more information on our security checks, please refer to the \"}]]}],\"$Lc7\",[\"$\",\"$1\",\"867b7d50d78d41309cb47d95d70efe37\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\" page.\"}]]}]]}]\nad:[\"$\",\"p\",\"ba6c573a3d5d45b58301f9b9b1f770cf\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"f7aaeb546d9e4049ba2b0035fe31c8cf\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Each vault on the platform is named after the token that users can deposit in it. For example, the CAKE-BNB LP vault uses CAKE-BNB LP tokens for its investment strategy. A BTC vault uses the BTC token, etc.\"}]]}]]}]\nae:[\"$\",\"p\",\"3ff69fcb04494b06b93b16d0819afa9d\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"cb1e69d91adb4d86b58af27c016f7cf8\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Underneath the vault name, you can find the platform used for investing the token and farming its yields. For example, Uses: Venus means that that particular vault invests the token in Venus, a DeFi algorithmic money market and synthetic stablecoin protocol.\"}]]}]]}]\nb0:[\"$\",\"p\",\"8b05c48f839540dd961303bd160bdc42\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"8144d32b2e124e75a7e17cc90cd0ea1e\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[\"$\",\"i\",\"mark\",{\"className\":\"font-italic\",\"children\":\"The following applies to: Aave, Banker Joe, Blizz, Geist, Scream, Venus, and similar lending platforms.\"}]}]]}]]}]\nb1:[\"$\",\"p\",\"5b843d702d78444f971e74d7e515b593\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"66a1bd8f97e0497c988648ae82242ad3\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Most Beefy single asset vaults utilize decentralized marketplaces for lenders and borrowers. By depositing your initial asset in the vault, Beefy deposits it into the lending marketplace and borrows against your token at safe levels of collateral.\"}]]}]]}]\nb2:[\"$\",\"p\",\"9b8c68ec08aa4afda196476806ffa092\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"b657c21de47a49d180407a5df7dbc14a\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The borrowed tokens are redeposited into the platform, and once again used as collateral to borrow more tokens. This cycle is repeated multiple times to generate as much interest as possible from the lending interest and the reward token, which is used to buy more of your originally deposited assets. This strategy is also known as a folding strategy. It is noteworthy that this \\\"leveraged\\\" multi lending and multi borrowing is only with the deposited vault token, so there is no liquidation risk due to token price swings. \"}]]}]]}]\nb5:[\"$\",\"p\",\"4e7f1ce4806e4999aea8c8c94c0d195d\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"f70b4630a8a349849ffdbf460ed25aa3\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Due to accruing debt/supply interest, one may notice that the deposited token amount may decline ever so slightly in between harvests. After the harvest event, you will see your deposited token amount increase as the yields are compounded back into it. The change in deposited token amount over time of a typical lending style vault looks as follows:\"}]]}]]}]\nb6:[\"$\",\"div\",\"5db9a861a7e6479eacf3782fa82b8a10\",{\"className\":\"decoration-primary/6 max-w-3xl layout-wide:max-w-6xl mx-auto print:break-inside-avoid flex w-full justify-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-row gap-3\",\"children\":[\"$Lc8\"]}]}]\nb7:[\"$\",\"div\",null,{\"className\":\"max-w-3xl layout-wide:max-w-6xl mx-auto w-full mt-6 flex flex-row flex-wrap items-center gap-4 text-tint contrast-more:text-tint-strong\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mr-auto text-sm\",\"children\":[[[\"$\",\"$1\",\"string-0\",{\"children\":\"Last updated \"}],[\"$\",\"$1\",\"arg-0\",{\"children\":[\"$\",\"$Lc9\",null,{\"value\":\"2026-01-27T11:16:37.866Z\"}]}]],\"\"]}],[\"$\",\"$L67\",null,{\"className\":\"layout-wide:chat-open:max-[2416px]:flex layout-wide:max-3xl:flex xl:hidden xl:max-3xl:chat-open:flex\",\"pageId\":\"-MYopsjqfv8zovqC390o\"}]]}]\nb8:[\"$\",\"$Lca\",null,{\"displayContext\":\"site\"}]\n6a:[\"$\",\"header\",null,{\"className\":\"max-w-3xl layout-wide:max-w-6xl mx-auto w-full mb-6 space-y-3 after:clear-both after:block\",\"children\":[[\"$\",\"div\",null,{\"className\":\"float-right ml-4 flex gap-2 -mb-1 -mt-1.5\",\"children\":[[\"$\",\"$Lcb\",null,{\"siteTitle\":\"Beefy\",\"urls\":{\"html\":\"https://docs.beefy.finance/beefy-products/vaults\",\"markdown\":\"https://docs.beefy.finance/beefy-products/vaults.md\",\"rss\":\"$undefined\",\"editOnGit\":\"$undefined\",\"pdf\":\"$undefined\",\"mcp\":\"https://docs.beefy.finance/~gitbook/mcp\"},\"actions\":{\"items\":[\"markdown\",\"external-ai\",\"mcp\"]},\"page\":{\"id\":\"-MYopsjqfv8zovqC390o\",\"title\":\"Vaults\",\"path\":\"beefy-products/vaults\",\"href\":\"/beefy-products/vaults\"}}],[\"$\",\"$Lcc\",null,{}]]}],[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"data-cover-aware-text\":true,\"data-over-cover\":true,\"className\":\"page-cover-background:text-contrast-cover flow-root text-xs leading-relaxed text-tint layout-wide:page-no-toc:hidden page-cover-background:opacity-9\",\"children\":[\"$\",\"ol\",null,{\"className\":\"inline\",\"children\":[[],[[\"$\",\"li\",\"IWI8YtMiefLx0OpsSPW5\",{\"className\":\"inline\",\"children\":[[\"$\",\"$Lcd\",null,{\"href\":\"/beefy-products\",\"label\":\"Beefy Products\",\"emoji\":\"$undefined\",\"icon\":\"$undefined\",\"linkClassName\":[\"inline\",\"no-underline\",\"hover:underline\",\"text-xs\",\"font-normal\",\"items-center\",\"contrast-more:underline\",\"contrast-more:decoration-current\"],\"siblings\":[{\"id\":\"-MJZ103-ZVtXOD-rbQ6m\",\"title\":\"Overview\",\"href\":\"/\",\"emoji\":\"$undefined\",\"icon\":\"$undefined\",\"isActive\":false},{\"id\":\"w9qdMSjwFyaxEPBD