mr-[max(calc((100vw-90rem)/2),0rem)] page-api-block:page-has-outline:min-[96rem]:flex! page-api-block:page-has-outline:min-[96rem]:animate-none! page-api-block:page-has-outline:min-[96rem]:border-l-0 page-api-block:page-has-outline:min-[96rem]:pl-8 max-xl:hydrated:site-background layout-wide:max-3xl:hydrated:site-background text-tint contrast-more:text-tint-strong5f:[\"$\",\"$L47\",null,{\"side\":\"right\",\"toggleClass\":\"outline-open\",\"withOverlay\":true,\"withCloseButton\":true,\"className\":\"$62\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex h-full w-full shrink-0 flex-col overflow-hidden\",\"children\":[[null,[\"$\",\"div\",null,{\"className\":\"mb-3 ml-3 flex page-no-outline:hidden items-center justify-between max-lg:hidden\",\"children\":[[\"$\",\"$L63\",null,{\"data-cover-aware-text\":true,\"className\":\"leading-wider xl:page-cover-background:text-contrast-cover flex cursor-pointer items-center gap-1 text-xs font-semibold uppercase text-tint\",\"children\":[[\"$\",\"$L64\",null,{\"icon\":\"block-quote\",\"className\":\"size-3\"}],\" \",\"On this page\"]}],[\"$\",\"$L65\",null,{\"className\":\"page-api-block:min-[96rem]:hidden layout-default:xl:hidden layout-wide:3xl:hidden\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex shrink flex-col overflow-hidden\",\"children\":[[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L66\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-3 border-tint-subtle border-t first:border-none sidebar-list-default:px-3 pt-5 first:pt-0 empty:hidden\",\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":[\"$\",\"$L67\",null,{\"pageId\":\"-MYopsjqfv8zovqC390o\"}]}]}]]}]],null]}]}]\n60:[\"$\",\"$L68\",null,{\"page\":{\"spaceId\":\"-MJZ0tXJc-hdgL-YTlPk-887967055\",\"pageId\":\"-MYopsjqfv8zovqC390o\"},\"children\":[[\"$\",\"main\",null,{\"className\":\"relative min-w-0 flex-1 break-anywhere py-8 layout-wide:no-sidebar:lg:max-xl:pb-20 @container flex flex-col max-w-3xl layout-wide:max-w-6xl mx-auto w-full page-has-toc layout-default\",\"children\":[[\"$\",\"$L69\",null,{\"wideLayout\":false,\"pageHasToc\":true}],[\"$\",\"div\",null,{\"className\":\"sr-only\",\"children\":[\"For the complete documentation index, see \",[\"$\",\"a\",null,{\"href\":\"https://docs.beefy.finance/llms.txt\",\"children\":\"llms.txt\"}],\". This page is also available as \",[\"$\",\"a\",null,{\"href\":\"https://docs.beefy.finance/beefy-products/vaults.md\",\"children\":\"Markdown\"}],\".\"]}],null,[\"$\",\"div\",null,{\"className\":\"min-w-0 grow\",\"children\":[\"$L6a\",[[\"$\",\"$L6b\",null,{}],[\"$\",\"div\",null,{\"className\":\"contents\",\"data-content-ref-root\":\"\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col [\u0026\u003e*+*]:mt-5 whitespace-pre-wrap\",\"children\":[\"$L6c\",[\"$\",\"p\",\"c283b54dfdf446f098b74d293106fe1a\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"7c33f41823344bec84dce00e4f8617e0\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vaults are investment instruments that employ a specific set of \"}]]}],\"$L6d\",[\"$\",\"$1\",\"e4b58fad30dc4ba69c99d8bb14f1c2b9\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\" for yield farming or \"}]]}],\"$L6e\",[\"$\",\"$1\",\"ajshIEjWXSr6\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\". They make use of automation to invest and manage deposited funds, which help to achieve high levels of compounding interest. By using a Beefy vault to compound your gains, you save countless small transactions and their associated gas costs, and precious personal time. Instead of manually managing your position our vaults do that all automatically and at a higher frequency.\"}]]}]]}],[\"$\",\"p\",\"92aa0c70c0424451a1e3bddff23c89a1\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"d834f47ac10e40fd8984c1c898cf2db3\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Vaults are the core of the Beefy ecosystem. In a Beefy vault, you earn more of the asset you stake in it, regardless if this is an liquidity pool (LP) token or a single asset. For example, vaults where one can stake BTC-BNB LP will result in more BTC-BNB LP over time, effectively growing your share in the liquidity pool and thus allowing for more and more fees and rewards over time.\"}]]}]]}],[\"$\",\"p\",\"3ba237c7adef4adbbeb5ab0ffe1699f1\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"fb6b7d50ad9d48f79e8b79f75e8b21ca\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Despite the name 'Vault' suggests, user funds are never locked in any vault on Beefy. One could always withdraw from a vault at any moment in time. Beefy also does not own user funds staked in vaults. However, it is generally best to view vaults as investment tools to store funds for the medium to long term in order to have the effects of compounding really kick in.\"}]]}]]}],[\"$\",\"p\",\"64081e834efd40058afaf3d90e926162\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$1\",\"d4dea22ad14b40618db0df5570d1c765\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"When browsing the vaults on the platform, you will see the annual percentage yield (APY), which takes the frequent compounding into consideration compared to annual percentage rate (APR) which does not. You will also see daily interest percentages and the total amount invested in a vault by all users (TVL). Furthermore, one can see what underlying platform the vault is using as a source of revenue.\"}]]}]]}],\"$L6f\",\"$L70\",\"$L71\",\"$L72\",\"$L73\",\"$L74\",\"$L75\",\"$L76\",\"$L77\",\"$L78\",\"$L79\",\"$L7a\",\"$L7b\",\"$L7c\",\"$L7d\",\"$L7e\",\"$L7f\",\"$L80\",\"$L81\",\"$L82\",\"$L83\",\"$L84\",\"$L85\",\"$L86\",\"$L87\",\"$L88\",\"$L89\",\"$L8a\",\"$L8b\",\"$L8c\",\"$L8d\",\"$L8e\",\"$L8f\",\"$L90\",\"$L91\",\"$L92\",\"$L93\",\"$L94\",\"$L95\",\"$L96\",\"$L97\",\"$L98\",\"$L99\",\"$L9a\",\"$L9b\",\"$L9c\",\"$L9d\",\"$L9e\",\"$L9f\",\"$La0\",\"$La1\",\"$La2\",\"$La3\",\"$La4\",\"$La5\",\"$La6\",\"$La7\",\"$La8\",\"$La9\",\"$Laa\",\"$Lab\",\"$Lac\",\"$Lad\",\"$Lae\",\"$Laf\",\"$Lb0\",\"$Lb1\",\"$Lb2\",\"$Lb3\",\"$Lb4\",\"$Lb5\",\"$Lb6\"]}]}]]]}],null,\"$Lb7\"]}],\"$Lb8\"]}]\n"])</script><script>self.__next_f.push([1,"c9:I[13665,[\"6268\",\"static/chunks/f5718501-a20130c46e7caef0.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"2122\",\"static/chunks/9071f66d-65831af376c95d36.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"9246\",\"static/chunks/9246-1df5a88dbb0722cb.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"6213\",\"static/chunks/6213-fcd8f601a9fdf399.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"6811\",\"static/chunks/6811-b5a1327b6b81e44f.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"8925\",\"static/chunks/8925-6060a99c23e7e616.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"9935\",\"static/chunks/9935-80b39f0c55275a9a.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"2335\",\"static/chunks/2335-8c32917160f47d72.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"4825\",\"static/chunks/4825-f35482f8ae1516fc.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"9495\",\"static/chunks/9495-ba5508b79e993015.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"3305\",\"static/chunks/3305-d6785762ffbce13a.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\"8617\",\"static/chunks/app/sites/static/%5Bmode%5D/%5BsiteURL%5D/%5BsiteData%5D/(content)/%5BpagePath%5D/page-2b817ac5b411d64f.js?dpl=p-40150f0a6cd80dd82e78562380092f\"],\"DateRelative\"]\nca:I[29183,[\"6268\",\"static/chunks/f5718501-a20130c46e7caef0.js?dpl=p-40150f0a6cd80dd82e78562380092f\",\