`,children:_jsx(_components.p,{children:`Use CCTP hooks to chain together crosschain actions. Transfer assets across\nblockchains and automatically deposit them into DeFi protocols, purchase NFTs,\nor execute smart contract logic.`})})]}),`\n`,_jsx(Heading,{level:`2`,id:`get-started`,children:`Get started`}),`\n`,_jsxs(CardGroup,{cols:2,children:[_jsx(Card,{title:`Transfer USDC from Ethereum to Arc`,icon:`rocket`,href:`/cctp/quickstarts/transfer-usdc-ethereum-to-arc`,children:_jsx(_components.p,{children:`Build a script to transfer USDC between EVM blockchains using CCTP`})}),_jsx(Card,{title:`Transfer USDC from Solana to Arc`,icon:`rocket`,href:`/cctp/quickstarts/transfer-usdc-solana-to-arc`,children:_jsx(_components.p,{children:`Transfer USDC from Solana to an EVM blockchain using CCTP`})}),_jsx(Card,{title:`Transfer USDC between Stellar and Arc`,icon:`rocket`,href:`/cctp/quickstarts/transfer-usdc-stellar-arc`,children:_jsx(_components.p,{children:`Transfer USDC between Arc and Stellar using CCTP`})})]}),`\n`,_jsx(Heading,{level:`2`,id:`cctp-for-non-usdc-assets`,children:`CCTP for non-USDC assets`}),`\n`,_jsxs(_components.p,{children:[`CCTP natively transfers USDC across blockchains using burn-and-mint. For EURC or\nother registered ERC-20 assets, see\n`,_jsx(_components.a,{href:`/cctp/expanded-assets`,children:`CCTP for non-USDC assets`}),`, which extends CCTP’s\nattestation infrastructure to support EURC burn-and-mint and permissionless\nwrapping of third-party assets (including pre-registered tokens like WETH).`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Feature`}),_jsx(_components.th,{children:`CCTP`}),_jsx(_components.th,{children:`CCTP for non-USDC`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Token scope`}),_jsx(_components.td,{children:`USDC`}),_jsx(_components.td,{children:`EURC and any registered ERC-20`})]}),_js