-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.accent-orange {\n  background-color: #fff7ed;\n  color: #ea580c;\n}\n\n.accent-blue {\n  background-color: #eff6ff;\n  color: #2563eb;\n}\n\n.accent-green {\n  background-color: #f0fdf4;\n  color: #16a34a;\n}\n\n.accent-purple {\n  background-color: #faf5ff;\n  color: #9333ea;\n}\n\n.accent-violet {\n  background-color: #f5f3ff;\n  color: #7c3aed;\n}\n\n.type-header-xs {\n  font-size: 18px;\n  font-weight: 600;\n  line-height: 1.4;\n  color: #111827;\n}\n\n.type-body-base {\n  font-size: 14px;\n  line-height: 1.5;\n  color: #6b7280;\n}\n\n.type-body-xs-bold {\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: #6b7280;\n}\n\n.type-body-sm {\n  font-size: 14px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.type-body-sm-bold {\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.5;\n}\n\n.text-neutral-subtle {\n  color: #6b7280;\n}\n\n.text-icon-neutral {\n  color: #6b7280;\n}\n\n.cb-button {\n  display: inline-flex;\n  align-items: center;\n  padding: 8px 16px;\n  border-radius: 8px;\n  font-size: 14px;\n  font-weight: 500;\n  text-decoration: none;\n  transition: all 0.2s;\n  border: 1px solid #e5e7eb;\n  background: white;\n  color: #374151;\n}\n\n.cb-button:hover {\n  background: #f9fafb;\n  border-color: #d1d5db;\n}\n"])</script><script>self.__next_f.push([1,"55:T5edf,"])</script><script>self.__next_f.push([1,"/* ============================================================\n   EDS dark-mode background overrides\n   ============================================================ */\n\n/* Override Mintlify's --background-dark with EDS bg-surface-background.\n   This variable drives every dark-mode surface in Mintlify (page body,\n   #background-color span, navbar, sidebar, footer) via the\n   `dark:bg-background-dark` Tailwind utility. Setting it once propagates\n   everywhere — and only affects dark mode. Light mode keeps the default\n   --background-light (white).\n   Value is RGB triplet (Tailwind v4 convention), no commas. 17 24 39 = #111827.\n   The !important is needed to beat Aspen theme's downstream override (15 17 23). */\n:root {\n  --background-dark: 17 24 39 !important;\n}\n\n/* Match card surfaces to the page bg in dark mode so cards render as\n   outline-only against the EDS dark surface. Scoped to html.dark so light\n   mode is unaffected. */\nhtml.dark .card {\n  background-color: #111827 !important;\n}\n\n/* Same treatment for accordions — outline-only against the EDS dark surface.\n   The circle-info accordion override below is more specific (:has() pulls in\n   the inner selector's specificity) and keeps its intentional tinted bg. */\nhtml.dark .accordion {\n  background-color: #111827 !important;\n}\n\n/* ============================================================\n   Navbar action pills — unify Sign in to console / Faucet / theme\n   toggle on a single visible wash. Mintlify ships each with its\n   own bg utility (Sign in \u0026 Faucet: bg-gray-950/[0.03], toggle:\n   bg-gray-800/[0.04] / dark:bg-white/10), so at rest the three\n   look mismatched.\n\n   We also apply the dark-mode value via prefers-color-scheme in\n   addition to html.dark. Mintlify renders the SSR HTML without\n   .dark on \u003chtml\u003e and only adds it after hydration; meanwhile\n   the page background already paints dark (inlined from\n   docs.json background.color.dark). That gap is what causes the\n   \"flash\" where pills look like light-mode washes on a dark\n   page. prefers-color-scheme lands the right color on first paint\n   for the common case (system-dark users); html.dark re-asserts\n   it for users who manually toggle dark on a light system.\n\n   Values are subtle neutral washes — visible enough to read as\n   pill chrome on either surface, quiet enough not to compete with\n   the search bar and the primary CTA.\n\n   Trade-off: a user with a dark system preference who has\n   manually toggled the docs to light will briefly see a\n   transparent-looking pill on a white page, because the @media\n   rule wins until hydration adds .dark (or in this case, removes\n   the absence-of-.dark default) and the page repaints. Acceptable\n   until we add a pre-paint inline script that reads localStorage\n   and sets the theme class before first paint.\n   ============================================================ */\n#navbar [data-component-name=\"theme-toggle\"],\n#navbar a[href*=\"console.circle.com\"],\n#navbar a[href*=\"faucet.circle.com\"],\n#navbar .navbar-link a {\n  background-color: rgba(17, 24, 39, 0.03) !important;\n}\n\n#navbar [data-component-name=\"theme-toggle\"]:hover,\n#navbar a[href*=\"console.circle.com\"]:hover,\n#navbar a[href*=\"faucet.circle.com\"]:hover,\n#navbar .navbar-link a:hover {\n  background-color: rgba(17, 24, 39, 0.07) !important;\n}\n\n@media (prefers-color-scheme: dark) {\n  #navbar [data-component-name=\"theme-toggle\"],\n  #navbar a[href*=\"console.circle.com\"],\n  #navbar a[href*=\"faucet.circle.com\"],\n  #navbar .navbar-link a {\n    background-color: rgba(255, 255, 255, 0.05) !important;\n  }\n\n  #navbar [data-component-name=\"theme-toggle\"]:hover,\n  #navbar a[href*=\"console.circle.com\"]:hover,\n  #navbar a[href*=\"faucet.circle.com\"]:hover,\n  #navbar .navbar-link a:hover {\n    background-color: rgba(255, 255, 255, 0.10) !important;\n  }\n}\n\nhtml.dark #navbar [data-component-name=\"theme-toggle\"],\nhtml.dark #navbar a[href*=\"console.circle.com\"],\nhtml.dark #navbar a[href*=\"faucet.circle.com\"],\nhtml.dark #navbar .navbar-link a {\n  background-color: rgba(255, 255, 255, 0.05) !important;\n}\n\nhtml.dark #navbar [data-component-name=\"theme-toggle\"]:hover,\nhtml.dark #navbar a[href*=\"console.circle.com\"]:hover,\nhtml.dark #navbar a[href*=\"faucet.circle.com\"]:hover,\nhtml.dark #navbar .navbar-link a:hover {\n  background-color: rgba(255, 255, 255, 0.10) !important;\n}\n\n/* ============================================================\n   EDS dark-mode primary button text fix\n   Per EDS text-invert token: dark mode text on bold-interactive\n   backgrounds should be black (#000000) for WCAG AA contrast\n   (white on #1AA3FF = 2.7:1, black on #1AA3FF = 7.7:1).\n   ============================================================ */\nhtml.dark #topbar-cta-button,\nhtml.dark #topbar-cta-button a {\n  color: #000000 !important;\n}\n\nhtml.dark #feedback-form-submit {\n  color: #000000 !important;\n}\n\nhtml.dark tryit-button {\n  color: #000000 !important;\n}\n\nhtml.dark chat-assistant-send-button {\n  color: #000000 !important;\n}\n\nhtml.dark contextual-feedback-form-submit-button {\n  color: #000000 !important;\n}\n\nhtml.dark code-snippet-feedback-form-submit-button {\n  color: #000000 !important;\n}\n\n/* Hero primary CTA in HeroSection.jsx — Mintlify's Tailwind compilation\n   for snippet files doesn't reliably pick up dark: variants, so we override\n   here. Targets any anchor with the primary button background colors.\n   Dark-mode primary uses blue-200 (#5FBFFF), with black text for\n   WCAG AAA contrast. */\nhtml.dark a[class*=\"bg-[#5FBFFF]\"],\nhtml.dark a[class*=\"bg-[#90D2FF]\"],\nhtml.dark a[class*=\"bg-[#1AA3FF]\"],\nhtml.dark a[class*=\"bg-[#0073C3]\"] {\n  color: #000000 !important;\n}\n\nhtml.dark a[class*=\"bg-[#5FBFFF]\"] svg,\nhtml.dark a[class*=\"bg-[#90D2FF]\"] svg,\nhtml.dark a[class*=\"bg-[#1AA3FF]\"] svg,\nhtml.dark a[class*=\"bg-[#0073C3]\"] svg {\n  color: #000000 !important;\n}\n\n/* ============================================================\n   MCP Setup Container\n   ============================================================ */\n.mcp-setup-container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 24px;\n  margin: 20px 0 28px;\n}\n\n.mcp-setup-section {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.mcp-setup-label {\n  font-size: 0.75rem;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: #64748b;\n}\n\n.dark .mcp-setup-label {\n  color: #94a3b8;\n}\n\n.mcp-cta-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.mcp-cta {\n  height: 40px;\n  border-radius: 12px;\n  font-weight: 600;\n  font-size: 0.875rem;\n  padding: 0 16px;\n  text-decoration: none !important;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  border: 1px solid rgba(15, 23, 42, 0.15);\n  background-color: #f8fafc;\n  color: #0b0f19;\n  transition: background-color 0.15s ease, border-color 0.15s ease;\n  cursor: pointer;\n}\n\n.mcp-cta:hover {\n  background-color: #f1f5f9;\n  border-color: rgba(15, 23, 42, 0.25);\n}\n\n.mcp-cta img {\n  width: 20px;\n  height: 20px;\n  object-fit: contain;\n  border-radius: 6px;\n  flex-shrink: 0;\n}\n\n.mcp-cta span {\n  white-space: nowrap;\n}\n\n.dark .mcp-cta {\n  border-color: rgba(255, 255, 255, 0.2);\n  background-color: rgba(255, 255, 255, 0.08);\n  color: #f8fafc;\n}\n\n.dark .mcp-cta:hover {\n  background-color: rgba(255, 255, 255, 0.12);\n  border-color: rgba(255, 255, 255, 0.3);\n}\n\n/* CLI-specific button styles (single line) */\n.mcp-cta-cli {\n  background-color: #f1f5f9;\n  border-color: #e2e8f0;\n}\n\n.mcp-cta-cli:hover {\n  background-color: #e2e8f0;\n  border-color: #cbd5e1;\n}\n\n.dark .mcp-cta-cli {\n  background-color: rgba(255, 255, 255, 0.06);\n  border-color: rgba(255, 255, 255, 0.15);\n}\n\n.dark .mcp-cta-cli:hover {\n  background-color: rgba(255, 255, 255, 0.1);\n  border-color: rgba(255, 255, 255, 0.25);\n}\n\n.mcp-cli-label {\n  font-weight: 600;\n  color: #0f172a;\n}\n\n.dark .mcp-cli-label {\n  color: #f1f5f9;\n}\n\n.mcp-cli-cmd {\n  font-size: 0.75rem;\n  font-family: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace;\n  color: #64748b;\n  background: transparent !important;\n  padding: 0;\n  white-space: nowrap;\n  border: none;\n}\n\n.dark .mcp-cli-cmd {\n  color: #94a3b8;\n  background: transparent !important;\n}\n\n.mcp-cli-icon-wrap {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: 14px;\n  height: 14px;\n  position: relative;\n}\n\n.mcp-cli-icon-wrap svg {\n  color: #94a3b8;\n  transition: opacity 0.15s ease;\n}\n\n.mcp-cta-cli:hover .mcp-cli-icon-wrap svg {\n  color: #64748b;\n}\n\n.dark .mcp-cli-icon-wrap svg {\n  color: #64748b;\n}\n\n.dark .mcp-cta-cli:hover .mcp-cli-icon-wrap svg {\n  color: #94a3b8;\n}\n\n/* Copy/Check icon toggle */\n.mcp-icon-check {\n  position: absolute;\n  opacity: 0;\n  color: #22c55e !important;\n}\n\n.mcp-cta-cli.copied .mcp-icon-copy {\n  opacity: 0;\n}\n\n.mcp-cta-cli.copied .mcp-icon-check {\n  opacity: 1;\n}\n\n/* OpenAI logo is black on transparent - invert in dark mode */\n.dark .mcp-cli-openai-logo {\n  filter: invert(1);\n}\ntable thead {\n  text-align: left;\n  background-color: #f5f5f8;\n}\n\n.dark table thead {\n  text-align: left;\n  background-color: #29233b;\n}\n\ntable thead th,\ntable td {\n  padding: 8px !important;\n}\n\n/* Accordion with circle-info icon styling */\n.accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  ) {\n  background-color: #e1f2ff !important;\n  border-color: #c9e1f5 !important;\n}\n\n.accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  summary {\n  transition: background-color 0.3s ease !important;\n}\n\n.accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  summary:hover {\n  background-color: #c9e1f5 !important;\n}\n\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  ) {\n  background-color: #1f1a30 !important;\n  border-color: #29233b !important;\n}\n\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  summary {\n  transition: background-color 0.3s ease !important;\n}\n\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  summary:hover {\n  background-color: #29233b !important;\n}\n\n/* Ensure text is white in dark mode for circle-info accordions */\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  [data-component-part=\"accordion-title\"] {\n  color: #ffffff !important;\n}\n\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  [data-component-part=\"accordion-content\"] {\n  color: #e5e7eb !important;\n}\n\n/* Links in dark mode circle-info accordions */\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  [data-component-part=\"accordion-content\"]\n  a {\n  color: #1aa3ff !important;\n}\n\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  [data-component-part=\"accordion-content\"]\n  a:hover {\n  color: #1894e8 !important;\n}\n\n/* Inline code in dark mode circle-info accordions */\n.dark\n  .accordion:has(\n    [data-component-part=\"accordion-icon\"] svg[style*=\"circle-info.svg\"]\n  )\n  [data-component-part=\"accordion-content\"]\n  code {\n  color: #fbbf24 !important;\n  background-color: #374151 !important;\n}\n\n/* TryItOut Component code block styling */\n.TryItOutComponent pre,\n.TryItOutComponent code {\n  background-color: transparent !important;\n}\n\n.TryItOutComponent .code-container {\n  background-color: white !important;\n}\n\n.dark .TryItOutComponent .code-container {\n  background-color: #29233b !important;\n}\n\n.home_code_container .code-block {\n  margin: 0 !important;\n  height: 100%;\n}\n\n.home_code_container .code-block .code-block-background {\n  height: 100% !important;\n}\n\n.home_mint_cards a.card \u003e div {\n  padding: 20px !important;\n}\n\n.home_mint_cards h2 {\n  color: #29233b !important;\n}\n\n.home_mint_cards div.prose span {\n  color: #6b6580 !important;\n}\n\n.dark .home_mint_cards h2 {\n  color: #fff !important;\n}\n\n.dark .home_mint_cards div.prose span {\n  color: #9ca3af !important;\n}\n\n.home_mint_cards a.card svg {\n  background-color: #6b6580 !important;\n}\n\n.home_mint_cards a.card:hover svg {\n  background: linear-gradient(135deg, #5fbfff 0%, #b090f5 100%) !important;\n}\n\n.home_tryitout {\n  background: linear-gradient(\n    89deg,\n    var(\n        --background-gradient-bg-accent-purple-gradient-bottom-left,\n        rgba(241, 235, 255, 0.5)\n      )\n      0%,\n    var(\n        --background-gradient-bg-accent-purple-gradient-top-right,\n        rgba(225, 242, 255, 0.5)\n      )\n      94.58%\n  );\n}\n\n.dark .home_tryitout {\n  background: linear-gradient(\n    89deg,\n    var(\n        --background-gradient-bg-accent-purple-gradient-bottom-left,\n        rgba(44, 44, 44, 0.5)\n      )\n      0%,\n    var(\n        --background-gradient-bg-accent-purple-gradient-top-right,\n        rgba(75, 82, 86, 0.5)\n      )\n      94.58%\n  );\n}\n\n/* Quickstart cards - ensure equal height and aligned CTAs */\n.quickstart-cards-aligned [data-component-part=\"card-group\"] {\n  gap: 16px !important;\n}\n\n/* Asset cards */\n.asset-card-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 1.5rem;\n  margin: 1.5rem 0;\n  align-items: stretch;\n}\n\n.asset-card {\n  border: 1px solid #e5e7eb;\n  border-radius: 1rem;\n  background: transparent;\n  padding: 1rem 1.25rem 1.5rem;\n  text-decoration: none;\n  color: inherit;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  gap: 0.45rem;\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;\n  height: 100%;\n}\n\n.asset-card:hover {\n  border-color: #cfd3dc;\n  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);\n  transform: translateY(-2px);\n}\n\n.dark .asset-card {\n  border-color: rgba(148, 163, 184, 0.14);\n  background: transparent;\n  box-shadow: none;\n}\n\n.asset-card h3 {\n  font-size: 1.125rem;\n  font-weight: 600;\n  margin: 0;\n  color: #0f172a;\n}\n\n.dark .asset-card h3 {\n  color: #f8fafc;\n}\n\n.asset-card p {\n  margin: 0;\n  font-weight: 300;\n  color: #475569;\n}\n\n.dark .asset-card p {\n  color: #b8b8b8;\n}\n\n.asset-card-image-wrapper,\n.asset-card-inline-icon {\n  width: 56px;\n  height: 56px;\n  border-radius: 9999px;\n  margin-bottom: 0.6rem;\n  flex-shrink: 0;\n}\n\n.asset-card-image-wrapper {\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(15, 23, 42, 0.05);\n}\n\n.dark .asset-card-image-wrapper {\n  background: rgba(248, 250, 252, 0.08);\n}\n\n.asset-card-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n.asset-card-inline-icon {\n  padding: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(\n    135deg,\n    rgba(0, 96, 255, 0.18),\n    rgba(0, 164, 255, 0.05)\n  );\n  color: #0d5be1;\n}\n\n.dark .asset-card-inline-icon {\n  background: rgba(255, 255, 255, 0.08);\n  color: #82b7ff;\n}\n\n.asset-card-inline-icon svg {\n  width: 26px;\n  height: 26px;\n}\n\n.asset-card.secondary {\n  justify-content: flex-start;\n}\n\n/* Ensure cards have equal height */\n.quickstart-cards-aligned a.card,\n.quickstart-cards-aligned [data-component-part=\"card\"] {\n  display: flex !important;\n  flex-direction: column !important;\n  height: 100% !important;\n}\n\n/* Make card content flex to push CTA to bottom */\n.quickstart-cards-aligned a.card \u003e div,\n.quickstart-cards-aligned [data-component-part=\"card\"] \u003e div {\n  display: flex !important;\n  flex-direction: column !important;\n  height: 100% !important;\n}\n\n/* Make the prose/content area grow to push CTA to bottom */\n.quickstart-cards-aligned a.card \u003e div \u003e .prose,\n.quickstart-cards-aligned [data-component-part=\"card\"] \u003e div \u003e .prose {\n  flex-grow: 1 !important;\n  display: flex !important;\n  flex-direction: column !important;\n}\n\n/* Ensure CTA button stays at bottom */\n.quickstart-cards-aligned a.card \u003e div \u003e div:last-child,\n.quickstart-cards-aligned [data-component-part=\"card\"] \u003e div \u003e div:last-child {\n  margin-top: auto !important;\n}\n\n/* Mobile/Tablet view: Add vertical spacing between cards when they stack */\n@media (max-width: 1024px) {\n  /* Convert parent to flexbox for better mobile control */\n  div.quickstart-cards-aligned,\n  .quickstart-cards-aligned {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 4px !important;\n  }\n\n  /* Ensure CardGroup respects parent flex layout */\n  div.quickstart-cards-aligned [data-component-part=\"card-group\"],\n  div.quickstart-cards-aligned \u003e div,\n  .quickstart-cards-aligned [data-component-part=\"card-group\"],\n  .quickstart-cards-aligned \u003e div {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 4px !important;\n    row-gap: 4px !important;\n    grid-row-gap: 4px !important;\n    width: 100% !important;\n  }\n\n  /* Add margin-bottom as triple-fallback for individual cards */\n  div.quickstart-cards-aligned a.card,\n  .quickstart-cards-aligned a.card,\n  .quickstart-cards-aligned [data-component-part=\"card\"] {\n    margin-bottom: 4px !important;\n    width: 100% !important;\n  }\n\n  /* Remove extra margin from last card */\n  div.quickstart-cards-aligned a.card:last-child,\n  .quickstart-cards-aligned a.card:last-child,\n  .quickstart-cards-aligned [data-component-part=\"card\"]:last-child {\n    margin-bottom: 0 !important;\n  }\n}\n\n/* Footer container - prevent overflow */\nfooter,\nfooter \u003e div,\nfooter [data-component-part=\"footer\"],\nfooter [data-component-part=\"footer-section\"] {\n  overflow-x: hidden !important;\n  max-width: 100% !important;\n  padding-top: 1.75rem !important;\n}\n\n/* Footer links — layout/typography only. */\nfooter a,\nfooter [data-component-part=\"footer-link\"],\nfooter .footer-link,\n#your-privacy-choices-button {\n  overflow-wrap: normal !important;\n  word-wrap: normal !important;\n  word-break: keep-all !important;\n  hyphens: none !important;\n  font-size: 0.75rem !important; /* 12px - text-xs */\n  white-space: normal !important;\n  max-width: 100% !important;\n  line-height: 1.4 !important;\n  min-width: 0 !important;\n}\n\n/* Footer chrome color tier — legal links, privacy button, and the\n   social icons (via the same EDS neutrals applied as background-color\n   for mask-image icons further down). Replaces Mintlify's default\n   `text-gray-950/50 dark:text-white/50` (which dropped to ~3.8:1 in\n   light mode, failing WCAG AA) with EDS neutrals that read as quiet\n   footer chrome while staying AA-compliant on both surfaces.\n     - Light: black-400 #6B6580 on white      ≈ 5.7:1 ✓\n     - Dark:  black-300 #8A849C on #111827    ≈ 4.8:1 ✓\n   Hover bumps one tier toward body text for affordance. */\n#footer a,\n#your-privacy-choices-button {\n  color: #6B6580 !important;\n}\n\nhtml.dark #footer a,\nhtml.dark #your-privacy-choices-button {\n  color: #8A849C !important;\n}\n\n#footer a:hover,\n#your-privacy-choices-button:hover {\n  color: #4E4763 !important; /* black-500 */\n}\n\nhtml.dark #footer a:hover,\nhtml.dark #your-privacy-choices-button:hover {\n  color: #A7A3B5 !important; /* black-200 */\n}\n\n#your-privacy-choices-button {\n  position: relative;\n  align-self: start;\n}\n\n/* The footer column wrapper has `md:items-center`, which horizontally centers\n   the inner link group at md+ breakpoints. Align the inner group to the start\n   so the privacy-choices button (and its sibling links) sit left. */\nfooter .md\\:items-center \u003e div:has(\u003e #your-privacy-choices-button) {\n  align-self: flex-start !important;\n}\n\n#your-privacy-choices-button::after {\n  content: url(\"https://6778953.fs1.hubspotusercontent-na1.net/hubfs/6778953/legal/opt-out-30x14.svg\");\n  right: -34px;\n  position: absolute;\n}\n\n/* No hover color override — Mintlify's default\n   `hover:text-gray-950/70 dark:hover:text-white/70` handles hover state\n   in the same muted tier. */\n\n#footer \u003e div {\n  gap: 12px;\n  padding-bottom: 20px;\n}\n\n/* \"Powered by Mintlify\" badge — Mintlify's plan-tier enforcement\n   requires the badge stay visible. Color it with EDS neutral tokens so\n   it reads as subtle footer chrome while meeting WCAG AA contrast\n   (4.5:1 for normal text). The opacity-based subduing we used\n   previously dropped contrast below 2:1; explicit tokens give\n   predictable, accessible color.\n     - Light: black-400 #6B6580 on white      ≈ 5.7:1 ✓\n     - Dark:  black-300 #8A849C on #111827    ≈ 4.8:1 ✓\n   Hover bumps one step closer to body text for affordance. */\n#footer a[href*=\"mintlify\"],\n#footer a[href*=\"mintlify\"] span,\n#footer a[href*=\"mintlify\"] svg {\n  color: #6B6580 !important;\n  fill: currentColor !important;\n}\n\nhtml.dark #footer a[href*=\"mintlify\"],\nhtml.dark #footer a[href*=\"mintlify\"] span,\nhtml.dark #footer a[href*=\"mintlify\"] svg {\n  color: #8A849C !important;\n}\n\n#footer a[href*=\"mintlify\"]:hover,\n#footer a[href*=\"mintlify\"]:hover span,\n#footer a[href*=\"mintlify\"]:hover svg {\n  color: #4E4763 !important; /* black-500 */\n}\n\nhtml.dark #footer a[href*=\"mintlify\"]:hover,\nhtml.dark #footer a[href*=\"mintlify\"]:hover span,\nhtml.dark #footer a[href*=\"mintlify\"]:hover svg {\n  color: #A7A3B5 !important; /* black-200 */\n}\n\n/* Cap the desktop socials column width so it tracks the social icons\n   (~164px for 5 icons + gaps) rather than stretching wider when the\n   relocated badge is appended. Without this the column expands to\n   accommodate the badge's natural content width, doubling its width. */\n#footer\n  .gap-4.min-w-\\[140px\\].max-w-\\[492px\\].flex-wrap.hidden.md\\:flex:has(\n    [data-powered-by-relocated]\n  ) {\n  flex: 0 0 auto !important;\n  width: auto !important;\n  max-width: 200px !important;\n}\n\n/* When the badge is relocated into the desktop socials column by\n   content/footer-powered-by.js, sit it on its own line at the bottom\n   of that column. The socials column is a wrapping flex row aligned\n   to the end; `flex-basis: 100%` forces the badge to wrap onto its own\n   line, and `justify-content: flex-end` keeps it right-aligned in line\n   with the icons. */\n#footer [data-powered-by-relocated] {\n  flex: 0 0 100% !important;\n  display: flex !important;\n  justify-content: flex-end !important;\n  margin-top: 0.25rem !important;\n}\n\n/* Match the badge text/wordmark to the rest of the footer chrome\n   (12px) and ensure it fits comfortably in the constrained column. */\n#footer [data-powered-by-relocated] a[href*=\"mintlify\"] {\n  font-size: 0.75rem !important;\n}\n\n#footer [data-powered-by-relocated] a[href*=\"mintlify\"] svg {\n  height: 0.75rem !important;\n  width: auto !important;\n}\n\n/* Hide the unrelated icon group (theme toggle / Mintlify chrome) that\n   ships in the same wrapper as the \"Powered by\" attribution. Keep only\n   the children that actually contain the attribution link. */\n#footer [data-powered-by-relocated] \u003e *:not(:has(a[href*=\"mintlify\"])) {\n  display: none !important;\n}\n\n/* The desktop socials column is `hidden md:flex`, which would also hide\n   the relocated badge on mobile. The Mintlify attribution must remain\n   visible, so on mobile we keep the column flex-displayed *only* to\n   show the badge — the social icons themselves are duplicated in the\n   separate mobile-only socials column (`md:hidden flex ...`), so we\n   hide the desktop-column copies on mobile to avoid showing them twice. */\n@media (max-width: 767px) {\n  #footer\n    .gap-4.min-w-\\[140px\\].max-w-\\[492px\\].flex-wrap.hidden.md\\:flex {\n    display: flex !important;\n    justify-content: flex-end !important;\n  }\n  #footer\n    .gap-4.min-w-\\[140px\\].max-w-\\[492px\\].flex-wrap.hidden.md\\:flex\n    \u003e a {\n    display: none !important;\n  }\n}\n\n/* Footer social icons (X, LinkedIn, Instagram, YouTube, Discord).\n   Mintlify renders these as \u003csvg\u003e with `mask-image`; their visible\n   color is `background-color` (not `color`). Match them to the same\n   EDS footer-chrome tier as the legal links so the whole footer reads\n   as one coordinated, AA-compliant tier. WCAG 1.4.11 (non-text\n   contrast) requires 3:1 for UI components — these comfortably pass\n   on both surfaces. */\n#footer svg[style*=\"mask-image\"] {\n  background-color: #6B6580 !important; /* black-400 */\n}\n\nhtml.dark #footer svg[style*=\"mask-image\"] {\n  background-color: #8A849C !important; /* black-300 */\n}\n\n#footer a:hover svg[style*=\"mask-image\"] {\n  background-color: #4E4763 !important; /* black-500 */\n}\n\nhtml.dark #footer a:hover svg[style*=\"mask-image\"] {\n  background-color: #A7A3B5 !important; /* black-200 */\n}\n"])</script><script>self.__next_f.push([1,"4f:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"snippets/SDKCard.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$54\"}}],[\"$\",\"style\",\"1\",{\"data-custom-css-index\":1,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$55\"}}]]\n57:T6b2,"])</script><script>self.__next_f.push([1,"const privacyChoiceButtonId = \"your-privacy-choices-button\";\n\nfunction createYourPrivacyChoicesFooterButton() {\n  const button = document.createElement(\"button\");\n  button.innerHTML = \"Your Privacy Choices\";\n  button.id = privacyChoiceButtonId;\n  button.addEventListener(\"click\", () =\u003e {\n    if (window.OneTrust \u0026\u0026 window.OneTrust.ToggleInfoDisplay) {\n      window.OneTrust.ToggleInfoDisplay();\n    } else {\n      console.error(\"OneTrust not loaded\");\n    }\n  });\n  return button;\n}\n\nfunction addPrivacyChoicesToFooter() {\n  const sibling = document.querySelector(\n    'a[href=\"https://www.circle.com/en/legal/cookie-policy\"]'\n  );\n  const privacyChoiceButtonExists = !!document.getElementById(\n    privacyChoiceButtonId\n  );\n\n  // If the privacy choice button does not yet exist, add it to the footer.\n  if (sibling \u0026\u0026 !privacyChoiceButtonExists) {\n    sibling.after(createYourPrivacyChoicesFooterButton());\n  }\n}\n\n(function (w, d, s, l, i) {\n  w[l] = w[l] || [];\n  w[l].push({ \"gtm.start\": new Date().getTime(), event: \"gtm.js\" });\n  var f = d.getElementsByTagName(s)[0],\n    j = d.createElement(s),\n    dl = l != \"dataLayer\" ? \"\u0026l=\" + l : \"\";\n  j.async = true;\n  j.src = \"https://www.googletagmanager.com/gtm.js?id=\" + i + dl;\n  f.parentNode.insertBefore(j, f);\n\n  // One-trust privacy choices button: ability to toggle privacy choices.\n  addPrivacyChoicesToFooter();\n})(window, document, \"script\", \"dataLayer\", \"GTM-T2NX7ZN\");\n\n// Add privacy choices to footer on navigation, since the iife runs after the site is loaded, but not again during navigation.\nnavigation.addEventListener(\"navigate\", async () =\u003e {\n  await new Promise((resolve) =\u003e requestAnimationFrame(resolve));\n  addPrivacyChoicesToFooter();\n});\n"])</script><script>self.__next_f.push([1,"58:T8a0,"])</script><script>self.__next_f.push([1,"// Move the Mintlify \"Powered by\" attribution badge into the desktop\n// socials column so it sits below the social icons rather than living\n// in its own section under the main footer row. The badge stays visible\n// (per Mintlify's plan-tier requirement); this only changes layout.\n\nconst POWERED_BY_LINK_SELECTOR = 'a[href*=\"mintlify.com\"]';\n// The DESKTOP socials column. There's also a mobile variant\n// (`md:hidden flex ...`) but we anchor to the desktop one and rely on\n// CSS to keep the badge visible on mobile (see style.css).\nconst SOCIALS_COLUMN_SELECTOR =\n  '.gap-4.min-w-\\\\[140px\\\\].max-w-\\\\[492px\\\\].flex-wrap.hidden.md\\\\:flex';\n\nfunction repositionPoweredBy() {\n  const footer = document.getElementById(\"footer\");\n  if (!footer) return false;\n\n  const poweredByLink = footer.querySelector(POWERED_BY_LINK_SELECTOR);\n  if (!poweredByLink) return false;\n\n  const outerContainer = footer.firstElementChild;\n  if (!outerContainer) return false;\n\n  // Walk up to find the badge wrapper that's a direct child of the\n  // outer footer container (the separate \"Powered by\" row).\n  let badgeRow = poweredByLink;\n  while (badgeRow \u0026\u0026 badgeRow.parentElement !== outerContainer) {\n    badgeRow = badgeRow.parentElement;\n  }\n  if (!badgeRow) return false;\n\n  const socialsColumn = footer.querySelector(SOCIALS_COLUMN_SELECTOR);\n  if (!socialsColumn) return false;\n\n  // Already moved — nothing to do.\n  if (socialsColumn.contains(badgeRow)) return true;\n\n  badgeRow.dataset.poweredByRelocated = \"true\";\n  socialsColumn.appendChild(badgeRow);\n  return true;\n}\n\n// Retry briefly in case the footer isn't in the DOM yet on first call.\nfunction tryReposition(retries = 10) {\n  if (repositionPoweredBy()) return;\n  if (retries \u003e 0) {\n    setTimeout(() =\u003e tryReposition(retries - 1), 100);\n  }\n}\n\nif (document.readyState === \"loading\") {\n  document.addEventListener(\"DOMContentLoaded\", () =\u003e tryReposition());\n} else {\n  tryReposition();\n}\n\n// Re-run on SPA navigation; Mintlify re-renders the footer between routes.\nif (typeof navigation !== \"undefined\") {\n  navigation.addEventListener(\"navigate\", async () =\u003e {\n    await new Promise((resolve) =\u003e requestAnimationFrame(resolve));\n    tryReposition();\n  });\n}\n"])</script><script>self.__next_f.push([1,"50:[\"$\",\"$L56\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"692e14204726034eb2448a82\",\"subdomain\":\"circle-167b8d39\",\"filePath\":\"content/gtm.js\",\"__v\":0,\"content\":\"$57\"},{\"_id\":\"6a04b8036b0075a7bda53702\",\"subdomain\":\"circle-167b8d39\",\"filePath\":\"content/footer-powered-by.js\",\"__v\":0,\"content\":\"$58\"