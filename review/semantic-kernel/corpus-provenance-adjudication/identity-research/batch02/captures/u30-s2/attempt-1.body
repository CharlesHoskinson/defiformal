Z","isStandalone":false,"isEntityRestricted":false,"isFeatureRestricted":false,"siteBlacklist":["OKX_TR","OKX_US","OKX_HK","OKX_EUR","OKX_AI","OKX_MONEY"],"isRichText":true,"richTextContent":[25]},"supportLocales":["en-US"]},"dsn":"https://0d62f08b9fa0de848bd7e9a79a861bd9@sentry.okg.com/134","templateConfig":null,"version":"0.0.568","project":"helpcenter","urlKey":"%2Fhelp%2F%5Bslug%5D","traceId":"3130888137049310002","enableRTL":true,"isAPMProxyOff":"0","isYandexOff":"0","isWebWorkerEnable":"0","polyfillLevel":"default"}}</script>
