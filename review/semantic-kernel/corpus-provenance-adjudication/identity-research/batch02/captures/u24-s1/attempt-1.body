 v1\n  30197, // loot mainnet v2\n  291, // xchain mainnet v1\n  30291, // xchain mainnet v2\n  234, // inEVM mainnet v1\n  30234, // inEVM mainnet v2\n  418, // adi mainnet v1 (hidden - metadata only)\n  30418, // adi mainnet v2 (hidden - metadata only)\n];\n\nexport const ALLOWED_TESTNET_EIDS = [\n  40106, 10106, 40161, 10161, 40217, 10217, 40231, 10231, 40232, 10232, 40245, 10245, 40267, 10267,\n  40102, 10102, 40305, 10248, 40168, 10168, 40108, 10108, 40326, 10326, 40343, 10343, 40420, 10420,\n  40371, 10371, 40362, 40351, 40294, 40333, 40285, 40378, 10439, 40439, 40500, 10449, 40449,\n  10451, 40451, // robinhood testnet\n];\n"])</script><script>self.__next_f.push([1,"5d:Tcba0,"])</script><script>self.__next_f.push([1,"import {\n  chainToChainType,\n  ChainType,\n  endpointIdToChain,\n  endpointIdToNetwork,\n  EndpointId,\n  isTronChain,\n} from '@layerzerolabs/lz-definitions';\nimport chalk from 'chalk';\nimport {execSync} from 'child_process';\nimport fs from 'fs';\nimport fetch from 'node-fetch';\nimport path from 'path';\nimport prompts from 'prompts';\nimport {Command} from 'commander';\n\nimport {\n  ALLOWED_TESTNET_EIDS,\n  BLACKLIST,\n  DEPRECATED_CHAINS,\n  DEPRECATED_DVNS,\n  DEPRECATED_ENDPOINTS,\n  DVN_NAME_OVERRIDES,\n  EID_NAME_OVERRIDES,\n  NOTES,\n  PRIVATE_ENDPOINTS,\n} from './constants.js';\n\nconst API_URL = 'https://metadata.layerzero-api.com/v1/metadata/deployments';\n\n// Convert to a Set once so repeated membership checks stay O(1)\nconst ALLOWED_TESTNET_EIDS_SET = new Set(ALLOWED_TESTNET_EIDS);\n\n// Classify a deployment as an EVM (non-Tron) chain. Mirrors the logic the OFT\n// chain reference generator used before this was baked into deploymentsV2.json,\n// so the rendered table is unchanged.\nfunction isEvmEndpoint(eid) {\n  try {\n    const chain = endpointIdToChain(eid);\n    if (chainToChainType(chain) !== ChainType.EVM) return false;\n    if (isTronChain(chain)) return false;\n    return true;\n  } catch {\n    return false;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// CLI Setup\n// ---------------------------------------------------------------------------\nconst program = new Command();\n\nprogram\n  .name('update-deployments')\n  .description('Fetch and update LayerZero deployment data')\n  .option('--chains \u003citems\u003e', 'Comma-separated EIDs or chainKeys to add')\n  .option('--dvns \u003citems\u003e', 'Comma-separated DVN@EID pairs (e.g., \"LayerZero Labs@30101\")')\n  .option('--update-rpcs', 'Run RPC updater (updates all chains, or use --rpc-filter to limit)')\n  .option('--rpc-filter \u003cchainIds\u003e', 'Optional: comma-separated chainIds to limit RPC updates')\n  .option('--dry-run', 'Preview changes without writing files')\n  .option('--verbose', 'Enable detailed logging')\n  .option('--list-deployments', 'List all new deployments available to add')\n  .option('--list-dvns', 'List all new DVNs available to add')\n  .parse(process.argv);\n\nconst opts = program.opts();\n\n// Determine if we're in non-interactive (flag) mode\nconst isNonInteractive = opts.chains || opts.dvns || opts.listDeployments || opts.listDvns || opts.updateRpcs;\n\n// ---------------------------------------------------------------------------\n// Utility Functions\n// ---------------------------------------------------------------------------\nfunction toDvnId(canonicalName) {\n  return canonicalName\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, '-')\n    .replace(/[^a-z0-9-]+/g, '')\n    .replace(/-{2,}/g, '-');\n}\n\nfunction capitalizeFirstLetter(str) {\n  return str.charAt(0).toUpperCase() + str.slice(1);\n}\n\nfunction getHumanReadableNameFromChainKey(chainKey) {\n  return chainKey\n    .split('-')\n    .map((i) =\u003e capitalizeFirstLetter(i))\n    .join(' ');\n}\n\nfunction readJsonFileSafe(filePath) {\n  try {\n    if (fs.existsSync(filePath)) {\n      const data = fs.readFileSync(filePath, 'utf8');\n      return JSON.parse(data);\n    }\n  } catch (err) {\n    console.error(`Error reading ${filePath}:`, err);\n  }\n  return null;\n}\n\nfunction saveDvnsIfChanged(dvns, dryRun = false) {\n  const baseDir = path.resolve('./public/data');\n  const dvnsPath = path.join(baseDir, 'dvnLzReadExclusion.json');\n  const tempPath = path.join(baseDir, 'dvnLzReadExclusion.temp.json');\n\n  const newDataString = JSON.stringify({dvns}, null, 2);\n\n  if (dryRun) {\n    console.log(chalk.yellow('[DRY RUN] Would update dvnLzReadExclusion.json'));\n    return false;\n  }\n\n  fs.writeFileSync(tempPath, newDataString, 'utf8');\n\n  try {\n    execSync(`npx prettier --write \"${tempPath}\"`, {\n      stdio: 'pipe',\n    });\n  } catch (err) {\n    console.error('Prettier formatting failed:', err);\n    if (fs.existsSync(tempPath)) {\n      try {\n        fs.unlinkSync(tempPath);\n      } catch (cleanupErr) {\n        console.error('Failed to clean up temp file:', cleanupErr);\n      }\n    }\n    throw err;\n  }\n\n  const lintedNewDataString = fs.readFileSync(tempPath, 'utf8');\n\n  let existingDataString = '';\n  if (fs.existsSync(dvnsPath)) {\n    existingDataString = fs.readFileSync(dvnsPath, 'utf8');\n  }\n\n  if (existingDataString === lintedNewDataString) {\n    console.log(chalk.cyanBright('dvnLzReadExclusion.json is up to date; skipping write.'));\n    fs.unlinkSync(tempPath);\n    return false;\n  }\n\n  fs.writeFileSync(dvnsPath, lintedNewDataString, 'utf8');\n  console.log('dvnLzReadExclusion.json updated.');\n  fs.unlinkSync(tempPath);\n  return true;\n}\n\nfunction loadExistingFiles() {\n  const baseDir = path.resolve('./public/data');\n  const v1Path = path.join(baseDir, 'deploymentsV1.json');\n  const v2Path = path.join(baseDir, 'deploymentsV2.json');\n  const existingDeploymentsV1 = readJsonFileSafe(v1Path) || [];\n  const existingDeploymentsV2 = readJsonFileSafe(v2Path) || [];\n\n  const dvnDeploymentsPath = path.join(baseDir, 'dvnDeployments.json');\n  const existingDvnDeployments = readJsonFileSafe(dvnDeploymentsPath) || [];\n\n  const blockExplorersPath = path.join(baseDir, 'blockExplorers.json');\n  const existingBlockExplorers = readJsonFileSafe(blockExplorersPath) || [];\n\n  return {\n    existingDeploymentsV1,\n    existingDeploymentsV2,\n    existingDvnDeployments,\n    existingBlockExplorers,\n  };\n}\n\nfunction loadExistingDVNs(existingDvnDeployments) {\n  const existingDVNSet = new Set();\n  for (const item of existingDvnDeployments) {\n    const {canonicalName, eid, stage, dvnAddress} = item;\n    if (canonicalName \u0026\u0026 eid != null \u0026\u0026 stage \u0026\u0026 dvnAddress) {\n      const signature = `${canonicalName.trim()}@@${dvnAddress.trim()}@@${eid}@@${stage.trim()}`;\n      existingDVNSet.add(signature);\n    }\n  }\n  return existingDVNSet;\n}\n\nfunction saveJSON(fileName, contents, dryRun = false) {\n  const dataStr = JSON.stringify(contents, null, 2);\n  const baseDir = path.resolve('./public/data');\n  const filePath = path.join(baseDir, fileName);\n  const tempPath = path.join(baseDir, `${fileName}.temp`);\n\n  if (dryRun) {\n    console.log(chalk.yellow(`[DRY RUN] Would update ${fileName}`));\n    return false;\n  }\n\n  fs.writeFileSync(tempPath, dataStr, 'utf8');\n  try {\n    execSync(`npx prettier --parser=json --write \"${tempPath}\"`, {\n      stdio: 'pipe',\n    });\n  } catch (err) {\n    console.error(`Prettier formatting failed for ${fileName}:`, err);\n    if (fs.existsSync(tempPath)) {\n      try {\n        fs.unlinkSync(tempPath);\n      } catch (cleanupErr) {\n        console.error('Failed to clean up temp file:', cleanupErr);\n      }\n    }\n    throw err;\n  }\n  const lintedDataStr = fs.readFileSync(tempPath, 'utf8');\n  let existingDataStr = '';\n  if (fs.existsSync(filePath)) {\n    existingDataStr = fs.readFileSync(filePath, 'utf8');\n  }\n  if (existingDataStr === lintedDataStr) {\n    console.log(chalk.cyanBright(`${fileName} is up to date; skipping write.`));\n    fs.unlinkSync(tempPath);\n    return false;\n  }\n  fs.writeFileSync(filePath, lintedDataStr, 'utf8');\n  console.log(chalk.greenBright(`${fileName} updated.`));\n  fs.unlinkSync(tempPath);\n  return true;\n}\n\nfunction syncNotesToComponent(dryRun = false) {\n  const componentPath = path.resolve('./snippets/ContractAddressesTable.jsx');\n  if (!fs.existsSync(componentPath)) {\n    console.log(chalk.yellow('ContractAddressesTable.jsx not found, skipping notes sync.'));\n    return false;\n  }\n\n  const content = fs.readFileSync(componentPath, 'utf8');\n  const startMarker = '// __CHAIN_NOTES_START__';\n  const endMarker = '// __CHAIN_NOTES_END__';\n  const startIdx = content.indexOf(startMarker);\n  const endIdx = content.indexOf(endMarker);\n\n  if (startIdx === -1 || endIdx === -1) {\n    console.log(chalk.yellow('Chain notes markers not found in component, skipping sync.'));\n    return false;\n  }\n\n  // Build the replacement block\n  const entries = Object.entries(NOTES)\n    .sort(([a], [b]) =\u003e parseInt(a, 10) - parseInt(b, 10))\n    .map(([eid, note]) =\u003e `    ${JSON.stringify(eid.toString())}: ${JSON.stringify(note)},`)\n    .join('\\n');\n\n  const newBlock = [\n    startMarker,\n    '  // Auto-generated from scripts/update-deployments/constants.js — do not edit manually.',\n    '  // To add or update a note, edit NOTES in constants.js then run the update-deployments script.',\n    '  var notesMap = {',\n    entries,\n    '  };',\n    '  ' + endMarker,\n  ].join('\\n');\n\n  const newContent = content.slice(0, startIdx) + newBlock + content.slice(endIdx + endMarker.length);\n\n  if (newContent === content) {\n    console.log(chalk.cyanBright('Chain notes in component already up to date.'));\n    return false;\n  }\n\n  if (dryRun) {\n    console.log(chalk.yellow('[DRY RUN] Would sync chain notes to ContractAddressesTable.jsx'));\n    return false;\n  }\n\n  fs.writeFileSync(componentPath, newContent, 'utf8');\n  console.log(chalk.greenBright('Synced chain notes to ContractAddressesTable.jsx.'));\n  return true;\n}\n\nfunction isBlacklisted(url) {\n  return BLACKLIST.some((sub) =\u003e url.includes(sub));\n}\n\nfunction getAllowedChainIds() {\n  const baseDir = path.resolve('./public/data');\n  const v2Path = path.join(baseDir, 'deploymentsV2.json');\n  const deploymentsV2 = readJsonFileSafe(v2Path) || [];\n  const chainIdSet = new Set();\n  for (const dep of deploymentsV2) {\n    if (typeof dep.nativeChainId === 'number') {\n      let chainType = ChainType.EVM;\n      if (dep.eid) {\n        try {\n          const chainObj = endpointIdToChain(dep.eid);\n          chainType = chainToChainType(chainObj);\n        } catch (error) {\n          // ignore\n        }\n      }\n      if (chainType !== ChainType.EVM) {\n        continue;\n      }\n      chainIdSet.add(dep.nativeChainId);\n    }\n  }\n  return chainIdSet;\n}\n\nfunction getAllowedChainEidMap() {\n  const baseDir = path.resolve('./public/data');\n  const v2Path = path.join(baseDir, 'deploymentsV2.json');\n  const deploymentsV2 = readJsonFileSafe(v2Path) || [];\n  const map = new Map();\n  for (const dep of deploymentsV2) {\n    if (typeof dep.nativeChainId === 'number' \u0026\u0026 dep.eid != null) {\n      map.set(dep.nativeChainId, dep.eid);\n    }\n  }\n  return map;\n}\n\nasync function testRpcEndpoint(rpcUrl, expectedDecimalChainId, timeoutMs = 5000) {\n  const expectedHexChainId = '0x' + expectedDecimalChainId.toString(16);\n  const controller = new AbortController();\n  const timeout = setTimeout(() =\u003e controller.abort(), timeoutMs);\n  const payload = {\n    jsonrpc: '2.0',\n    id: 1,\n    method: 'eth_chainId',\n    params: [],\n  };\n  try {\n    const response = await fetch(rpcUrl, {\n      method: 'POST',\n      body: JSON.stringify(payload),\n      headers: {'Content-Type': 'application/json'},\n      signal: controller.signal,\n    });\n    clearTimeout(timeout);\n    if (!response.ok) {\n      if (opts.verbose) {\n        console.warn(chalk.redBright(`RPC test failed at ${rpcUrl} with status ${response.status}`));\n      }\n      return false;\n    }\n    const data = await response.json();\n    if (data.result \u0026\u0026 data.result.toLowerCase() === expectedHexChainId.toLowerCase()) {\n      return true;\n    } else {\n      if (opts.verbose) {\n        console.warn(chalk.yellow(`RPC test for ${rpcUrl} returned ${data.result}, expected ${expectedHexChainId}`));\n      }\n      return false;\n    }\n  } catch (error) {\n    clearTimeout(timeout);\n    if (opts.verbose) {\n      if (error.name === 'AbortError') {\n        console.warn(chalk.redBright(`RPC test at ${rpcUrl} timed out after ${timeoutMs}ms.`));\n      } else {\n        console.warn(chalk.redBright(`RPC test failed at ${rpcUrl}: ${error.name} - ${error.message}`));\n      }\n    }\n    return false;\n  }\n}\n\nasync function findNewWorkingRpc(rpcList, chainId, networkName = `Chain ${chainId}`, failedRpcSet = new Set()) {\n  const filtered = rpcList.filter((url) =\u003e !isBlacklisted(url) \u0026\u0026 !failedRpcSet.has(url));\n  for (const url of filtered) {\n    if (opts.verbose) {\n      console.log(chalk.cyanBright(`Testing new RPC URL for network ${networkName}: ${url}`));\n    }\n    const valid = await testRpcEndpoint(url, chainId);\n    if (valid) {\n      return url;\n    } else {\n      failedRpcSet.add(url);\n    }\n  }\n  return null;\n}\n\nasync function getMetadataRpcForChain(allowedChainIds) {\n  const metadataUrl = 'https://metadata.layerzero-api.com/v1/metadata';\n  try {\n    console.log(`Fetching metadata from LayerZero: ${metadataUrl}`);\n    const response = await fetch(metadataUrl);\n    if (!response.ok) {\n      throw new Error(`Metadata fetch failed with status ${response.status}`);\n    }\n    const metadata = await response.json();\n    const rpcMap = new Map();\n    for (const key of Object.keys(metadata)) {\n      const entry = metadata[key];\n      if (!entry || !entry.chainDetails || typeof entry.chainDetails.nativeChainId !== 'number') {\n        continue;\n      }\n      const chainId = entry.chainDetails.nativeChainId;\n      if (!allowedChainIds.has(chainId)) continue;\n      if (entry.rpcs \u0026\u0026 Array.isArray(entry.rpcs)) {\n        const urls = entry.rpcs\n          .map((rpcObj) =\u003e (typeof rpcObj === 'string' ? rpcObj : rpcObj.url))\n          .filter((url) =\u003e typeof url === 'string' \u0026\u0026 url.length \u003e 0);\n        if (urls.length \u003e 0) {\n          if (rpcMap.has(chainId)) {\n            const existingUrls = rpcMap.get(chainId);\n            rpcMap.set(chainId, [...existingUrls, ...urls]);\n          } else {\n            rpcMap.set(chainId, urls);\n          }\n        }\n      }\n    }\n    return rpcMap;\n  } catch (error) {\n    console.warn(chalk.redBright('Error fetching metadata RPCs:'), error);\n    return new Map();\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Filter Parsing and Validation\n// ---------------------------------------------------------------------------\nfunction parseDeploymentFilter(filterStr, discoveredDeployments) {\n  if (!filterStr) return null;\n\n  const items = filterStr.split(',').map(s =\u003e s.trim());\n  const selectedSignatures = [];\n  const errors = [];\n\n  // Build lookup maps\n  // byEid: EID -\u003e signature (1:1 since EIDs are unique)\n  // byChainKey: chainKey -\u003e [signatures] (1:many since V1 and V2 share chainKey)\n  const byEid = new Map();\n  const byChainKey = new Map();\n\n  for (const [sig, item] of Object.entries(discoveredDeployments)) {\n    byEid.set(item.eid, sig);\n\n    const chainKey = (item.deployment?.chainKey || item.entry?.chainKey || '').toLowerCase();\n    if (chainKey) {\n      if (!byChainKey.has(chainKey)) {\n        byChainKey.set(chainKey, []);\n      }\n      byChainKey.get(chainKey).push(sig);\n    }\n  }\n\n  for (const item of items) {\n    const eidNum = parseInt(item, 10);\n    if (!isNaN(eidNum) \u0026\u0026 byEid.has(eidNum)) {\n      // EID filter: add single matching deployment\n      selectedSignatures.push(byEid.get(eidNum));\n    } else if (byChainKey.has(item.toLowerCase())) {\n      // ChainKey filter: add ALL matching deployments (V1 and V2)\n      selectedSignatures.push(...byChainKey.get(item.toLowerCase()));\n    } else {\n      // Check if it's a valid EID that just isn't in the new deployments\n      if (!isNaN(eidNum)) {\n        errors.push(`EID ${eidNum} not found in new deployments. Use --list-deployments to see available EIDs.`);\n      } else {\n        errors.push(`Chain \"${item}\" not found. Use --list-deployments to see available chains.`);\n      }\n    }\n  }\n\n  return { selectedSignatures, errors };\n}\n\nfunction parseDvnFilter(filterStr, discoveredDVNs) {\n  if (!filterStr) return null;\n\n  const items = filterStr.split(',').map(s =\u003e s.trim());\n  const selectedSignatures = [];\n  const errors = [];\n\n  // Build lookup: DVN name -\u003e list of (signature, eid)\n  const dvnByName = new Map();\n\n  for (const item of discoveredDVNs) {\n    const name = item.canonicalName.toLowerCase();\n    if (!dvnByName.has(name)) {\n      dvnByName.set(name, []);\n    }\n    dvnByName.get(name).push({ signature: item.dvnSignature, eid: item.eidAsInt, chainKey: item.chainKey });\n  }\n\n  for (const item of items) {\n    // Parse DVN@EID format\n    const parts = item.split('@');\n    if (parts.length !== 2) {\n      errors.push(`Invalid DVN filter format: \"${item}\". Use format: \"DVN Name@EID\" (e.g., \"LayerZero Labs@30101\")`);\n      continue;\n    }\n\n    const [dvnName, eidOrChain] = parts;\n    const dvnNameLower = dvnName.toLowerCase();\n\n    if (!dvnByName.has(dvnNameLower)) {\n      errors.push(`DVN \"${dvnName}\" not found in new DVNs. Use --list-dvns to see available DVNs.`);\n      continue;\n    }\n\n    const dvnEntries = dvnByName.get(dvnNameLower);\n    const eidNum = parseInt(eidOrChain, 10);\n\n    // Find matching DVN entry\n    let found = false;\n    for (const entry of dvnEntries) {\n      if (!isNaN(eidNum) \u0026\u0026 entry.eid === eidNum) {\n        selectedSignatures.push(entry.signature);\n        found = true;\n        break;\n      } else if (entry.chainKey?.toLowerCase() === eidOrChain.toLowerCase()) {\n        selectedSignatures.push(entry.signature);\n        found = true;\n        break;\n      }\n    }\n\n    if (!found) {\n      const availableEids = dvnEntries.map(e =\u003e e.eid).join(', ');\n      errors.push(`DVN \"${dvnName}\" is not available on ${eidOrChain}. Available on EIDs: ${availableEids}`);\n    }\n  }\n\n  return { selectedSignatures, errors };\n}\n\nfunction parseRpcFilter(filterStr) {\n  if (!filterStr) return null;\n  return filterStr.split(',').map(s =\u003e parseInt(s.trim(), 10)).filter(n =\u003e !isNaN(n));\n}\n\n// ---------------------------------------------------------------------------\n// RPC Updater\n// ---------------------------------------------------------------------------\nasync function updateChainlistRPCs(rpcFilterChainIds = null, dryRun = false) {\n  const chainlistUrl = 'https://chainlist.org/rpcs.json';\n  try {\n    console.log('Fetching chainlist RPC data from:', chainlistUrl);\n    const response = await fetch(chainlistUrl);\n    if (!response.ok) throw new Error(`Fetch failed with status ${response.status}`);\n    const chainlistData = await response.json();\n\n    const allowedChainIds = getAllowedChainIds();\n    const allowedChainEidMap = getAllowedChainEidMap();\n    const metadataRpcMap = await getMetadataRpcForChain(allowedChainIds);\n\n    const failedRpcCache = new Map();\n\n    const baseDir = path.resolve('./public/data');\n    const existingFilePath = path.join(baseDir, 'chainlistRPCs.json');\n    const existingChainlist = readJsonFileSafe(existingFilePath) || [];\n    const existingMap = new Map(existingChainlist.map((obj) =\u003e [obj.chainId, obj]));\n\n    const updatedChains = await Promise.all(\n      chainlistData.map(async (chain) =\u003e {\n        const {chainId, rpc} = chain;\n        if (!chainId || !rpc || rpc.length === 0) return null;\n        if (!allowedChainIds.has(chainId)) return null;\n\n        const rpcUrlsChainlist = rpc\n          .map((entry) =\u003e (typeof entry === 'string' ? entry : entry.url))\n          .filter((url) =\u003e typeof url === 'string' \u0026\u0026 url.length \u003e 0);\n        const eid = allowedChainEidMap.get(chainId);\n        const networkName = eid ? endpointIdToNetwork(eid) : `Chain ${chainId}`;\n\n        let chainType;\n        try {\n          const chainObj = endpointIdToChain(eid);\n          chainType = chainToChainType(chainObj);\n        } catch (error) {\n          return null;\n        }\n\n        if (chainType !== ChainType.EVM) {\n          console.log(chalk.cyanBright(`Chain ${networkName} is not EVM. Skipping RPC tests.`));\n          return { ...chain, rpc: null };\n        }\n\n        if (!failedRpcCache.has(chainId)) failedRpcCache.set(chainId, new Set());\n        const failedRpcSet = failedRpcCache.get(chainId);\n\n        const existingObj = existingMap.get(chainId);\n        if (existingObj \u0026\u0026 existingObj.rpc) {\n          const stillWorks = await testRpcEndpoint(existingObj.rpc, chainId);\n          if (stillWorks) {\n            console.log(chalk.greenBright(`Existing RPC is still valid for network ${networkName}`));\n            return existingObj;\n          } else {\n            console.log(chalk.yellow(`Existing RPC for network ${networkName} is invalid; searching for new endpoints...`));\n            failedRpcSet.add(existingObj.rpc);\n          }\n        }\n\n        let newRpc =\n          (await findNewWorkingRpc(metadataRpcMap.get(chainId) || [], chainId, networkName, failedRpcSet)) ||\n          (await findNewWorkingRpc(rpcUrlsChainlist, chainId, networkName, failedRpcSet));\n\n        if (!newRpc) {\n          console.warn(chalk.redBright(`No working RPC found for network ${networkName} =\u003e skipping`));\n          return null;\n        }\n\n        return { ...chain, rpc: newRpc };\n      }),\n    );\n\n    const finalData = updatedChains.filter(Boolean);\n\n    const changesToPropose = finalData.filter((chain) =\u003e {\n      const existing = existingMap.get(chain.chainId);\n      return !existing || existing.rpc !== chain.rpc;\n    });\n\n    if (changesToPropose.length === 0) {\n      console.log(chalk.cyanBright('No new RPC updates to propose, skipping write.'));\n      return;\n    }\n\n    let updatesToApply;\n\n    if (isNonInteractive) {\n      // Non-interactive mode: apply filter or all\n      if (rpcFilterChainIds \u0026\u0026 rpcFilterChainIds.length \u003e 0) {\n        const filterSet = new Set(rpcFilterChainIds);\n        updatesToApply = changesToPropose.filter(c =\u003e filterSet.has(c.chainId));\n\n        // Check for invalid chainIds\n        const foundIds = new Set(updatesToApply.map(c =\u003e c.chainId));\n        for (const id of rpcFilterChainIds) {\n          if (!foundIds.has(id) \u0026\u0026 !changesToPropose.find(c =\u003e c.chainId === id)) {\n            console.warn(chalk.yellow(`Warning: chainId ${id} not found in RPC updates`));\n          }\n        }\n      } else {\n        updatesToApply = changesToPropose;\n      }\n\n      console.log(chalk.greenBright(`Applying ${updatesToApply.length} RPC update(s)`));\n    } else {\n      // Interactive mode: prompt user\n      const choices = changesToPropose.map((chain) =\u003e {\n        const existing = existingMap.get(chain.chainId);\n        const existingRpc = existing ? existing.rpc : chalk.redBright('None');\n        const newRpc = chalk.greenBright(chain.rpc);\n        return {\n          title:\n            chalk.yellowBright(`${chain.name || `Chain ${chain.chainId}`} (chainId: ${chain.chainId}):\\n`) +\n            chalk.grey(`    Existing RPC: ${existingRpc}\\n`) +\n            chalk.grey(`    New RPC:      ${newRpc}`),\n          value: chain,\n        };\n      });\n\n      choices.unshift({\n        title: chalk.yellowBright('SELECT ALL Proposed Updates'),\n        value: '__ALL__',\n      });\n\n      const {selectedChains} = await prompts({\n        type: 'multiselect',\n        name: 'selectedChains',\n        message: 'Select which RPC updates to apply:',\n        choices,\n        instructions: false,\n        hint: '- Space to select, Enter to confirm',\n      });\n\n      updatesToApply = selectedChains.includes('__ALL__') ? changesToPropose : selectedChains;\n    }\n\n    if (dryRun) {\n      console.log(chalk.yellow(`[DRY RUN] Would apply ${updatesToApply.length} RPC update(s)`));\n      return;\n    }\n\n    updatesToApply.forEach((update) =\u003e {\n      existingMap.set(update.chainId, { ...existingMap.get(update.chainId), ...update });\n    });\n\n    const mergedData = Array.from(existingMap.values());\n    const isChanged = saveJSON('chainlistRPCs.json', mergedData, dryRun);\n    if (isChanged) {\n      console.log(chalk.greenBright('chainlistRPCs.json updated with selected RPC updates.'));\n    } else {\n      console.log(chalk.cyanBright('No changes were made; all data is up to date.'));\n    }\n  } catch (error) {\n    console.error('Error updating chainlist RPC data:', error);\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Main Updater Function\n// ---------------------------------------------------------------------------\nasync function updateDeployments() {\n  const dryRun = opts.dryRun || false;\n\n  try {\n    // (A) LOAD existing local data\n    const {\n      existingDeploymentsV1,\n      existingDeploymentsV2,\n      existingDvnDeployments,\n      existingBlockExplorers,\n    } = loadExistingFiles();\n\n    const existingDeploymentSignatures = loadExistingDeploymentSignatures([\n      ...existingDeploymentsV1,\n      ...existingDeploymentsV2,\n    ]);\n    const existingDVNSet = loadExistingDVNs(existingDvnDeployments);\n\n    const baseDir = path.resolve('./public/data');\n    const existingDvnsFile = readJsonFileSafe(path.join(baseDir, 'dvnLzReadExclusion.json')) || {};\n    const existingDvnsArray = existingDvnsFile.dvns || [];\n\n    const dvnsMap = new Map();\n    for (const dvnItem of existingDvnsArray) {\n      if (dvnItem.dvnId) {\n        dvnsMap.set(dvnItem.dvnId, {...dvnItem});\n      }\n    }\n\n    // (B) FETCH fresh data from the API\n    console.log('Fetching latest deployments...');\n    const response = await fetch(API_URL);\n    const json = await response.json();\n\n    const newlyDiscoveredDeployments = [];\n    const newlyDiscoveredDVNs = [];\n\n    const newBlockExplorers = [];\n    const newEntriesV1 = [];\n    const newEntriesV2 = [];\n    const newDVNDeployments = [];\n\n    // (D) DISCOVER new deployments \u0026 DVNs\n    for (const objectKey in json) {\n      const entry = json[objectKey];\n      if (!entry.deployments) continue;\n\n      for (const deployment of entry.deployments) {\n        if (deployment.deprecated) continue;\n\n        const eidAsInt = parseInt(deployment.eid, 10);\n        if (isNaN(eidAsInt)) continue;\n\n        const stage = deployment.stage;\n        const version = deployment.version || 1;\n        const firstDigit = eidAsInt.toString()[0];\n\n        if (stage === 'sandbox' || (stage === 'testnet' \u0026\u0026 !ALLOWED_TESTNET_EIDS_SET.has(eidAsInt)))\n          continue;\n\n        const contractName = deployment.contract?.name || '_CHAIN_';\n        const signature = `${eidAsInt}@@${stage}@@${contractName}`;\n\n        if (\n          !existingDeploymentSignatures.has(signature) \u0026\u0026\n          !PRIVATE_ENDPOINTS.includes(eidAsInt) \u0026\u0026\n          !DEPRECATED_ENDPOINTS.includes(eidAsInt) \u0026\u0026\n          !DEPRECATED_CHAINS.includes(entry.chainKey) \u0026\u0026\n          ['1', '2', '3', '4'].includes(firstDigit) \u0026\u0026\n          !(firstDigit === '2' \u0026\u0026 eidAsInt.toString().length === 5)\n        ) {\n          newlyDiscoveredDeployments.push({eid: eidAsInt, entry, deployment, version});\n        }\n      }\n\n      if (entry.dvns) {\n        if (DEPRECATED_CHAINS.includes(entry.chainKey)) continue;\n\n        const v2Deployment = entry.deployments.find((d) =\u003e d.version === 2 \u0026\u0026 !d.deprecated);\n        if (!v2Deployment) continue;\n\n        const eidAsInt = parseInt(v2Deployment.eid, 10);\n        if (\n          isNaN(eidAsInt) ||\n          PRIVATE_ENDPOINTS.includes(eidAsInt) ||\n          DEPRECATED_ENDPOINTS.includes(eidAsInt)\n        )\n          continue;\n\n        for (const dvnKey of Object.keys(entry.dvns)) {\n          const dvn = entry.dvns[dvnKey];\n          if (!dvn || dvn.deprecated) continue;\n\n          const isV2Dvn = dvn.lzReadCompatible === true || dvn.version === 2;\n          if (!isV2Dvn) continue;\n\n          const canonicalName = dvn.canonicalName;\n          if (DEPRECATED_DVNS.includes(canonicalName)) continue;\n\n          const dvnSignature = `${canonicalName.trim()}@@${dvnKey.trim()}@@${eidAsInt}@@${v2Deployment.stage.trim()}`;\n          const isAlreadyKnownDVN = existingDVNSet.has(dvnSignature);\n\n          if (!isAlreadyKnownDVN) {\n            newlyDiscoveredDVNs.push({\n              dvnKey,\n              dvn,\n              dvnSignature,\n              canonicalName,\n              eidAsInt,\n              chainKey: v2Deployment.chainKey,\n              stage: v2Deployment.stage,\n              version: v2Deployment.version,\n              entry,\n              deployment: v2Deployment,\n              deprecated: v2Deployment.deprecated,\n            });\n          }\n        }\n      }\n    }\n\n    // ---------------------------------------------------------------------------\n    // Handle --list-deployments and --list-dvns flags\n    // ---------------------------------------------------------------------------\n    if (opts.listDeployments) {\n      // Separate V1 and V2 deployments\n      const v1Deployments = newlyDiscoveredDeployments.filter((d) =\u003e d.version === 1);\n      const v2Deployments = newlyDiscoveredDeployments.filter((d) =\u003e d.version === 2);\n\n      console.log(chalk.cyanBright(`\\nAvailable new deployments (${newlyDiscoveredDeployments.length} total: ${v2Deployments.length} V2, ${v1Deployments.length} V1)\\n`));\n\n      // Helper to dedupe and display\n      const displayDeployments = (deployments, versionLabel) =\u003e {\n        const uniqueMap = {};\n        for (const item of deployments) {\n          const contractName = item.deployment.contract?.name || '_CHAIN_';\n          const signature = `${item.eid}@@${item.deployment.stage}@@${contractName}`;\n          if (!uniqueMap[signature]) {\n            uniqueMap[signature] = item;\n          }\n        }\n\n        for (const [signature, item] of Object.entries(uniqueMap)) {\n          const chainDisplayName =\n            EID_NAME_OVERRIDES[item.eid] ||\n            (item.entry.chainDetails \u0026\u0026 item.entry.chainDetails.name) ||\n            getHumanReadableNameFromChainKey(item.deployment.chainKey);\n\n          const isChainEndpoint = !item.deployment.contract?.name;\n          const contractName = item.deployment.contract?.name;\n\n          if (isChainEndpoint) {\n            console.log(`  - ${chainDisplayName} (EID=${item.eid}, chainKey=${item.deployment.chainKey}, stage=${item.deployment.stage})`);\n          } else {\n            console.log(`  - Contract \"${contractName}\" on ${chainDisplayName} (EID=${item.eid}, stage=${item.deployment.stage})`);\n          }\n        }\n      };\n\n      // Display V2 first (primary)\n      if (v2Deployments.length \u003e 0) {\n        console.log(chalk.green(`── V2 Deployments (${v2Deployments.length}) ──`));\n        displayDeployments(v2Deployments, 'V2');\n      }\n\n      // Display V1 (legacy)\n      if (v1Deployments.length \u003e 0) {\n        console.log(chalk.yellow(`\\n── V1 Deployments (${v1Deployments.length}) ──`));\n        displayDeployments(v1Deployments, 'V1');\n      }\n\n      return;\n    }\n\n    if (opts.listDvns) {\n      console.log(chalk.cyanBright(`\\nAvailable new DVNs (${newlyDiscoveredDVNs.length} found):\\n`));\n\n      for (const item of newlyDiscoveredDVNs) {\n        const chainDisplayName =\n          EID_NAME_OVERRIDES[item.eidAsInt] ||\n          (item.entry.chainDetails \u0026\u0026 item.entry.chainDetails.name) ||\n          getHumanReadableNameFromChainKey(item.chainKey);\n\n        const dvnDisplayName = item.dvn.lzReadCompatible\n          ? `${item.canonicalName} (lzRead)`\n          : item.canonicalName;\n\n        console.log(`  - \"${dvnDisplayName}\" on ${chainDisplayName} (EID=${item.eidAsInt}, stage=${item.stage})`);\n      }\n\n      return;\n    }\n\n    // ---------------------------------------------------------------------------\n    // (E) PROMPT or FILTER user for new DEPLOYMENTS\n    // ---------------------------------------------------------------------------\n    let userSelectedDeployments = [];\n    const uniqueDeploymentMap = {};\n\n    if (newlyDiscoveredDeployments.length \u003e 0) {\n      console.log(chalk.cyanBright(`Discovered ${newlyDiscoveredDeployments.length} new deployment(s).`));\n\n      for (const item of newlyDiscoveredDeployments) {\n        const contractName = item.deployment.contract?.name || '_CHAIN_';\n        const signature = `${item.eid}@@${item.deployment.stage}@@${contractName}`;\n        if (!uniqueDeploymentMap[signature]) {\n          uniqueDeploymentMap[signature] = item;\n        }\n      }\n\n      if (isNonInteractive \u0026\u0026 opts.chains) {\n        // Non-interactive: use filter\n        const result = parseDeploymentFilter(opts.chains, uniqueDeploymentMap);\n        if (result.errors.length \u003e 0) {\n          for (const err of result.errors) {\n            console.error(chalk.red(`Error: ${err}`));\n          }\n          process.exit(1);\n        }\n        userSelectedDeployments = result.selectedSignatures;\n        console.log(chalk.greenBright(`Selected ${userSelectedDeployments.length} deployment(s) via filter`));\n      } else if (!isNonInteractive) {\n        // Interactive: prompt user\n        const choices = [\n          {title: 'SELECT ALL newly discovered deployments', value: '__ALL_DEPLOYMENTS__'},\n          ...Object.entries(uniqueDeploymentMap).map(([signature, item]) =\u003e {\n            const chainDisplayName =\n              EID_NAME_OVERRIDES[item.eid] ||\n              (item.entry.chainDetails \u0026\u0026 item.entry.chainDetails.name) ||\n              getHumanReadableNameFromChainKey(item.deployment.chainKey);\n\n            const isChainEndpoint = !item.deployment.contract?.name;\n            const contractName = item.deployment.contract?.name;\n            const title = isChainEndpoint\n              ? `New Chain: ${chainDisplayName} (EID=${item.eid}, stage=${item.deployment.stage})`\n              : `New Contract \"${contractName}\" on ${chainDisplayName} (EID=${item.eid}, stage=${item.deployment.stage})`;\n\n            return { title, value: signature };\n          }),\n        ];\n\n        const promptResponse = await prompts({\n          type: 'multiselect',\n          name: 'selectedDeployments',\n          message: 'Select which new deployments to add:',\n          choices,\n          instructions: false,\n        });\n\n        const selectedSignatures = promptResponse.selectedDeployments || [];\n        if (selectedSignatures.includes('__ALL_DEPLOYMENTS__')) {\n          userSelectedDeployments = Object.keys(uniqueDeploymentMap);\n        } else {\n          userSelectedDeployments = selectedSignatures;\n        }\n      }\n\n      if (userSelectedDeployments.length === 0) {\n        console.log(chalk.cyanBright('No new deployments selected, skipping deployment additions...'));\n      } else {\n        console.log(chalk.greenBright('User selected deployments:', userSelectedDeployments));\n      }\n    } else {\n      console.log(chalk.cyanBright('No new deployments discovered.'));\n    }\n\n    // ---------------------------------------------------------------------------\n    // (F) PROMPT or FILTER user for new DVNs\n    // ---------------------------------------------------------------------------\n    const allAllowedEIDs = new Set(\n      [...existingDeploymentsV1, ...existingDeploymentsV2].map((d) =\u003e parseInt(d.eid, 10)),\n    );\n    for (const signature of userSelectedDeployments) {\n      const eid = parseInt(signature.split('@@')[0], 10);\n      allAllowedEIDs.add(eid);\n    }\n    const filteredNewDVNs = newlyDiscoveredDVNs.filter((item) =\u003e {\n      return allAllowedEIDs.has(item.eidAsInt);\n    });\n\n    let userSelectedDVNs = [];\n    if (filteredNewDVNs.length \u003e 0) {\n      console.log(chalk.cyanBright(`Discovered ${filteredNewDVNs.length} new DVN(s).`));\n\n      if (isNonInteractive \u0026\u0026 opts.dvns) {\n        // Non-interactive: use filter\n        const result = parseDvnFilter(opts.dvns, filteredNewDVNs);\n        if (result.errors.length \u003e 0) {\n          for (const err of result.errors) {\n            console.error(chalk.red(`Error: ${err}`));\n          }\n          process.exit(1);\n        }\n        userSelectedDVNs = result.selectedSignatures;\n        console.log(chalk.greenBright(`Selected ${userSelectedDVNs.length} DVN(s) via filter`));\n      } else if (!isNonInteractive) {\n        // Interactive: prompt user\n        const uniqueDVNMap = {};\n        for (const item of filteredNewDVNs) {\n          uniqueDVNMap[item.dvnSignature] = item;\n        }\n        const choices = [\n          {title: 'SELECT ALL newly discovered DVNs', value: '__ALL_DVNS__'},\n          ...Object.values(uniqueDVNMap).map((item) =\u003e {\n            const chainDisplayName =\n              EID_NAME_OVERRIDES[item.eidAsInt] ||\n              (item.entry.chainDetails \u0026\u0026 item.entry.chainDetails.name) ||\n              getHumanReadableNameFromChainKey(item.chainKey);\n            const dvnDisplayName = item.dvn.lzReadCompatible\n              ? `${item.canonicalName} (lzRead)`\n              : item.canonicalName;\n            return {\n              title: `DVN \"${dvnDisplayName}\" on ${chainDisplayName} (EID=${item.eidAsInt}, stage=${item.stage})`,\n              value: item.dvnSignature,\n            };\n          }),\n        ];\n        const promptResponse = await prompts({\n          type: 'multiselect',\n          name: 'selectedDVNs',\n          message: 'Select which new DVNs to add:',\n          choices,\n          instructions: false,\n        });\n        const selectedDVNs = promptResponse.selectedDVNs || [];\n        if (selectedDVNs.includes('__ALL_DVNS__')) {\n          userSelectedDVNs = filteredNewDVNs.map((item) =\u003e item.dvnSignature);\n        } else {\n          userSelectedDVNs = selectedDVNs;\n        }\n      }\n\n      if (userSelectedDVNs.length === 0) {\n        console.log(chalk.cyanBright('No new DVNs selected, skipping DVN additions...'));\n      } else {\n        console.log(chalk.greenBright('User selected DVNs:', userSelectedDVNs));\n      }\n    } else {\n      console.log(chalk.cyanBright('No new DVNs discovered.'));\n    }\n\n    // ---------------------------------------------------------------------------\n    // (G) Build final new DEPLOYMENT entries\n    // ---------------------------------------------------------------------------\n    const newEntriesV1Temp = [];\n    const newEntriesV2Temp = [];\n    for (const signature of userSelectedDeployments) {\n      const item = uniqueDeploymentMap[signature];\n      if (!item) continue;\n\n      const {eid, entry, deployment} = item;\n      const chainDisplayName =\n        EID_NAME_OVERRIDES[eid] ||\n        (entry.chainDetails \u0026\u0026 entry.chainDetails.name) ||\n        getHumanReadableNameFromChainKey(deployment.chainKey);\n      const nativeChainId = entry.chainDetails \u0026\u0026 entry.chainDetails.nativeChainId;\n      const note = NOTES[eid];\n\n      const deploymentEntry = {\n        ...deployment,\n        nativeChainId,\n        chainDisplayName,\n        note,\n      };\n\n      if (!deployment.contract?.name) {\n        delete deploymentEntry.contract;\n      }\n\n      if (deployment.version === 1) {\n        newEntriesV1Temp.push(deploymentEntry);\n      } else if (deployment.version === 2) {\n        newEntriesV2Temp.push(deploymentEntry);\n      }\n    }\n\n    // ---------------------------------------------------------------------------\n    // (H) Build final new DVN entries\n    // ---------------------------------------------------------------------------\n    const newDVNDeploymentsTemp = [];\n    for (const item of filteredNewDVNs) {\n      if (!userSelectedDVNs.includes(item.dvnSignature)) continue;\n      existingDVNSet.add(item.dvnSignature);\n      const {dvnKey, dvn, chainKey, stage, version, canonicalName, entry, eidAsInt} = item;\n      const nativeChainId = entry.chainDetails \u0026\u0026 entry.chainDetails.nativeChainId;\n      let dvnDisplayName = DVN_NAME_OVERRIDES[canonicalName] || canonicalName;\n      if (dvn.lzReadCompatible) {\n        dvnDisplayName += ' (lzRead)';\n      }\n      const chainDisplayName =\n        EID_NAME_OVERRIDES[eidAsInt] ||\n        (entry.chainDetails \u0026\u0026 entry.chainDetails.name) ||\n        getHumanReadableNameFromChainKey(chainKey);\n      const dvnEntry = {\n        eid: eidAsInt,\n        chainKey,\n        nativeChainId,\n        stage,\n        version,\n        ...dvn,\n        canonicalName,\n        dvnDisplayName,\n        dvnAddress: dvnKey,\n        chainDisplayName,\n      };\n      newDVNDeploymentsTemp.push(dvnEntry);\n      if (dvn.lzReadCompatible) {\n        const isExcludedInMetadata =\n          entry.lzReadConfig?.dvnsExcludedRemoteChain?.includes(canonicalName);\n        if (isExcludedInMetadata) {\n          const dvnId = toDvnId(canonicalName);\n          if (!dvnsMap.has(dvnId)) {\n            dvnsMap.set(dvnId, {\n              dvnName: DVN_NAME_OVERRIDES[canonicalName] || dvn.canonicalName,\n              dvnId,\n              dvnAddress: dvn.dvnAddress,\n              excludedChains: [],\n            });\n          }\n          const currentDvn = dvnsMap.get(dvnId);\n          if (!currentDvn.excludedChains) {\n            currentDvn.excludedChains = [];\n          }\n          currentDvn.excludedChains.push({\n            chainKey,\n            environment: stage,\n            chainDisplayName: entry.chainDisplayName || getHumanReadableNameFromChainKey(chainKey),\n            reason: dvn.exclusionReason || 'Excluded by lzReadConfig',\n          });\n        }\n      }\n    }\n\n    // (I) Merge existing + new entries\n    const finalDeploymentsV1 = [...existingDeploymentsV1, ...newEntriesV1Temp];\n    const finalDeploymentsV2 = [...existingDeploymentsV2, ...newEntriesV2Temp];\n    const finalDvnDeployments = [...existingDvnDeployments, ...newDVNDeploymentsTemp];\n\n    // ---------------------------------------------------------------------------\n    // (I1) AUTO-DETECT AND ADD readLib1002 for V2 deployments\n    // ---------------------------------------------------------------------------\n    console.log(chalk.cyanBright('Auto-detecting readLib1002 contracts for V2 deployments...'));\n\n    const apiV2Map = new Map();\n    for (const objectKey in json) {\n      const entry = json[objectKey];\n      if (!entry.deployments) continue;\n\n      for (const deployment of entry.deployments) {\n        if (deployment.deprecated || deployment.version !== 2) continue;\n\n        const eidAsInt = parseInt(deployment.eid, 10);\n        if (isNaN(eidAsInt)) continue;\n\n        apiV2Map.set(deployment.eid, {deployment, entry});\n      }\n    }\n\n    const readLibUpdates = [];\n\n    for (const existingDeployment of finalDeploymentsV2) {\n      const apiData = apiV2Map.get(existingDeployment.eid);\n      if (!apiData) continue;\n\n      const {deployment: apiDeployment, entry} = apiData;\n      const apiReadLib = apiDeployment.readLib1002?.address;\n      const localReadLib = existingDeployment.readLib1002?.address;\n\n      if (apiReadLib \u0026\u0026 (!localReadLib || localReadLib !== apiReadLib)) {\n        const eidAsInt = parseInt(existingDeployment.eid, 10);\n        const chainDisplayName =\n          EID_NAME_OVERRIDES[eidAsInt] ||\n          (entry.chainDetails \u0026\u0026 entry.chainDetails.name) ||\n          getHumanReadableNameFromChainKey(existingDeployment.chainKey);\n\n        readLibUpdates.push({\n          eid: existingDeployment.eid,\n          chainKey: existingDeployment.chainKey,\n          chainDisplayName,\n          oldAddress: localReadLib || 'None',\n          newAddress: apiReadLib,\n          stage: existingDeployment.stage,\n        });\n\n        existingDeployment.readLib1002 = {address: apiReadLib};\n      }\n    }\n\n    if (readLibUpdates.length \u003e 0) {\n      console.log(chalk.greenBright(`Auto-detected ${readLibUpdates.length} readLib1002 contract(s) to update:`));\n      for (const update of readLibUpdates) {\n        console.log(chalk.yellowBright(`   ${update.chainDisplayName} (${update.eid}): ${update.oldAddress} -\u003e ${update.newAddress}`));\n      }\n    } else {\n      console.log(chalk.cyanBright('All existing V2 deployments already have up-to-date readLib1002 contracts.'));\n    }\n\n    // Filter out private endpoints\n    const countBeforePrivateFilterV1 = finalDeploymentsV1.length;\n    const countBeforePrivateFilterV2 = finalDeploymentsV2.length;\n    const countBeforePrivateFilterDVN = finalDvnDeployments.length;\n\n    let filteredDeploymentsV1 = finalDeploymentsV1.filter((item) =\u003e {\n      const eidNum = parseInt(item.eid, 10);\n      return !PRIVATE_ENDPOINTS.includes(eidNum);\n    });\n    let filteredDeploymentsV2 = finalDeploymentsV2.filter((item) =\u003e {\n      const eidNum = parseInt(item.eid, 10);\n      return !PRIVATE_ENDPOINTS.includes(eidNum);\n    });\n    let filteredDvnDeployments = finalDvnDeployments.filter((dvn) =\u003e {\n      const eidNum = parseInt(dvn.eid, 10);\n      return !PRIVATE_ENDPOINTS.includes(eidNum);\n    });\n\n    if (\n      countBeforePrivateFilterV1 \u003e filteredDeploymentsV1.length ||\n      countBeforePrivateFilterV2 \u003e filteredDeploymentsV2.length ||\n      countBeforePrivateFilterDVN \u003e filteredDvnDeployments.length\n    ) {\n      console.log(chalk.cyanBright('Detected endpoints that are now marked as PRIVATE. Removed endpoints from local files.'));\n    }\n\n    // Update chainDisplayName\n    let updateCount = 0;\n    filteredDeploymentsV1 = filteredDeploymentsV1.map((item) =\u003e {\n      const eidNum = parseInt(item.eid, 10);\n      const newName =\n        EID_NAME_OVERRIDES[eidNum] ||\n        (item.chainDetails \u0026\u0026 item.chainDetails.name) ||\n        item.chainDisplayName ||\n        getHumanReadableNameFromChainKey(item.chainKey || '');\n      if (item.chainDisplayName !== newName) {\n        updateCount++;\n      }\n      return {...item, chainDisplayName: newName};\n    });\n    filteredDeploymentsV2 = filteredDeploymentsV2.map((item) =\u003e {\n      const eidNum = parseInt(item.eid, 10);\n      const newName =\n        EID_NAME_OVERRIDES[eidNum] ||\n        (item.chainDetails \u0026\u0026 item.chainDetails.name) ||\n        item.chainDisplayName ||\n        getHumanReadableNameFromChainKey(item.chainKey || '');\n      if (item.chainDisplayName !== newName) {\n        updateCount++;\n      }\n      return {...item, chainDisplayName: newName};\n    });\n    filteredDvnDeployments = filteredDvnDeployments.map((dvn) =\u003e {\n      const eidNum = parseInt(dvn.eid, 10);\n      const newName =\n        EID_NAME_OVERRIDES[eidNum] ||\n        (dvn.chainDetails \u0026\u0026 dvn.chainDetails.name) ||\n        dvn.chainDisplayName ||\n        getHumanReadableNameFromChainKey(dvn.chainKey || '');\n      if (dvn.chainDisplayName !== newName) {\n        updateCount++;\n      }\n      return {...dvn, chainDisplayName: newName};\n    });\n    if (updateCount \u003e 0) {\n      console.log(chalk.cyanBright(`Detected changes in name overrides. Updated chainDisplayName in ${updateCount} location(s).`));\n    }\n\n    // Remove deprecated DVNs\n    const countBeforeDeprecatedDVN = filteredDvnDeployments.length;\n    filteredDvnDeployments = filteredDvnDeployments.filter(\n      (dvn) =\u003e !DEPRECATED_DVNS.includes(dvn.canonicalName),\n    );\n    if (filteredDvnDeployments.length \u003c countBeforeDeprecatedDVN) {\n      console.log(chalk.cyanBright('Detected deprecated DVNs based on updated DEPRECATED_DVNS list. Removed affected DVN entries.'));\n    }\n\n    // Sort\n    filteredDeploymentsV1.sort((a, b) =\u003e parseInt(a.eid, 10) - parseInt(b.eid, 10));\n    filteredDeploymentsV2.sort((a, b) =\u003e parseInt(a.eid, 10) - parseInt(b.eid, 10));\n    filteredDvnDeployments.sort((a, b) =\u003e {\n      const eidDiff = parseInt(a.eid, 10) - parseInt(b.eid, 10);\n      if (eidDiff !== 0) return eidDiff;\n      return (a.canonicalName || '').localeCompare(b.canonicalName || '');\n    });\n\n    // Normalize lzReadConfig without overwriting existing values\n    for (const deployment of filteredDeploymentsV2) {\n      const existingConfig =\n        deployment.lzReadConfig \u0026\u0026 typeof deployment.lzReadConfig === 'object'\n          ? { ...deployment.lzReadConfig }\n          : {};\n      const excludedChains = Array.isArray(existingConfig.dvnsExcludedRemoteChain)\n        ? existingConfig.dvnsExcludedRemoteChain\n        : [];\n      existingConfig.dvnsExcludedRemoteChain = [...new Set(excludedChains)];\n      deployment.lzReadConfig = existingConfig;\n    }\n\n    // Build final dvns array\n    const dvns = Array.from(dvnsMap.values()).map((dvn) =\u003e {\n      const uniqueExcludedChains = [];\n      const seen = new Set();\n      dvn.excludedChains = dvn.excludedChains || [];\n      dvn.excludedChains.forEach((chain) =\u003e {\n        const chainEnv = `${chain.chainKey}-${chain.environment}`;\n        if (!seen.has(chainEnv)) {\n          seen.add(chainEnv);\n          uniqueExcludedChains.push(chain);\n        }\n      });\n      const dvnId = toDvnId(dvn.dvnId || dvn.dvnName || '');\n      return {\n        dvnId,\n        dvnName: dvn.dvnName,\n        excludedChains: uniqueExcludedChains,\n      };\n    });\n\n    // Handle RPC updater\n    if (isNonInteractive) {\n      // In non-interactive mode, only run if --update-rpcs flag is set\n      if (opts.updateRpcs) {\n        console.log(chalk.cyanBright('Running RPC updater...'));\n        const rpcFilterChainIds = parseRpcFilter(opts.rpcFilter);\n        await updateChainlistRPCs(rpcFilterChainIds, dryRun);\n      }\n    } else {\n      // Interactive mode: prompt user\n      const runRpcPrompt = await prompts({\n        type: 'confirm',\n        name: 'runRpcUpdater',\n        message: 'Would you like to run the RPC updater (pull from LZ Metadata + Chainlist)?',\n        initial: true,\n      });\n\n      if (runRpcPrompt.runRpcUpdater) {\n        console.log(chalk.cyanBright('Running RPC updater...'));\n        await updateChainlistRPCs(null, dryRun);\n      } else {\n        console.log(chalk.cyanBright('Skipping RPC updater.'));\n      }\n    }\n\n    // Filter out deprecated\n    const cleanedDeploymentsV1 = filteredDeploymentsV1.filter((item) =\u003e !item.deprecated);\n    const cleanedDeploymentsV2 = filteredDeploymentsV2.filter((item) =\u003e !item.deprecated);\n    const cleanedDvnDeployments = filteredDvnDeployments.filter((dvn) =\u003e !dvn.deprecated);\n\n    if (\n      cleanedDeploymentsV1.length !== finalDeploymentsV1.length ||\n      cleanedDeploymentsV2.length !== finalDeploymentsV2.length ||\n      cleanedDvnDeployments.length !== finalDvnDeployments.length\n    ) {\n      console.log(chalk.cyanBright('Removed deprecated endpoints from existing data.'));\n    }\n\n    // Final sort\n    cleanedDeploymentsV1.sort((a, b) =\u003e parseInt(a.eid, 10) - parseInt(b.eid, 10));\n    cleanedDeploymentsV2.sort((a, b) =\u003e parseInt(a.eid, 10) - parseInt(b.eid, 10));\n    cleanedDvnDeployments.sort((a, b) =\u003e {\n      const eidDiff = parseInt(a.eid, 10) - parseInt(b.eid, 10);\n      if (eidDiff !== 0) return eidDiff;\n      return (a.canonicalName || '').localeCompare(b.canonicalName || '');\n    });\n\n    // Bake the EndpointId enum token and EVM (non-Tron) classification onto each\n    // V2 record so downstream consumers (the OFT chain reference generator and\n    // the docs guard) can read them without importing lz-definitions. Appended\n    // after lzReadConfig so they are the last keys in each record.\n    for (const deployment of cleanedDeploymentsV2) {\n      deployment.endpointIdName = EndpointId[parseInt(deployment.eid, 10)] || null;\n      deployment.isEvm = isEvmEndpoint(deployment.eid);\n    }\n\n    // Write files\n    let fileChanged = false;\n    fileChanged = saveJSON('deploymentsV1.json', cleanedDeploymentsV1, dryRun) || fileChanged;\n    fileChanged = saveJSON('deploymentsV2.json', cleanedDeploymentsV2, dryRun) || fileChanged;\n    fileChanged = saveJSON('dvnDeployments.json', cleanedDvnDeployments, dryRun) || fileChanged;\n    const dvnsFileChanged = saveDvnsIfChanged(dvns, dryRun);\n    if (dvnsFileChanged) fileChanged = true;\n\n    // Sync chain notes from constants.js into the React component\n    const notesChanged = syncNotesToComponent(dryRun);\n    if (notesChanged) fileChanged = true;\n\n    if (dryRun) {\n      // In dry-run mode, the \"[DRY RUN] Would update...\" messages are already logged\n    } else if (!fileChanged) {\n      console.log(chalk.cyanBright('Already up to date. No files changed.'));\n    } else {\n      console.log(chalk.greenBright('Done writing new data.'));\n    }\n\n  } catch (error) {\n    console.error('Error updating deployments:', error);\n    process.exit(2);\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Entry point\n// ---------------------------------------------------------------------------\nfunction loadExistingDeploymentSignatures(deployments) {\n  const signatures = new Set();\n  for (const deployment of deployments) {\n    if (deployment.eid \u0026\u0026 deployment.stage) {\n      const contractName = deployment.contract?.name || '_CHAIN_';\n      const signature = `${deployment.eid}@@${deployment.stage}@@${contractName}`;\n      signatures.add(signature);\n    }\n  }\n  return signatures;\n}\n\n(async () =\u003e {\n  await updateDeployments();\n  console.log(chalk.greenBright('Done.'));\n})();\n\nexport const __TEST_ONLY__ = {\n  toDvnId,\n  readJsonFileSafe,\n  saveDvnsIfChanged,\n  loadExistingFiles,\n  loadExistingDVNs,\n  saveJSON,\n  isBlacklisted,\n  getAllowedChainIds,\n  getAllowedChainEidMap,\n  testRpcEndpoint,\n  findNewWorkingRpc,\n  getMetadataRpcForChain,\n  updateChainlistRPCs,\n  updateDeployments,\n  loadExistingDeploymentSignatures,\n  parseDeploymentFilter,\n  parseDvnFilter,\n};\n"])</script><script>self.__next_f.push([1,"52:[\"$\",\"$L57\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"696af37df45ad9b0711ee9bf\",\"filePath\":\"accessibility.js\",\"subdomain\":\"layerzero\",\"__v\":0,\"content\":\"$58\"},{\"_id\":\"696af381f45ad9b0711f6a8b\",\"filePath\":\"posthog.js\",\"subdomain\":\"layerzero\",\"__v\":0,\"content\":\"$59\"},{\"_id\":\"696af381f45ad9b0711f6ae5\",\"subdomain\":\"layerzero\",\"filePath\":\"snippets/contractAbis.js\",\"__v\":0,\"content\":\"$5a\"},{\"_id\":\"6997a3893a1020f95b4e4873\",\"filePath\":\"scripts/generate-chain-pages.js\",\"subdomain\":\"layerzero\",\"__v\":0,\"content\":\"$5b\"},{\"_id\":\"6997a3893a1020f95b4e4928\",\"filePath\":\"scripts/update-deployments/constants.js\",\"subdomain\":\"layerzero\",\"__v\":0,\"content\":\"$5c\"},{\"_id\":\"6997a3893a1020f95b4e49d2\",\"filePath\":\"scripts/update-deployments/index.js\",\"subdomain\":\"layerzero\",\"__v\":0,\"content\":\"$5d\"}]}]\n"])</script><script>self.__next_f.push([1,"60:T303d,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,br:`br`,code:`code`,li:`li`,ol:`ol`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Heading,OptimizedImage}=_components;if(!Heading)_missingMdxReference(`Heading`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`To send a crosschain message, a user must write a transaction on both the source and destination blockchains.`}),`\n`,_jsxs(_components.p,{children:[`At its core, the LayerZero protocol defines a `,_jsx(_components.strong,{children:`channel`}),` between a `,_jsx(_components.code,{children:`sender`}),` and a `,_jsx(_components.code,{children:`receiver`}),` smart contract by leveraging two key components:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Source and Destination Endpoints:`}),_jsx(_components.br,{}),`\n`,`Each supported blockchain deploys an immutable, permissionless Endpoint contract. On the source chain, a smart contract calls the Endpoint’s entry function (`,_jsx(_components.code,{children:`endpoint.send()`}),`) to send a message. On the destination chain, a smart contract authorizes the Endpoint to act as an exit point to receive and process that same message (`,_jsx(_components.code,{children:`endpoint.lzReceive()`}),`).`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Channel Definition:`}),_jsx(_components.br,{}),`\n`,`A unique messaging channel in LayerZero is defined by four specific components:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Sender Contract (Source OApp):`}),` The contract initiating the crosschain communication.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Source Endpoint ID:`}),` The identifier for the Endpoint on the source chain.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Destination Endpoint ID:`}),` The identifier for the Endpoint on the destination chain.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Receiver Contract (Destination OApp):`}),` The contract designated to receive and process the message on the destination chain.`]}),`\n`]}),`\n`]}),`\n`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`Within each channel, message ordering is maintained through nonce tracking. This ensures that messages are delivered exactly once.`}),`\n`,_jsx(_components.p,{children:`For example, if a token bridge on one chain sends a message to its counterpart on another chain, the messages flow through a dedicated channel — distinct from all other application pathways between those chains — preserving the integrity and sequence of communication.`}),`\n`,_jsx(Heading,{level:`2`,id:`how-the-protocol-works`,children:`How the Protocol Works`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=1e6425cec656ea5235837f655e5dcd9d`,alt:`Diagram showing LayerZero V2 protocol flow: message dispatch through source Endpoint, Message Library generating standardized packets, DVN verification, and execution via lzReceive on the destination chain`,className:`block dark:hidden`,\"data-og-width\":`1920`,width:`1920`,\"data-og-height\":`1044`,height:`1044`,\"data-path\":`images/learn/protocolv2light.svg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?w=280\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=0ea30c9dcac7b1efe07f98005a64ec80 280w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?w=560\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=d53ab0a7559b0319cbad2da676b35c96 560w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?w=840\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=16b5e6c6cd7171d61ff654e1f34d7aed 840w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?w=1100\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=f9d6d800fe7157cff947d1b4c29aaa77 1100w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?w=1650\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=03224e129dc40196645eeb940d7094e7 1650w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2light.svg?w=2500\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=1c9fef36cb0d8bda36da0a9045cce9fd 2500w`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=8c36228d3acfb4f4357a762788853258`,alt:`Diagram showing LayerZero V2 protocol flow: message dispatch through source Endpoint, Message Library generating standardized packets, DVN verification, and execution via lzReceive on the destination chain`,className:`hidden dark:block`,\"data-og-width\":`1920`,width:`1920`,\"data-og-height\":`1044`,height:`1044`,\"data-path\":`images/learn/protocolv2dark.svg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?w=280\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=a216beae3dcd443005c9e6132546a6e8 280w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?w=560\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=d76b54ffc44bd7a5db9293d42c658f0a 560w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?w=840\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=4b28cda15ba6bd45bb2151272420e469 840w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?w=1100\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=f06e6f27459e0a9c4e8dc780ee2996e4 1100w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?w=1650\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=323950a848978ecb60926d350a36dd9e 1650w, https://mintcdn.com/layerzero/VohHXGobQ14zkw24/images/learn/protocolv2dark.svg?w=2500\u0026fit=max\u0026auto=format\u0026n=VohHXGobQ14zkw24\u0026q=85\u0026s=dad501ee20172ef1dccced419bcfdd38 2500w`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Message Dispatch on the Source Chain:`}),_jsx(_components.br,{}),`\n`,`A smart contract on the source blockchain initiates the process by calling the Endpoint’s entry function. This call includes an arbitrary message payload, details of the destination Endpoint, and the receiver’s contract address. The Endpoint then uses a configurable Message Library to generate a standardized Message Packet based on the sender contract’s configuration.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Establishing a Secure Channel:`}),_jsx(_components.br,{}),`\n`,`The generated Message Packet is emitted as an event by the source Endpoint. This packet contains critical information—including source and destination Endpoint IDs, the sender’s and receiver’s addresses, and the message payload—which collectively define a unique messaging channel.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Verification and Nonce Management:`}),_jsx(_components.br,{}),`\n`,`On the destination chain, the configured Security Stack (Decentralized Verifier Networks) deliver the corresponding payload hash to the receiver contract’s configured Message Library. Once the threshold of DVN verifications satisfies the `,_jsx(_components.a,{href:`../glossary#x-of-y-of-n`,children:`X of Y of N`}),` configuration, the Message Packet can be marked as verified and committed to the destination channel, ensuring exactly-once delivery.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Message Execution on the Destination Chain:`}),_jsx(_components.br,{}),`\n`,`Finally, a caller (typically an authorized smart contract like the Executor) calls the Endpoint’s exit function `,_jsx(_components.code,{children:`lzReceive`}),` to trigger the execution of the verified message. This call delivers the message payload to the receiver contract, which can then execute its defined logic based on the incoming data.`]}),`\n`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`security-and-flexibility`,children:`Security and Flexibility`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Immutable and Permissionless Design:`}),_jsx(_components.br,{}),`\n`,`The core Endpoint contracts are immutable and permissionless. This ensures that the protocol remains secure and resistant to unauthorized changes, regardless of which virtual machine (VM) or blockchain environment is used.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`VM-Agnostic Integration:`}),_jsx(_components.br,{}),`\n`,`The LayerZero protocol itself is designed to be VM agnostic. The same fundamental principles apply whether you’re working with Solidity on Ethereum, Rust on Solana, Move on Aptos, or any other supported environment.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Independent Channel Management:`}),_jsx(_components.br,{}),`\n`,`Each channel between a given pair of endpoints maintains its own independent message sequence. This means that multiple applications can communicate across the same chain pairs without interference, providing scalability and flexibility in designing crosschain solutions.`]}),`\n`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`further-reading`,children:`Further Reading`}),`\n`,_jsx(_components.p,{children:`For more detailed technical insights into the protocol contracts for each specific virtual machine, please refer to the following overviews:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`EVM Technical Overview:`}),_jsx(_components.br,{}),`\n`,`Learn how LayerZero’s protocol contracts are implemented for EVM-based chains, covering the Endpoint architecture, Message Libraries, and Workers.`,_jsx(_components.br,{}),`\n`,_jsx(_components.a,{href:`../../developers/evm/protocol-contracts-overview`,children:`Read the EVM Protocol Overview`})]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Solana Technical Overview:`}),_jsx(_components.br,{}),`\n`,`Discover the adaptations made for Solana’s runtime, including crosschain messaging through the LayerZero Endpoint and integrations with Solana’s unique architecture.`,_jsx(_components.br,{}),`\n`,_jsx(_components.a,{href:`../../developers/solana/technical-overview`,children:`Read the Solana Protocol Overview`})]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Aptos Technical Overview:`}),_jsx(_components.br,{}),`\n`,`Explore how LayerZero leverages the Aptos Move language and framework to implement secure and efficient crosschain messaging on Aptos-based networks.`,_jsx(_components.br,{}),`\n`,_jsx(_components.a,{href:`../../developers/aptos-move/overview`,children:`Read the Aptos Protocol Overview`})]}),`\n`]}),`\n`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"53:[\"$\",\"$L5e\",null,{\"slug\":\"v2/concepts/protocol/protocol-overview\",\"pageMetadata\":\"$48:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5f\",null,{\"mdxSource\":{\"compiledSource\":\"$60\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"Protocol Overview\",\"sidebarTitle\":\"Protocol Overview\",\"description\":\"Learn about Protocol Overview in LayerZero V2. Understand the architecture, core concepts, and how it enables omnichain interoperability. Architecture and im...\",\"keywords\":[\"LayerZero\",\"concepts\",\"overview\"],\"lastUpdated\":\"2025-01-13\",\"author\":\"LayerZero\",\"schema\":\"Article\",\"related\":[\"/v2/concepts/v2-overview\",\"/v2/concepts/application-design-patterns\",\"/v2/concepts/applications/asset0\"],\"href\":\"/v2/concepts/protocol/protocol-overview\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.layerzero.network\"}]}]\n"])</script></body></html>