;\nimport path from 'path';\nimport {fileURLToPath} from 'url';\nimport {Command} from 'commander';\n\nimport {serializeDocsJson} from './lib/docs-json.mjs';\n\n// ES module __dirname equivalent\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// CLI setup\nconst program = new Command();\nprogram\n  .name('generate-chain-pages')\n  .description('Generate chain endpoint pages in Mintlify format')\n  .argument('[chainKeys...]', 'Chain keys to generate pages for')\n  .option('--dry-run', 'Preview changes without writing files')\n  .option('--skip-nav-update', 'Skip updating docs.json navigation')\n  .option('--list-chains', 'List all available chains')\n  .parse(process.argv);\n\nconst options = program.opts();\nconst chainKeys = program.args;\nconst isDryRun = !!options.dryRun;\nconst skipNavUpdate = !!options.skipNavUpdate;\n\n// Import deployment data\nconst deploymentsV2 = JSON.parse(\n  fs.readFileSync(path.join(__dirname, '../public/data/deploymentsV2.json'), 'utf8')\n);\n\n// Paths\nconst OUTPUT_DIR = path.join(__dirname, '../v2/deployments/chains');\nconst DOCS_JSON_PATH = path.join(__dirname, '../docs.json');\n\n// Ensure output directory exists\nif (!isDryRun \u0026\u0026 !fs.existsSync(OUTPUT_DIR)) {\n  fs.mkdirSync(OUTPUT_DIR, {recursive: true});\n}\n\n// Get today's date in YYYY-MM-DD format\nfunction getFormattedDate() {\n  const now = new Date();\n  return now.toISOString().split('T')[0];\n}\n\n// Template for chain page (Mintlify format)\nfunction generateChainPage(deployment) {\n  const chainKey = deployment.chainKey.toLowerCase();\n  const chainDisplayName = deployment.chainDisplayName;\n  const nativeChainId = deployment.nativeChainId;\n  const eid = deployment.eid;\n  const stage = deployment.stage || 'mainnet';\n  const lastUpdated = getFormattedDate();\n\n  const content = `---\ntitle: \"${chainDisplayName}\"\nsidebarTitle: \"${chainDisplayName}\"\ndescription: \"LayerZero V2 deployment addresses and configuration for ${chainDisplayName}. Find Endpoint, DVN, and Executor contract addresses for integration.\"\nkeywords: [\"LayerZero\",\"deployments\",\"contracts\",\"EID\",\"${chainDisplayName}\"]\nlastUpdated: \"${lastUpdated}\"\nauthor: \"LayerZero\"\nschema: \"TechArticle\"\nhide_title: \"true\"\nmode: \"wide\"\n---\nimport { ChainDetails } from '/snippets/ChainDetails.jsx';\n\n\u003cChainDetails\n  chainKey='${chainKey}'\n  chainDisplayName='${chainDisplayName}'\n  nativeChainId='${nativeChainId}'\n  eid='${eid}'\n  stage='${stage}'\n/\u003e\n`;\n\n  return content;\n}\n\n// Function to generate page for a specific chain\nfunction generatePageForChain(chainKey, generatedDocs) {\n  const deployment = deploymentsV2.find(\n    (dep) =\u003e dep.chainKey.toLowerCase() === chainKey.toLowerCase()\n  );\n\n  if (!deployment) {\n    console.error(`Error: Chain \"${chainKey}\" not found in deploymentsV2.json`);\n    return {status: 'error'};\n  }\n\n  const fileName = `${chainKey.toLowerCase()}.mdx`;\n  const filePath = path.join(OUTPUT_DIR, fileName);\n  const docId = `v2/deployments/chains/${chainKey.toLowerCase()}`;\n  const stage = deployment.stage || 'mainnet';\n\n  const content = generateChainPage(deployment);\n\n  // Check if file already exists with same content (ignoring lastUpdated date)\n  if (fs.existsSync(filePath)) {\n    const existing = fs.readFileSync(filePath, 'utf8');\n    const stripDate = (s) =\u003e s.replace(/^lastUpdated:.*$/m, '');\n    if (stripDate(existing) === stripDate(content)) {\n      return {status: 'skipped'};\n    }\n  }\n\n  if (isDryRun) {\n    console.log(`[DRY RUN] Would generate: ${fileName}`);\n  } else {\n    fs.writeFileSync(filePath, content);\n    console.log(`Generated: ${fileName}`);\n  }\n\n  // Track for nav update\n  generatedDocs.push({\n    id: docId,\n    name: deployment.chainDisplayName,\n    stage: stage,\n  });\n\n  return {status: 'generated'};\n}\n\n// Update docs.json navigation\nfunction updateDocsNavigation(generatedDocs, docsJson) {\n  let navChanged = false;\n\n  // Separate by stage\n  const mainnetDocs = generatedDocs.filter((d) =\u003e d.stage === 'mainnet');\n  const testnetDocs = generatedDocs.filter((d) =\u003e d.stage === 'testnet');\n\n  function findAndUpdateGroup(obj, groupName, docs) {\n    if (Array.isArray(obj)) {\n      for (const item of obj) {\n        findAndUpdateGroup(item, groupName, docs);\n      }\n    } else if (obj \u0026\u0026 typeof obj === 'object') {\n      if (obj.group === groupName \u0026\u0026 Array.isArray(obj.pages)) {\n        const currentIds = new Set(obj.pages);\n        const sortedDocs = [...docs].sort((a, b) =\u003e a.name.localeCompare(b.name));\n        for (const doc of sortedDocs) {\n          if (!currentIds.has(doc.id)) {\n            obj.pages.push(doc.id);\n            navChanged = true;\n          }\n        }\n        // Sort pages alphabetically\n        obj.pages.sort((a, b) =\u003e {\n          const docA = docs.find((d) =\u003e d.id === a);\n          const docB = docs.find((d) =\u003e d.id === b);\n          const nameA = docA ? docA.name : a;\n          const nameB = docB ? docB.name : b;\n          return nameA.localeCompare(nameB);\n        });\n      }\n      // Recurse into nested objects\n      for (const key of Object.keys(obj)) {\n        findAndUpdateGroup(obj[key], groupName, docs);\n      }\n    }\n  }\n\n  if (mainnetDocs.length \u003e 0) {\n    findAndUpdateGroup(docsJson, 'Mainnet Endpoints', mainnetDocs);\n  }\n  if (testnetDocs.length \u003e 0) {\n    findAndUpdateGroup(docsJson, 'Testnet Endpoints', testnetDocs);\n  }\n\n  return navChanged;\n}\n\n// Clean docs.json navigation: remove orphaned chain entries\nfunction cleanDocsNavigation(validDocIds, docsJson) {\n  let removedCount = 0;\n  const validSet = new Set(validDocIds);\n  const PREFIX = 'v2/deployments/chains/';\n\n  function cleanGroup(obj) {\n    if (Array.isArray(obj)) {\n      for (const item of obj) {\n        cleanGroup(item);\n      }\n    } else if (obj \u0026\u0026 typeof obj === 'object') {\n      if (\n        (obj.group === 'Mainnet Endpoints' || obj.group === 'Testnet Endpoints') \u0026\u0026\n        Array.isArray(obj.pages)\n      ) {\n        const before = obj.pages.length;\n        obj.pages = obj.pages.filter((page) =\u003e {\n          if (typeof page === 'string' \u0026\u0026 page.startsWith(PREFIX)) {\n            return validSet.has(page);\n          }\n          return true; // keep non-chain entries and group objects\n        });\n        removedCount += before - obj.pages.length;\n      }\n      for (const key of Object.keys(obj)) {\n        cleanGroup(obj[key]);\n      }\n    }\n  }\n\n  cleanGroup(docsJson);\n  return removedCount;\n}\n\n// List available chains\nfunction listChains() {\n  console.log('Available chains:\\n');\n\n  const mainnetChains = deploymentsV2.filter((dep) =\u003e dep.stage === 'mainnet' || !dep.stage);\n  const testnetChains = deploymentsV2.filter((dep) =\u003e dep.stage === 'testnet');\n\n  console.log('Mainnet chains:');\n  mainnetChains.forEach((dep) =\u003e {\n    console.log(`  - ${dep.chainKey} (${dep.chainDisplayName}, EID=${dep.eid})`);\n  });\n\n  if (testnetChains.length \u003e 0) {\n    console.log('\\nTestnet chains:');\n    testnetChains.forEach((dep) =\u003e {\n      console.log(`  - ${dep.chainKey} (${dep.chainDisplayName}, EID=${dep.eid})`);\n    });\n  }\n}\n\n// Main execution\nconsole.log('Chain Page Generator (Mintlify)');\nconsole.log('================================\\n');\n\nif (options.listChains) {\n  listChains();\n  process.exit(0);\n}\n\nconst isFullSync = chainKeys.length === 0;\n\nif (isFullSync) {\n  console.log('Full sync mode: processing all chains from deploymentsV2.json\\n');\n  if (isDryRun) {\n    console.log('[DRY RUN] No files will be written or deleted.\\n');\n  }\n}\n\nconst generatedDocs = [];\nlet generatedCount = 0;\nlet skippedCount = 0;\nlet errorCount = 0;\nlet deletedCount = 0;\n\nconst keysToProcess = isFullSync\n  ? deploymentsV2.map((dep) =\u003e dep.chainKey.toLowerCase())\n  : chainKeys;\n\nkeysToProcess.forEach((chainKey) =\u003e {\n  const result = generatePageForChain(chainKey, generatedDocs);\n  if (result.status === 'generated') {\n    generatedCount++;\n  } else if (result.status === 'skipped') {\n    skippedCount++;\n  } else {\n    errorCount++;\n  }\n});\n\n// In full sync mode, clean up orphaned .mdx files\nif (isFullSync \u0026\u0026 fs.existsSync(OUTPUT_DIR)) {\n  const validKeys = new Set(deploymentsV2.map((dep) =\u003e dep.chainKey.toLowerCase()));\n  const existingFiles = fs.readdirSync(OUTPUT_DIR).filter((f) =\u003e f.endsWith('.mdx'));\n\n  for (const file of existingFiles) {\n    const key = file.replace(/\\.mdx$/, '');\n    if (!validKeys.has(key)) {\n      const filePath = path.join(OUTPUT_DIR, file);\n      if (isDryRun) {\n        console.log(`[DRY RUN] Would delete orphaned file: ${file}`);\n      } else {\n        fs.unlinkSync(filePath);\n        console.log(`Deleted orphaned file: ${file}`);\n      }\n      deletedCount++;\n    }\n  }\n}\n\n// Update docs.json navigation\nif (!skipNavUpdate) {\n  try {\n    const docsJson = JSON.parse(fs.readFileSync(DOCS_JSON_PATH, 'utf8'));\n    let navChanged = false;\n    let navRemovedCount = 0;\n\n    if (isFullSync) {\n      // Full sync: ensure all valid chains are in nav and remove orphans\n      const allValidDocs = deploymentsV2.map((dep) =\u003e ({\n        id: `v2/deployments/chains/${dep.chainKey.toLowerCase()}`,\n        name: dep.chainDisplayName,\n        stage: dep.stage || 'mainnet',\n      }));\n      navChanged = updateDocsNavigation(allValidDocs, docsJson);\n\n      // Remove orphaned entries\n      const validDocIds = allValidDocs.map((d) =\u003e d.id);\n      navRemovedCount = cleanDocsNavigation(validDocIds, docsJson);\n      if (navRemovedCount \u003e 0) navChanged = true;\n    } else if (generatedDocs.length \u003e 0) {\n      // Selective mode: only add new entries\n      navChanged = updateDocsNavigation(generatedDocs, docsJson);\n    }\n\n    if (navChanged) {\n      if (isDryRun) {\n        console.log('\\n[DRY RUN] Would update docs.json navigation');\n        if (navRemovedCount \u003e 0) {\n          console.log(`  → Would remove ${navRemovedCount} orphaned navigation entry/entries`);\n        }\n      } else {\n        fs.writeFileSync(DOCS_JSON_PATH, serializeDocsJson(docsJson), 'utf8');\n        console.log('\\n✅ docs.json navigation updated');\n      }\n    }\n  } catch (err) {\n    console.error('Warning: Could not update docs.json:', err.message);\n  }\n}\n\n// Summary\nconsole.log('');\nif (isDryRun) {\n  console.log(`[DRY RUN] Would generate/update ${generatedCount} chain page(s)`);\n} else {\n  console.log(`Generated/updated ${generatedCount} chain page(s)`);\n}\nif (skippedCount \u003e 0) {\n  console.log(`Skipped ${skippedCount} unchanged page(s)`);\n}\nif (deletedCount \u003e 0) {\n  if (isDryRun) {\n    console.log(`[DRY RUN] Would delete ${deletedCount} orphaned page(s)`);\n  } else {\n    console.log(`Deleted ${deletedCount} orphaned page(s)`);\n  }\n}\nif (errorCount \u003e 0) {\n  console.log(`Errors: ${errorCount} chain(s) not found`);\n}\nconsole.log(`Output directory: ${OUTPUT_DIR}`);\n"])</script><script>self.__next_f.push([1,"5c:T5810,"])</script><script>self.__next_f.push([1,"export const BLACKLIST = ['llamarpc'];\n\nexport const DVN_NAME_OVERRIDES = {\n  ABDB: 'Animoca-Blockdaemon',\n  LayerZero: 'LayerZero Labs',\n  POPS: 'P-OPS',\n  Omnix: 'Omni X',\n  BCW: 'BCW Group',\n  Stablelab: 'StableLab',\n  Nodesguru: 'Nodes.Guru',\n  Tapioca: 'Pearlnet',\n  Stakingcabin: 'StakingCabin',\n  Superduper: 'Portal',\n  Planetarium: 'Planetarium Labs',\n  Nocturnal: 'Nocturnal Labs',\n  CCIP: 'Chainlink CCIP',\n  Bitgo: 'BitGo',\n  'Japan Open Chain': 'Japan Blockchain Foundation',\n  Polyhedra: 'Polyhedra zkBridge',\n};\n\nexport const EID_NAME_OVERRIDES = {\n  40451: 'Robinhood Chain Testnet',\n  10451: 'Robinhood Chain Testnet',\n  40371: 'Berachain Bepolia Testnet', // Berachain Bepolia\n  10371: 'Berachain Bepolia Testnet', // Berachain Bepolia\n  10267: 'Polygon Amoy Testnet',\n  362: 'Berachain Mainnet',\n  30362: 'Berachain Mainnet',\n  30365: 'XDC Mainnet',\n  365: 'XDC Mainnet',\n  40301: 'Fi Sepolia Testnet',\n  40359: 'Cronos EVM Testnet',\n  10359: 'Cronos EVM Testnet',\n  40360: 'Cronos zkEVM Testnet',\n  10360: 'Cronos zkEVM Testnet',\n  30154: 'Ethereum Sepolia Mainnet',\n  10161: 'Ethereum Sepolia Testnet',\n  155: 'OKX Mainnet',\n  198: 'Beam Mainnet',\n  10178: 'Beam Testnet',\n  274: 'XLayer Mainnet',\n  10126: 'Moonbeam Testnet',\n  10133: 'Harmony Testnet',\n  10157: 'Linea Consensys zkEVM Testnet',\n  10151: 'Metis Testnet',\n  10292: 'Metis Sepolia Testnet',\n  10159: 'Canto Testnet',\n  10162: 'DOS Testnet',\n  10216: 'XPLA Testnet',\n  10218: 'inEVM Testnet',\n  10220: 'zKatana Astar zkEVM Testnet',\n  10223: 'Public Goods Network Testnet',\n  10224: 'PolygonCDK Testnet',\n  10238: 'Tiltyard Testnet',\n  10251: 'XAI Testnet',\n  10266: 'zKatana Astar zkEVM Testnet',\n  30110: 'Arbitrum Mainnet',\n  110: 'Arbitrum Mainnet',\n  30175: 'Arbitrum Nova Mainnet',\n  175: 'Arbitrum Nova Mainnet',\n  30210: 'Astar Mainnet',\n  40210: 'Astar Testnet',\n  30257: 'Astar zkEVM Mainnet',\n  257: 'Astar zkEVM Mainnet',\n  40266: 'Astar zkEVM Testnet',\n  30106: 'Avalanche Mainnet',\n  106: 'Avalanche Mainnet',\n  40106: 'Avalanche Fuji Testnet',\n  10106: 'Avalanche Fuji Testnet',\n  40291: 'Berachain Bartio Testnet',\n  10291: 'Berachain Bartio Testnet',\n  30211: 'Near Aurora Mainnet',\n  30184: 'Base Mainnet',\n  184: 'Base Mainnet',\n  40245: 'Base Sepolia Testnet',\n  40102: 'BNB Smart Chain (BSC) Testnet',\n  10102: 'BNB Smart Chain (BSC) Testnet',\n  30102: 'BNB Smart Chain (BSC) Mainnet',\n  102: 'BNB Smart Chain (BSC) Mainnet',\n  30243: 'Blast Mainnet',\n  243: 'Blast Mainnet',\n  30279: 'BOB Mainnet',\n  279: 'BOB Mainnet',\n  40279: 'BOB Testn