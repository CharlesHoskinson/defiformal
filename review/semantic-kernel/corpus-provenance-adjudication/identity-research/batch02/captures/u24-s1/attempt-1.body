=\n   DESIGN SYSTEM TOKENS (CSS Variables)\n   ======================================== */\n\n:root {\n  /* Backgrounds */\n  --lz-bg-primary: #fafafa;\n  --lz-bg-secondary: #f5f5f5;\n  /* Text - from Figma neutral scale */\n  --lz-text-primary: #171717;\n  --lz-text-secondary: #5c5c5c; /* neutral/600 */\n  /* Borders */\n  --lz-border-primary: #e5e5e5;\n  /* LayerZero Purple - brand accent */\n  --lz-purple-400: #c084fc;\n  --lz-purple-500: #a855f7;\n  --lz-purple-600: #9333ea;\n  /* Stargate Green - from Stargate Design System */\n  --lz-stargate-400: #0fb983; /* accent/primary */\n  --lz-stargate-500: #10a073; /* accent/darker */\n}\n\nhtml[class~=\"dark\"] {\n  /* Backgrounds */\n  --lz-bg-primary: #0a0a0a;\n  --lz-bg-secondary: #171717;\n  /* Text - from Figma neutral scale */\n  --lz-text-primary: #f0f0f0; /* neutral/100 */\n  --lz-text-secondary: #a3a3a3; /* neutral/400 */\n  /* Borders */\n  --lz-border-primary: #2b2b2b;\n}\n\n/* ========================================\n   BACKGROUND COLOR OVERRIDE\n   ======================================== */\n\nhtml[class~=\"dark\"],\nhtml[class~=\"dark\"] body {\n  background-color: #0a0a0a !important;\n}\n\nhtml:not([class~=\"dark\"]),\nhtml:not([class~=\"dark\"]) body {\n  background-color: #fafafa !important;\n}\n\n/* Override Mintlify's background CSS variables to match design system */\n:root {\n  --background-light: 250 250 250 !important; /* #fafafa */\n  --background-dark: 10 10 10 !important; /* #0a0a0a */\n}\n\n/* ========================================\n   CUSTOM BUTTON COMPONENT\n   ======================================== */\n\n.custom-button {\n  display: inline-flex !important;\n  align-items: center;\n  justify-content: center;\n  padding: 0.5rem 1rem;\n  border-radius: 0.375rem;\n  font-weight: 600;\n  transition: color 100ms, background-color 100ms, border-color 100ms;\n  text-decoration: none !important;\n  cursor: pointer;\n}\n\n.custom-button:hover {\n  text-decoration: none !important;\n}\n\n.custom-button-primary {\n  background-color: #0a0a0a;\n  color: #f2f2f2 !important;\n  border: 1px solid transparent;\n}\n\n.custom-button-primary:hover {\n  opacity: 0.9;\n  color: #f2f2f2 !important;\n}\n\n.custom-button-secondary {\n  background-color: transparent;\n  color: #0a0a0a !important;\n  border: 1px solid #0a0a0a;\n}\n\n.custom-button-secondary:hover {\n  background-color: #0a0a0a;\n  color: #f2f2f2 !important;\n}\n\nhtml[class~=\"dark\"] .custom-button-primary {\n  background-color: #f2f2f2;\n  color: #0a0a0a !important;\n}\n\nhtml[class~=\"dark\"] .custom-button-primary:hover {\n  color: #0a0a0a !important;\n}\n\nhtml[class~=\"dark\"] .custom-button-secondary {\n  color: #f2f2f2 !important;\n  border-color: #f2f2f2;\n}\n\nhtml[class~=\"dark\"] .custom-button-secondary:hover {\n  background-color: #f2f2f2;\n  color: #0a0a0a !important;\n}\n\n/* ========================================\n   NAVIGATION ICON OVERRIDES\n   ======================================== */\n\na[href=\"/v2/developers/solana/overview\"] svg {\n  -webkit-mask-image: url('/images/icons/solana-mask.svg') !important;\n  mask-image: url('/images/icons/solana-mask.svg') !important;\n}\n\na[href=\"/v2/developers/aptos-move/overview\"] svg {\n  -webkit-mask-image: url('/images/icons/aptos-mask.svg') !important;\n  mask-image: url('/images/icons/aptos-mask.svg') !important;\n}\n\na[href=\"/v2/developers/hyperliquid/hyperliquid-concepts\"] svg {\n  -webkit-mask-image: url('/images/icons/hyperliquid-mask.svg') !important;\n  mask-image: url('/images/icons/hyperliquid-mask.svg') !important;\n}\n\na[href=\"/v2/developers/sui/overview\"] svg {\n  -webkit-mask-image: url('/images/icons/sui-mask.svg') !important;\n  mask-image: url('/images/icons/sui-mask.svg') !important;\n}\n\na[href=\"/v2/developers/iota/overview\"] svg {\n  -webkit-mask-image: url('/images/icons/iota-mask.svg') !important;\n  mask-image: url('/images/icons/iota-mask.svg') !important;\n}\n\na[href=\"/chain/index\"] svg,\na[href=\"/chain\"] svg {\n  -webkit-mask-image: url('/images/icons/zero-mask.svg') !important;\n  mask-image: url('/images/icons/zero-mask.svg') !important;\n}\n\na[href=\"/v2/developers/evm/overview\"] svg {\n  -webkit-mask-image: url('/images/icons/ethereum-mask.svg') !important;\n  mask-image: url('/images/icons/ethereum-mask.svg') !important;\n}\n\na[href=\"/v2/developers/stellar/overview\"] svg {\n  -webkit-mask-image: url('/images/icons/stellar-mask.svg') !important;\n  mask-image: url('/images/icons/stellar-mask.svg') !important;\n}\n\na[href=\"/v2/developers/tempo/overview\"] svg,\na[href=\"/v2/developers/tempo\"] svg {\n  -webkit-mask-image: url('/images/icons/tempo-mark-white.svg') !important;\n  mask-image: url('/images/icons/tempo-mark-white.svg') !important;\n}\n\n/* ========================================\n   MOBILE MENU - iOS SAFARI FIXES\n   Fixes intermittent touch/tap failures on iOS Safari\n   ======================================== */\n\n/* The .lz-mobile-nav-dialog class is added by accessibility.js to scope\n   these rules to the mobile navigation dialog only, not search or other\n   HeadlessUI dialogs. */\n\n/* Eliminate iOS double-tap-to-zoom delay and fix competing scroll contexts:\n   dialog root has overflow-y-auto from Mintlify, but the inner scroll\n   container also has overflow-y-auto. On iOS Safari, nested scrollable\n   containers cause touch events to be dispatched to the wrong element. */\n.lz-mobile-nav-dialog {\n  touch-action: manipulation;\n  -webkit-tap-highlight-color: transparent;\n  overflow-y: hidden !important;\n}\n\n/* Inner scroll container: enable iOS momentum scrolling and prevent\n   scroll chaining (rubber-band effect) from propagating to body */\n.lz-mobile-nav-dialog .overflow-y-auto {\n  -webkit-overflow-scrolling: touch;\n  overscroll-behavior: contain;\n}\n\n/* Ensure all interactive elements inside mobile menu have adequate\n   touch targets (Apple HIG: minimum 44px) and no tap delay */\n.lz-mobile-nav-dialog button,\n.lz-mobile-nav-dialog a {\n  touch-action: manipulation;\n  -webkit-tap-highlight-color: transparent;\n  min-height: 44px;\n  display: flex;\n  align-items: center;\n}\n\n/* Fix navbar backdrop-filter stealing touch events on iOS Safari.\n   #navbar-transition is a purely visual blur overlay (position:absolute,\n   full-size) sibling to the interactive navbar content. backdrop-filter\n   creates a composited layer that on iOS Safari can intercept touches,\n   especially on very tall pages (60k+ px) when the address bar animates. */\n#navbar-transition {\n  pointer-events: none;\n}\n\n/* iOS body scroll lock: position:fixed prevents background scroll-through.\n   The .lz-ios-scroll-lock class is toggled by accessibility.js which also\n   saves/restores the scroll position to prevent page jump. */\nhtml.lz-ios-scroll-lock {\n  position: fixed;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n}\n\n/* ========================================\n   FOOTER \u0026 NAV FIXES\n   ======================================== */\n\n#footer a[href*=\"mintlify.com\"][href*=\"poweredBy\"] {\n  display: none !important;\n}\n\nimg.nav-logo {\n  width: 102px !important;\n  height: 28px !important;\n  aspect-ratio: 109 / 30;\n}\n\n/* ========================================\n   LANDING PAGE STYLES\n   ======================================== */\n\n.lz-content-wrapper {\n  position: relative;\n}\n\n.lz-content-video-bg {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 100vw;\n  max-width: 900px;\n  height: 280px;\n  overflow: hidden;\n  pointer-events: none;\n  z-index: 0;\n  mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%);\n  -webkit-mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%);\n}\n\n.lz-content-video {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center top;\n  opacity: 0;\n}\n\nhtml[class~=\"dark\"] .lz-content-video {\n  opacity: 0.25;\n}\n\n@media (min-width: 900px) {\n  .lz-content-video-bg {\n    border-radius: 12px;\n  }\n}\n\n/* ========================================\n   MOBILE CARD STYLES\n   ======================================== */\n\n.lz-mobile-card-header {\n  display: flex !important;\n  flex-direction: row !important;\n  align-items: center !important;\n  gap: 12px;\n  margin-bottom: 12px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #e5e7eb;\n}\n\n.lz-mobile-icon-wrapper {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  flex-shrink: 0;\n}\n\n.lz-mobile-icon-wrapper [data-rmiz],\n.lz-mobile-icon-wrapper [data-rmiz-content] {\n  display: block !important;\n  width: 100% !important;\n  height: 100% !important;\n  line-height: normal !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.lz-mobile-card-title {\n  font-size: 18px !important;\n  font-weight: 700 !important;\n  margin: 0 !important;\n  line-height: 1.2 !important;\n  color: #000;\n}\n\nhtml[class~=\"dark\"] .lz-mobile-card-header {\n  border-bottom-color: rgba(255, 255, 255, 0.1);\n}\n\nhtml[class~=\"dark\"] .lz-mobile-card-title {\n  color: #fff;\n}\n\n/* ========================================\n   ICONCARD BASE STYLES\n   Fallback for Tailwind arbitrary values that don't compile in Mintlify\n   ======================================== */\n\n/* Card container - light mode */\na[data-accent] \u003e div {\n  background-color: #ffffff !important;\n  border-color: #e5e5e5 !important;\n  border-width: 2px !important;\n  border-style: solid !important;\n}\n\n/* Card container - dark mode */\nhtml[class~=\"dark\"] a[data-accent] \u003e div {\n  background-color: #0a0a0a !important;\n  border-color: #2b2b2b !important;\n}\n\n/* Card title - light mode */\na[data-accent] h3 {\n  color: #171717 !important;\n  font-weight: 600 !important;\n}\n\n/* Card title - dark mode */\nhtml[class~=\"dark\"] a[data-accent] h3 {\n  color: #fafafa !important;\n}\n\n/* Card description - light mode */\na[data-accent] p {\n  color: #525252 !important;\n}\n\n/* Card description - dark mode */\nhtml[class~=\"dark\"] a[data-accent] p {\n  color: #a1a1a1 !important;\n}\n\n/* Arrow icon - light mode */\na[data-accent] svg:last-child {\n  color: #a1a1a1 !important;\n}\n\n/* Arrow icon - dark mode */\nhtml[class~=\"dark\"] a[data-accent] svg:last-child {\n  color: #525252 !important;\n}\n\n/* ========================================\n   ICONCARD HOVER STATES\n   ======================================== */\n\n/* Purple accent */\na[data-accent=\"purple\"]:hover h3 {\n  color: #9333ea !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"purple\"]:hover h3 {\n  color: #c084fc !important;\n}\n\na[data-accent=\"purple\"]:hover \u003e div {\n  border-color: #9333ea !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"purple\"]:hover \u003e div {\n  border-color: #c084fc !important;\n}\n\na[data-accent=\"purple\"]:hover svg:last-child {\n  color: #9333ea !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"purple\"]:hover svg:last-child {\n  color: #c084fc !important;\n}\n\n/* Stargate accent */\na[data-accent=\"stargate\"]:hover h3 {\n  color: #10a073 !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"stargate\"]:hover h3 {\n  color: #0fb983 !important;\n}\n\na[data-accent=\"stargate\"]:hover \u003e div {\n  border-color: #10a073 !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"stargate\"]:hover \u003e div {\n  border-color: #0fb983 !important;\n}\n\na[data-accent=\"stargate\"]:hover svg:last-child {\n  color: #10a073 !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"stargate\"]:hover svg:last-child {\n  color: #0fb983 !important;\n}\n\n/* Gray accent */\na[data-accent=\"gray\"]:hover h3 {\n  color: #525252 !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"gray\"]:hover h3 {\n  color: #d4d4d4 !important;\n}\n\na[data-accent=\"gray\"]:hover \u003e div {\n  border-color: #a1a1a1 !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"gray\"]:hover \u003e div {\n  border-color: #525252 !important;\n}\n\na[data-accent=\"gray\"]:hover svg:last-child {\n  color: #525252 !important;\n}\n\nhtml[class~=\"dark\"] a[data-accent=\"gray\"]:hover svg:last-child {\n  color: #d4d4d4 !important;\n}\n"])</script><script>self.__next_f.push([1,"51:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$56\"}}]]\n58:T1ab2,"])</script><script>self.__next_f.push([1,"/**\n * Accessibility Fixes for Mintlify Documentation\n * Optimized for performance - deferred loading and minimal observers\n */\n\n(function () {\n  'use strict';\n\n  /**\n   * Fix 1: aria-hidden with focusable descendants\n   * Only observes the specific chat-assistant-sheet element, not the entire body\n   */\n  function fixAriaHiddenFocusable() {\n    var chatSheet = document.getElementById('chat-assistant-sheet');\n    if (!chatSheet) return;\n\n    var focusableSelectors = 'a[href], button, input, select, textarea, [tabindex]:not([tabindex=\"-1\"])';\n\n    function updateFocusability(isHidden) {\n      var elements = chatSheet.querySelectorAll(focusableSelectors);\n      for (var i = 0; i \u003c elements.length; i++) {\n        var el = elements[i];\n        if (isHidden) {\n          if (!el.hasAttribute('data-orig-tab')) {\n            el.setAttribute('data-orig-tab', el.getAttribute('tabindex') || '');\n          }\n          el.setAttribute('tabindex', '-1');\n        } else {\n          var orig = el.getAttribute('data-orig-tab');\n          if (orig === '') {\n            el.removeAttribute('tabindex');\n          } else if (orig) {\n            el.setAttribute('tabindex', orig);\n          }\n          el.removeAttribute('data-orig-tab');\n        }\n      }\n    }\n\n    // Initial fix\n    if (chatSheet.getAttribute('aria-hidden') === 'true') {\n      updateFocusability(true);\n    }\n\n    // Observe only attribute changes on the specific element\n    var observer = new MutationObserver(function (mutations) {\n      for (var i = 0; i \u003c mutations.length; i++) {\n        if (mutations[i].attributeName === 'aria-hidden') {\n          updateFocusability(chatSheet.getAttribute('aria-hidden') === 'true');\n          break;\n        }\n      }\n    });\n\n    observer.observe(chatSheet, { attributes: true, attributeFilter: ['aria-hidden'] });\n  }\n\n  /**\n   * Fix 2: Add main landmark (one-time check, no observer needed)\n   */\n  function addMainLandmark() {\n    if (document.querySelector('main, [role=\"main\"]')) return;\n\n    var selectors = ['article', '.prose', '[class*=\"content\"]'];\n    for (var i = 0; i \u003c selectors.length; i++) {\n      var el = document.querySelector(selectors[i]);\n      if (el \u0026\u0026 !el.closest('nav, header, footer, main')) {\n        el.setAttribute('role', 'main');\n        return;\n      }\n    }\n  }\n\n  /**\n   * Fix 3: Viewport zoom fix (one-time, immediate)\n   */\n  function fixViewportZoom() {\n    var viewport = document.querySelector('meta[name=\"viewport\"]');\n    if (!viewport) return;\n\n    var content = viewport.getAttribute('content')\n      .replace(/,?\\s*maximum-scale\\s*=\\s*[^,]*/gi, '')\n      .replace(/,?\\s*user-scalable\\s*=\\s*(no|0)/gi, '')\n      .replace(/,\\s*,/g, ',')\n      .replace(/^,|,$/g, '')\n      .trim();\n\n    viewport.setAttribute('content', content);\n  }\n\n  // Run viewport fix immediately (it's fast and important)\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', fixViewportZoom);\n  } else {\n    fixViewportZoom();\n  }\n\n  /**\n   * Fix 4: Tag mobile nav dialog with .lz-mobile-nav-dialog\n   * HeadlessUI is used for both the mobile nav and the search dialog.\n   * CSS rules for mobile nav (touch targets, overflow) must not affect\n   * other dialogs. This observer adds .lz-mobile-nav-dialog to the\n   * mobile navigation dialog so CSS can scope to it.\n   */\n  function tagMobileNavDialog() {\n    if (!document.body) return;\n\n    var observer = new MutationObserver(function () {\n      var dialogs = document.querySelectorAll(\n        'div[id^=\"headlessui-dialog-\"][role=\"dialog\"]:not(.lz-mobile-nav-dialog)'\n      );\n      for (var i = 0; i \u003c dialogs.length; i++) {\n        var dialog = dialogs[i];\n        if (\n          dialog.querySelector('button[aria-label=\"Close navigation\"]') ||\n          dialog.querySelector('nav')\n        ) {\n          dialog.classList.add('lz-mobile-nav-dialog');\n        }\n      }\n    });\n\n    observer.observe(document.body, { childList: true, subtree: true });\n  }\n\n  /**\n   * Fix 5: iOS Safari mobile menu scroll lock\n   * overflow:hidden on \u003chtml\u003e does not reliably prevent background scrolling\n   * on iOS Safari. This watches for HeadlessUI dialogs opening and applies\n   * position:fixed with scroll position save/restore.\n   */\n  function fixIOSMobileMenuScrollLock() {\n    var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||\n      (navigator.platform === 'MacIntel' \u0026\u0026 navigator.maxTouchPoints \u003e 1);\n    if (!isIOS) return;\n    if (!document.body) return;\n\n    var savedScrollY = 0;\n\n    var observer = new MutationObserver(function () {\n      var dialog = document.querySelector('.lz-mobile-nav-dialog');\n      var html = document.documentElement;\n\n      if (dialog \u0026\u0026 !html.classList.contains('lz-ios-scroll-lock')) {\n        savedScrollY = window.scrollY;\n        html.classList.add('lz-ios-scroll-lock');\n        html.style.top = '-' + savedScrollY + 'px';\n      } else if (!dialog \u0026\u0026 html.classList.contains('lz-ios-scroll-lock')) {\n        html.classList.remove('lz-ios-scroll-lock');\n        html.style.top = '';\n        window.scrollTo(0, savedScrollY);\n      }\n    });\n\n    observer.observe(document.body, { childList: true, subtree: true });\n  }\n\n  /**\n   * Fix 6: Escape key closes HeadlessUI dialog\n   * HeadlessUI's dialog should handle Escape natively, but Mintlify's\n   * implementation sometimes misses it. This is a safety net.\n   */\n  function fixDialogEscapeKey() {\n    document.addEventListener('keydown', function (e) {\n      if (e.key !== 'Escape') return;\n      var dialog = document.querySelector('.lz-mobile-nav-dialog');\n      if (!dialog) return;\n      // Target the close button specifically by its accessible name\n      var closeBtn = dialog.querySelector('button[aria-label=\"Close navigation\"]');\n      if (!closeBtn) {\n        try {\n          closeBtn = dialog.querySelector('button:has(\u003e .sr-only)');\n        } catch (_e) {\n          // :has() not supported in this browser — fall through to text search\n        }\n      }\n      // Fallback: find button whose text content indicates close\n      if (!closeBtn) {\n        var btns = dialog.querySelectorAll('button');\n        for (var i = 0; i \u003c btns.length; i++) {\n          if (/close/i.test(btns[i].textContent)) { closeBtn = btns[i]; break; }\n        }\n      }\n      if (closeBtn) closeBtn.click();\n    });\n  }\n\n  // Defer other fixes until browser is idle\n  if ('requestIdleCallback' in window) {\n    requestIdleCallback(function() {\n      fixAriaHiddenFocusable();\n      addMainLandmark();\n      tagMobileNavDialog();\n      fixIOSMobileMenuScrollLock();\n      fixDialogEscapeKey();\n    }, { timeout: 2000 });\n  } else {\n    setTimeout(function() {\n      fixAriaHiddenFocusable();\n      addMainLandmark();\n      tagMobileNavDialog();\n      fixIOSMobileMenuScrollLock();\n      fixDialogEscapeKey();\n    }, 1000);\n  }\n})();\n"])</script><script>self.__next_f.push([1,"59:T1010,"])</script><script>self.__next_f.push([1,"/**\n * PostHog Analytics - Deferred Loading\n * Loads after page is interactive to improve initial performance\n */\n(function() {\n  'use strict';\n\n  function loadPostHog() {\n    !function(t,e){var o,n,p,r;e.__SV||(window.posthog \u0026\u00