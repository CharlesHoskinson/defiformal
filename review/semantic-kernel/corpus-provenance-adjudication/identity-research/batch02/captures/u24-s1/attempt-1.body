    window.__mintlifyInitialSidebarScrollDone = true;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content')) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.layerzero.network/#organization","name":"LayerZero","url":"https://docs.layerzero.network","logo":{"@type":"ImageObject","url":"https://mintcdn.com/layerzero/MzSiOdXt8xlDlEr4/images/LayerZero_Logo_Black.svg?fit=max&auto=format&n=MzSiOdXt8xlDlEr4&q=85&s=091b05c7556f6e8e948d613c2abf58cb"}},{"@type":"WebSite","@id":"https://docs.layerzero.network#website","name":"LayerZero","url":"https://docs.layerzero.network","publisher":{"@id":"https://docs.layerzero.network/#organization"}},{"@type":"WebPage","@id":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview#webpage","url":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview","name":"Protocol Overview","description":"Learn about Protocol Overview in LayerZero V2. Understand the architecture, core concepts, and how it enables omnichain interoperability. Architecture and im...","dateModified":"2026-03-16T22:01:41.523Z","isPartOf":{"@id":"https://docs.layerzero.network#website"},"breadcrumb":{"@id":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"LayerZero","item":"https://docs.layerzero.network"},{"@type":"ListItem","position":2,"name":"Protocol Overview","item":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview"}]},{"@type":["Article","TechArticle"],"@id":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview#article","headline":"Protocol Overview","name":"Protocol Overview","description":"Learn about Protocol Overview in LayerZero V2. Understand the architecture, core concepts, and how it enables omnichain interoperability. Architecture and im...","url":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview","mainEntityOfPage":{"@id":"https://docs.layerzero.network/v2/concepts/protocol/protocol-overview#webpage"},"dateModified":"2026-03-16T22:01:41.523Z","keywords":"LayerZero, concepts, overview","publisher":{"@id":"https://docs.layerzero.network/#organization"},"isPartOf":{"@id":"https://docs.layerzero.network#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "none");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="style.css">/* ========================================
   LAYERZERO DOCUMENTATION - CUSTOM STYLES

   RULES:
   - Only use scoped selectors (.lz-*, [data-*], specific hrefs)
   - NO broad [class*="mint-"] selectors
   - NO global element overrides (code, a, table, etc.)
   - Let Mintlify handle its own component styling
   ======================================== */

/* ========================================
   DESIGN SYSTEM TOKENS (CSS Variables)
   ======================================== */

:root {
  /* Backgrounds */
  --lz-bg-primary: #fafafa;
  --lz-bg-secondary: #f5f5f5;
  /* Text - from Figma neutral scale */
  --lz-text-primary: #171717;
  --lz-text-secondary: #5c5c5c; /* neutral/600 */
  /* Borders */
  --lz-border-primary: #e5e5e5;
  /* LayerZero Purple - brand accent */
  --lz-purple-400: #c084fc;
  --lz-purple-500: #a855f7;
  --lz-purple-600: #9333ea;
  /* Stargate Green - from Stargate Design System */
  --lz-stargate-400: #0fb983; /* accent/primary */
  --lz-stargate-500: #10a073; /* accent/darker */
}

html[class~="dark"] {
  /* Backgrounds */
  --lz-bg-primary: #0a0a0a;
  --lz-bg-secondary: #171717;
  /* Text - from Figma neutral scale */
  --lz-text-primary: #f0f0f0; /* neutral/100 */
  --lz-text-secondary: #a3a3a3; /* neutral/400 */
  /* Borders */
  --lz-border-primary: #2b2b2b;
}

/* ========================================
   BACKGROUND COLOR OVERRIDE
   ======================================== */

html[class~="dark"],
html[class~="dark"] body {
  background-color: #0a0a0a !important;
}

html:not([class~="dark"]),
html:not([class~="dark"]) body {
  background-color: #fafafa !important;
}

/* Override Mintlify's background CSS variables to match design system */
:root {
  --background-light: 250 250 250 !important; /* #fafafa */
  --background-dark: 10 10 10 !important; /* #0a0a0a */
}

/* ========================================
   CUSTOM BUTTON COMPONENT
   ======================================== */

.custom-button {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  font-weight: 600;
  transition: color 100ms, background-color 100ms, border-color 100ms;
  text-decoration: none !important;
  cursor: pointer;
}

.custom-button:hover {
  text-decoration: none !important;
}

.custom-button-primary {
  background-color: #0a0a0a;
  color: #f2f2f2 !important;
  border: 1px solid transparent;
}

.custom-button-primary:hover {
  opacity: 0.9;
  color: #f2f2f2 !important;
}

.custom-button-secondary {
  background-color: transparent;
  color: #0a0a0a !important;
  border: 1px solid #0a0a0a;
}

.custom-button-secondary:hover {
  background-color: #0a0a0a;
  color: #f2f2f2 !important;
}

html[class~="dark"] .custom-button-primary {
  background-color: #f2f2f2;
  color: #0a0a0a !important;
}

html[class~="dark"] .custom-button-primary:hover {
  color: #0a0a0a !important;
}

html[class~="dark"] .custom-button-secondary {
  color: #f2f2f2 !important;
  border-color: #f2f2f2;
}

html[class~="dark"] .custom-button-secondary:hover {
  background-color: #f2f2f2;
  color: #0a0a0a !important;
}

/* ========================================
   NAVIGATION ICON OVERRIDES
   ======================================== */

a[href="/v2/developers/solana/overview"] svg {
  -webkit-mask-image: url('/images/icons/solana-mask.svg') !important;
  mask-image: url('/images/icons/solana-mask.svg') !important;
}

a[href="/v2/developers/aptos-move/overview"] svg {
  -webkit-mask-image: url('/images/icons/aptos-mask.svg') !important;
  mask-image: url('/images/icons/aptos-mask.svg') !important;
}

a[href="/v2/developers/hyperliquid/hyperliquid-concepts"] svg {
  -webkit-mask-image: url('/images/icons/hyperliquid-mask.svg') !important;
  mask-image: url('/images/icons/hyperliquid-mask.svg') !important;
}

a[href="/v2/developers/sui/overview"] svg {
  -webkit-mask-image: url('/images/icons/sui-mask.svg') !important;
  mask-image: url('/images/icons/sui-mask.svg') !important;
}

a[href="/v2/developers/iota/overview"] svg {
  -webkit-mask-image: url('/images/icons/iota-mask.svg') !important;
  mask-image: url('/images/icons/iota-mask.svg') !important;
}

a[href="/chain/index"] svg,
a[href="/chain"] svg {
  -webkit-mask-image: url('/images/icons/zero-mask.svg') !important;
  mask-image: url('/images/icons/zero-mask.svg') !important;
}

a[href="/v2/developers/evm/overview"] svg {
  -webkit-mask-image: url('/images/icons/ethereum-mask.svg') !important;
  mask-image: url('/images/icons/ethereum-mask.svg') !important;
}

a[href="/v2/developers/stellar/overview"] svg {
  -webkit-mask-image: url('/images/icons/stellar-mask.svg') !important;
  mask-image: url('/images/icons/stellar-mask.svg') !important;
}

a[href="/v2/developers/tempo/overview"] svg,
a[href="/v2/developers/tempo"] svg {
  -webkit-mask-image: url('/images/icons/tempo-mark-white.svg') !important;
  mask-image: url('/images/icons/tempo-mark-white.svg') !important;
}

/* ========================================
   MOBILE MENU - iOS SAFARI FIXES
   Fixes intermittent touch/tap failures on iOS Safari
   ======================================== */

/* The .lz-mobile-nav-dialog class is added by accessibility.js to scope
   these rules to the mobile navigation dialog only, not search or other
   HeadlessUI dialogs. */

/* Eliminate iOS double-tap-to-zoom delay and fix competing scroll contexts:
   dialog root has overflow-y-auto from Mintlify, but the inner scroll
   container also has overflow-y-auto. On iOS Safari, nested scrollable
   containers cause touch events to be dispatched to the wrong element. */
.lz-mobile-nav-dialog {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  overflow-y: hidden !important;
}

/* Inner scroll container: enable iOS momentum scrolling and prevent
   scroll chaining (rubber-band effect) from propagating to body */
.lz-mobile-nav-dialog .overflow-y-auto {
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
}

/* Ensure all interactive elements inside mobile menu have adequate
   touch targets (Apple HIG: minimum 44px) and no tap delay */
.lz-mobile-nav-dialog button,
.lz-mobile-nav-dialog a {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  min-height: 44px;
  display: flex;
  align-items: center;
}

/* Fix navbar backdrop-filter stealing touch events on iOS Safari.
   #navbar-transition is a purely visual blur overlay (position:absolute,
   full-size) sibling to the interactive navbar content. backdrop-filter
   creates a composited layer that on iOS Safari can intercept touches,
   especially on very tall pages (60k+ px) when the address bar animates. */
#navbar-transition {
  pointer-events: none;
}

/* iOS body scroll lock: position:fixed prevents background scroll-through.
   The .lz-ios-scroll-lock class is toggled by accessibility.js which also
   saves/restores the scroll position to prevent page jump. */
html.lz-ios-scroll-lock {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* ========================================
   FOOTER & NAV FIXES
   ======================================== */

#footer a[href*="mintlify.com"][href*="poweredBy"] {
  display: none !important;
}

img.nav-logo {
  width: 102px !important;
  height: 28px !important;
  aspect-ratio: 109 / 30;
}

/* ========================================
   LANDING PAGE STYLES
   ======================================== */

.lz-content-wrapper {
  position: relative;
}

.lz-content-video-bg {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  max-width: 900px;
  height: 280px;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
  mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%);
}

.lz-content-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  opacity: 0;
}

html[class~="dark"] .lz-content-video {
  opacity: 0.25;
}

@media (min-width: 900px) {
  .lz-content-video-bg {
    border-radius: 12px;
  }
}

/* ========================================
   MOBILE CARD STYLES
   ======================================== */

.lz-mobile-card-header {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 12px;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e5e7eb;
}

.lz-mobile-icon-wrapper {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0;
}

.lz-mobile-icon-wrapper [data-rmiz],
.lz-mobile-icon-wrapper [data-rmiz-content] {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  line-height: normal !important;
  margin: 0 !important;
  padding: 0 !important;
}

.lz-mobile-card-title {
  font-size: 18px !important;
  font-weight: 700 !important;
  margin: 0 !important;
  line-height: 1.2 !important;
  color: #000;
}

html[class~="dark"] .lz-mobile-card-header {
  border-bottom-color: rgba(255, 255, 255, 0.1);
}

html[class~="dark"] .lz-mobile-card-title {
  color: #fff;
}

/* ========================================
   ICONCARD BASE STYLES
   Fallback for Tailwind arbitrary values that don't compile in Mintlify
   ======================================== */

/* Card container - light mode */
a[data-accent] > div {
  background-color: #ffffff !important;
  border-color: #e5e5e5 !important;
  border-width: 2px !important;
  border-style: solid !important;
}

/* Card container - dark mode */
html[class~="dark"] a[data-accent] > div {
  background-color: #0a0a0a !important;
  border-color: #2b2b2b !important;
}

/* Card title - light mode */
a[data-accent] h3 {
  color: #171717 !important;
  font-weight: 600 !important;
}

/* Card title - dark mode */
html[class~="dark"] a[data-accent] h3 {
  color: #fafafa !important;
}

/* Card description - light mode */
a[data-accent] p {
  color: #525252 !important;
}

/* Card description - dark mode */
html[class~="dark"] a[data-accent] p {
  color: #a1a1a1 !important;
}

/* Arrow icon - light mode */
a[data-accent] svg:last-child {
  color: #a1a1a1 !important;
}

/* Arrow icon - dark mode */
html[class~="dark"] a[data-accent] svg:last-child {
  color: #525252 !important;
}

/* ========================================
   ICONCARD HOVER STATES
   ======================================== */

/* Purple accent */
a[data-accent="purple"]:hover h3 {
  color: #9333ea !important;
}

html[class~="dark"] a[data-accent="purple"]:hover h3 {
  color: #c084fc !important;
}

a[data-accent="purple"]:hover > div {
  border-color: #9333ea !important;
}

html[class~="dark"] a[data-accent="purple"]:hover > div {
  border-color: #c084fc !important;
}

a[data-accent="purple"]:hover svg:last-child {
  color: #9333ea !important;
}

html[class~="dark"] a[data-accent="purple"]:hover svg:last-child {
  color: #c084fc !important;
}

/* Stargate accent */
a[data-accent="stargate"]:hover h3 {
  color: #10a073 !important;
}

html[class~="dark"] a[data-accent="stargate"]:hover h3 {
  color: #0fb983 !important;
}

a[data-accent="stargate"]:hover > div {
  border-color: #10a073 !important;
}

html[class~="dark"] a[data-accent="stargate"]:hover > div {
  border-color: #0fb983 !important;
}

a[data-accent="stargate"]:hover svg:last-child {
  color: #10a073 !important;
}

html[class~="dark"] a[data-accent="stargate"]:hover svg:last-child {
  color: #0fb983 !important;
}

/* Gray accent */
a[data-accent="gray"]:hover h3 {
  color: #525252 !important;
}

html[class~="dark"] a[data-accent="gray"]:hover h3 {
  color: #d4d4d4 !important;
}

a[data-accent="gray"]:hover > div {
  border-color: #a1a1a1 !important;
}

html[class~="dark"] a[data-accent="gray"]:hover > div {
  border-color: #525252 !important;
}

a[data-accent="gray"]:hover svg:last-child {
  color: #525252 !important;
}

html[class~="dark"] a[data-accent="gray"]:hover svg:last-child {
  color: #d4d4d4 !important;
}
