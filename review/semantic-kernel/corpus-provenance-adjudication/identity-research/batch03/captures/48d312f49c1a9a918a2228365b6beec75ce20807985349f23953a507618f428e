                    <div id="_ctrl0_ctl17_divNewsDetailsHeadline" class="evergreen-news-headline evergreen-data-left">
                        <h3 id="_ctrl0_ctl17_lblModuleDetailTitle" class="evergreen-item-detail-title evergreen-news-title">
                            <span id="_ctrl0_ctl17_spanNewsDetailsTitle">BlackRock and Securitize Debut New BUIDL Share Class on Solana Network</span>
                        </h3>
                    </div>
                    <div id="_ctrl0_ctl17_divNewsDetailsDateTime" class="evergreen-item-date-time evergreen-news-date-time evergreen-data-left">
                        <span id="_ctrl0_ctl17_spanDate" class="evergreen-news-date-text">March 25, 2025</span> <span id="_ctrl0_ctl17_spanTime" class="evergreen-news-time-text"></span>
                    </div>
                    <div id="_ctrl0_ctl17_divNewsDetailsAttachmentsContainer" class="evergreen-news-attachments-container evergreen-data-left">
                        <ul id="_ctrl0_ctl17_divEvergreenNewsAttachments" class="evergreen-news-attachments evergreen-styleless-list">
                            
