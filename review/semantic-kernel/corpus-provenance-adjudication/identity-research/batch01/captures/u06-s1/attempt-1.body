"_blank" rel="noopener noreferrer" aria-label="Aave on Dune (opens in a new tab)" href="https://dune.com/aavelabs"><svg class="styles_socialIcon__Te5yv" width="18" height="18" viewBox="0 0 18 18"><path d="M18 9C18 12.53 15.91 15.88 12.44 17.31C8.98 18.74 5.14 17.86 2.64 15.37L18 9Z"></path><path d="M5.56.69C10.15-1.21 15.41.97 17.31 5.56C17.6 6.25 17.8 6.96 17.9 7.68L1.77 14.36C1.34 13.78.98 13.14.69 12.44C-1.21 7.85.97 2.59 5.56.69Z"></path></svg></a><a class="styles_socialIconWrapper__prFQG" target="_blank" rel="noopener noreferrer" aria-label="Aave on TokenLogic (opens in a new tab)" href="https://aave.tokenlogic.xyz"><svg class="styles_socialIcon__Te5yv" width="19" height="15" viewBox="0 0 19 15"><rect y="12" width="4" height="3"></rect><rect x="5" y="11" width="4" height="4"></rect><rect x="10" y="12" width="4" height="3"></rect><rect x="15" y="10" width="4" height="5"></rect><rect x="5" y="8" width="4" height="2"></rect><rect x="10" y="4" width="4" height="7"></rect><rect x="15" y="6" width="4" height="3"></rect><rect x="15" width="4" height="5"></rect></svg></a><a class="styles_socialIconWrapper__prFQG" target="_blank" rel="noopener noreferrer" aria-label="Aave on DefiLlama (opens in a new tab)" href="https://defillama.com/protocol/aave"><svg class="styles_socialIcon__Te5yv" width="22" height="22" viewBox="0 0 22 22"><path d="M9.76 8.37C9.79 8.41 9.82 8.45 9.86 8.48C10.16 8.71 10.57 8.72 10.86 8.49C10.86 8.81 11.19 9.07 11.58 9.07C11.61 9.07 11.65 9.07 11.69 9.07C12.03 9.03 12.29 8.79 12.29 8.5C12.59 8.73 13 8.72 13.29 8.49L13.33 8.46C13.38 8.62 13.36 8.79 13.28 8.93C13.14 9.15 13.06 9.41 13.04 9.67L13.04 9.78C13.04 10.07 13.12 10.36 13.25 10.61C13.35 10.79 13.35 11.01 13.23 11.18C12.83 11.77 12.27 12.21 11.56 12.21H11.41C10.79 12.16 10.15 11.75 9.75 11.27C9.6 11.09 9.58 10.84 9.7 10.64C9.85 10.38 9.93 10.08 9.93 9.78C9.93 9.49 9.86 9.21 9.73 8.95C9.63 8.77 9.64 8.55 9.76 8.37ZM11.59 9.78L11.53 9.79H11.49L10.79 9.7C10.75 9.69 10.71 9.71 10.67 9.74C10.65 9.76 10.64 9.79 10.64 9.82C10.63 9.86 10.64 9.91 10.67 9.94L11.14 10.37C11.18 10.4 11.21 10.45 11.22 10.51L11.37 11.1C11.39 11.17 11.44 11.21 11.51 11.21C11.58 11.21 11.63 11.17 11.65 11.1C11.7 10.87 11.76 10.63 11.79 10.51C11.8 10.45 11.83 10.41 11.87 10.37L12.34 9.94C12.37 9.91 12.39 9.86 12.38 9.82C12.38 9.8 12.38 9.79 12.37 9.77C12.35 9.72 12.29 9.69 12.23 9.7L11.59 9.78Z"></path><path d="M10.45 1.92C11.91 1.92 13.35 2.26 14.64 2.93C14.78 3 14.91 3.08 15.04 3.15L15.43 3.39C18.06 5.09 19.65 8 19.65 11.13C19.65 14.57 17.74 17.72 14.69 19.3L14.41 11V10.92C14.43 10.91 14.45 10.89 14.46 10.88C14.79 10.69 15.01 10.24 15.01 9.73C15.01 9.67 15.01 9.61 15 9.55C14.95 9.02 14.65 8.6 14.27 8.5C14.22 8.13 14.09 7.77 13.89 7.46C14.08 7.44 14.25 7.33 14.35 7.17C14.73 6.61 15.24 6.03 15.63 5.12L15.65 5.08C15.7 4.96 15.69 4.83 15.61 4.73C15.59 4.7 15.56 4.67 15.53 4.65C15.39 4.55 15.2 4.57 15.09 4.69C14.5 5.25 13.83 5.37 13.45 5.89C13.42 5.82 13.38 5.76 13.34 5.7C13.23 5.56 13.08 5.46 12.92 5.41L12.92 5.4C12.73 5.34 12.52 5.35 12.34 5.43C12.26 5.15 12.04 4.93 11.75 4.85C11.29 4.71 10.81 4.97 10.68 5.43C10.32 5.28 9.91 5.39 9.67 5.69C9.63 5.75 9.59 5.82 9.56 5.89C9.15 5.33 8.42 5.16 7.81 4.58C7.8 4.57 7.79 4.56 7.78 4.55C7.67 4.47 7.52 4.49 7.44 4.6C7.33 4.75 7.31 4.94 7.38 5.1C7.78 6.03 8.29 6.6 8.67 7.16C8.77 7.32 8.94 7.43 9.12 7.46C8.93 7.77 8.8 8.13 8.74 8.49C8.32 8.61 8 9.12 8 9.73C8 10.27 8.25 10.74 8.6 10.91L8.29 20.34H5.01C4.09 20.33 3.35 19.59 3.35 18.67V3.58C3.35 2.67 4.09 1.93 5.01 1.92H7.88L10.45 1.92Z"></path></svg></a><a class="styles_socialIconWrapper__prFQG" target="_blank" rel="noopener noreferrer" aria-label="Aave on Token Terminal (opens in a new tab)" href="https://tokenterminal.com/explorer/projects/aave"><svg class="styles_socialIcon__Te5yv" width="23" height="17" viewBox="0 0 23 17"><path d="M22.88 13.88V16.13H12.38V13.88H22.88Z"></path><path d="M3.38 13.5V5.63H0V3.38H3.38V0H5.63V3.38H9.38V5.63H5.63V13.5C5.63 13.71 5.79 13.88 6 13.88H9.38V16.13H6C4.55 16.13 3.38 14.95 3.38 13.5Z"></path></svg></a></div></div></div></div><div class="styles_legalText__Ne3Z_">Aave.com provides information and resources about the fundamentals of the decentralised non-custodial liquidity protocol called the Aave Protocol, comprised of open-source self-executing smart contracts that are deployed on various permissionless public blockchains, such as Ethereum (the &quot;Aave Protocol&quot; or the &quot;Protocol&quot;). Aave Labs does not control or operate any version of the Aave Protocol on any blockchain network.</div></footer></section></main></div></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"post":{"slug":"introduction-to-aave","date":"9 Aug, 2024","category":"aave-101","title":"Introduction To Aave V3","description":"Introduction to the Aave V3 Protocol.","difficulty":0,"index":1,"mdxSource":{"compiledSource":"\"use strict\";\nconst {Fragment: _Fragment, jsx: _jsx, jsxs: _jsxs} = arguments[0];\nconst {useMDXComponents: _provideComponents} = arguments[0];\nfunction _createMdxContent(props) {\n  const _components = {\n    em: \"em\",\n    h2: \"h2\",\n    h3: \"h3\",\n    li: \"li\",\n    p: \"p\",\n    strong: \"strong\",\n    ul: \"ul\",\n    ..._provideComponents(),\n    ...props.components\n  };\n  return _jsxs(_Fragment, {\n    children: [_jsx(_components.h2, {\n      id: \"introduction-to-aave-v3\",\n      children: \"Introduction to Aave V3\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: _jsx(_components.em, {\n        children: \"This guide refers to Aave V3, the version of the protocol currently in production.\"\n      })\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"The Aave V3 Protocol is a collection of smart contracts that facilitates overcollateralised borrowing of digital assets. The protocol is deployed on Ethereum, Polygon, Avalanche, BNB Chain, Fantom, and Harmony networks, as well as Layer 2 chains including Base, Arbitrum, Optimism, Gnosis, Base, Scroll, Metis, and ZKsync Era.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Aave allows users to supply and borrow cryptocurrencies without the need of a central authority or intermediary. The protocol is comprised of publicly accessible, self-executing smart contracts that are deployed on various permissionless public blockchains. Users interact with the Aave Protocol by submitting transactions to the blockchain using self-custodial wallets.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"supply\",\n      children: \"Supply\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"By supplying tokens to Aave, users can earn interest on their assets while contributing to the protocol’s liquidity. These supplied assets are “pooled” and can also be utilised as collateral for borrowing while continuing to earn interest.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Suppliers, also known as liquidity providers, supply their cryptocurrency into Aave's liquidity pools.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Here's how it works:\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"A user selects a supported cryptocurrency (e.g., ETH, USDC) and supplies it into the Aave Protocol.\"\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"Upon supplying, the address receives a corresponding amount of \", _jsx(_components.strong, {\n          children: _jsx(_components.em, {\n            children: \"aTokens\"\n          })\n        }), \" (e.g., aETH, aUSDC) in return. These tokens represent the addresses share in the pool and start accruing interest automatically.\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"The interest earned by liquidity providers is not fixed and varies depending on the \", _jsx(_components.strong, {\n        children: _jsx(_components.em, {\n          children: \"utilisation rate\"\n        })\n      }), \" of the asset in the pool. The utilisation rate is the percentage of the total pool that is currently borrowed.\"]\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"High Utilisation Rate\"\n        }), \": if a large portion of the pool is being borrowed, the interest rate increases. This incentivizes supplies, borrow repayments, and disincentivizes further borrowing.\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Low Utilisation Rate\"\n        }), \": if most of the pool is idle, the interest rate decreases, reflecting the lower demand for borrowing that asset.\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Interest is accrued continuously and is added to the suppliers aTokens automatically. In other words, over time the balance of aTokens increases, allowing the supplier to redeem the enhanced value of their supply position.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Suppliers can withdraw their tokens at any time alongside the accrued interest as long as there is available (unborrowed) liquidity in the token pool. This is done by burning the aTokens, which triggers the return of the corresponding amount of the underlying asset from the pool.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"borrow\",\n      children: \"Borrow\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Supplied tokens can be utilised as collateral to borrow against. The collateral must be greater in value than the borrowed amount, a concept known as overcollateralisation. If the assets supplied as collateral drop under the minimum collateralisation threshold, the position could face liquidation.\"\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"collateralisation\",\n      children: \"Collateralisation\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"To borrow assets from Aave, a user must first supply collateral. This collateral can be any cryptocurrency supported within the protocol. The value of the collateral must always exceed the value of the amount borrowed. Overcollateralisation is a safeguard to protect the protocol against market volatility. For example, if a user wants to borrow $100 worth of GHO, they might be required to supply $150 worth of ETH as the collateral, depending on specific Loan-to-Value (LTV) collateral requirements.\"\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"loan-to-value-ltv-ratio\",\n      children: \"Loan-to-Value (LTV) Ratio\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"Each type of collateral has a specific \", _jsx(_components.strong, {\n        children: \"LTV ratio\"\n      }), \". The LTV ratio determines how much a user can borrow against their collateral. For example, if the LTV ratio for ETH is 75%, a user can borrow up to 75% of the value of their ETH supply position. If the collateral value drops, the LTV ratio increases and when this ration reaches a threshold, the borrower risks liquidation.\"]\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"borrowing-process\",\n      children: \"Borrowing Process\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"After supplying collateral, the user can borrow assets up to the allowed amount based on the LTV ratio.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"The borrower is transferred the underlying tokens that can be used freely. The borrow position accrues interest and supplied collateral tokens cannot be transferred or withdrawn until the borrow position is repaid.\"\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"repayment\",\n      children: \"Repayment\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Borrowers can repay their borrow position at any time. Repayment includes the principal amount borrowed plus the accrued interest.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Once the borrow position is fully repaid, the collateral is unlocked and can be transferred or withdrawn by the supplier.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"liquidations\",\n      children: \"Liquidations\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"When an open borrow position falls below the minimum collateralisation parameters, any user can participate as a liquidator. The liquidator repays the borrow position and receives a portion of the collateral larger than the amount repaid. This creates a competitive and incentivized landscape that maintains the protocol’s overcollateralisation.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"participating-in-aave-governance\",\n      children: \"Participating in Aave Governance\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"The Aave Protocol's governance is driven by the AAVE token holder community, who participate in governance in a structured manner by submitting proposals, open discussion, voting, and smart contract execution. Through the governance process, token holders shape the future of the protocol, making a variety of decisions such as protocol upgrades, enhancements, and more.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"participating-in-the-aave-safety-module\",\n      children: \"Participating in the Aave Safety Module\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Participants in the Aave Safety Module earn incentives for supplying tokens that backstop the protocol in the event of a shortfall. This mechanism helps protect the protocol from unforeseen risks and market volatility, and helps maintain the stability of the ecosystem.\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = {\n    ..._provideComponents(),\n    ...props.components\n  };\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\n","frontmatter":{"date":"9 Aug, 2024","category":"aave-101","title":"Introduction To Aave V3","description":"Introduction to the Aave V3 Protocol.","difficulty":0,"index":1},"scope":{}}},"posts":[{"slug":"introduction-to-aave","date":"9 Aug, 2024","category":"aave-101","title":"Introduction To Aave V3","description":"Introduction to the Aave V3 Protocol.","difficulty":0,"index":1,"mdxSource":{"compiledSource":"\"use strict\";\nconst {Fragment: _Fragment, jsx: _jsx, jsxs: _jsxs} = arguments[0];\nconst {useMDXComponents: _provideComponents} = arguments[0];\nfunction _createMdxContent(props) {\n  const _components = {\n    em: \"em\",\n    h2: \"h2\",\n    h3: \"h3\",\n    li: \"li\",\n    p: \"p\",\n    strong: \"strong\",\n    ul: \"ul\",\n    ..._provideComponents(),\n    ...props.components\n  };\n  return _jsxs(_Fragment, {\n    children: [_jsx(_components.h2, {\n      id: \"introduction-to-aave-v3\",\n      children: \"Introduction to Aave V3\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: _jsx(_components.em, {\n        children: \"This guide refers to Aave V3, the version of the protocol currently in production.\"\n      })\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"The Aave V3 Protocol is a collection of smart contracts that facilitates overcollateralised borrowing of digital assets. The protocol is deployed on Ethereum, Polygon, Avalanche, BNB Chain, Fantom, and Harmony networks, as well as Layer 2 chains including Base, Arbitrum, Optimism, Gnosis, Base, Scroll, Metis, and ZKsync Era.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Aave allows users to supply and borrow cryptocurrencies without the need of a central authority or intermediary. The protocol is comprised of publicly accessible, self-executing smart contracts that are deployed on various permissionless public blockchains. Users interact with the Aave Protocol by submitting transactions to the blockchain using self-custodial wallets.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"supply\",\n      children: \"Supply\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"By supplying tokens to Aave, users can earn interest on their assets while contributing to the protocol’s liquidity. These supplied assets are “pooled” and can also be utilised as collateral for borrowing while continuing to earn interest.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Suppliers, also known as liquidity providers, supply their cryptocurrency into Aave's liquidity pools.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Here's how it works:\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"A user selects a supported cryptocurrency (e.g., ETH, USDC) and supplies it into the Aave Protocol.\"\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"Upon supplying, the address receives a corresponding amount of \", _jsx(_components.strong, {\n          children: _jsx(_components.em, {\n            children: \"aTokens\"\n          })\n        }), \" (e.g., aETH, aUSDC) in return. These tokens represent the addresses share in the pool and start accruing interest automatically.\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"The interest earned by liquidity providers is not fixed and varies depending on the \", _jsx(_components.strong, {\n        children: _jsx(_components.em, {\n          children: \"utilisation rate\"\n        })\n      }), \" of the asset in the pool. The utilisation rate is the percentage of the total pool that is currently borrowed.\"]\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"High Utilisation Rate\"\n        }), \": if a large portion of the pool is being borrowed, the interest rate increases. This incentivizes supplies, borrow repayments, and disincentivizes further borrowing.\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Low Utilisation Rate\"\n        }), \": if most of the pool is idle, the interest rate decreases, reflecting the lower demand for borrowing that asset.\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Interest is accrued continuously and is added to the suppliers aTokens automatically. In other words, over time the balance of aTokens increases, allowing the supplier to redeem the enhanced value of their supply position.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Suppliers can withdraw their tokens at any time alongside the accrued interest as long as there is available (unborrowed) liquidity in the token pool. This is done by burning the aTokens, which triggers the return of the corresponding amount of the underlying asset from the pool.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"borrow\",\n      children: \"Borrow\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Supplied tokens can be utilised as collateral to borrow against. The collateral must be greater in value than the borrowed amount, a concept known as overcollateralisation. If the assets supplied as collateral drop under the minimum collateralisation threshold, the position could face liquidation.\"\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"collateralisation\",\n      children: \"Collateralisation\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"To borrow assets from Aave, a user must first supply collateral. This collateral can be any cryptocurrency supported within the protocol. The value of the collateral must always exceed the value of the amount borrowed. Overcollateralisation is a safeguard to protect the protocol against market volatility. For example, if a user wants to borrow $100 worth of GHO, they might be required to supply $150 worth of ETH as the collateral, depending on specific Loan-to-Value (LTV) collateral requirements.\"\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"loan-to-value-ltv-ratio\",\n      children: \"Loan-to-Value (LTV) Ratio\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"Each type of collateral has a specific \", _jsx(_components.strong, {\n        children: \"LTV ratio\"\n      }), \". The LTV ratio determines how much a user can borrow against their collateral. For example, if the LTV ratio for ETH is 75%, a user can borrow up to 75% of the value of their ETH supply position. If the collateral value drops, the LTV ratio increases and when this ration reaches a threshold, the borrower risks liquidation.\"]\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"borrowing-process\",\n      children: \"Borrowing Process\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"After supplying collateral, the user can borrow assets up to the allowed amount based on the LTV ratio.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"The borrower is transferred the underlying tokens that can be used freely. The borrow position accrues interest and supplied collateral tokens cannot be transferred or withdrawn until the borrow position is repaid.\"\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"repayment\",\n      children: \"Repayment\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Borrowers can repay their borrow position at any time. Repayment includes the principal amount borrowed plus the accrued interest.\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Once the borrow position is fully repaid, the collateral is unlocked and can be transferred or withdrawn by the supplier.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"liquidations\",\n      children: \"Liquidations\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"When an open borrow position falls below the minimum collateralisation parameters, any user can participate as a liquidator. The liquidator repays the borrow position and receives a portion of the collateral larger than the amount repaid. This creates a competitive and incentivized landscape that maintains the protocol’s overcollateralisation.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"participating-in-aave-governance\",\n      children: \"Participating in Aave Governance\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"The Aave Protocol's governance is driven by the AAVE token holder community, who participate in governance in a structured manner by submitting proposals, open discussion, voting, and smart contract execution. Through the governance process, token holders shape the future of the protocol, making a variety of decisions such as protocol upgrades, enhancements, and more.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"participating-in-the-aave-safety-module\",\n      children: \"Participating in the Aave Safety Module\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Participants in the Aave Safety Module earn incentives for supplying tokens that backstop the protocol in the event of a shortfall. This mechanism helps protect the protocol from unforeseen risks and market volatility, and helps maintain the stability of the ecosystem.\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = {\n    ..._provideComponents(),\n    ...props.components\n  };\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\n","frontmatter":{"date":"9 Aug, 2024","category":"aave-101","title":"Introduction To Aave V3","description":"Introduction to the Aave V3 Protocol.","difficulty":0,"index":1},"scope":{}},"readingTime":8},{"slug":"accessing-aave","date":"9 Aug, 2024","category":"aave-101","title":"Accessing Aave","description":"Accessing the Aave Protocol.","difficulty":0,"index":2,"mdxSource":{"compiledSource":"\"use strict\";\nconst {Fragment: _Fragment, jsx: _jsx, jsxs: _jsxs} = arguments[0];\nconst {useMDXComponents: _provideComponents} = arguments[0];\nfunction _createMdxContent(props) {\n  const _components = {\n    a: \"a\",\n    h2: \"h2\",\n    h3: \"h3\",\n    li: \"li\",\n    p: \"p\",\n    strong: \"strong\",\n    ul: \"ul\",\n    ..._provideComponents(),\n    ...props.components\n  };\n  return _jsxs(_Fragment, {\n    children: [_jsx(_components.h2, {\n      id: \"introduction\",\n      children: \"Introduction\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Aave is an open protocol, and users can interact with Aave through a variety of user-friendly interfaces, or directly with its smart contracts. This openness also enables the creation of third-party services or applications that integrate with the protocol.\"\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"interfaces\",\n      children: \"Interfaces\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"There are multiple interfaces available to access the Aave Protocol. Below are just a few examples:\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [\"The Aave Interface located at \", _jsx(_components.a, {\n          href: \"https://app.aave.com/\",\n          children: \"app.aave.com\"\n        }), \" – an interface hosted on IPFS, maintained by Aave Labs\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.a, {\n          href: \"https://app.defisaver.com/aave\",\n          children: \"DeFi Saver\"\n        }), \": all the protocol functionalities, combined withleverage and auto liquidation (repayment with collateral)\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"Flash Loans, supply and withdrawal from the \", _jsx(_components.a, {\n          href: \"https://furucombo.app/\",\n          children: \"Furucombo\"\n        }), \" interface\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"Supply and withdraw from the \", _jsx(_components.a, {\n          href: \"https://www.argent.xyz/\",\n          children: \"Argent wallet\"\n        })]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"Manage positions via smart accounts with the \", _jsx(_components.a, {\n          href: \"https://console.brahma.fi/\",\n          children: \"Brahma Console\"\n        })]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"Asset management on \", _jsx(_components.a, {\n          href: \"https://www.fireblocks.com/\",\n          children: \"Fireblocks\"\n        })]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [\"All actions are available directly through the protocol’s smart contracts, which can be accessed through block explorers or code, by following the guidelines available in the \", _jsx(_components.a, {\n          href: \"https://aave.com/docs\",\n          children: \"docs\"\n        })]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"deployments\",\n      children: \"Deployments\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"All official deployments of the Aave Protocol are approved through community governance. The protocol is currently deployed on the following blockchain networks:\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Mainnet\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"Ethereum Core (V3, V2, V1)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Ethereum Prime (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Ethereum EtherFi (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Polygon (V3, V2)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Avalanche C-Chain (V3, V2)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Arbitrum (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Optimism (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Base (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"BNB Chain (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Scroll (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Metis (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Gnosis (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"ZKsync Era (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Linea (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Sonic (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Celo (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Soneium (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Plasma (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Fantom (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Harmony (V3)\"\n      }), \"\\n\"]\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"The Ethereum \", _jsx(_components.strong, {\n        children: \"Core\"\n      }), \" market serves as the most liquid and risk-adjusted environment for a diverse range of assets, while the Ethereum \", _jsx(_components.strong, {\n        children: \"Prime\"\n      }), \" market is dedicated to blue-chip collaterals and high-leverage, correlated assets.\"]\n    }), \"\\n\", _jsx(_components.h3, {\n      id: \"testnet\",\n      children: \"Testnet\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"Ethereum Sepolia (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Arbitrum Sepolia (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Base Sepolia (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Scroll Sepolia (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Optimism Sepolia (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Avalanche Fuji (V3)\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"Fantom Testnet (V3)\"\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.h2, {\n      id: \"notice\",\n      children: \"Notice\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Beware of scams: Aave never advertises on any social media platform or search engine and does not have any downloadable mobile application available. Aave Protocol will never ask for your wallet seed phrase. Should you encounter any of these suspicious instances, do not interact with them.\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = {\n    ..._provideComponents(),\n    ...props.components\n  };\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\n","frontmatter":{"date":"9 Aug, 2024","category":"aave-101","title":"Accessing Aave","description":"Accessing the Aave Protocol.","difficulty":0,"index":2},"scope":{}},"readingTime":4}]},"__N_SSG":true},"page":"/help/[guide]/[slug]","query":{"guide":"aave-101","slug":"introduction-to-aave"},"buildId":"xSmqNdaBUuKhYEjAY3H-6","isFallback":false,"gsp":true,"scriptLoader":[]}</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a37886192a6fe75d',t:'MTc4ODgxMzU3Nw=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);"