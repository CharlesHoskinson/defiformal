r.png\"] {\n  width: 18px;\n  height: 18px;\n  object-fit: contain;\n  filter: grayscale(1) opacity(0.68);\n}\n\n.group:hover img[src*=\"raydium-r.png\"] {\n  filter: brightness(0) invert(1);\n  background-color: transparent;\n}\n.group:hover \u003e div:has(\u003e img[src*=\"raydium-r.png\"]) {\n  background-color: #8C6EFF;\n}\n\n/* ===================================================================== */\n/* Suppress Mintlify chrome on the homepage (where .rd-home is rendered) */\n/* Uses :has() — supported in all modern browsers (Chrome 105+, Safari 15.4+, Firefox 121+) */\n/* ===================================================================== */\n\n/* Hide Mintlify's topbar, sidebar, tab bar, footer, and the right-rail TOC\n   on any page that contains the .rd-home wrapper. */\nhtml:has(.rd-home) header,\nhtml:has(.rd-home) #header,\nhtml:has(.rd-home) [class*=\"Header\"],\nhtml:has(.rd-home) [data-element*=\"header\"],\nhtml:has(.rd-home) aside,\nhtml:has(.rd-home) #sidebar,\nhtml:has(.rd-home) [class*=\"Sidebar\"],\nhtml:has(.rd-home) [class*=\"sidebar\"],\nhtml:has(.rd-home) nav[class*=\"tab\"],\nhtml:has(.rd-home) nav[class*=\"Tab\"],\nhtml:has(.rd-home) [class*=\"TabBar\"],\nhtml:has(.rd-home) [class*=\"tab-bar\"],\nhtml:has(.rd-home) #navbar,\nhtml:has(.rd-home) footer,\nhtml:has(.rd-home) [class*=\"Footer\"],\nhtml:has(.rd-home) [class*=\"TableOfContents\"],\nhtml:has(.rd-home) [class*=\"toc\"],\nhtml:has(.rd-home) #table-of-contents,\nhtml:has(.rd-home) .pagination,\nhtml:has(.rd-home) [class*=\"Pagination\"],\nhtml:has(.rd-home) [class*=\"Breadcrumb\"],\nhtml:has(.rd-home) .breadcrumbs {\n  display: none !important;\n}\n\n/* Neutralize only the outer app shell Mintlify imposes on the content area\n   so .rd-home can fill the viewport edge-to-edge.\n   Keep this list intentionally narrow: broad class-name matching can\n   accidentally strip spacing from real homepage content blocks. */\nhtml:has(.rd-home),\nhtml:has(.rd-home) body,\nhtml:has(.rd-home) #__next,\nhtml:has(.rd-home) #root,\nhtml:has(.rd-home) main,\nhtml:has(.rd-home) article,\nhtml:has(.rd-home) \u003e body \u003e div,\nhtml:has(.rd-home) \u003e body \u003e div \u003e div {\n  padding: 0 !important;\n  margin: 0 !important;\n  max-width: none !important;\n  width: 100% !important;\n  border: 0 !important;\n}\n\n/* Clear any remaining top spacing on the immediate wrapper that contains\n   the custom homepage. This is especially important on mobile, where the\n   docs shell may reserve space for Mintlify's own header. */\nhtml:has(.rd-home) *:has(\u003e .rd-home) {\n  padding-top: 0 !important;\n  margin-top: 0 !important;\n}\n\n/* Mintlify may render the homepage inside a shell node with Tailwind utility\n   classes like `pt-[120px]` to reserve space for its own header. On our custom\n   homepage that header is hidden, so this top padding becomes a visible blank\n   band on mobile. Override that utility only when `.rd-home` is present. */\nhtml:has(.rd-home) .pt-\\[120px\\] {\n  padding-top: 0 !important;\n}\n\n/* Match the page color across all root elements — any sliver that escapes the\n   .rd-home wrapper still looks like the design's bg, not a black bar. */\nhtml:has(.rd-home),\nhtml:has(.rd-home) body,\nhtml:has(.rd-home) #__next,\nhtml:has(.rd-home) #root,\nhtml:has(.rd-home) main {\n  background: #0A0514 !important;\n}\n\nhtml:has(.rd-home) {\n  overflow-x: hidden !important;\n}\n\nhtml:has(.rd-home) body {\n  overflow-x: hidden !important;\n  min-height: 100vh;\n}\n\n/* Reset ::before / ::after pseudo-elements Mintlify might use for decorative borders */\nhtml:has(.rd-home) body::before,\nhtml:has(.rd-home) body::after,\nhtml:has(.rd-home) main::before,\nhtml:has(.rd-home) main::after {\n  display: none !important;\n}\n\n/* .rd-home fills its (now-unconstrained, thanks to mode:\"custom\") parent.\n   No more vw/negative-margin tricks — the wrapper above is already full-width. */\n.rd-home {\n  position: relative !important;\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  left: 0 !important;\n  right: 0 !important;\n}\n\n:root {\n  --rd-purple: #8C6EFF;\n  --rd-purple-light: #A88BFF;\n  --rd-purple-dark: #5E3BE1;\n  --rd-cyan: #60D5FF;\n  --rd-pink: #FF60D5;\n  --rd-amber: #FFBB4C;\n  --rd-green: #4ADE80;\n  --rd-bg: #0A0514;\n  --rd-bg-surf: #140C28;\n  --rd-bg-elev: #1A1330;\n  --rd-bg-hover: #231A3C;\n  --rd-border: rgba(140, 110, 255, 0.18);\n  --rd-border-strong: rgba(140, 110, 255, 0.32);\n  --rd-text: #FFFFFF;\n  --rd-text-2: #B8B0D9;\n  --rd-text-3: #8279A4;\n  --rd-shadow-soft: 0 20px 60px rgba(0, 0, 0, 0.28);\n  --rd-shell-max: 1580px;\n  --rd-space-1: 16px;\n  --rd-space-2: 24px;\n  --rd-space-3: 36px;\n  --rd-space-4: 52px;\n  --rd-space-5: 72px;\n  --rd-space-6: 96px;\n  --rd-space-7: 128px;\n}\n/* Color theming helper classes (replaces inline style={{color: ...}}).\n   Prefixed with .rd-home so specificity (0,2,0) wins over .rd-home a (0,1,1)\n   from the link reset — otherwise the accent color never reaches icons. */\n.rd-home .rd-c-purple { color: var(--rd-purple); }\n.rd-home .rd-c-cyan   { color: var(--rd-cyan); }\n.rd-home .rd-c-green  { color: var(--rd-green); }\n.rd-home .rd-c-amber  { color: var(--rd-amber); }\n.rd-home .rd-c-pink   { color: var(--rd-pink); }\n\n/* Always-white text inside accent-colored cards */\n.rd-track__title, .rd-product__label, .rd-comm__title { color: var(--rd-text); }\n\n/* Responsive visibility helpers — let MDX inline different copy/components per viewport.\n   Use .rd-only-desktop on content that should ONLY appear on \u003e=769px,\n   and .rd-only-mobile on content that should ONLY appear on \u003c=768px. */\n.rd-only-mobile { display: none; }\n.rd-only-desktop { display: inline; }\n\n.rd-home, .rd-home * { box-sizing: border-box; }\n.rd-home {\n  background: var(--rd-bg);\n  color: var(--rd-text);\n  font-family: -apple-system, BlinkMacSystemFont, \"Inter\", \"Segoe UI\", Roboto, sans-serif;\n  font-size: 16px;\n  line-height: 1.5;\n  overflow-x: hidden;\n}\n.rd-home a { color: inherit; text-decoration: none; }\n.rd-home p, .rd-home h1, .rd-home h2, .rd-home h3, .rd-home h4 { margin: 0; }\n.rd-home button { font-family: inherit; cursor: pointer; }\n.rd-home input, .rd-home textarea, .rd-home select, .rd-home button { font: inherit; }\n\n/* Restore intentional spacing for elements that need a bottom margin.\n   The blanket `.rd-home p { margin: 0 }` reset above has the same specificity\n   (0,1,1) as Mintlify's own `\u003cp\u003e` rules, so without these explicit overrides\n   the eyebrow/title margins below would also be flattened to 0. Prefixing\n   with `.rd-home` bumps specificity to (0,2,0) and wins. */\n.rd-home .rd-eyebrow-tx { margin: 0 0 14px; }\n.rd-home .rd-section__title { margin: 0 0 18px; }\n.rd-home .rd-section__sub { margin: 0; }\n.rd-home .rd-qs__title { margin: 0 0 16px; }\n.rd-home .rd-qs__desc { margin: 0 0 28px; }\n.rd-home .rd-aistrip__title { margin: 0 0 8px; }\n.rd-home .rd-aistrip__desc { margin: 0; }\n.rd-home .rd-footer__brand-desc { margin: 14px 0; }\n\n.rd-hero-zone {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  background: #0A0514;\n}\n\n.rd-hero-zone::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse 166.67% 166.67% at -93.33% -153.33%, rgba(255, 186.91, 75.99, 0.10) 0%, rgba(255, 186.91, 75.99, 0) 100%),\n    radial-gradient(ellipse 111.11% 100% at -77.78% 64%, rgba(95.88, 212.92, 255, 0.20) 0%, rgba(95.88, 212.92, 255, 0) 100%),\n    radial-gradient(ellipse 111.11% 100% at 71.11% 70%, rgba(255, 95.88, 212.92, 0.18) 0%, rgba(255, 95.88, 212.92, 0) 100%),\n    radial-gradient(ellipse 111.11% 100% at 17.78% 40%, rgba(140, 109.90, 255, 0.30) 0%, rgba(140, 109.90, 255, 0) 100%),\n    radial-gradient(ellipse 58.82% 55.56% at 0% 64.44%, rgba(94.09, 58.91, 224.91, 0.45) 0%, rgba(94.09, 58.91, 224.91, 0) 100%),\n    #0A0514;\n  z-index: 0;\n}\n\n.rd-nav,\n.rd-hero {\n  position: relative;\n}\n.rd-hero { z-index: 1; }\n.rd-nav { z-index: 2; }\n\n.rd-nav {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  padding: 20px 64px;\n  width: 100%;\n  max-width: none;\n  margin: 0;\n  min-height: 74px;\n  background: linear-gradient(180deg, rgba(19.52, 0.52, 25.37, 0.35) 0%, rgba(9, 1, 11, 0) 100%);\n  -webkit-backdrop-filter: blur(8px);\n  backdrop-filter: blur(8px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.30), 0 12px 32px rgba(140, 109.90, 255, 0.10);\n}\n.rd-nav__brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }\n.rd-nav__logo { display: block; height: 28px; width: auto; }\n/* Legacy CSS-drawn brand mark — kept for non-English locales until they\n   re-translate from the English index.mdx, which now uses .rd-nav__logo. */\n.rd-nav__mark { width: 32px; height: 32px; border-radius: 8px; background: #8C6EFF; display: grid; place-items: center; font-weight: 700; font-size: 18px; color: #fff; box-shadow: none; }\n.rd-nav__name { font-size: 16px; font-weight: 600; letter-spacing: 0; }\n.rd-nav__links { display: flex; gap: 32px; }\n.rd-nav__links a { font-size: 14px; font-weight: 500; color: #B8B0D9; transition: color 0.15s; }\n.rd-nav__links a:hover { color: var(--rd-text); }\n.rd-nav__links { margin-left: 88px; }\n.rd-nav__right { display: flex; gap: 12px; align-items: center; margin-left: auto; }\n.rd-nav__search { display: flex; align-items: center; gap: 10px; height: 38px; padding: 0 12px; background: #1A1330; border: 1px solid #2A1F4A; border-radius: 8px; font-size: 13px; color: #8279A4; min-width: 258px; line-height: 1; }\n.rd-nav__search input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--rd-text); outline: none; font: inherit; }\n.rd-nav__search input::placeholder { color: #8279A4; opacity: 1; }\n.rd-nav__search input[readonly],\n.rd-hero__search input[readonly] { cursor: pointer; caret-color: transparent; }\n.rd-nav__search-kbd { margin-left: auto; padding: 2px 6px; background: #140C28; border: 1px solid #2A1F4A; border-radius: 4px; font-family: ui-monospace, \"JetBrains Mono\", monospace; font-size: 11px; color: #8279A4; }\n.rd-lang-menu { position: relative; }\n.rd-lang-menu::after { content: \"\"; position: absolute; top: 100%; right: 0; width: 100%; height: 10px; }\n.rd-lang { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px; background: #1A1330; border: 1px solid #2A1F4A; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; user-select: none; color: var(--rd-text); }\n.rd-lang-menu__list { position: absolute; top: calc(100% + 8px); right: 0; min-width: 132px; padding: 8px; display: none; flex-direction: column; gap: 4px; background: #140C28; border: 1px solid #2A1F4A; border-radius: 10px; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.32); z-index: 20; }\n.rd-lang-menu:hover .rd-lang-menu__list,\n.rd-lang-menu:focus-within .rd-lang-menu__list { display: flex; }\n.rd-lang-menu__item { padding: 9px 10px; border-radius: 8px; font-size: 13px; color: var(--rd-text-2); }\n.rd-lang-menu__item:hover,\n.rd-lang-menu__item.is-active { background: #1A1330; color: var(--rd-text); }\n.rd-cta-primary { height: 38px; padding: 0 16px; display: inline-flex; align-items: center; background: #8C6EFF; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; transition: background 0.15s, transform 0.15s; box-shadow: none; }\n.rd-cta-primary:hover { background: var(--rd-purple-light); transform: translateY(-1px); }\n\n.rd-hero { width: 100%; padding: 88px 64px 80px; max-width: 1440px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 32px; }\n.rd-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: var(--rd-bg-elev); border: 1px solid var(--rd-border-strong); border-radius: 999px; font-size: 12px; font-weight: 500; color: var(--rd-text-2); }\n.rd-eyebrow__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--rd-green); box-shadow: 0 0 8px var(--rd-green); }\n.rd-headline { font-size: 72px; font-weight: 700; line-height: 80px; letter-spacing: 0; width: 1100px; max-width: 100%; overflow-wrap: break-word; text-wrap: balance; margin-bottom: 0; }\n.rd-headline br { display: block; }\n.rd-subhead { font-size: 18px; line-height: 28px; color: #B8B0D9; width: 800px; max-width: 100%; margin-bottom: 0; }\n.rd-hero__search { display: inline-flex; align-items: center; gap: 12px; width: 640px; max-width: 100%; min-width: 0; padding: 16px 20px; background: #1A1330; border: 1px solid #3C2D64; border-radius: 12px; font-size: 15px; color: #8279A4; box-shadow: none; margin-bottom: 0; }\n.rd-hero__search input { flex: 1; border: none; background: none; font: inherit; color: var(--rd-text); outline: none; }\n.rd-hero__search input::placeholder { color: #8279A4; }\n.rd-hero__search-ico { font-size: 18px; color: #8279A4; }\n.rd-kbd { padding: 4px 8px; background: #140C28; border: 1px solid #2A1F4A; border-radius: 4px; font-family: ui-monospace, \"JetBrains Mono\", monospace; font-size: 12px; color: #8279A4; }\n.rd-hero__chips { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 0; }\n.rd-hero__chips-label { font-size: 13px; font-weight: 500; color: #8279A4; }\n.rd-chip { padding: 6px 12px; background: #1A1330; border: 1px solid #2A1F4A; border-radius: 999px; font-size: 12px; font-weight: 500; color: #B8B0D9; transition: background 0.15s, color 0.15s; }\n.rd-chip:hover { background: var(--rd-bg-hover); color: var(--rd-text); }\n\n.rd-section { padding: 80px 64px; }\n.rd-section--surf { background: #180d2b; }\n.rd-section--quickstart { padding-top: 80px; padding-bottom: 80px; background: #0A0514; }\n/* Tracks sits flush below the hero — design uses 40px top padding here, not 80px. */\n.rd-section--tracks { padding-top: 40px; padding-bottom: 80px; background: #0A0514; }\n.rd-section--surf { padding-top: 80px; padding-bottom: 80px; background: #140C28; }\n.rd-comm { padding-top: 80px; padding-bottom: 80px; }\n.rd-section__head { text-align: center; max-width: 1160px; margin: 0 auto 28px; display: flex; flex-direction: column; align-items: center; gap: 8px; }\n.rd-section--surf .rd-section__head,\n.rd-comm .rd-section__head { gap: 12px; }\n.rd-eyebrow-tx { font-size: 14px; font-weight: 600; letter-spacing: 0.5px; color: var(--rd-purple); margin-bottom: 0; }\n.rd-eyebrow-tx--cyan { color: var(--rd-cyan); }\n.rd-product__ix-wrap { display: flex; flex-direction: column; gap: 4px; }\n.rd-codewindow__dot--r { background: #FF6B62; }\n.rd-codewindow__dot--y { background: #FFBB2D; }\n.rd-codewindow__dot--g { background: #28C73D; }\n.rd-codewindow__pre code { font: inherit; color: inherit; background: transparent; padding: 0; }\n.rd-comm__card--bb .rd-comm__icon::before { display: none; }\n.rd-section__title { font-size: 36px; font-weight: 700; letter-spacing: 0; line-height: 1.2; margin-bottom: 0; text-wrap: balance; }\n.rd-section__sub { font-size: 16px; line-height: 24px; color: var(--rd-text-2); max-width: 720px; margin-left: auto; margin-right: auto; }\n\n.rd-tracks { display: grid; grid-template-columns: repeat(3, 400px); gap: 24px; max-width: 1248px; margin: 0 auto; }\n.rd-track { display: flex; flex-direction: column; gap: 20px; min-height: 0; padding: 32px 28px; background: #140C28; border: 1px solid #2A1F4A; border-radius: 16px; transition: border-color 0.2s, transform 0.2s, background 0.2s; box-shadow: none; }\n.rd-track:hover { border-color: rgba(140, 110, 255, 0.42); transform: translateY(-2px); background: rgba(30, 19, 52, 0.95); }\n.rd-track__icon { width: 48px; height: 48px; border-radius: 12px; background: color-mix(in srgb, currentColor 16%, transparent); display: inline-flex; align-items: center; justify-content: center; box-shadow: none; }\n.rd-track__icon svg { width: 24px; height: 24px; color: currentColor; }\n.rd-track__title { font-size: 22px; font-weight: 600; }\n.rd-track__desc { font-size: 14px; line-height: 22px; color: var(--rd-text-2); max-width: 344px; }\n.rd-track__cta { font-size: 14px; font-weight: 700; margin-top: auto; }\n\n.rd-products { display: grid; grid-template-columns: repeat(3, 414px); gap: 20px; max-width: 1282px; margin: 0 auto; }\n.rd-product { display: flex; flex-direction: column; gap: 16px; min-height: 0; padding: 28px; background: #1A1330; border: 1px solid #2A1F4A; border-radius: 16px; transition: border-color 0.2s, transform 0.2s, background 0.2s; }\n.rd-product:hover { border-color: rgba(140, 110, 255, 0.38); transform: translateY(-2px); background: rgba(30, 22, 55, 0.92); }\n.rd-product__top { display: flex; align-items: center; justify-content: space-between; }\n.rd-product__name { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 600; }\n.rd-product__dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }\n.rd-product__tag { padding: 4px 10px; background: #140C28; border: 1px solid #2A1F4A; border-radius: 999px; font-size: 11px; font-weight: 500; letter-spacing: 0.3px; }\n.rd-product__desc { font-size: 14px; line-height: 22px; color: var(--rd-text-2); max-width: 358px; }\n.rd-product__ix-label { font-size: 11px; font-weight: 500; letter-spacing: 0.5px; color: var(--rd-text-3); text-transform: none; margin-bottom: 0; }\n.rd-product__ix { font-family: ui-monospace, \"JetBrains Mono\", monospace; font-size: 12px; color: #b7a9ff; }\n.rd-product__cta { font-size: 13px; font-weight: 600; margin-top: auto; padding-top: 8px; }\n\n.rd-quickstart { display: flex; justify-content: space-between; align-items: center; gap: 48px; max-width: 1312px; margin: 0 auto; }\n.rd-quickstart__copy { width: 560px; flex: 0 0 560px; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }\n.rd-qs__title { font-size: 40px; font-weight: 700; line-height: 48px; letter-spacing: 0; margin-bottom: 0; max-width: 560px; }\n.rd-qs__desc { font-size: 16px; line-height: 26px; color: var(--rd-text-2); margin-bottom: 0; max-width: 560px; }\n.rd-qs__btns { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 12px; }\n.rd-btn-primary { padding: 14px 24px; background: var(--rd-purple); color: #fff; border: none; border-radius: 10px; font-size: 14px; font-weight: 600; transition: background 0.15s, transform 0.15s; display: inline-block; }\n.rd-btn-primary:hover { background: var(--rd-purple-light); transform: translateY(-1px); }\n.rd-btn-ghost { padding: 14px 24px; background: transparent; color: var(--rd-text); border: 1px solid #3C2D64; border-radius: 10px; font-size: 14px; font-weight: 600; transition: background 0.15s; display: inline-block; }\n.rd-btn-ghost:hover { background: var(--rd-bg-elev); }\n\n.rd-codewindow { border: 1px solid #2A1F4A; border-radius: 14px; overflow: hidden; background: #140C28; box-shadow: none; min-height: 0; width: 704px; flex: 0 0 704px; }\n.rd-codewindow__bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; min-height: 48px; background: #1A1330; border-bottom: 1px solid #2A1F4A; }\n.rd-codewindow__dot { width: 12px; height: 12px; border-radius: 50%; }\n.rd-codewindow__dot--r { background: #FF6B63; }\n.rd-codewindow__dot--y { background: #FFBD2E; }\n.rd-codewindow__dot--g { background: #29C75C; }\n.rd-codewindow__filename { margin-left: auto; font-family: ui-monospace, \"JetBrains Mono\", monospace; font-size: 12px; line-height: 1; color: #8279A4; letter-spacing: 0; }\n.rd-codewindow__pre { margin: 0; padding: 21px 24px 19px; min-height: 444px; font-family: ui-monospace, \"JetBrains Mono\", monospace; font-size: 13px; font-weight: 400; line-height: 20px; color: #FFFFFF; overflow-x: auto; white-space: pre; }\n.rd-codewindow__line { display: block; min-height: 20px; color: #FFFFFF; }\n.rd-codewindow__line--comment { color: #8279A4; }\n.rd-codewindow__line--accent { color: #A88BFF; }\n.rd-codewindow__line--muted { color: #B8B0D9; }\n.rd-codewindow__line--success { color: #4ADE80; }\n.rd-c1 { color: var(--rd-text-3); }\n.rd-c2 { color: var(--rd-purple-light); }\n.rd-c3 { color: var(--rd-text-2); }\n.rd-c4 { color: var(--rd-green); }\n\n.rd-aistrip { background: radial-gradient(ellipse 125% 83.33% at 100% 66.67%, rgba(140, 109, 255, 0.10) 0%, rgba(140, 109, 255, 0) 100%), radial-gradient(ellipse 90.91% 58.82% at -63.64% -41.18%, rgba(96, 213, 255, 0.16) 0%, rgba(96, 213, 255, 0) 100%), #140C28; }\n.rd-aistrip__inner { max-width: 1440px; margin: 0 auto; padding: 56px 64px; display: grid; grid-template-columns: 720px 1fr; gap: 48px; align-items: center; }\n.rd-aistrip__copy { width: 720px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }\n.rd-aistrip__title { font-size: 28px; font-weight: 700; letter-spacing: 0; margin-bottom: 0; }\n.rd-aistrip__desc { font-size: 14px; line-height: 22px; color: var(--rd-text-2); max-width: 720px; }\n.rd-aistrip__tools { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }\n.rd-tool-pill { padding: 10px 16px; background: #0A0514; border: 1px solid #3C2D64; border-radius: 10px; font-size: 13px; font-weight: 600; }\n\n.rd-comm { background-image: radial-gradient(ellipse 80% 80% at 50% 50%, rgba(140, 110, 255, 0.08), transparent 70%); }\n.rd-comm__grid { display: grid; grid-template-columns: repeat(4, 308px); gap: 20px; max-width: 1292px; margin: 0 auto; }\n.rd-comm__card { display: flex; flex-direction: column; gap: 14px; min-height: 0; padding: 24px; background: #140C28; border: 1px solid #2A1F4A; border-radius: 14px; transition: border-color 0.2s, transform 0.2s; }\n.rd-comm__card:hover { border-color: var(--rd-border-strong); transform: translateY(-2px); }\n.rd-comm__icon { width: 38px; height: 38px; border-radius: 10px; background: color-mix(in srgb, currentColor 18%, transparent); display: inline-flex; align-items: center; justify-content: center; }\n.rd-comm__icon::before { display: none; }\n.rd-comm__icon svg { width: 22px; height: 22px; color: currentColor; }\n.rd-comm__icon img { display: none; }\n.rd-comm__card.is-bb .rd-comm__icon::before { display: none; }\n.rd-comm__title { font-size: 18px; font-weight: 600; }\n.rd-comm__desc { font-size: 13px; line-height: 20px; color: var(--rd-text-2); }\n.rd-comm__text { display: flex; flex-direction: column; gap: 4px; }\n\n.rd-footer { background: #140C28; padding: 56px 64px 32px; }\n.rd-footer__top { display: grid; grid-template-columns: 360px repeat(4, 160px); gap: 38px; max-width: 1312px; margin: 0 auto 32px; }\n.rd-footer__brand-desc { font-size: 13px; line-height: 1.55; color: var(--rd-text-2); margin: 14px 0; max-width: 340px; }\n.rd-footer__socials { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 8px; }\n.rd-footer__social { padding: 8px 12px; background: #1A1330; border: 1px solid #2A1F4A; border-radius: 8px; font-size: 12px; font-weight: 500; color: var(--rd-text-2); }\n.rd-footer__col h4 { font-size: 13px; font-weight: 600; letter-spacing: 0.4px; margin-bottom: 14px; }\n.rd-footer__col a { display: block; font-size: 13px; color: var(--rd-text-2); padding: 0 0 12px; }\n.rd-footer__col a:hover { color: var(--rd-text); }\n.rd-footer__divider { height: 1px; background: #2A1F4A; max-width: 1312px; margin: 0 auto; }\n.rd-footer__bot { max-width: 1312px; width: 100%; margin: 24px auto 0; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--rd-text-3); }\n\n@media (max-width: 768px) {\n  .rd-only-mobile { display: inline; }\n  .rd-only-desktop { display: none !important; }\n  .rd-nav { padding: 12px 16px; max-width: none; background: rgba(21, 13, 36, 0.68); }\n  .rd-nav__brand { gap: 8px; }\n  .rd-nav__logo { height: 18px; }\n  .rd-nav__mark { width: 15px; height: 15px; font-size: 9px; border-radius: 4px; }\n  .rd-nav__name { font-size: 11px; }\n  .rd-nav__links, .rd-nav__search, .rd-cta-primary { display: none; }\n  .rd-lang-menu__list { right: 0; min-width: 116px; padding: 6px; }\n  .rd-lang { padding: 0 6px; height: 28px; gap: 3px; font-size: 10px; border-radius: 8px; }\n  /* Mobile hero design (Figma 4:14): top 48 / bottom 32 — was 40/48. */\n  .rd-hero { padding: 50px 20px 34px; gap: 16px; }\n  /* Mobile design (Figma 4:18): wraps to 2 lines in a 350px column —\n     28px Bold lets \"Build, integrate, and / trade on Raydium.\" break naturally. */\n  .rd-headline { font-size: 28px; line-height: 1.18; letter-spacing: -0.6px; width: auto; max-width: 332px; margin-bottom: 0; }\n  .rd-headline br { display: none; }\n  .rd-subhead br { display: none; }\n  .rd-subhead { font-size: 12px; line-height: 1.55; width: auto; max-width: 310px; margin-bottom: 0; }\n  .rd-hero__search { width: 100%; min-width: 0; max-width: 304px; padding: 12px 14px; font-size: 12px; border-radius: 10px; margin-bottom: 0; }\n  .rd-hero__search-ico { font-size: 14px; }\n  .rd-kbd { display: none; }\n  .rd-hero__chips { display: none; }\n  .rd-hero__ctas-mobile { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 304px; }\n  .rd-hero__ctas-mobile .rd-btn-primary, .rd-hero__ctas-mobile .rd-btn-ghost { width: 100%; text-align: center; }\n  .rd-hero__ctas-mobile .rd-btn-primary { padding: 13px 18px; border-radius: 10px; font-size: 13px; }\n  .rd-hero__ctas-mobile .rd-btn-ghost { padding: 0; background: transparent; border: 0; font-size: 12px; color: rgba(255,255,255,0.78); }\n  /* Mobile sections design: 40 top / 48 bottom (Figma 4:53/4:111).\n     Tracks overrides top to 32. Community overrides bottom to 40. */\n  .rd-section { padding: 52px 20px 64px; }\n  .rd-section--quickstart { padding-top: 44px; padding-bottom: 64px; }\n  .rd-section--tracks { padding-top: 44px; padding-bottom: 64px; }\n  .rd-section--surf { padding-top: 44px; padding-bottom: 64px; }\n  .rd-comm { padding-bottom: 40px; }\n  .rd-section__head { margin-bottom: 32px; }\n  .rd-section__title { font-size: 20px; line-height: 1.18; letter-spacing: -0.35px; max-width: 320px; margin-left: auto; margin-right: auto; }\n  .rd-section__sub { font-size: 12px; line-height: 1.55; max-width: 280px; }\n  .rd-eyebrow-tx { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 10px; }\n  .rd-tracks { grid-template-columns: 1fr; gap: 10px; }\n  .rd-track { flex-direction: row; flex-wrap: wrap; min-height: 0; padding: 18px 14px; gap: 12px; border-radius: 12px; }\n  .rd-track__icon { width: 10px; height: 10px; margin-top: 6px; border-radius: 999px; background: currentColor; }\n  .rd-track__icon svg { display: none; }\n  .rd-track__title { font-size: 16px; flex: 1; align-self: center; }\n  .rd-track__desc { width: 100%; font-size: 11px; line-height: 1.55; }\n  .rd-track__cta { font-size: 11px; }\n  .rd-products { grid-template-columns: 1fr; gap: 10px; }\n  .rd-product { min-height: 0; padding: 16px 14px 15px; gap: 10px; border-radius: 12px; }\n  .rd-product__name { font-size: 15px; }\n  .rd-product__tag { font-size: 9px; padding: 2px 7px; }\n  .rd-product__desc { font-size: 11px; line-height: 1.52; }\n  .rd-product__cta { font-size: 11px; }\n  /* Design hides the Instructions row on mobile to keep cards compact (Figma: Mobile / Homepage · EN) */\n  .rd-product__ix-wrap { display: none; }\n  .rd-quickstart { flex-direction: column; gap: 28px; }\n  .rd-quickstart__copy { width: 100%; flex: 0 0 auto; }\n  .rd-qs__title { font-size: 20px; line-height: 1.2; max-width: 230px; margin-left: auto; margin-right: auto; text-align: center; word-spacing: normal; letter-spacing: -0.02em; }\n  .rd-qs__desc { font-size: 11px; line-height: 1.55; text-align: center; max-width: 300px; margin-left: auto; margin-right: auto; }\n  .rd-quickstart__copy { text-align: center; }\n  /* Mobile design centers the single primary CTA — ghost \"View on GitHub\" is hidden */\n  .rd-qs__btns { justify-content: center; }\n  .rd-qs__btns .rd-btn-primary { width: auto; min-width: 172px; padding: 11px 16px; font-size: 12px; text-align: center; border-radius: 10px; }\n  .rd-codewindow { border-radius: 12px; min-height: 0; }\n  .rd-codewindow__bar { padding: 10px 12px; }\n  .rd-codewindow__dot { width: 8px; height: 8px; }\n  .rd-codewindow__filename { font-size: 10px; }\n  .rd-codewindow__pre { padding: 14px 12px; font-size: 10px; line-height: 1.65; }\n  .rd-aistrip__inner { grid-template-columns: 1fr; padding: 36px 20px; gap: 18px; text-align: center; }\n  .rd-aistrip__copy { width: auto; }\n  .rd-aistrip__title { font-size: 18px; line-height: 1.28; }\n  .rd-aistrip__desc { font-size: 11px; line-height: 1.55; max-width: 306px; margin: 0 auto; }\n  .rd-aistrip__tools { justify-content: center; gap: 8px; }\n  .rd-tool-pill { padding: 7px 10px; font-size: 10px; border-radius: 9px; }\n  .rd-comm__grid { grid-template-columns: 1fr; gap: 10px; }\n  .rd-comm__card { flex-direction: row; gap: 12px; min-height: 0; padding: 16px 14px; align-items: flex-start; border-radius: 12px; }\n  .rd-comm__icon { flex: 0 0 10px; height: 10px; width: 10px; margin-top: 5px; border-radius: 999px; background: currentColor; }\n  .rd-comm__icon svg { display: none; }\n  .rd-comm__title { font-size: 13px; }\n  .rd-comm__desc { font-size: 11px; line-height: 1.5; }\n  .rd-footer { padding: 26px 20px 22px; }\n  .rd-footer__top { grid-template-columns: 1fr; gap: 24px; }\n  .rd-footer__brand-desc { font-size: 11px; line-height: 1.55; margin: 10px 0 12px; max-width: 280px; }\n  .rd-footer__socials { gap: 8px; }\n  .rd-footer__social { padding: 7px 10px; font-size: 10px; }\n  .rd-footer__cols-desktop { display: none; }\n  .rd-footer__cols-mobile { display: flex; flex-direction: column; gap: 10px; }\n  .rd-footer__row { display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; background: rgba(17, 11, 30, 0.8); border: 1px solid rgba(140, 110, 255, 0.18); border-radius: 10px; font-size: 12px; font-weight: 600; }\n  .