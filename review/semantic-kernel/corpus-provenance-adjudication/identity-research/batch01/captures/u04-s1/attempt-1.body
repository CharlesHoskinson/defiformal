i,{children:[_jsx(_components.strong,{children:`Source-code availability.`}),` Of the on-chain programs above, only `,_jsx(_components.code,{children:`raydium-amm`}),` (AMM v4), `,_jsx(_components.code,{children:`raydium-cp-swap`}),` (CPMM), and `,_jsx(_components.code,{children:`raydium-clmm`}),` (CLMM) ship with public source repositories under `,_jsx(_components.a,{href:`https://github.com/raydium-io`,children:_jsx(_components.code,{children:`github.com/raydium-io`})}),`. Stable AMM, LaunchLab, AMM Routing, Burn \u0026 Earn / LP Lock, and the Farm programs are not publicly available — verify them against the live API, the on-chain bytecode, and the published IDLs in `,_jsx(_components.a,{href:`https://github.com/raydium-io/raydium-idl`,children:_jsx(_components.code,{children:`raydium-io/raydium-idl`})}),` instead.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`shared-admin-authority`,children:`Shared admin authority`}),`\n`,_jsxs(_components.p,{children:[`All Anchor-based programs (CLMM, CPMM, LaunchLab, Lock) share a single hardcoded admin `,_jsx(_components.code,{children:`Pubkey`}),` for instruction-level access control to admin paths (such as `,_jsx(_components.code,{children:`CreateAmmConfig`}),` or `,_jsx(_components.code,{children:`UpdatePoolStatus`}),`):`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Cluster`}),_jsx(_components.th,{children:`Admin`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`mainnet-beta`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`GThUX1Atko4tqhN2NaiTazWSeFWMuiUvfFnyJyUghFMJ`})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`devnet`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`DRayqG9RXYi8WHgWEmRQGrUWRWbhjYWYkCRJDd6JBBak`})})]})]})]}),`\n`,_jsxs(_components.p,{children:[`Account-level operational authorities (e.g. `,_jsx(_components.code,{children:`protocol_owner`}),`, `,_jsx(_components.code,{children:`fund_owner`}),` on CPMM/CLMM `,_jsx(_components.code,{children:`AmmConfig`}),`, or the migration wallets on LaunchLab `,_jsx(_components.code,{children:`GlobalConfig`}),`) are stored on-chain and may differ from the program admin. Read them directly from the relevant config account before sending high-stakes transactions.`]}),`\n`,_jsx(Heading,{level:`3`,id:`cpmm-permission-pda-creator-authority`,children:`CPMM permission-PDA creator authority`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`CreatePermissionPda`}),` accepts either the shared program admin above or a dedicated owner. `,_jsx(_components.code,{children:`ClosePermissionPda`}),` remains restricted to the shared program admin.`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Cluster`}),_jsxs(_components.th,{children:[`Dedicated `,_jsx(_components.code,{children:`CreatePermissionPda`}),` owner`]})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`mainnet-beta`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`RayqjDRsNEFuPcDE4JpEScwJvwusmHYuNZ3MgET4D7U`})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`devnet`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`DRayJkSKsijbcEqdooK4uUGcT6gjbEuwUh7V6Nmqct7M`})})]})]})]}),`\n`,_jsx(Heading,{level:`3`,id:`launchlab-delegated-config-creator`,children:`LaunchLab delegated config creator`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`CreateConfig`}),` accepts either the shared program admin or the delegated authority below. The delegated role can create a new `,_jsx(_components.code,{children:`GlobalConfig`}),`; it cannot call the admin-only `,_jsx(_components.code,{children:`UpdateConfig`}),` path for an existing account.`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.the