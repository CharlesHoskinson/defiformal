ub.com/repos/compound-finance/comet/commits/db72b0ca39118098846605479d156ce9b1736cf3","html_url":"https://github.com/compound-finance/comet/commit/db72b0ca39118098846605479d156ce9b1736cf3"}],"stats":{"total":5311,"additions":4739,"deletions":572},"files":[{"sha":"b2d8df37f885a252b2a2e60d89e22adf4f5625d1","filename":"SCENARIO.md","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/compound-finance/comet/blob/f766f51583c23acc33b2a7824654ef2029a96804/SCENARIO.md","raw_url":"https://github.com/compound-finance/comet/raw/f766f51583c23acc33b2a7824654ef2029a96804/SCENARIO.md","contents_url":"https://api.github.com/repos/compound-finance/comet/contents/SCENARIO.md?ref=f766f51583c23acc33b2a7824654ef2029a96804","patch":"@@ -10,6 +10,14 @@ You can run scenarios against a given base as:\n \n `npx hardhat scenario --bases development,linea,mainnet`\n \n+You can run scenarios from a specific file (or files matching a glob pattern) with `--glob`:\n+\n+`npx hardhat scenario --glob 'scenario/AllowBySigScenario.ts'`\n+\n+`npx hardhat scenario --glob 'scenario/AllowBySigScenario.ts' --bases development`\n+\n+The default is `scenario/**.ts` (all scenario files). The pattern is passed to [fast-glob](https://github.com/mrmlnc/fast-glob); quote it in the shell so paths and braces are not expanded by bash. Combine with `--bases` to limit which deployment environments are used.\n+\n You can run spider persistently first if you wish:\n \n `npx hardhat scenario --spider`"},{"sha":"c4dcb68003677ce9a8a30b55d60ff8e3f1a4c46a","filename":"contracts/AssetList.sol","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/compound-finance/comet/blob/f766f51583c23acc33b2a7824654ef2029a96804/contracts%2FAssetList.sol","raw_url":"https://github.com/compound-finance/comet/raw/f766f51583c23acc33b2a7824654ef2029a96804/contracts%2FAssetList.sol","contents_url":"https://api.github.com/repos/compound-finance/comet/contents/contracts%2FAs