nts/hardhat/dai/deploy.ts","status":"modified","additions":50,"deletions":1,"changes":51,"blob_url":"https://github.com/compound-finance/comet/blob/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Fhardhat%2Fdai%2Fdeploy.ts","raw_url":"https://github.com/compound-finance/comet/raw/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Fhardhat%2Fdai%2Fdeploy.ts","contents_url":"https://api.github.com/repos/compound-finance/comet/contents/deployments%2Fhardhat%2Fdai%2Fdeploy.ts?ref=f766f51583c23acc33b2a7824654ef2029a96804","patch":"@@ -1,7 +1,11 @@\n import { Deployed, DeploymentManager } from '../../../plugins/deployment_manager';\n-import { FaucetToken, SimplePriceFeed } from '../../../build/types';\n+import { Configurator, FaucetToken, SimplePriceFeed } from '../../../build/types';\n import { DeploySpec, cloneGov, deployComet, exp, sameAddress, wait } from '../../../src/deploy';\n \n+// Fixed test addresses for the dev market-admin role (impersonated by scenarios).\n+const MARKET_ADMIN = '0x1111111111111111111111111111111111111111';\n+const MARKET_ADMIN_PAUSE_GUARDIAN = '0x2222222222222222222222222222222222222222';\n+\n async function makeToken(\n   deploymentManager: DeploymentManager,\n   amount: number,\n@@ -65,6 +69,51 @@ export default async function deploy(deploymentManager: DeploymentManager, deplo\n     assetConfigs: [assetConfig0, assetConfig1],\n   });\n   const { rewards } = deployed;\n+  const configurator = deployed.configurator as unknown as Configurator;\n+\n+  // Deploy + wire a MarketAdminPermissionChecker so the market-admin Configurator\n+  // scenarios are exercised on the local development base. On live networks this is\n+  // rolled out per-market via a gov_marketupdates migration; here we bake it into the\n+  // fresh dev deployment so the feature is enabled instead of left at address(0).\n+  const configuratorGovernor = await configurator.governor();\n+  const marketAdminPermissionChecker = await deploymentManager.deploy(\n+    'marketAdminPermissionChecker',\n+    'marketupdates/MarketAdminPermissionChecker.sol',\n+    [configuratorGovernor, MARKET_ADMIN, MARKET_ADMIN_PAUSE_GUARDIAN]\n+  );\n+\n+  // The Configurator governor is the timelock after deployComet, so impersonate it to\n+  // call the governor-only setter (dev base runs on the hardhat network).\n+  await deploymentManager.idempotent(\n+    async () =>\n+      !sameAddress(\n+        await configurator.marketAdminPermissionChecker(),\n+        marketAdminPermissionChecker.address\n+      ),\n+    async () => {\n+      trace(`Setting MarketAdminPermissionChecker in Configurator to ${marketAdminPermissionChecker.address}`);\n+      await deploymentManager.hre.network.provider.request({\n+        method: 'hardhat_impersonateAccount',\n+        params: [configuratorGovernor],\n+      });\n+      await deploymentManager.hre.network.provider.send('hardhat_setBalance', [\n+        configuratorGovernor,\n+        '0x' + (10n ** 18n).toString(16),\n+      ]);\n+      const govSigner = await deploymentManager.hre.ethers.getSigner(configuratorGovernor);\n+      trace(\n+        await wait(\n+          configurator\n+            .connect(govSigner)\n+            .setMarketAdminPermissionChecker(marketAdminPermissionChecker.address)\n+        )\n+      );\n+      await deploymentManager.hre.network.provider.request({\n+        method: 'hardhat_stopImpersonatingAccount',\n+        params: [configuratorGovernor],\n+      });\n+    }\n+  );\n \n   await deploymentManager.idempotent(\n     async () => (await GOLD.balanceOf(rewards.address)).eq(0),"},{"sha":"45f0e6ca2041f0111c37aac6c6a7ac5ba4d424f3","filename":"deployments/linea/usdc/relations.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/compound-finance/comet/blob/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Flinea%2Fusdc%2Frelations.ts","raw_url":"https://github.com/compound-finance/comet/raw/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Flinea%2Fusdc%2Frelations.ts","contents_url":"https://api.github.com/repos/compound-finance/comet/contents/deployments%2Flinea%2Fusdc%2Frelations.ts?ref=f766f51583c23acc33b2a7824654ef2029a96804","patch":"@@ -31,7 +31,7 @@ export default {\n     },\n   },  \n   'TransparentUpgradeableProxy': {\n-    artifact: 'contracts/ERC20.sol:ERC20',\n+    artifact: 'contracts/interfaces/ERC20.sol:ERC20',\n     delegates: {\n       field: {\n         slot: '0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc'"},{"sha":"219251ed0128422990ca1a4e464bba0139a024e8","filename":"deployments/linea/weth/relations.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/compound-finance/comet/blob/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Flinea%2Fweth%2Frelations.ts","raw_url":"https://github.com/compound-finance/comet/raw/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Flinea%2Fweth%2Frelations.ts","contents_url":"https://api.github.com/repos/compound-finance/comet/contents/deployments%2Flinea%2Fweth%2Frelations.ts?ref=f766f51583c23acc33b2a7824654ef2029a96804","patch":"@@ -23,7 +23,7 @@ export default {\n     },\n   },  \n   'TransparentUpgradeableProxy': {\n-    artifact: 'contracts/ERC20.sol:ERC20',\n+    artifact: 'contracts/interfaces/ERC20.sol:ERC20',\n     delegates: {\n       field: {\n         slot: '0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc'"},{"sha":"0529dd46155276a849b12b3c452281a10ac08ce9","filename":"deployments/mainnet/usdc/migrations/1720623615_add_wsteth_as_collateral.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/compound-finance/comet/blob/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Fmainnet%2Fusdc%2Fmigrations%2F1720623615_add_wsteth_as_collateral.ts","raw_url":"https://github.com/compound-finance/comet/raw/f766f51583c23acc33b2a7824654ef2029a96804/deployments%2Fmainnet%2Fusdc%2Fmigrations%2F1720623615_add_wsteth_as