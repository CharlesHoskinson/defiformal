import("https://cdn.developers.uniswap.org/assets/entry.client-XVOqePWy.js");</script><!--$?--><template id="B:0"></template><!--/$--><script id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><div hidden id="S:0"><script>window.__reactRouterContext.streamController.enqueue("[{\"_1\":2,\"_3\":-5,\"_4\":-5},\"loaderData\",{\"_5\":6,\"_7\":8},\"actionData\",\"errors\",\"root\",{\"_3645\":-5,\"_3646\":3647,\"_3648\":3649,\"_3650\":3651,\"_3652\":3653,\"_3654\":175,\"_3655\":3656},\"docs/page\",{\"_9\":10,\"_11\":12,\"_13\":-5,\"_14\":15,\"_16\":17,\"_18\":19,\"_20\":21,\"_22\":-5,\"_23\":24,\"_25\":-5,\"_26\":-5,\"_27\":-5,\"_28\":-5,\"_29\":30,\"_31\":-5},\"path\",\"protocols/overview.mdx\",\"pageTree\",{\"_64\":65,\"_66\":67},\"docsTree\",\"breadcrumbs\",[55,56,57],\"lastModified\",\"2026-08-27T21:02:25.000Z\",\"title\",\"Uniswap Protocols Overview\",\"description\",\"Navigate the Uniswap protocol documentation, from the core AMM versions to supporting infrastructure contracts.\",\"pageType\",\"faqs\",[38,39,40,41,42],\"terms\",\"datePublished\",\"entries\",\"programmingModel\",\"keywords\",[32,33,34,35,36,37],\"author\",\"Uniswap protocols\",\"AMM versions\",\"Universal Router\",\"Permit2\",\"The Compact\",\"protocol fees\",{\"_43\":53,\"_45\":54},{\"_43\":51,\"_45\":52},{\"_43\":49,\"_45\":50},{\"_43\":47,\"_45\":48},{\"_43\":44,\"_45\":46},\"question\",\"Where do I find Uniswap contract deployment addresses?\",\"answer\",\"The unified deployments page at developers.uniswap.org/deployments lists Uniswap contract addresses across all protocols and chains. Each protocol section of the docs also has its own deployments page; for example, Uniswap v4 addresses are on the v4 deployments page, and the smart wallet deployments page lists the Calibur address across supported networks.\",\"Are the Uniswap protocol contracts audited?\",\"Yes. The Uniswap v4 core and periphery repositories publish their audit reports, and Uniswap Labs maintains an active bug bounty program on Cantina for eligible vulnerability disclosures.\",\"Which contract should I use to execute Uniswap swaps programmatically?\",\"The Universal Router is the recommended entry point for executing swaps programmatically. It is an unowned, non-upgradeable contract that composes swaps across Uniswap v2, v3, and v4 in a single transaction using command-based encoding, and it integrates with Permit2 for signature-controlled token approvals.\",\"What is the difference between the Uniswap AMM and its supporting protocols?\",\"The AMM contracts are the pool contracts that hold liquidity and execute swaps, versioned as Uniswap v2, v3, and v4. The supporting protocols are infrastructure contracts used across versions: the Universal Router composes swaps across v2, v3, and v4 in a single transaction, Permit2 handles signature-based token transfers and time-bound allowances, Fee Adapter and TokenJar contracts collect protocol fees, The Compact provides ERC-6909 resource locks for cross-chain coordination, and Calibur powers smart wallet delegation through EIP-7702.\",\"Which Uniswap protocol version should I use for a new integration?\",\"Uniswap v4 is the current and recommended version for new integrations. It consolidates all pools into a single PoolManager contract, supports hooks that customize pool behavior across the pool lifecycle, and uses flash accounting to defer token transfers until the end of a transaction, which reduces gas for multi-step operations. Use v3 for existing concentrated liquidity integrations and v2 for legacy constant product workflows.\",{\"_58\":62,\"_60\":63},{\"_58\":59,\"_60\":61},{\"_58\":19},\"name\",\"Protocols\",\"url\",\"/docs/protocols\",\"Docs\",\"/docs\",\"$fumadocs_loader\",\"page-tree\",\"data\",{\"_68\":5,\"_58\":69,\"_70\":71,\"_72\":73},\"$id\",{\"_111\":112,\"_81\":113,\"_114\":-5,\"_115\":-5,\"_116\":3642},\"children\",[469,470,471,472,473,474,475,476],\"fallback\",{\"_68\":74,\"_58\":75,\"_70\":76},\"fallbac