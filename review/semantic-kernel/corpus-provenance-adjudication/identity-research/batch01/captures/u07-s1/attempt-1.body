/chunks/3r6u621-lf59k.js\",\"/_next/static/immutable/chunks/02_i2s7l-_0j1.js\",\"/_next/static/immutable/chunks/430py2naikisa.js\",\"/_next/static/immutable/chunks/1cmbak4jjc5nv.js\",\"/_next/static/immutable/chunks/168374sq15pnc.js\"],\"DocsBody\"]\n6c:I[850022,[\"/_next/static/immutable/chunks/3wpxkj0g6mgv-.js\",\"/_next/static/immutable/chunks/1bplrgnbi2za4.js\",\"/_next/static/immutable/chunks/39pga-axrlw7j.js\",\"/_next/static/immutable/chunks/186gpa3or4lb0.js\",\"/_next/static/immutable/chunks/3sgilzt0pf6oe.js\",\"/_next/static/immutable/chunks/1lfsbxjmh9tg4.js\",\"/_next/static/immutable/chunks/0zckab6prg60y.js\",\"/_next/static/immutable/chunks/0i-kk4okl3qa7.js\",\"/_next/static/immutable/chunks/20xs3fnyzs58g.js\",\"/_next/static/immutable/chunks/0x4y-44ygf3yg.js\",\"/_next/static/immutable/chunks/450k-7qi8vyep.js\",\"/_next/static/immutable/chunks/3r6u621-lf59k.js\",\"/_next/static/immutable/chunks/02_i2s7l-_0j1.js\",\"/_next/static/immutable/chunks/430py2naikisa.js\",\"/_next/static/immutable/chunks/1cmbak4jjc5nv.js\",\"/_next/static/immutable/chunks/168374sq15pnc.js\"],\"Heading\"]\n56:C\n63:[\"$\",\"$L61\",null,{\"toc\":[{\"depth\":2,\"url\":\"#introduction\",\"title\":\"Introduction\"},{\"depth\":2,\"url\":\"#morpho\",\"title\":\"Morpho\"},{\"depth\":3,\"url\":\"#overview\",\"title\":\"Overview\"},{\"depth\":3,\"url\":\"#key-concepts\",\"title\":\"Key Concepts\"},{\"depth\":2,\"url\":\"#blue-and-midnight\",\"title\":\"Blue and Midnight\"}],\"full\":\"$undefined\",\"breadcrumb\":{\"enabled\":false},\"tableOfContent\":{\"style\":\"normal\"},\"tableOfContentPopover\":{\"style\":\"normal\"},\"children\":[[[\"$\",\"h1\",null,{\"className\":\"text-title-sm h1\",\"children\":\"Morpho Overview\"}],\"$undefined\"],[\"$\",\"$L6b\",null,{\"children\":[[\"$\",\"$L6c\",null,{\"as\":\"h2\",\"id\":\"introduction\",\"children\":\"Introduction\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Morpho\"}],\" is a decentralized lending protocol with different entities and individuals contributing to its development and adoption. As a result, the documentation refers to different areas of “Morpho” which are worth distinguishing.\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The Morpho Protocols\"}],\":\\nDecentralized, noncustodial lending protocols implemented for the Ethereum Virtual Machine.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The Morpho Interfaces\"}],\":\",[\"$\",\"br\",null,{}],\"\\n\",\"Multiple web interfaces allowing easy interaction with the Morpho protocol. Those interfaces are ways to interact with the Morpho protocol.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Morpho Governance\"}],\":\",[\"$\",\"br\",null,{}],\"\\n\",\"A governance system for governing the Morpho Protocol, enabled by the \",[\"$\",\"$L60\",null,{\"href\":\"/learn/governance/morpho-token/#1\",\"children\":\"MORPHO token\"}],\".\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Morpho Association\"}],\":\",[\"$\",\"br\",null,{}],\"\\n\",\"A France-registered association that regroups the main contributors to promote the development and the decentralization of the Morpho Protocol. \",[\"$\",\"$L60\",null,{\"href\":\"/learn/governance/organization/#morpho-association\",\"children\":\"The Morpho Association\"}],\" hosts one of the Morpho Interfaces.\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"$L6c\",null,{\"as\":\"h2\",\"id\":\"morpho\",\"children\":\"Morpho\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Morpho is a simple lending primitive layer that allows the creation of immutable and efficient lending markets in a permissionless way.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The protocol comes with EVM smart contracts which facilitate interactions and integrations.\"}],\"\\n\",[\"$\",\"$L6c\",null,{\"as\":\"h3\",\"id\":\"overview\",\"children\":\"Overview\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Morpho is a decentralized protocol enabling the overcollateralized lending and borrowing of crypto assets (ERC20 \u0026 ERC4626 Tokens) on the \",[\"$\",\"$L60\",null,{\"href\":\"https://ethereum.org/en/developers/docs/evm/\",\"children\":\"Ethereum Virtual Machine\"}],\". The protocol is implemented as an immutable smart contract, engineered to serve as a trustless base layer for lenders, borrowers, and applications.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Morpho is licensed under a dual license (BUSL-1.1 and GPLv2) which you can find \",[\"$\",\"$L60\",null,{\"href\":\"https://github.com/morpho-org/morpho-blue/blob/main/LICENSE\",\"children\":\"here\"}],\". Once deployed, Morpho will function in perpetuity, provided by the existence of the blockchain.\"]}],\"\\n\",[\"$\",\"$L6c\",null,{\"as\":\"h3\",\"id\":\"key-concepts\",\"children\":\"Key Concepts\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Overcollateralized lending in Morpho involves:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Collateralization\"}],\": Users provide collateral to borrow other assets\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Risk Protection\"}],\": Liquidation mechanisms protect the protocol through loan-to-value ratios\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Interest Accrual\"}],\": Dynamic interest rates based on market conditions\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Open Participation\"}],\": Anyone can lend or borrow through the protocol\"]}],\"\\n\",\"$L6d\",\"\\n\"]}],\"\\n\"