INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Simulation","name":"DefiKernel.Interleaving.Recovery.advance_simulates","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (m : DefiKernel.Interleaving.Machine P A D),\n      @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial\n          m →\n        @DefiKernel.Interleaving.Recovery.Simulates P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n            left right lf rf m →\n          ∀ (b : DefiKernel.Parallel.BranchId),\n            @DefiKernel.Interleaving.Recovery.Simulates P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n              initial left right lf rf\n              (@DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n                m b)"}
INTERLEAVING_PROOF_JSON {"axioms":[],"module":"DefiKernel.Interleaving.Recovery.Step","name":"DefiKernel.Interleaving.Recovery.compatible_peer_reads","statement":"∀ {P A D : Type} (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @DefiKernel.Parallel.Compatible P A D lf rf →\n    ∀ (b peer : DefiKernel.Parallel.BranchId),\n      @Ne.{1} DefiKernel.Parallel.BranchId b peer →\n        ∀ (c : DefiKernel.Typed.Cell P A D),\n          @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n              (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n              (@DefiKernel.Parallel.Footprint.reads P A D\n                (@DefiKernel.Interleaving.Recovery.footprint P A D lf rf peer))\n              c →\n            c ∉ @DefiKernel.Parallel.Footprint.writes P A D (@DefiKernel.Interleaving.Recovery.footprint P A D lf rf b)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Reference","name":"DefiKernel.Interleaving.Recovery.continue_active_index","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundary : Nat → DefiKernel.Composition.Boundary P A D) (cursor : DefiKernel.Composition.Cursor P A D)\n  (steps : List.{0} (DefiKernel.Composition.Step P A D)),\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n      (@DefiKernel.Composition.Cursor.failure P A D\n        (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary cursor steps))\n      (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)) →\n    @Eq.{1} Nat\n      (@DefiKernel.Composition.Cursor.nextIndex P A D\n        (@DefiKernel.Composition.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary cursor steps))\n      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n        (@DefiKernel.Composition.Cursor.nextIndex P A D cursor)\n        (@List.length.{0} (DefiKernel.Composition.Step P A D) steps))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Simulation","name":"DefiKernel.Interleaving.Recovery.continue_outside","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (m : DefiKernel.Interleaving.Machine P A D),\n      @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial\n          m →\n        ∀ (schedule : DefiKernel.Interleaving.Schedule),\n          ∀ c ∉ @DefiKernel.Parallel.Footprint.writes P A D lf,\n            c ∉ @DefiKernel.Parallel.Footprint.writes P A D rf →\n              @Eq.{1} Rat\n                (@DefiKernel.Typed.State.balance P A D\n                  (@DefiKernel.Typed.ExecutionResult.state P A D\n                    (@DefiKernel.Interleaving.Machine.world P A D\n                      (@DefiKernel.Interleaving.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n                        left right m schedule)))\n                  c)\n                (@DefiKernel.