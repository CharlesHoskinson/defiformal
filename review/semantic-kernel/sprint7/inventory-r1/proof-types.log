INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Soundness","name":"DefiKernel.Interleaving.AdvanceSound.consumed","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {m post : DefiKernel.Interleaving.Machine P A D} {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    ∀ (own : DefiKernel.Parallel.BranchId),\n      @Eq.{1} Nat\n        (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n        (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n          (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m own))\n          (@ite.{1} Nat (@Eq.{1} DefiKernel.Parallel.BranchId b own) (DefiKernel.Parallel.instDecidableEqBranchId b own)\n            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))\n            (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Interleaving.AdvanceSound.locality","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {m post : DefiKernel.Interleaving.Machine P A D} {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    ∀ c ∉ @DefiKernel.Interleaving.Machine.writes P A D post,\n      And\n        (@Eq.{1} Rat\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D post)) c)\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D m)) c))\n        (c ∉ @DefiKernel.Interleaving.Machine.writes P A D m)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Trace","name":"DefiKernel.Interleaving.AdvanceSound.refusal_stable","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {m post : DefiKernel.Interleaving.Machine P A D} {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    ∀ (own : DefiKernel.Parallel.BranchId) (failure : DefiKernel.Composition.LocatedFailure P A D),\n      @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n          (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m own))\n          (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure) →\n        And\n          (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n            (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure))\n          (And\n            (@Eq.{1} (List.{0} (DefiKernel.Composition.Event P A D))\n              (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n              (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D m own)))\n            (And\n              (@Eq.{1} (List.{0} (DefiKernel.Composition.OutputObservation A))\n                (@DefiKernel.Interleaving.LocalState.outputs P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D post own))\n                (@DefiKernel.Interleaving.LocalState.outputs P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D m own)))\n              (@Eq.{1} Nat\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D post own))\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D m own)))))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Soundness","name":"DefiKernel.Interleaving.AdvanceSound.store","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {m post : DefiKernel.Interleaving.Machine P A D} {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    @Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n      (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Interleaving.Machine.world P A D post))\n      (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Interleaving.Machine.world P A D m))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Quot.sound"],"module":"DefiKernel.Interleaving.Trace","name":"DefiKernel.Interleaving.AttemptChain.brecOn","statement":"∀ {P A D : Type} {initial : DefiKernel.Composition.World P A D}\n  {motive :\n    (a : List.{0} (DefiKernel.Interleaving.Attempt P A D)) →\n      (a_1 : DefiKernel.Composition.World P A D) → @DefiKernel.Interleaving.AttemptChain P A D initial a a_1 → Prop}\n  {a : List.{0} (DefiKernel.Interleaving.Attempt P A D)} {a_1 : DefiKernel.Composition.World P A D}\n  (t : @DefiKernel.Interleaving.AttemptChain P A D initial a a_1),\n  (∀ (a : List.{0} (DefiKernel.Interleaving.Attempt P A D)) (a_2 : DefiKernel.Composition.World P A D)\n      (t : @DefiKernel.Interleaving.AttemptChain P A D initial a a_2),\n      @DefiKernel.Interleaving.AttemptChain.below P A D initial motive a a_2 t → motive a a_2 t) →\n    motive a a_1 t"}
