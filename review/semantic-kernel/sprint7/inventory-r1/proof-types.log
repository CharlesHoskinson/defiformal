INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Trace","name":"DefiKernel.Interleaving.Reachable.local_order","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {initial : DefiKernel.Composition.World P A D} {m : DefiKernel.Interleaving.Machine P A D},\n  @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial m →\n    ∀ (b : DefiKernel.Parallel.BranchId),\n      @Eq.{1} (List.{0} (DefiKernel.Composition.Step P A D))\n        (@List.map.{0, 0} (DefiKernel.Composition.Event P A D) (DefiKernel.Composition.Step P A D)\n          (@DefiKernel.Composition.Event.step P A D)\n          (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D m b)))\n        (@List.map.{0, 0} (DefiKernel.Composition.Invocation P A D) (DefiKernel.Composition.Step P A D)\n          (@DefiKernel.Composition.Step.invoke P A D)\n          (@List.take.{0} (DefiKernel.Composition.Invocation P A D)\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@DefiKernel.Interleaving.selectBranch P A D left right b)))"}
