Kernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n              (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))\n            (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D)\n              (@DefiKernel.Composition.LocatedFailure.mk P A D\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n                (@Option.some.{0} (DefiKernel.Composition.Step P A D) (@DefiKernel.Composition.Step.invoke P A D inv))\n                reason)))))\n      (@DefiKernel.Interleaving.Machine.right P A D\n        (@DefiKernel.Interleaving.Machine.setLocal P A D m b\n          (@DefiKernel.Interleaving.LocalState.mk P A D\n            (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)\n              (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n              (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))\n            (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n            (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D)\n              (@DefiKernel.Composition.LocatedFailure.mk P A D\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n                (@Option.some.{0} (DefiKernel.Composition.Step P A D) (@DefiKernel.Composition.Step.invoke P A D inv))\n                reason)))))\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n        (List.{0} (DefiKernel.Interleaving.Attempt P A D)) (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n        (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@List.instAppend.{0} (DefiKernel.Interleaving.Attempt P A D)))\n        (@DefiKernel.Interleaving.Machine.attempts P A D m)\n        (@List.cons.{0} (DefiKernel.Interleaving.Attempt P A D)\n          (@DefiKernel.Interleaving.Attempt.mk P A D b\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b)) inv\n            (@DefiKernel.Interleaving.Machine.world P A D m)\n            (@Except.error.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) reason))\n          (@List.nil.{0} (DefiKernel.Interleaving.Attempt P A D)))))"}
