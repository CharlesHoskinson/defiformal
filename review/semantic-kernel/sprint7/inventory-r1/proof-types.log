INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery","name":"DefiKernel.Interleaving.runInterleaving_blockLR","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    @Eq.{1} Bool\n      (@DefiKernel.Interleaving.matchesParallel P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n        (@DefiKernel.Interleaving.runInterleaving P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n          left right\n          (@HAppend.hAppend.{0, 0, 0} (List.{0} DefiKernel.Parallel.BranchId) (List.{0} DefiKernel.Parallel.BranchId)\n            DefiKernel.Interleaving.Schedule\n            (@instHAppendOfAppend.{0} (List.{0} DefiKernel.Parallel.BranchId)\n              (@List.instAppend.{0} DefiKernel.Parallel.BranchId))\n            (@List.replicate.{0} DefiKernel.Parallel.BranchId\n              (@List.length.{0} (DefiKernel.Composition.Invocation P A D) left) DefiKernel.Parallel.BranchId.left)\n            (@List.replicate.{0} DefiKernel.Parallel.BranchId\n              (@List.length.{0} (DefiKernel.Composition.Invocation P A D) right) DefiKernel.Parallel.BranchId.right)))\n        (@DefiKernel.Parallel.runSerialLR P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n          right))\n      Bool.true"}
