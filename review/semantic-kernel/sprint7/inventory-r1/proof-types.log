INTERLEAVING_PROOF_JSON {"axioms":["propext","Quot.sound"],"module":"DefiKernel.Interleaving.Execution","name":"DefiKernel.Interleaving.ProjectedEquivalent.eq_1","statement":"∀ {P A D : Type} (m : DefiKernel.Interleaving.Machine P A D) (joined : DefiKernel.Parallel.Joined P A D),\n  @Eq.{1} Prop (@DefiKernel.Interleaving.ProjectedEquivalent P A D m joined)\n    (And\n      (@DefiKernel.Parallel.WorldEquivalent P A D (@DefiKernel.Interleaving.Machine.world P A D m)\n        (@DefiKernel.Parallel.Joined.world P A D joined))\n      (And\n        (@Eq.{1} (DefiKernel.Parallel.BranchObservation P A D)\n          (@DefiKernel.Interleaving.LocalState.observe P A D (@DefiKernel.Interleaving.Machine.left P A D m))\n          (@DefiKernel.Parallel.observeBranch P A D (@DefiKernel.Parallel.Joined.left P A D joined)))\n        (@Eq.{1} (DefiKernel.Parallel.BranchObservation P A D)\n          (@DefiKernel.Interleaving.LocalState.observe P A D (@DefiKernel.Interleaving.Machine.right P A D m))\n          (@DefiKernel.Parallel.observeBranch P A D (@DefiKernel.Parallel.Joined.right P A D joined)))))"}
