INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Trace","name":"DefiKernel.Interleaving.advance_refusal_stable","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (m : DefiKernel.Interleaving.Machine P A D) (b own : DefiKernel.Parallel.BranchId)\n  (failure : DefiKernel.Composition.LocatedFailure P A D),\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n      (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m own))\n      (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure) →\n    have post :=\n      @DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b;\n    And\n      (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n        (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n        (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure))\n      (And\n        (@Eq.{1} (List.{0} (DefiKernel.Composition.Event P A D))\n          (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n          (@DefiKernel.Interleaving.LocalState.events P A D (@DefiKernel.Interleaving.Machine.local P A D m own)))\n        (And\n          (@Eq.{1} (List.{0} (DefiKernel.Composition.OutputObservation A))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n            (@DefiKernel.Interleaving.LocalState.outputs P A D (@DefiKernel.Interleaving.Machine.local P A D m own)))\n          (@Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n              (@DefiKernel.Interleaving.Machine.local P A D post own))\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n              (@DefiKernel.Interleaving.Machine.local P A D m own)))))"}
