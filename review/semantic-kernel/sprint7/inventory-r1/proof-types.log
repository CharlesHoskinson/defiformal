INTERLEAVING_PROOF_JSON {"axioms":["propext"],"module":"DefiKernel.Interleaving.Schedule","name":"DefiKernel.Interleaving.checkSchedule_error_iff","statement":"∀ (leftLength rightLength : Nat) (schedule : DefiKernel.Interleaving.Schedule)\n  (mismatch : DefiKernel.Interleaving.ScheduleMismatch),\n  Iff\n    (@Eq.{1} (Except.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1})\n      (DefiKernel.Interleaving.checkSchedule leftLength rightLength schedule)\n      (@Except.error.{0, 0} DefiKernel.Interleaving.ScheduleMismatch PUnit.{1} mismatch))\n    (And\n      (Not\n        (And\n          (@Eq.{1} Nat\n            (@List.count.{0} DefiKernel.Parallel.BranchId\n              (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId)\n              DefiKernel.Parallel.BranchId.left schedule)\n            leftLength)\n          (@Eq.{1} Nat\n            (@List.count.{0} DefiKernel.Parallel.BranchId\n              (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId)\n              DefiKernel.Parallel.BranchId.right schedule)\n            rightLength)))\n      (@Eq.{1} DefiKernel.Interleaving.ScheduleMismatch mismatch\n        { expectedLeft := leftLength,\n          observedLeft :=\n            @List.count.{0} DefiKernel.Parallel.BranchId\n              (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId)\n              DefiKernel.Parallel.BranchId.left schedule,\n          expectedRight := rightLength,\n          observedRight :=\n            @List.count.{0} DefiKernel.Parallel.BranchId\n              (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId)\n              DefiKernel.Parallel.BranchId.right schedule }))"}
