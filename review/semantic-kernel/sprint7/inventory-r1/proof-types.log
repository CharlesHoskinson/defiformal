t.length.{0} (DefiKernel.Composition.Invocation P A D) left) DefiKernel.Parallel.BranchId.left)))\n        (@DefiKernel.Parallel.runSerialRL P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n          right))\n      Bool.true"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery","name":"DefiKernel.Interleaving.runInterleaving_empty","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D),\n  @Eq.{1} Bool\n      (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n        (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n      Bool.true →\n    @Eq.{1} (DefiKernel.Interleaving.Result P A D)\n      (@DefiKernel.Interleaving.runInterleaving P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n        (@List.nil.{0} (DefiKernel.Composition.Invocation P A D))\n        (@List.nil.{0} (DefiKernel.Composition.Invocation P A D)) (@List.nil.{0} DefiKernel.Parallel.BranchId))\n      (@DefiKernel.Interleaving.Result.executed P A D (@List.nil.{0} DefiKernel.Parallel.BranchId)\n        (@DefiKernel.Interleaving.start P A D initial))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery","name":"DefiKernel.Interleaving.runInterleaving_empty_left","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (right : DefiKernel.Parallel.Branch P A D) (rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries\n        (@List.nil.{0} (DefiKernel.Composition.Invocation P A D)) right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)\n          (@DefiKernel.Parallel.Footprint.empty P A D) rf)) →\n    ∀ (schedule : DefiKernel.Interleaving.Schedule),\n      @DefiKernel.Interleaving.Complete P A D (@List.nil.{0} (DefiKernel.Composition.Invocation P A D)) right schedule →\n        @Eq.{1} Bool\n          (@DefiKernel.Interleaving.matchesParallel P A D inst inst_1 inst_2 inst_3 inst_4 inst_5\n            (@DefiKernel.Interleaving.runInterleaving P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n              initial (@List.nil.{0} (DefiKernel.Composition.Invocation P A D)) right schedule)\n            (@DefiKernel.Parallel.Result.executed P A D\n              (@DefiKernel.Parallel.Joined.mk P A D\n                (@DefiKernel.Composition.Cursor.world P A D\n                  (@DefiKernel.Parallel.runBranch P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n                    (boundaries DefiKernel.Parallel.BranchId.right) initial right))\n                (@DefiKernel.Composition.startCursor P A D inst inst_1 inst_2 cfg initial)\n                (@DefiKernel.Parallel.runBranch P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n                  (boundaries DefiKernel.Parallel.BranchId.right) initial right))))\n          Bool.true"}
