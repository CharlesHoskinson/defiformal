el.Composition.Failure (DefiKernel.Parallel.Footprint P A D) part))\n            (And\n              (∀ (c : DefiKernel.Typed.Cell P A D),\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.reads P A D part) c →\n                  @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.reads P A D rf) c)\n              (∀ (c : DefiKernel.Typed.Cell P A D),\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.writes P A D part) c →\n                  @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                    (@DefiKernel.Parallel.Footprint.writes P A D rf) c))"}
