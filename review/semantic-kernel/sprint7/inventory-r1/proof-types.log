INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery","name":"DefiKernel.Interleaving.runInterleaving_recovers","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (schedule : DefiKernel.Interleaving.Schedule),\n      @DefiKernel.Interleaving.Complete P A D left right schedule →\n        ∃ joined,\n          And\n            (@Eq.{1} (DefiKernel.Parallel.Result P A D)\n              (@DefiKernel.Parallel.runParallel P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n                left right)\n              (@DefiKernel.Parallel.Result.executed P A D joined))\n            (And\n              (@Eq.{1} (DefiKernel.Interleaving.Result P A D)\n                (@DefiKernel.Interleaving.runInterleaving P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n                  initial left right schedule)\n                (@DefiKernel.Interleaving.Result.executed P A D schedule\n                  (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries\n                    initial left right schedule)))\n              (@DefiKernel.Interleaving.ProjectedEquivalent P A D\n                (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n                  left right schedule)\n                joined))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Interleaving.runPrefix_accounting","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (schedule : DefiKernel.Interleaving.Schedule) (d : D) (a : A),\n  @Eq.{1} Rat\n    (@DefiKernel.Typed.total P A D inst_3\n      (@DefiKernel.Typed.ExecutionResult.state P A D\n        (@DefiKernel.Interleaving.Machine.world P A D\n          (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n            right schedule)))\n      d a)\n    (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n      (@DefiKernel.Typed.total P A D inst_3 (@DefiKernel.Typed.ExecutionResult.state P A D initial) d a)\n      (@DefiKernel.Interleaving.Machine.supply P A D inst_1 inst_2\n        (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n          right schedule)\n        d a))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Soundness","name":"DefiKernel.Interleaving.runPrefix_complete_counts","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (schedule : DefiKernel.Interleaving.Schedule),\n  @DefiKernel.Interleaving.Complete P A D left right schedule →\n    And\n      (@Eq.{1} Nat\n        (@DefiKernel.Interleaving.LocalState.consumed P A D\n          (@DefiKernel.Interleaving.Machine.left P A D\n            (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n              left right schedule)))\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) left))\n      (@Eq.{1} Nat\n        (@DefiKernel.Interleaving.LocalState.consumed P A D\n          (@DefiKernel.Interleaving.Machine.right P A D\n            (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n              left right schedule)))\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) right))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Soundness","name":"DefiKernel.Interleaving.runPrefix_consumed","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (schedule : DefiKernel.Interleaving.Schedule)\n  (b : DefiKernel.Parallel.BranchId),\n  @Eq.{1} Nat\n    (@DefiKernel.Interleaving.LocalState.consumed P A D\n      (@DefiKernel.Interleaving.Machine.local P A D\n        (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n          right schedule)\n        b))\n    (@List.count.{0} DefiKernel.Parallel.BranchId\n      (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId) b schedule)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Interleaving.runPrefix_frame","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (schedule : DefiKernel.Interleaving.Schedule)\n  (region : Set.{0} (DefiKernel.Typed.Cell P A D)) (predicate : DefiKernel.Typed.State P A D → Prop),\n  @DefiKernel.Composition.Supports P A D region predicate →\n    (∀ (c : DefiKernel.Typed.Cell P A D),\n        @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (Set.{0} (DefiKernel.Typed.Cell P A D))\n            (@Set.instMembership.{0} (DefiKernel.Typed.Cell P A D)) region c →\n          c ∉\n            @DefiKernel.Interleaving.Machine.writes P A D\n              (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n                left right schedule)) →\n      Iff (predicate (@DefiKernel.Typed.ExecutionResult.state P A D initial))\n        (predicate\n          (@DefiKernel.Typed.ExecutionResult.state P A D\n            (@DefiKernel.Interleaving.Machine.world P A D\n              (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n                left right schedule))))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Interleaving.runPrefix_nonnegative","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (schedule : DefiKernel.Interleaving.Schedule)\n  (c : DefiKernel.Typed.Cell P A D),\n  @LE.le.{0} Rat Rat.instLE (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0)))\n    (@DefiKernel.Typed.State.balance P A D\n      (@DefiKernel.Typed.ExecutionResult.state P A D\n        (@DefiKernel.Interleaving.Machine.world P A D\n          (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n            right schedule)))\n      c)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery","name":"DefiKernel.Interleaving.runPrefix_parallel","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (schedule : DefiKernel.Interleaving.Schedule),\n      @DefiKernel.Interleaving.Complete P A D left right schedule →\n        have l :=\n          @DefiKernel.Parallel.runBranch P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n            (boundaries DefiKernel.Parallel.BranchId.left) initial left;\n        have r :=\n          @DefiKernel.Parallel.runBranch P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n            (boundaries DefiKernel.Parallel.BranchId.right) initial right;\n        @DefiKernel.Interleaving.ProjectedEquivalent P A D\n          (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n            right schedule)\n          (@DefiKernel.Parallel.Joined.mk P A D\n            (@DefiKernel.Parallel.mergeWorld P A D inst inst_1 inst_2 lf rf initial\n              (@DefiKernel.Composition.Cursor.world P A D l) (@DefiKernel.Composition.Cursor.world P A D r))\n            l r)"}
