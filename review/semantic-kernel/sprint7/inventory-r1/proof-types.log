INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Composition.ReceiptAuthorized.eq_1","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (pre : DefiKernel.Composition.World P A D) (boundary : DefiKernel.Composition.Boundary P A D)\n  (request : DefiKernel.Typed.Request P A D) (e : DefiKernel.Typed.Evaluated P A D),\n  @Eq.{1} Prop\n    (@DefiKernel.Composition.ReceiptAuthorized P A D inst inst_1 inst_2 pre boundary\n      (@DefiKernel.Composition.Receipt.invoked P A D request e))\n    (And\n      (@Eq.{1} Bool\n        (@DefiKernel.Typed.hasAuthority P A D inst inst_1 inst_2\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n          (@DefiKernel.Typed.Request.capabilityIds P A D request) (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n          (@DefiKernel.Typed.Request.operation P A D request) (@DefiKernel.Typed.Right.invoke P A D))\n        Bool.true)\n      (And\n        (∀ (c : DefiKernel.Typed.Cell P A D),\n          @LT.lt.{0} Rat Rat.instLT (@DefiKernel.Typed.Evaluated.effect P A D inst inst_1 inst_2 e c)\n              (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))) →\n            @Eq.{1} Bool\n              (@DefiKernel.Typed.hasAuthority P A D inst inst_1 inst_2\n                (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n                (@DefiKernel.Typed.Request.capabilityIds P A D request)\n                (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n                (@DefiKernel.Typed.Request.operation P A D request) (@DefiKernel.Typed.Right.debit P A D c))\n              Bool.true)\n        (∀ (d : D) (a : A),\n          @Ne.{1} Rat (@DefiKernel.Typed.Evaluated.supply P A D inst_1 inst_2 e d a)\n              (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))) →\n            @Eq.{1} Bool\n              (@DefiKernel.Typed.hasAuthority P A D inst inst_1 inst_2\n                (@DefiKernel.Typed.ExecutionResult.capabilities P A D pre)\n                (@DefiKernel.Typed.Request.capabilityIds P A D request)\n                (@DefiKernel.Composition.Boundary.ctx P A D boundary)\n                (@DefiKernel.Typed.Request.operation P A D request) (@DefiKernel.Typed.Right.changeSupply P A D d a))\n              Bool.true)))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Composition.ReceiptAuthorized.eq_2","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (pre : DefiKernel.Composition.World P A D) (boundary : DefiKernel.Composition.Boundary P A D)\n  (receipt : DefiKernel.Composition.Receipt P A D),\n  (∀ (request : DefiKernel.Typed.Request P A D) (e : DefiKernel.Typed.Evaluated P A D),\n      @Eq.{1} (DefiKernel.Composition.Receipt P A D) receipt (@DefiKernel.Composition.Receipt.invoked P A D request e) →\n        False) →\n    @Eq.{1} Prop (@DefiKernel.Composition.ReceiptAuthorized P A D inst inst_1 inst_2 pre boundary receipt) True"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Interleaving.AdvanceSound.accounting","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {m post : DefiKernel.Interleaving.Machine P A D} {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    ∀ (d : D) (a : A),\n      @Eq.{1} Rat\n        (@HSub.hSub.{0, 0, 0} Rat Rat Rat (@instHSub.{0} Rat Rat.instSub)\n          (@DefiKernel.Typed.total P A D inst_3\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D post)) d a)\n          (@DefiKernel.Typed.total P A D inst_3\n            (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D m)) d a))\n        (@HSub.hSub.{0, 0, 0} Rat Rat Rat (@instHSub.{0} Rat Rat.instSub)\n          (@DefiKernel.Interleaving.Machine.supply P A D inst_1 inst_2 post d a)\n          (@DefiKernel.Interleaving.Machine.supply P A D inst_1 inst_2 m d a))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.LocalOrder","name":"DefiKernel.Interleaving.AdvanceSound.active_index","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {m post : DefiKernel.Interleaving.Machine P A D} {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    (∀ (own : DefiKernel.Parallel.BranchId),\n        @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m own))\n            (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)) →\n          @Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m own))\n            (@Min.min.{0} Nat instMinNat\n              (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m own))\n              (@List.length.{0} (DefiKernel.Composition.Invocation P A D)\n                (@DefiKernel.Interleaving.selectBranch P A D left right own)))) →\n      ∀ (own : DefiKernel.Parallel.BranchId),\n        @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D post own))\n            (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)) →\n          @Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n              (@DefiKernel.Interleaving.Machine.local P A D post own))\n            (@Min.min.{0} Nat instMinNat\n              (@DefiKernel.Interleaving.LocalState.consumed P A D\n                (@DefiKernel.Interleaving.Machine.local P A D post own))\n              (@List.length.{0} (DefiKernel.Composition.Invocation P A D)\n                (@DefiKernel.Interleaving.selectBranch P A D left right own)))"}
