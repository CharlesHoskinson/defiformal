INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Preservation","name":"DefiKernel.Interleaving.AdvanceSound.before_stores","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {initial : DefiKernel.Composition.World P A D} {m post : DefiKernel.Interleaving.Machine P A D}\n  {b : DefiKernel.Parallel.BranchId},\n  @DefiKernel.Interleaving.AdvanceSound P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b\n      post →\n    @Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n        (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Interleaving.Machine.world P A D m))\n        (@DefiKernel.Typed.ExecutionResult.capabilities P A D initial) →\n      (∀ (attempt : DefiKernel.Interleaving.Attempt P A D),\n          @Membership.mem.{0, 0} (DefiKernel.Interleaving.Attempt P A D)\n              (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n              (@List.instMembership.{0} (DefiKernel.Interleaving.Attempt P A D))\n              (@DefiKernel.Interleaving.Machine.attempts P A D m) attempt →\n            @Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n              (@DefiKernel.Typed.ExecutionResult.capabilities P A D\n                (@DefiKernel.Interleaving.Attempt.before P A D attempt))\n              (@DefiKernel.Typed.ExecutionResult.capabilities P A D initial)) →\n        ∀ (attempt : DefiKernel.Interleaving.Attempt P A D),\n          @Membership.mem.{0, 0} (DefiKernel.Interleaving.Attempt P A D)\n              (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n              (@List.instMembership.{0} (DefiKernel.Interleaving.Attempt P A D))\n              (@DefiKernel.