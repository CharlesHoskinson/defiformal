INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Schedule","name":"DefiKernel.Interleaving.Complete.prefix_counts","statement":"∀ {P A D : Type} {left right : DefiKernel.Parallel.Branch P A D} {preTokens suffix : DefiKernel.Interleaving.Schedule},\n  @DefiKernel.Interleaving.Complete P A D left right\n      (@HAppend.hAppend.{0, 0, 0} DefiKernel.Interleaving.Schedule DefiKernel.Interleaving.Schedule\n        DefiKernel.Interleaving.Schedule\n        (@instHAppendOfAppend.{0} DefiKernel.Interleaving.Schedule (@List.instAppend.{0} DefiKernel.Parallel.BranchId))\n        preTokens suffix) →\n    And\n      (@LE.le.{0} Nat instLENat\n        (@List.count.{0} DefiKernel.Parallel.BranchId\n          (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId)\n          DefiKernel.Parallel.BranchId.left preTokens)\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) left))\n      (@LE.le.{0} Nat instLENat\n        (@List.count.{0} DefiKernel.Parallel.BranchId\n          (@instBEqOfDecidableEq.{0} DefiKernel.Parallel.BranchId DefiKernel.Parallel.instDecidableEqBranchId)\n          DefiKernel.Parallel.BranchId.right preTokens)\n        (@List.length.{0} (DefiKernel.Composition.Invocation P A D) right))"}
