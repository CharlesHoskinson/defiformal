INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Soundness","name":"DefiKernel.Interleaving.Reachable.brecOn","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {initial : DefiKernel.Composition.World P A D}\n  {motive :\n    (a : DefiKernel.Interleaving.Machine P A D) →\n      @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial\n          a →\n        Prop}\n  {a : DefiKernel.Interleaving.Machine P A D}\n  (t :\n    @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial\n      a),\n  (∀ (a : DefiKernel.Interleaving.Machine P A D)\n      (t :\n        @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n          initial a),\n      @DefiKernel.Interleaving.Reachable.below P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n          initial motive a t →\n        motive a t) →\n    motive a t"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Trace","name":"DefiKernel.Interleaving.Reachable.congr_simp","statement":"∀ {P A D : Type} {inst : DecidableEq.{1} P} [inst_1 : DecidableEq.{1} P] {inst_2 : DecidableEq.{1} A}\n  [inst_3 : DecidableEq.{1} A] {inst_4 : DecidableEq.{1} D} [inst_5 : DecidableEq.{1} D] [inst_6 : Fintype.{0} P]\n  [inst_7 : Fintype.{0} A] [inst_8 : Fintype.{0} D] (cfg cfg_1 : DefiKernel.Composition.Config P A D),\n  @Eq.{1} (DefiKernel.Composition.Config P A D) cfg cfg_1 →\n    ∀ (boundaries boundaries_1 : DefiKernel.Parallel.ParallelBoundary P A D),\n      @Eq.{1} (DefiKernel.Parallel.ParallelBoundary P A D) boundaries boundaries_1 →\n        ∀ (left left_1 : DefiKernel.Parallel.Branch P A D),\n          @Eq.{1} (DefiKernel.Parallel.Branch P A D) left left_1 →\n            ∀ (right right_1 : DefiKernel.Parallel.Branch P A D),\n              @Eq.{1} (DefiKernel.Parallel.Branch P A D) right right_1 →\n                ∀ (initial initial_1 : DefiKernel.Composition.World P A D),\n                  @Eq.{1} (DefiKernel.Composition.World P A D) initial initial_1 →\n                    ∀ (a a_1 : DefiKernel.Interleaving.Machine P A D),\n                      @Eq.{1} (DefiKernel.Interleaving.Machine P A D) a a_1 →\n                        @Eq.{1} Prop\n                          (@DefiKernel.Interleaving.Reachable P A D inst inst_2 inst_4 inst_6 inst_7 inst_8 cfg\n                            boundaries left right initial a)\n                          (@DefiKernel.Interleaving.Reachable P A D inst_1 inst_3 inst_5 inst_6 inst_7 inst_8 cfg_1\n                            boundaries_1 left_1 right_1 initial_1 a_1)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Trace","name":"DefiKernel.Interleaving.Reachable.failure_index","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {initial : DefiKernel.Composition.World P A D} {m : DefiKernel.Interleaving.Machine P A D},\n  @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial m →\n    ∀ (b : DefiKernel.Parallel.BranchId) (failure : DefiKernel.Composition.LocatedFailure P A D),\n      @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n          (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m b))\n          (@Option.some.{0} (DefiKernel.Composition.LocatedFailure P A D) failure) →\n        @Eq.{1} Nat (@DefiKernel.Composition.LocatedFailure.index P A D failure)\n          (@DefiKernel.Interleaving.LocalState.nextIndex P A D (@DefiKernel.Interleaving.Machine.local P A D m b))"}
