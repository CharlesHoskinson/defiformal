INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Soundness","name":"DefiKernel.Interleaving.Reachable.store","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {initial : DefiKernel.Composition.World P A D} {m : DefiKernel.Interleaving.Machine P A D},\n  @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial m →\n    @Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n      (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Interleaving.Machine.world P A D m))\n      (@DefiKernel.Typed.ExecutionResult.capabilities P A D initial)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Interference","name":"DefiKernel.Interleaving.Reachable.two_invariants","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundaries : DefiKernel.Parallel.ParallelBoundary P A D} {left right : DefiKernel.Parallel.Branch P A D}\n  {initial : DefiKernel.Composition.World P A D} {m : DefiKernel.Interleaving.Machine P A D},\n  @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial m →\n    ∀ (invariant : DefiKernel.Parallel.BranchId → DefiKernel.Interleaving.LedgerPredicate P A D)\n      (guarantee rely : DefiKernel.Parallel.BranchId → DefiKernel.Interleaving.LedgerRelation P A D),\n      (∀ (b : DefiKernel.Parallel.BranchId), invariant b (@DefiKernel.Typed.ExecutionResult.state P A D initial)) →\n        @DefiKernel.Interleaving.LocalObligation P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n            invariant guarantee →\n          @DefiKernel.Interleaving.CrossInclusion P A D guarantee rely →\n            @DefiKernel.Interleaving.Stable P A D invariant rely →\n              ∀ (b : DefiKernel.Parallel.BranchId),\n                invariant b\n                  (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D m))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Step","name":"DefiKernel.Interleaving.Recovery.admitted_analysis","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (b : DefiKernel.Parallel.BranchId),\n      @Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n        (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries b)\n          (@DefiKernel.Interleaving.selectBranch P A D left right b))\n        (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D)\n          (@DefiKernel.Interleaving.Recovery.footprint P A D lf rf b))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Step","name":"DefiKernel.Interleaving.Recovery.advance_branch_frame","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (m : DefiKernel.Interleaving.Machine P A D),\n      @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial\n          m →\n        ∀ (b : DefiKernel.Parallel.BranchId),\n          ∀ c ∉ @DefiKernel.Parallel.Footprint.writes P A D (@DefiKernel.Interleaving.Recovery.footprint P A D lf rf b),\n            @Eq.{1} Rat\n              (@DefiKernel.Typed.State.balance P A D\n                (@DefiKernel.Typed.ExecutionResult.state P A D\n                  (@DefiKernel.Interleaving.Machine.world P A D\n                    (@DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left\n                      right m b)))\n                c)\n              (@DefiKernel.Typed.State.balance P A D\n                (@DefiKernel.Typed.ExecutionResult.state P A D (@DefiKernel.Interleaving.Machine.world P A D m)) c)"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Step","name":"DefiKernel.Interleaving.Recovery.advance_exhausted_cursor","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (m : DefiKernel.Interleaving.Machine P A D) (b : DefiKernel.Parallel.BranchId),\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n      (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat (DefiKernel.Composition.Invocation P A D)\n        (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n        (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D))\n        (@DefiKernel.Interleaving.selectBranch P A D left right b)\n        (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m b)))\n      (@Option.none.{0} (DefiKernel.Composition.Invocation P A D)) →\n    have post :=\n      @DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b;\n    @Eq.{1} (DefiKernel.Composition.Cursor P A D)\n      (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Interleaving.Machine.local P A D post b)\n        (@DefiKernel.Interleaving.Machine.world P A D post))\n      (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Interleaving.Machine.local P A D m b)\n        (@DefiKernel.Interleaving.Machine.world P A D m))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Simulation","name":"DefiKernel.Interleaving.Recovery.advance_own_agrees","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (initial : DefiKernel.Composition.World P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Parallel.admit P A D inst inst_1 inst_2 cfg boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Parallel.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    ∀ (m : DefiKernel.Interleaving.Machine P A D),\n      @DefiKernel.Interleaving.Reachable P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right initial\n          m →\n        ∀ (b : DefiKernel.Parallel.BranchId),\n          @DefiKernel.Parallel.CursorAgrees P A D\n              (@Set.ofPred.{0} (DefiKernel.Typed.Cell P A D) fun c =>\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                  (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                  (@DefiKernel.Parallel.Footprint.reads P A D\n                    (@DefiKernel.Interleaving.Recovery.footprint P A D lf rf b))\n                  c)\n              (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Interleaving.Machine.local P A D m b)\n                (@DefiKernel.Interleaving.Machine.world P A D m))\n              (@DefiKernel.Interleaving.Recovery.isolated P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n                (boundaries b) initial (@DefiKernel.Interleaving.selectBranch P A D left right b)\n                (@DefiKernel.Interleaving.LocalState.consumed P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D m b))) →\n            have post :=\n              @DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m\n                b;\n            @DefiKernel.Parallel.CursorAgrees P A D\n              (@Set.ofPred.{0} (DefiKernel.Typed.Cell P A D) fun c =>\n                @Membership.mem.{0, 0} (DefiKernel.Typed.Cell P A D) (List.{0} (DefiKernel.Typed.Cell P A D))\n                  (@List.instMembership.{0} (DefiKernel.Typed.Cell P A D))\n                  (@DefiKernel.Parallel.Footprint.reads P A D\n                    (@DefiKernel.Interleaving.Recovery.footprint P A D lf rf b))\n                  c)\n              (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Interleaving.Machine.local P A D post b)\n                (@DefiKernel.Interleaving.Machine.world P A D post))\n              (@DefiKernel.Interleaving.Recovery.isolated P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n                (boundaries b) initial (@DefiKernel.Interleaving.selectBranch P A D left right b)\n                (@DefiKernel.Interleaving.LocalState.consumed P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D post b)))"}
INTERLEAVING_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"DefiKernel.Interleaving.Recovery.Step","name":"DefiKernel.Interleaving.Recovery.advance_own_cursor","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (m : DefiKernel.Interleaving.Machine P A D) (b : DefiKernel.Parallel.BranchId)\n  (inv : DefiKernel.Composition.Invocation P A D),\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n      (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat (DefiKernel.Composition.Invocation P A D)\n        (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n        (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D))\n        (@DefiKernel.Interleaving.selectBranch P A D left right b)\n        (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m b)))\n      (@Option.some.{0} (DefiKernel.Composition.Invocation P A D) inv) →\n    have post :=\n      @DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m b;\n    @Eq.{1} (DefiKernel.Composition.Cursor P A D)\n      (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Interleaving.Machine.local P A D post b)\n        (@DefiKernel.Interleaving.Machine.world P A D post))\n      (@DefiKernel.Composition.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg (boundaries b)\n        (@DefiKernel.Interleaving.LocalState.toCursor P A D (@DefiKernel.Interleaving.Machine.local P A D m b)\n          (@DefiKernel.Interleaving.Machine.world P A D m))\n        (@DefiKernel.Composition.Step.invoke P A D inv))"}
