tempt P A D))\n          (@DefiKernel.Interleaving.Machine.attempts P A D\n            (@DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m\n              branch))\n          (@List.length.{0} (DefiKernel.Interleaving.Attempt P A D)\n            (@DefiKernel.Interleaving.Machine.attempts P A D m)))\n        (@Option.some.{0} (DefiKernel.Interleaving.Attempt P A D)\n          (@DefiKernel.Interleaving.Attempt.mk P A D branch\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n              (@DefiKernel.Interleaving.Machine.local P A D m branch))\n            inv (@DefiKernel.Interleaving.Machine.world P A D m)\n            (@DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg\n              (boundaries branch\n                (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                  (@DefiKernel.Interleaving.Machine.local P A D m branch)))\n              (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n                (@DefiKernel.Interleaving.Machine.local P A D m branch))\n              (@DefiKernel.Interleaving.LocalState.outputs P A D\n                (@DefiKernel.Interleaving.Machine.local P A D m branch))\n              (@DefiKernel.Composition.Step.invoke P A D inv) (@DefiKernel.Interleaving.Machine.world P A D m))))","user_name":"DefiKernel.Atomic.interleaving_advance_attempt"}
