ATOMIC_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.residuals_eq_filterMap_product","statement":"∀ {P A D : Type} (policy : DefiKernel.Atomic.Policy P A D) (owed : DefiKernel.Atomic.Outstanding P A D),\n  @Eq.{1} (List.{0} (DefiKernel.Atomic.Residual P A D)) (@DefiKernel.Atomic.residuals P A D policy owed)\n    (@List.filterMap.{0, 0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) P) (DefiKernel.Atomic.Residual P A D)\n      (fun key =>\n        @ite.{1} (Option.{0} (DefiKernel.Atomic.Residual P A D))\n          (@Eq.{1} Rat\n            (owed (@Prod.fst.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)\n              (@Prod.snd.{0, 0} (DefiKernel.Atomic.Lane P A D) P key))\n            (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))))\n          (instDecidableEqRat\n            (owed (@Prod.fst.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)\n              (@Prod.snd.{0, 0} (DefiKernel.Atomic.Lane P A D) P key))\n            (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))))\n          (@Option.none.{0} (DefiKernel.Atomic.Residual P A D))\n          (@Option.some.{0} (DefiKernel.Atomic.Residual P A D)\n            (@DefiKernel.Atomic.Residual.mk P A D (@Prod.fst.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)\n              (@Prod.snd.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)\n              (owed (@Prod.fst.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)\n                (@Prod.snd.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)))))\n      (@List.product.{0, 0} (DefiKernel.Atomic.Lane P A D) P (@DefiKernel.Atomic.Policy.lanes P A D policy)\n        (@DefiKernel.Atomic.Policy.participants P A D policy)))","user_name":"DefiKernel.Atomic.residuals_eq_filterMap_product"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.residuals_eq_nil_iff","statement":"∀ {P A D : Type} (policy : DefiKernel.Atomic.Policy P A D) (owed : DefiKernel.Atomic.Outstanding P A D),\n  Iff\n    (@Eq.{1} (List.{0} (DefiKernel.Atomic.Residual P A D)) (@DefiKernel.Atomic.residuals P A D policy owed)\n      (@List.nil.{0} (DefiKernel.Atomic.Residual P A D)))\n    (∀ (lane : DefiKernel.Atomic.Lane P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Atomic.Lane P A D) (List.{0} (DefiKernel.Atomic.Lane P A D))\n          (@List.instMembership.{0} (DefiKernel.Atomic.Lane P A D)) (@DefiKernel.Atomic.Policy.lanes P A D policy)\n          lane →\n        ∀ (p : P),\n          @Membership.mem.{0, 0} P (List.{0} P) (@List.instMembership.{0} P)\n              (@DefiKernel.Atomic.Policy.participants P A D policy) p →\n            @Eq.{1} Rat (owed lane p) (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))))","user_name":"DefiKernel.Atomic.residuals_eq_nil_iff"}
ATOMIC_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.residuals_keys","statement":"∀ {P A D : Type} (policy : DefiKernel.Atomic.Policy P A D) (owed : DefiKernel.Atomic.Outstanding P A D),\n  @Eq.{1} (List.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) P))\n    (@List.map.{0, 0} (DefiKernel.Atomic.Residual P A D) (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) P)\n      (fun r =>\n        @Prod.mk.{0, 0} (DefiKernel.Atomic.Lane P A D) P (@DefiKernel.Atomic.Residual.lane P A D r)\n          (@DefiKernel.Atomic.Residual.principal P A D r))\n      (@DefiKernel.Atomic.residuals P A D policy owed))\n    (@List.filter.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) P)\n      (fun key =>\n        @bne.{0} Rat (@instBEqOfDecidableEq.{0} Rat instDecidableEqRat)\n          (owed (@Prod.fst.{0, 0} (DefiKernel.Atomic.Lane P A D) P key)\n            (@Prod.snd.{0, 0} (DefiKernel.Atomic.Lane P A D) P key))\n          (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))))\n      (@List.product.{0, 0} (DefiKernel.Atomic.Lane P A D) P (@DefiKernel.Atomic.Policy.lanes P A D policy)\n        (@DefiKernel.Atomic.Policy.participants P A D policy)))","user_name":"DefiKernel.Atomic.residuals_keys"}
ATOMIC_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.residuals_keys_nodup","statement":"∀ {P A D : Type} (policy : DefiKernel.Atomic.Policy P A D) (owed : DefiKernel.Atomic.Outstanding P A D),\n  @List.Nodup.{0} (DefiKernel.Atomic.Lane P A D) (@DefiKernel.Atomic.Policy.lanes P A D policy) →\n    @List.Nodup.{0} P (@DefiKernel.Atomic.Policy.participants P A D policy) →\n      @List.Nodup.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) P)\n        (@List.map.{0, 0} (DefiKernel.Atomic.Residual P A D) (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) P)\n          (fun r =>\n            @Prod.mk.{0, 0} (DefiKernel.Atomic.Lane P A D) P (@DefiKernel.Atomic.Residual.lane P A D r)\n              (@DefiKernel.Atomic.Residual.principal P A D r))\n          (@DefiKernel.Atomic.residuals P A D policy owed))","user_name":"DefiKernel.Atomic.residuals_keys_nodup"}
