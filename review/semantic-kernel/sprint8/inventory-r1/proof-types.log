ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.checkPolicy_covers","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (left right : DefiKernel.Parallel.Branch P A D),\n  @Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n      (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}) →\n    ∀ (b : DefiKernel.Parallel.BranchId) (i : Nat),\n      @LT.lt.{0} Nat instLTNat i\n          (@List.length.{0} (DefiKernel.Composition.Invocation P A D)\n            (@DefiKernel.Interleaving.selectBranch P A D left right b)) →\n        @Membership.mem.{0, 0} P (List.{0} P) (@List.instMembership.{0} P)\n          (@DefiKernel.Atomic.Policy.participants P A D policy)\n          (@DefiKernel.Typed.InvocationContext.principal P D\n            (@DefiKernel.Composition.Boundary.ctx P A D (boundaries b i)))","user_name":"DefiKernel.Atomic.checkPolicy_covers"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.checkPolicy_lanes_nodup","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (left right : DefiKernel.Parallel.Branch P A D),\n  @Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n      (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}) →\n    @List.Nodup.{0} (DefiKernel.Atomic.Lane P A D) (@DefiKernel.Atomic.Policy.lanes P A D policy)","user_name":"DefiKernel.Atomic.checkPolicy_lanes_nodup"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.checkPolicy_ok_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (left right : DefiKernel.Parallel.Branch P A D),\n  Iff\n    (@Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n      (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}))\n    (And\n      (@List.Nodup.{0} (Prod.{0, 0} D A)\n        (@List.map.{0, 0} (DefiKernel.Atomic.Lane P A D) (Prod.{0, 0} D A)\n          (fun lane =>\n            @Prod.mk.{0, 0} D A (@DefiKernel.Atomic.Lane.domain P A D lane) (@DefiKernel.Atomic.Lane.asset P A D lane))\n          (@DefiKernel.Atomic.Policy.lanes P A D policy)))\n      (And (@List.Nodup.{0} P (@DefiKernel.Atomic.Policy.participants P A D policy))\n        (And\n          (∀ (i : Nat),\n            @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) left) →\n              @Membership.mem.{0, 0} P (List.{0} P) (@List.instMembership.{0} P)\n                (@DefiKernel.Atomic.Policy.participants P A D policy)\n                (@DefiKernel.Typed.InvocationContext.principal P D\n                  (@DefiKernel.Composition.Boundary.ctx P A D (boundaries DefiKernel.Parallel.BranchId.left i))))\n          (∀ (i : Nat),\n            @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) right) →\n              @Membership.mem.{0, 0} P (List.{0} P) (@List.instMembership.{0} P)\n                (@DefiKernel.Atomic.Policy.participants P A D policy)\n                (@DefiKernel.Typed.InvocationContext.principal P D\n                  (@DefiKernel.Composition.Boundary.ctx P A D (boundaries DefiKernel.Parallel.BranchId.right i)))))))","user_name":"DefiKernel.Atomic.checkPolicy_ok_iff"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.checkPolicy_participants_nodup","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (left right : DefiKernel.Parallel.Branch P A D),\n  @Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n      (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}) →\n    @List.Nodup.{0} P (@DefiKernel.Atomic.Policy.participants P A D policy)","user_name":"DefiKernel.Atomic.checkPolicy_participants_nodup"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.checkSupply_none_iff","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} A] [inst_1 : DecidableEq.{1} D] (policy : DefiKernel.Atomic.Policy P A D)\n  (receipt : DefiKernel.Composition.Receipt P A D),\n  Iff\n    (@Eq.{1} (Option.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) Rat))\n      (@DefiKernel.Atomic.checkSupply P A D inst inst_1 policy receipt)\n      (@Option.none.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) Rat)))\n    (∀ (lane : DefiKernel.Atomic.Lane P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Atomic.Lane P A D) (List.{0} (DefiKernel.Atomic.Lane P A D))\n          (@List.instMembership.{0} (DefiKernel.Atomic.Lane P A D)) (@DefiKernel.Atomic.Policy.lanes P A D policy)\n          lane →\n        @Eq.{1} Rat\n          (@DefiKernel.Composition.Receipt.supply P A D inst inst_1 receipt (@DefiKernel.Atomic.Lane.domain P A D lane)\n            (@DefiKernel.Atomic.Lane.asset P A D lane))\n          (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0))))","user_name":"DefiKernel.Atomic.checkSupply_none_iff"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Execution","name":"DefiKernel.Atomic.continueRun_aborted","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (m : DefiKernel.Atomic.Machine P A D)\n  (s : DefiKernel.Interleaving.Schedule) (reason : DefiKernel.Atomic.AbortReason P A D),\n  @Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D)) (@DefiKernel.Atomic.Machine.abort P A D m)\n      (@Option.some.{0} (DefiKernel.Atomic.AbortReason P A D) reason) →\n    @Eq.{1} (DefiKernel.Atomic.Machine P A D)\n      (@DefiKernel.Atomic.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right m\n        s)\n      m","user_name":"DefiKernel.Atomic.continueRun_aborted"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Execution","name":"DefiKernel.Atomic.continueRun_append","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (m : DefiKernel.Atomic.Machine P A D)\n  (s t : DefiKernel.Interleaving.Schedule),\n  @Eq.{1} (DefiKernel.Atomic.Machine P A D)\n    (@DefiKernel.Atomic.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right m\n      (@HAppend.hAppend.{0, 0, 0} DefiKernel.Interleaving.Schedule DefiKernel.Interleaving.Schedule\n        DefiKernel.Interleaving.Schedule\n        (@instHAppendOfAppend.{0} DefiKernel.Interleaving.Schedule (@List.instAppend.{0} DefiKernel.Parallel.BranchId))\n        s t))\n    (@DefiKernel.Atomic.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right\n      (@DefiKernel.Atomic.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right m\n        s)\n      t)","user_name":"DefiKernel.Atomic.continueRun_append"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Correspondence","name":"DefiKernel.Atomic.continueRun_no_abort_of_good_attempts","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (m : DefiKernel.Atomic.Machine P A D)\n  (schedule : DefiKernel.Interleaving.Schedule),\n  @Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D)) (@DefiKernel.Atomic.Machine.abort P A D m)\n      (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D)) →\n    @DefiKernel.Atomic.GoodAttempts P A D inst_1 inst_2 policy\n        (@DefiKernel.Interleaving.Machine.attempts P A D\n          (@DefiKernel.Interleaving.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n            (@DefiKernel.Atomic.Machine.speculative P A D m) schedule)) →\n      @Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D))\n        (@DefiKernel.Atomic.Machine.abort P A D\n          (@DefiKernel.Atomic.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right\n            m schedule))\n        (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D))","user_name":"DefiKernel.Atomic.continueRun_no_abort_of_good_attempts"}
