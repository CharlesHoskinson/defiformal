osition.Failure (DefiKernel.Composition.StepResult P A D))\n            (@DefiKernel.Interleaving.Attempt.outcome P A D attempt)\n            (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) result))\n          (@Eq.{1} (Option.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) Rat))\n            (@DefiKernel.Atomic.checkSupply P A D inst_1 inst_2 policy\n              (@DefiKernel.Composition.StepResult.receipt P A D result))\n            (@Option.none.{0} (Prod.{0, 0} (DefiKernel.Atomic.Lane P A D) Rat)))","user_name":"DefiKernel.Atomic.advance_last_good"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Correspondence","name":"DefiKernel.Atomic.advance_no_abort_of_good_attempts","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (m : DefiKernel.Atomic.Machine P A D)\n  (b : DefiKernel.Parallel.BranchId),\n  @Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D)) (@DefiKernel.Atomic.Machine.abort P A D m)\n      (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D)) →\n    @DefiKernel.Atomic.GoodAttempts P A D inst_1 inst_2 policy\n        (@DefiKernel.Interleaving.Machine.attempts P A D\n          (@DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n            (@DefiKernel.Atomic.Machine.speculative P A D m) b)) →\n      @Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D))\n        (@DefiKernel.Atomic.Machine.abort P A D\n          (@DefiKernel.Atomic.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right m\n            b))\n        (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D))","user_name":"DefiKernel.Atomic.advance_no_abort_of_good_attempts"}
