ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Preservation","name":"DefiKernel.Atomic.runAtomic_two_invariants","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule)\n  (invariant : DefiKernel.Parallel.BranchId → DefiKernel.Interleaving.LedgerPredicate P A D)\n  (guarantee rely : DefiKernel.Parallel.BranchId → DefiKernel.Interleaving.LedgerRelation P A D),\n  (∀ (b : DefiKernel.Parallel.BranchId), invariant b (@DefiKernel.Typed.ExecutionResult.state P A D initial)) →\n    @DefiKernel.Interleaving.LocalObligation P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n        invariant guarantee →\n      @DefiKernel.Interleaving.CrossInclusion P A D guarantee rely →\n        @DefiKernel.Interleaving.Stable P A D invariant rely →\n          ∀ (b : DefiKernel.Parallel.BranchId),\n            invariant b\n              (@DefiKernel.Typed.ExecutionResult.state P A D\n                (@DefiKernel.Atomic.Result.publicWorld P A D\n                  (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label\n                    policy initial left right schedule)))","user_name":"DefiKernel.Atomic.runAtomic_two_invariants"}
