q.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D))\n              (@DefiKernel.Atomic.Machine.abort P A D\n                (@DefiKernel.Atomic.continueRun P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left\n                  right m schedule))\n              (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D)) →\n            @Eq.{1} DefiKernel.Interleaving.Schedule suffix (@List.nil.{0} DefiKernel.Parallel.BranchId))))","user_name":"DefiKernel.Atomic.continueRun_prefix"}
