ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Soundness","name":"DefiKernel.Atomic.interleaving_advance_appended","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (m : DefiKernel.Interleaving.Machine P A D) (branch : DefiKernel.Parallel.BranchId)\n  (inv : DefiKernel.Composition.Invocation P A D),\n  @Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n      (@DefiKernel.Interleaving.LocalState.failure P A D (@DefiKernel.Interleaving.Machine.local P A D m branch))\n      (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)) →\n    @Eq.{1} (Option.{0} (DefiKernel.Composition.Invocation P A D))\n        (@GetElem?.getElem?.{0, 0, 0} (DefiKernel.Parallel.Branch P A D) Nat (DefiKernel.Composition.Invocation P A D)\n          (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Composition.Invocation P A D) as))\n          (@List.instGetElem?NatLtLength.{0} (DefiKernel.Composition.Invocation P A D))\n          (@DefiKernel.Interleaving.selectBranch P A D left right branch)\n          (@DefiKernel.Interleaving.LocalState.consumed P A D (@DefiKernel.Interleaving.Machine.local P A D m branch)))\n        (@Option.some.{0} (DefiKernel.Composition.Invocation P A D) inv) →\n      @Eq.{1} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n        (@DefiKernel.Interleaving.Machine.attempts P A D\n          (@DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right m\n            branch))\n        (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (List.{0} (DefiKernel.Interleaving.