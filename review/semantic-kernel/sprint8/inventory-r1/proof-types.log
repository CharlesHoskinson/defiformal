ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Settlement","name":"DefiKernel.Atomic.runPrefix_cash_owed","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule),\n  @Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n      (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}) →\n    ∀ (lane : DefiKernel.Atomic.Lane P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Atomic.Lane P A D) (List.{0} (DefiKernel.Atomic.Lane P A D))\n          (@List.instMembership.{0} (DefiKernel.Atomic.Lane P A D)) (@DefiKernel.Atomic.Policy.lanes P A D policy)\n          lane →\n        @Eq.{1} Rat\n          (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n            (@DefiKernel.Typed.State.balance P A D\n              (@DefiKernel.Typed.ExecutionResult.state P A D\n                (@DefiKernel.Interleaving.Machine.world P A D\n                  (@DefiKernel.Atomic.Machine.speculative P A D\n                    (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy\n                      initial left right schedule))))\n              (@DefiKernel.Atomic.Lane.cell P A D lane))\n            (@List.sum.{0} Rat Rat.instAdd\n              (@MulZeroClass.toZero.{0} Rat (@instMulZeroClassOfSemiring.{0} Rat Rat.semiring))\n              (@List.map.{0, 0} P Rat\n                (@DefiKernel.Atomic.Machine.outstanding P A D\n                  (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy\n                    initial left right schedule)\n                  lane)\n                (@DefiKernel.Atomic.Policy.participants P A D policy))))\n          (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D initial)\n            (@DefiKernel.Atomic.Lane.cell P A D lane))","user_name":"DefiKernel.Atomic.runPrefix_cash_owed"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Completion","name":"DefiKernel.Atomic.runPrefix_complete_active_exhaustion","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule),\n  @DefiKernel.Interleaving.Complete P A D left right schedule →\n    @Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D))\n        (@DefiKernel.Atomic.Machine.abort P A D\n          (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy initial left\n            right schedule))\n        (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D)) →\n      ∀ (b : DefiKernel.Parallel.BranchId),\n        And\n          (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D\n              (@DefiKernel.Interleaving.Machine.local P A D\n                (@DefiKernel.Atomic.Machine.speculative P A D\n                  (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy\n                    initial left right schedule))\n                b))\n            (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)))\n          (@Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n              (@DefiKernel.Interleaving.Machine.local P A D\n                (@DefiKernel.Atomic.Machine.speculative P A D\n                  (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy\n                    initial left right schedule))\n                b))\n            (@List.length.{0} (DefiKernel.Composition.Invocation P A D)\n              (@DefiKernel.Interleaving.selectBranch P A D left right b)))","user_name":"DefiKernel.Atomic.runPrefix_complete_active_exhaustion"}
