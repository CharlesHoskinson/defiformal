ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Settlement","name":"DefiKernel.Atomic.attemptOutstanding.eq_1","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (owed : DefiKernel.Atomic.Outstanding P A D) (attempt : DefiKernel.Interleaving.Attempt P A D),\n  @Eq.{1} (DefiKernel.Atomic.Outstanding P A D)\n    (@DefiKernel.Atomic.attemptOutstanding P A D inst inst_1 inst_2 policy boundaries owed attempt)\n    (@DefiKernel.Atomic.attemptOutstanding.match_1.{1} P A D (fun x => DefiKernel.Atomic.Outstanding P A D)\n      (@DefiKernel.Interleaving.Attempt.outcome P A D attempt) (fun a => owed) fun result =>\n      @DefiKernel.Atomic.updateOutstanding P A D inst inst_1 inst_2 policy owed\n        (@DefiKernel.Typed.InvocationContext.principal P D\n          (@DefiKernel.Composition.Boundary.ctx P A D\n            (boundaries (@DefiKernel.Interleaving.Attempt.branch P A D attempt)\n              (@DefiKernel.Interleaving.Attempt.index P A D attempt))))\n        (@DefiKernel.Composition.StepResult.receipt P A D result))","user_name":"DefiKernel.Atomic.attemptOutstanding.eq_1"}
