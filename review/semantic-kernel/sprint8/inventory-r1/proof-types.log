ATOMIC_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.PolicyProofs","name":"DefiKernel.Atomic.mem_residuals_iff","statement":"∀ {P A D : Type} (policy : DefiKernel.Atomic.Policy P A D) (owed : DefiKernel.Atomic.Outstanding P A D)\n  (r : DefiKernel.Atomic.Residual P A D),\n  Iff\n    (@Membership.mem.{0, 0} (DefiKernel.Atomic.Residual P A D) (List.{0} (DefiKernel.Atomic.Residual P A D))\n      (@List.instMembership.{0} (DefiKernel.Atomic.Residual P A D)) (@DefiKernel.Atomic.residuals P A D policy owed) r)\n    (And\n      (@Membership.mem.{0, 0} (DefiKernel.Atomic.Lane P A D) (List.{0} (DefiKernel.Atomic.Lane P A D))\n        (@List.instMembership.{0} (DefiKernel.Atomic.Lane P A D)) (@DefiKernel.Atomic.Policy.lanes P A D policy)\n        (@DefiKernel.Atomic.Residual.lane P A D r))\n      (And\n        (@Membership.mem.{0, 0} P (List.{0} P) (@List.instMembership.{0} P)\n          (@DefiKernel.Atomic.Policy.participants P A D policy) (@DefiKernel.Atomic.Residual.principal P A D r))\n        (And\n          (@Eq.{1} Rat (@DefiKernel.Atomic.Residual.amount P A D r)\n            (owed (@DefiKernel.Atomic.Residual.lane P A D r) (@DefiKernel.Atomic.Residual.principal P A D r)))\n          (@Ne.{1} Rat (@DefiKernel.Atomic.Residual.amount P A D r)\n            (@OfNat.ofNat.{0} Rat (nat_lit 0) (@Rat.instOfNat (nat_lit 0)))))))","user_name":"DefiKernel.Atomic.mem_residuals_iff"}
