ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Settlement","name":"DefiKernel.Atomic.accepted_cash_owed","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] {cfg : DefiKernel.Composition.Config P A D}\n  {boundary : DefiKernel.Composition.Boundary P A D} {index : Nat}\n  {history : List.{0} (DefiKernel.Composition.OutputObservation A)} {inv : DefiKernel.Composition.Invocation P A D}\n  {pre : DefiKernel.Composition.World P A D} {result : DefiKernel.Composition.StepResult P A D},\n  @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D))\n      (@DefiKernel.Composition.executeStep P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundary index history\n        (@DefiKernel.Composition.Step.invoke P A D inv) pre)\n      (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) result) →\n    ∀ (policy : DefiKernel.Atomic.Policy P A D) (owed : DefiKernel.Atomic.Outstanding P A D)\n      (lane : DefiKernel.Atomic.Lane P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Atomic.Lane P A D) (List.{0} (DefiKernel.Atomic.Lane P A D))\n          (@List.instMembership.{0} (DefiKernel.Atomic.Lane P A D)) (@DefiKernel.Atomic.Policy.lanes P A D policy)\n          lane →\n        @List.Nodup.{0} P (@DefiKernel.Atomic.Policy.participants P A D policy) →\n          @Membership.mem.{0, 0} P (List.{0} P) (@List.instMembership.{0} P)\n              (@DefiKernel.Atomic.Policy.participants P A D policy)\n              (@DefiKernel.Typed.InvocationContext.principal P D\n                (@DefiKernel.Composition.Boundary.ctx P A D boundary)) →\n            @Eq.{1} Rat\n              (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n                (@DefiKernel.Typed.State.balance P A D\n                  (@DefiKernel.Typed.ExecutionResult.state P A D\n                    (@DefiKernel.Composition.StepResult.world P A D result))\n                  (@DefiKernel.Atomic.Lane.cell P A D lane))\n                (@List.sum.{0} Rat Rat.instAdd\n                  (@MulZeroClass.toZero.{0} Rat (@instMulZeroClassOfSemiring.{0} Rat Rat.semiring))\n                  (@List.map.{0, 0} P Rat\n                    (@DefiKernel.Atomic.updateOutstanding P A D inst inst_1 inst_2 policy owed\n                      (@DefiKernel.Typed.InvocationContext.principal P D\n                        (@DefiKernel.Composition.Boundary.ctx P A D boundary))\n                      (@DefiKernel.Composition.StepResult.receipt P A D result) lane)\n                    (@DefiKernel.Atomic.Policy.participants P A D policy))))\n              (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n                (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D pre)\n                  (@DefiKernel.Atomic.Lane.cell P A D lane))\n                (@List.sum.{0} Rat Rat.instAdd\n                  (@MulZeroClass.toZero.{0} Rat (@instMulZeroClassOfSemiring.{0} Rat Rat.semiring))\n                  (@List.map.{0, 0} P Rat (owed lane) (@DefiKernel.Atomic.Policy.participants P A D policy))))","user_name":"DefiKernel.Atomic.accepted_cash_owed"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Admission","name":"DefiKernel.Atomic.admit_interleaving","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (policy : DefiKernel.Atomic.Policy P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Atomic.admit P A D inst inst_1 inst_2 cfg boundaries policy left right schedule)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Interleaving.admit P A D inst inst_1 inst_2 cfg boundaries left right schedule)\n      (@Except.ok.{0, 0} (DefiKernel.Interleaving.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf))","user_name":"DefiKernel.Atomic.admit_interleaving"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Admission","name":"DefiKernel.Atomic.admit_of_checks","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (policy : DefiKernel.Atomic.Policy P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1} Bool\n      (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n        (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n      Bool.true →\n    @Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n        (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries DefiKernel.Parallel.BranchId.left)\n          left)\n        (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) lf) →\n      @Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n          (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg\n            (boundaries DefiKernel.Parallel.BranchId.right) right)\n          (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) rf) →\n        @Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n            (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n            (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}) →\n          @DefiKernel.Interleaving.Complete P A D left right schedule →\n            @Eq.{1}\n              (Except.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n                (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n              (@DefiKernel.Atomic.admit P A D inst inst_1 inst_2 cfg boundaries policy left right schedule)\n              (@Except.ok.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n                (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n                (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf))","user_name":"DefiKernel.Atomic.admit_of_checks"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Admission","name":"DefiKernel.Atomic.admit_ok","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (cfg : DefiKernel.Composition.Config P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (policy : DefiKernel.Atomic.Policy P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Atomic.admit P A D inst inst_1 inst_2 cfg boundaries policy left right schedule)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    And\n      (@Eq.{1} Bool\n        (@DefiKernel.Composition.validateCatalog P A D inst inst_1 inst_2\n          (@DefiKernel.Composition.Config.registry P A D cfg) (@DefiKernel.Composition.Config.catalog P A D cfg))\n        Bool.true)\n      (And\n        (@Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n          (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg\n            (boundaries DefiKernel.Parallel.BranchId.left) left)\n          (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) lf))\n        (And\n          (@Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n            (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg\n              (boundaries DefiKernel.Parallel.BranchId.right) right)\n            (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) rf))\n          (And\n            (@Eq.{1} (Except.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1})\n              (@DefiKernel.Atomic.checkPolicy P A D inst inst_1 inst_2 policy boundaries left right)\n              (@Except.ok.{0, 0} (DefiKernel.Atomic.PolicyFailure P A D) PUnit.{1} PUnit.unit.{1}))\n            (@DefiKernel.Interleaving.Complete P A D left right schedule))))","user_name":"DefiKernel.Atomic.admit_ok"}
