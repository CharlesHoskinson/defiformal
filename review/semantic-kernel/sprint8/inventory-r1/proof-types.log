ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Preservation","name":"DefiKernel.Atomic.runAtomic_accounting","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (d : D) (a : A),\n  @Eq.{1} Rat\n    (@DefiKernel.Typed.total P A D inst_3\n      (@DefiKernel.Typed.ExecutionResult.state P A D\n        (@DefiKernel.Atomic.Result.publicWorld P A D\n          (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy\n            initial left right schedule)))\n      d a)\n    (@HAdd.hAdd.{0, 0, 0} Rat Rat Rat (@instHAdd.{0} Rat Rat.instAdd)\n      (@DefiKernel.Typed.total P A D inst_3 (@DefiKernel.Typed.ExecutionResult.state P A D initial) d a)\n      (@DefiKernel.Atomic.committedSupply P A D inst_1 inst_2\n        (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n          left right schedule)\n        d a))","user_name":"DefiKernel.Atomic.runAtomic_accounting"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Preservation","name":"DefiKernel.Atomic.runAtomic_analyzed_locality","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n      (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries DefiKernel.Parallel.BranchId.left)\n        left)\n      (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) lf) →\n    @Eq.{1} (Except.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D))\n        (@DefiKernel.Parallel.analyzeBranch P A D inst inst_1 inst_2 cfg (boundaries DefiKernel.Parallel.BranchId.right)\n          right)\n        (@Except.ok.{0, 0} DefiKernel.Parallel.LocalFailure (DefiKernel.Parallel.Footprint P A D) rf) →\n      ∀\n        c ∉\n          @HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Typed.Cell P A D)) (List.{0} (DefiKernel.Typed.Cell P A D))\n            (List.{0} (DefiKernel.Typed.Cell P A D))\n            (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Typed.Cell P A D))\n              (@List.instAppend.{0} (DefiKernel.Typed.Cell P A D)))\n            (@DefiKernel.Parallel.Footprint.writes P A D lf) (@DefiKernel.Parallel.Footprint.writes P A D rf),\n        @Eq.{1} Rat\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D\n              (@DefiKernel.Atomic.Result.publicWorld P A D\n                (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy\n                  initial left right schedule)))\n            c)\n          (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D initial) c)","user_name":"DefiKernel.Atomic.runAtomic_analyzed_locality"}
