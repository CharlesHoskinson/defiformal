ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Execution","name":"DefiKernel.Atomic.advance.eq_1","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (policy : DefiKernel.Atomic.Policy P A D)\n  (left right : DefiKernel.Parallel.Branch P A D) (m : DefiKernel.Atomic.Machine P A D)\n  (branch : DefiKernel.Parallel.BranchId),\n  @Eq.{1} (DefiKernel.Atomic.Machine P A D)\n    (@DefiKernel.Atomic.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy left right m branch)\n    (@DefiKernel.Atomic.advance.match_5.{1} P A D (fun x => DefiKernel.Atomic.Machine P A D)\n      (@DefiKernel.Atomic.Machine.abort P A D m) (fun val => m) fun _ =>\n      have next :=\n        @DefiKernel.Interleaving.advance P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries left right\n          (@DefiKernel.Atomic.Machine.speculative P A D m) branch;\n      have running :=\n        @DefiKernel.Atomic.Machine.mk P A D (@DefiKernel.Atomic.Machine.entryWorld P A D m) next\n          (@DefiKernel.Atomic.Machine.outstanding P A D m)\n          (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) (@DefiKernel.Atomic.Machine.position P A D m)\n            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))\n          (@DefiKernel.Atomic.Machine.abort P A D m);\n      @DefiKernel.Atomic.advance.match_3.{1} P A D (fun x => DefiKernel.Atomic.Machine P A D)\n        (@GetElem?.getElem?.{0, 0, 0} (List.{0} (DefiKernel.Interleaving.Attempt P A D)) Nat\n          (DefiKernel.Interleaving.Attempt P A D)\n          (fun as i => @LT.lt.{0} Nat instLTNat i (@List.length.{0} (DefiKernel.Interleaving.Attempt P A D) as))\n          (@List.instGetElem?NatLtLength.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@DefiKernel.Interleaving.Machine.attempts P A D next)\n          (@List.length.{0} (DefiKernel.Interleaving.Attempt P A D)\n            (@DefiKernel.Interleaving.Machine.attempts P A D (@DefiKernel.Atomic.Machine.speculative P A D m))))\n        (fun _ => running) fun attempt =>\n        @DefiKernel.Atomic.observeAttempt.match_1.{1} P A D (fun x => DefiKernel.Atomic.Machine P A D)\n          (@DefiKernel.Interleaving.Attempt.outcome P A D attempt)\n          (fun reason =>\n            @DefiKernel.Atomic.Machine.mk P A D (@DefiKernel.Atomic.Machine.entryWorld P A D running)\n              (@DefiKernel.Atomic.Machine.speculative P A D running)\n              (@DefiKernel.Atomic.Machine.outstanding P A D running) (@DefiKernel.Atomic.Machine.position P A D running)\n              (@Option.some.{0} (DefiKernel.Atomic.AbortReason P A D)\n                (@DefiKernel.Atomic.AbortReason.kernel P A D (@DefiKernel.Interleaving.Attempt.branch P A D attempt)\n                  (@DefiKernel.Interleaving.Attempt.index P A D attempt) (@DefiKernel.Atomic.Machine.position P A D m)\n                  (@DefiKernel.Interleaving.Attempt.invocation P A D attempt) reason)))\n          fun result =>\n          have owed :=\n            @DefiKernel.Atomic.updateOutstanding P A D inst inst_1 inst_2 policy\n              (@DefiKernel.Atomic.Machine.outstanding P A D m)\n              (@DefiKernel.Typed.InvocationContext.principal P D\n                (@DefiKernel.Composition.Boundary.ctx P A D\n                  (boundaries (@DefiKernel.Interleaving.Attempt.branch P A D attempt)\n                    (@DefiKernel.Interleaving.Attempt.index P A D attempt))))\n              (@DefiKernel.Composition.StepResult.receipt P A D result);\n          have accepted :=\n            @DefiKernel.Atomic.Machine.mk P A D (@DefiKernel.Atomic.Machine.entryWorld P A D running)\n              (@DefiKernel.Atomic.Machine.speculative P A D running) owed\n              (@DefiKernel.Atomic.Machine.position P A D running) (@DefiKernel.Atomic.Machine.abort P A D running);\n          @DefiKernel.Atomic.advance.match_1.{1} P A D (fun x => DefiKernel.Atomic.Machine P A D)\n            (@DefiKernel.Atomic.checkSupply P A D inst_1 inst_2 policy\n              (@DefiKernel.Composition.StepResult.receipt P A D result))\n            (fun _ => accepted) fun lane amount =>\n            @DefiKernel.Atomic.Machine.mk P A D (@DefiKernel.Atomic.Machine.entryWorld P A D accepted)\n              (@DefiKernel.Atomic.Machine.speculative P A D accepted)\n              (@DefiKernel.Atomic.Machine.outstanding P A D accepted)\n              (@DefiKernel.Atomic.Machine.position P A D accepted)\n              (@Option.some.{0} (DefiKernel.Atomic.AbortReason P A D)\n                (@DefiKernel.Atomic.AbortReason.laneSupply P A D (@DefiKernel.Interleaving.Attempt.branch P A D attempt)\n                  (@DefiKernel.Interleaving.Attempt.index P A D attempt) (@DefiKernel.Atomic.Machine.position P A D m)\n                  (@DefiKernel.Interleaving.Attempt.invocation P A D attempt) lane amount)))","user_name":"DefiKernel.Atomic.advance.eq_1"}
