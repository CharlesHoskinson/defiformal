ped.Cell P A D)) (List.{0} (DefiKernel.Typed.Cell P A D))\n                    (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Typed.Cell P A D))\n                      (@List.instAppend.{0} (DefiKernel.Typed.Cell P A D)))\n                    (@DefiKernel.Parallel.Footprint.writes P A D lf) (@DefiKernel.Parallel.Footprint.writes P A D rf)) →\n            Iff (predicate (@DefiKernel.Typed.ExecutionResult.state P A D initial))\n              (predicate\n                (@DefiKernel.Typed.ExecutionResult.state P A D\n                  (@DefiKernel.Atomic.Result.publicWorld P A D\n                    (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label\n                      policy initial left right schedule))))","user_name":"DefiKernel.Atomic.runAtomic_analyzed_predicate_frame"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Preservation","name":"DefiKernel.Atomic.runAtomic_commit_authority","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (m : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D)\n      (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n        left right schedule)\n      (@DefiKernel.Atomic.Result.committed P A D label schedule m) →\n    ∀ (attempt : DefiKernel.Interleaving.Attempt P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Interleaving.Attempt P A D) (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@List.instMembership.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@DefiKernel.Interleaving.Machine.attempts P A D (@DefiKernel.Atomic.Machine.speculative P A D m)) attempt →\n        ∀ (result : DefiKernel.Composition.StepResult P A D),\n          @Eq.{1} (Except.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D))\n              (@DefiKernel.Interleaving.Attempt.outcome P A D attempt)\n              (@Except.ok.{0, 0} DefiKernel.Composition.Failure (DefiKernel.Composition.StepResult P A D) result) →\n            @DefiKernel.Composition.ReceiptAuthorized P A D inst inst_1 inst_2\n              (@DefiKernel.Interleaving.Attempt.before P A D attempt)\n              (boundaries (@DefiKernel.Interleaving.Attempt.branch P A D attempt)\n                (@DefiKernel.Interleaving.Attempt.index P A D attempt))\n              (@DefiKernel.Composition.StepResult.receipt P A D result)","user_name":"DefiKernel.Atomic.runAtomic_commit_authority"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Preservation","name":"DefiKernel.Atomic.runAtomic_commit_before_store","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (m : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D)\n      (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n        left right schedule)\n      (@DefiKernel.Atomic.Result.committed P A D label schedule m) →\n    ∀ (attempt : DefiKernel.Interleaving.Attempt P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Interleaving.Attempt P A D) (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@List.instMembership.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@DefiKernel.Interleaving.Machine.attempts P A D (@DefiKernel.Atomic.Machine.speculative P A D m)) attempt →\n        @Eq.{1} (DefiKernel.Typed.CapabilityStore P A D)\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D (@DefiKernel.Interleaving.Attempt.before P A D attempt))\n          (@DefiKernel.Typed.ExecutionResult.capabilities P A D initial)","user_name":"DefiKernel.Atomic.runAtomic_commit_before_store"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Correspondence","name":"DefiKernel.Atomic.runAtomic_commit_cash","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (m : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D)\n      (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n        left right schedule)\n      (@DefiKernel.Atomic.Result.committed P A D label schedule m) →\n    ∀ (lane : DefiKernel.Atomic.Lane P A D),\n      @Membership.mem.{0, 0} (DefiKernel.Atomic.Lane P A D) (List.{0} (DefiKernel.Atomic.Lane P A D))\n          (@List.instMembership.{0} (DefiKernel.Atomic.Lane P A D)) (@DefiKernel.Atomic.Policy.lanes P A D policy)\n          lane →\n        @Eq.{1} Rat\n          (@DefiKernel.Typed.State.balance P A D\n            (@DefiKernel.Typed.ExecutionResult.state P A D\n              (@DefiKernel.Interleaving.Machine.world P A D (@DefiKernel.Atomic.Machine.speculative P A D m)))\n            (@DefiKernel.Atomic.Lane.cell P A D lane))\n          (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D initial)\n            (@DefiKernel.Atomic.Lane.cell P A D lane))","user_name":"DefiKernel.Atomic.runAtomic_commit_cash"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Completion","name":"DefiKernel.Atomic.runAtomic_commit_data","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (m : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D)\n      (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n        left right schedule)\n      (@DefiKernel.Atomic.Result.committed P A D label schedule m) →\n    ∃ lf rf,\n      And\n        (@Eq.{1}\n          (Except.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n            (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n          (@DefiKernel.Atomic.admit P A D inst inst_1 inst_2 cfg boundaries policy left right schedule)\n          (@Except.ok.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n            (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n            (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)))\n        (And\n          (@Eq.{1} (DefiKernel.Atomic.Machine P A D) m\n            (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy initial\n              left right schedule))\n          (And\n            (@Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D)) (@DefiKernel.Atomic.Machine.abort P A D m)\n              (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D)))\n            (@Eq.{1} (List.{0} (DefiKernel.Atomic.Residual P A D))\n              (@DefiKernel.Atomic.residuals P A D policy (@DefiKernel.Atomic.Machine.outstanding P A D m))\n              (@List.nil.{0} (DefiKernel.Atomic.Residual P A D)))))","user_name":"DefiKernel.Atomic.runAtomic_commit_data"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Correspondence","name":"DefiKernel.Atomic.runAtomic_commit_iff_interleaving","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Atomic.admit P A D inst inst_1 inst_2 cfg boundaries policy left right schedule)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    Iff\n      (@Eq.{1} (DefiKernel.Atomic.Result P A D)\n        (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n          left right schedule)\n        (@DefiKernel.Atomic.Result.committed P A D label schedule\n          (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy initial left\n            right schedule)))\n      (And\n        (@DefiKernel.Atomic.GoodAttempts P A D inst_1 inst_2 policy\n          (@DefiKernel.Interleaving.Machine.attempts P A D\n            (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n              left right schedule)))\n        (@Eq.{1} (List.{0} (DefiKernel.Atomic.Residual P A D))\n          (@DefiKernel.Atomic.residuals P A D policy\n            (@DefiKernel.Atomic.outstandingFromAttempts P A D inst inst_1 inst_2 policy boundaries\n              (@DefiKernel.Interleaving.Machine.attempts P A D\n                (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n                  left right schedule))))\n          (@List.nil.{0} (DefiKernel.Atomic.Residual P A D))))","user_name":"DefiKernel.Atomic.runAtomic_commit_iff_interleaving"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Completion","name":"DefiKernel.Atomic.runAtomic_commit_interleaving","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (m : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D)\n      (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n        left right schedule)\n      (@DefiKernel.Atomic.Result.committed P A D label schedule m) →\n    And\n      (@Eq.{1} (DefiKernel.Interleaving.Result P A D)\n        (@DefiKernel.Interleaving.runInterleaving P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n          left right schedule)\n        (@DefiKernel.Interleaving.Result.executed P A D schedule (@DefiKernel.Atomic.Machine.speculative P A D m)))\n      (∀ (b : DefiKernel.Parallel.BranchId),\n        And\n          (@Eq.{1} (Option.{0} (DefiKernel.Composition.LocatedFailure P A D))\n            (@DefiKernel.Interleaving.LocalState.failure P A D\n              (@DefiKernel.Interleaving.Machine.local P A D (@DefiKernel.Atomic.Machine.speculative P A D m) b))\n            (@Option.none.{0} (DefiKernel.Composition.LocatedFailure P A D)))\n          (@Eq.{1} Nat\n            (@DefiKernel.Interleaving.LocalState.nextIndex P A D\n              (@DefiKernel.Interleaving.Machine.local P A D (@DefiKernel.Atomic.Machine.speculative P A D m) b))\n            (@List.length.{0} (DefiKernel.Composition.Invocation P A D)\n              (@DefiKernel.Interleaving.selectBranch P A D left right b))))","user_name":"DefiKernel.Atomic.runAtomic_commit_interleaving"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Preservation","name":"DefiKernel.Atomic.runAtomic_commit_locality","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (m : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D)\n      (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy initial\n        left right schedule)\n      (@DefiKernel.Atomic.Result.committed P A D label schedule m) →\n    ∀ c ∉ @DefiKernel.Interleaving.Machine.writes P A D (@DefiKernel.Atomic.Machine.speculative P A D m),\n      @Eq.{1} Rat\n        (@DefiKernel.Typed.State.balance P A D\n          (@DefiKernel.Typed.ExecutionResult.state P A D\n            (@DefiKernel.Interleaving.Machine.world P A D (@DefiKernel.Atomic.Machine.speculative P A D m)))\n          c)\n        (@DefiKernel.Typed.State.balance P A D (@DefiKernel.Typed.ExecutionResult.state P A D initial) c)","user_name":"DefiKernel.Atomic.runAtomic_commit_locality"}
ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Correspondence","name":"DefiKernel.Atomic.runAtomic_commit_of_interleaving","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  [inst_3 : Fintype.{0} P] [inst_4 : Fintype.{0} A] [inst_5 : Fintype.{0} D] (cfg : DefiKernel.Composition.Config P A D)\n  (boundaries : DefiKernel.Parallel.ParallelBoundary P A D) (label : Nat) (policy : DefiKernel.Atomic.Policy P A D)\n  (initial : DefiKernel.Composition.World P A D) (left right : DefiKernel.Parallel.Branch P A D)\n  (schedule : DefiKernel.Interleaving.Schedule) (lf rf : DefiKernel.Parallel.Footprint P A D),\n  @Eq.{1}\n      (Except.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D)))\n      (@DefiKernel.Atomic.admit P A D inst inst_1 inst_2 cfg boundaries policy left right schedule)\n      (@Except.ok.{0, 0} (DefiKernel.Atomic.AdmissionFailure P A D)\n        (Prod.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D))\n        (@Prod.mk.{0, 0} (DefiKernel.Parallel.Footprint P A D) (DefiKernel.Parallel.Footprint P A D) lf rf)) →\n    @DefiKernel.Atomic.GoodAttempts P A D inst_1 inst_2 policy\n        (@DefiKernel.Interleaving.Machine.attempts P A D\n          (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial left\n            right schedule)) →\n      @Eq.{1} (List.{0} (DefiKernel.Atomic.Residual P A D))\n          (@DefiKernel.Atomic.residuals P A D policy\n            (@DefiKernel.Atomic.outstandingFromAttempts P A D inst inst_1 inst_2 policy boundaries\n              (@DefiKernel.Interleaving.Machine.attempts P A D\n                (@DefiKernel.Interleaving.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries initial\n                  left right schedule))))\n          (@List.nil.{0} (DefiKernel.Atomic.Residual P A D)) →\n        @Eq.{1} (DefiKernel.Atomic.Result P A D)\n          (@DefiKernel.Atomic.runAtomic P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries label policy\n            initial left right schedule)\n          (@DefiKernel.Atomic.Result.committed P A D label schedule\n            (@DefiKernel.Atomic.runPrefix P A D inst inst_1 inst_2 inst_3 inst_4 inst_5 cfg boundaries policy initial\n              left right schedule))","user_name":"DefiKernel.Atomic.runAtomic_commit_of_interleaving"}
