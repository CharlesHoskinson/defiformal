ATOMIC_PROOF_JSON {"axioms":["propext","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Completion","name":"DefiKernel.Atomic.finish_commit_data","statement":"∀ {P A D : Type} (label label' : Nat) (schedule schedule' : DefiKernel.Interleaving.Schedule)\n  (policy : DefiKernel.Atomic.Policy P A D) (m m' : DefiKernel.Atomic.Machine P A D),\n  @Eq.{1} (DefiKernel.Atomic.Result P A D) (@DefiKernel.Atomic.finish P A D label schedule policy m)\n      (@DefiKernel.Atomic.Result.committed P A D label' schedule' m') →\n    And (@Eq.{1} Nat label label')\n      (And (@Eq.{1} DefiKernel.Interleaving.Schedule schedule schedule')\n        (And (@Eq.{1} (DefiKernel.Atomic.Machine P A D) m m')\n          (And\n            (@Eq.{1} (Option.{0} (DefiKernel.Atomic.AbortReason P A D)) (@DefiKernel.Atomic.Machine.abort P A D m)\n              (@Option.none.{0} (DefiKernel.Atomic.AbortReason P A D)))\n            (@Eq.{1} (List.{0} (DefiKernel.Atomic.Residual P A D))\n              (@DefiKernel.Atomic.residuals P A D policy (@DefiKernel.Atomic.Machine.outstanding P A D m))\n              (@List.nil.{0} (DefiKernel.Atomic.Residual P A D))))))","user_name":"DefiKernel.Atomic.finish_commit_data"}
