ATOMIC_PROOF_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"is_private_name":false,"module":"DefiKernel.Atomic.Settlement","name":"DefiKernel.Atomic.outstandingFromAttempts_append","statement":"∀ {P A D : Type} [inst : DecidableEq.{1} P] [inst_1 : DecidableEq.{1} A] [inst_2 : DecidableEq.{1} D]\n  (policy : DefiKernel.Atomic.Policy P A D) (boundaries : DefiKernel.Parallel.ParallelBoundary P A D)\n  (xs ys : List.{0} (DefiKernel.Interleaving.Attempt P A D)),\n  @Eq.{1} (DefiKernel.Atomic.Outstanding P A D)\n    (@DefiKernel.Atomic.outstandingFromAttempts P A D inst inst_1 inst_2 policy boundaries\n      (@HAppend.hAppend.{0, 0, 0} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n        (List.{0} (DefiKernel.Interleaving.Attempt P A D)) (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n        (@instHAppendOfAppend.{0} (List.{0} (DefiKernel.Interleaving.Attempt P A D))\n          (@List.instAppend.{0} (DefiKernel.Interleaving.Attempt P A D)))\n        xs ys))\n    (@List.foldl.{0, 0} (DefiKernel.Atomic.Outstanding P A D) (DefiKernel.Interleaving.Attempt P A D)\n      (@DefiKernel.Atomic.attemptOutstanding P A D inst inst_1 inst_2 policy boundaries)\n      (@DefiKernel.Atomic.outstandingFromAttempts P A D inst inst_1 inst_2 policy boundaries xs) ys)","user_name":"DefiKernel.Atomic.outstandingFromAttempts_append"}
